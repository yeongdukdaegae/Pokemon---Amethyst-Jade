
// 시험용: dis.isPixelExists 대신 (이 에디터에는 아직 없음) — 그림마다 맨 위 픽셀 줄보다 아래면 1
func bit pixShim(string t, int x, int y){
    var list call nm = ["104", "69", "104f", "117f", "69f"];
    var list call tp = [30, 11, 29, 19, 11];
    var int call k = nm.find(t);
    if [k == 0]{
        return(0);
    }
    if [y >= tp[k]]{
        return(1);
    }
    return(0);
}
