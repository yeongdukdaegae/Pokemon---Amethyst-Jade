    engLang[2535] = "The user slams into the target with its flame-covered body. The more the user outweighs the target, the greater the move's power.";
    engLang[2536] = "The user attacks its target by encircling it in sharp leaves. This attack may also lower the target’s accuracy.";
    engLang[2537] = "The user crushes its target by rolling over the target with its rolled-up body. This may also make the target flinch.";
    engLang[2538] = "The user protects itself by wrapping its body in soft cotton, drastically boosting its Defense stat.";
    engLang[2539] = "The user looses a pitch-black shock wave at the target to inflict damage. This may also lower the target's accuracy.";
    engLang[2540] = "The user materializes an odd psychic wave to attack the target. This move deals physical damage.";
    engLang[2541] = "The user attacks by striking the target with its hard tail. This move hits two to five times in a row.";
    engLang[2542] = "The user attacks by wrapping its opponent in a fierce wind. This may also confuse the target.";
    engLang[2543] = "The user charges its head into its target, using its powerful guard hair. This also damages the user a little.";
    engLang[2544] = "The user attacks by throwing steel gears at its target twice.";
    engLang[2545] = "The user torches everything around it in an inferno of scarlet flames. This may also leave those it hits with a burn.";
    engLang[2546] = "The user fires a beam of light at its target. The move’s type changes depending on the Drive the user holds.";
    engLang[2547] = "The user sings an ancient song and attacks by appealing to the hearts of the listening opposing Pokémon. This may also induce sleep.";
    engLang[2548] = "The user cuts with its long horn. The odd power contained in the horn deals physical damage to the target.";
    engLang[2549] = "The user attacks by blowing freezing cold air at opposing Pokémon. This also lowers their Speed stats.";
    engLang[2550] = "The user surrounds itself with a great amount of electricity and charges the target. This may also leave the target with paralysis.";
    engLang[2551] = "The user attacks by engulfing the target in an intense, yet beautiful, blue flame. This may also leave the target with a burn.";
    engLang[2552] = "Cloaked in flames, the user attacks the target by dancing and flapping its wings. This may also boost the user's Sp. Atk stat.";
    engLang[2553] = "The turn after using this move, the user hits the target with electrically charged ice to inflict damage. This may also leave the target with paralysis.";
    engLang[2554] = "The turn after using this move, the user surrounds the target with an ultracold, freezing wind to inflict damage. This may also leave the target with a burn.";
    engLang[2555] = "The user yells as if it's ranting about something, which lowers the Sp. Atk stats of opposing Pokémon.";
    engLang[2556] = "The user attacks by crashing large icicles onto the target. This may also make the target flinch.";
    engLang[2557] = "With a hot flame on its forehead, the user hurls itself at its target. This lowers the user’s Defense, Sp. Def, and Speed stats.";
    engLang[2558] = "The user brings down a giant flame. This move's power is boosted when influenced by an enormous lightning bolt.";
    engLang[2559] = "The user throws down a giant lightning bolt. This move's power is boosted when influenced by an enormous flame.";
    engLang[2560] = "The user dives down onto the target from the sky. This move is Fighting and Flying type simultaneously.";
    engLang[2561] = "Using a pulled-up mat as a shield, the user protects itself and its allies from damaging moves. This does not stop status moves.";
    engLang[2562] = "The user lets out a damaging belch at the target. The user must eat a held Berry to use this move.";
