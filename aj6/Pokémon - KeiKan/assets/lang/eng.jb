    engLang[3886] = "You handed over the {item} and received {total}!";
    engLang[3880] = "There's a PC. It doesn't seem usable right now.";
    engLang[3881] = "Nurse Joy";
    engLang[3890] = "It's crammed full of difficult-looking books.";
    engLang[3891] = "A huge machine that's analyzing something.\nNumbers keep scrolling across the screen.";
    engLang[3892] = "Research data is displayed on the screen.";
    engLang[7200] = "Right on time! Let's go in. It's about to start.\nWhy am I here so early? You have to hurry to get a good Pokémon!";
    engLang[7201] = "Oh! You're early! They say it opens soon.\nThanks to you, we'll get to pick good Pokémon.";
    engLang[7202] = "You're both early.";
    engLang[7203] = "This world is home to mysterious creatures called Pocket Monsters, or Pokémon for short.";
    engLang[7204] = "People live together with Pokémon, and grow stronger together through battles.";
    engLang[7205] = "Today I'll entrust each of you with a Pokémon.\nChoose the one you like from the three on the table.";
    engLang[7206] = "You pick first. I'll watch what you choose.";
    engLang[7207] = "The {type}-type Pokémon, {poke}!";
    engLang[7208] = "Will you choose this Pokémon?";
    engLang[7209] = "Let's do our best, {poke}!";
    engLang[7210] = "Then I'll take...";
    engLang[7211] = "Don't hate me too much. I may not look it, but I'm super competitive.";
    engLang[7212] = "Well, you're better at battling than me anyway. I need a handicap.";
    engLang[7213] = "Let's battle with the Pokémon we catch at the end of that road. OK?";
    engLang[7214] = "Sorry, but you can't go past here yet.";
    engLang[7215] = "Hyunjung";
    engLang[7216] = "You haven't picked a Pokémon yet, have you? Choose one from the table.";
    engLang[7217] = "Choose the one you like from the three on the table.";
    engLang[7218] = "I hope you have a wonderful journey with your Pokémon.";
    engLang[7219] = "Summary";
    engLang[7220] = "Item";
    engLang[7221] = "Pokédex";
    engLang[7222] = "Release";
    engLang[7223] = "Do you really want to release {poke}?";
    engLang[7224] = "{poke} was released.\nBye-bye, {poke}!";
    engLang[7225] = "A Pokémon in a Sticker Ball can't be released!";
    engLang[7226] = "You can't release your last Pokémon!";
    engLang[7227] = "Give";
    engLang[7228] = "{poke} was given the {item} to hold.";
    engLang[7229] = "Took the {old} from {poke}\nand gave it the {item}.";
    engLang[7230] = "Summary   (Z: reorder moves · X: back)";
    engLang[7231] = "Learning {move} — choose a move to forget";
    engLang[7232] = "There are no items to use or give.";
    engLang[7233] = "The Pokédex isn't ready yet.";
    engLang[7234] = "{poke} wants to learn {move}...\nBut it already knows four moves!";
    engLang[7235] = "1, 2, and... Poof!\n{poke} forgot {old}!";
    engLang[7236] = "{poke} did not learn {move}.";
    engLang[7237] = "Choose an item";
    engLang[7374] = "Take item";
    engLang[7375] = "Received the {item} from {poke}.";
    engLang[7376] = "Flowder City";
    engLang[7377] = "Welcome to the Flowder City Mart!\nHow may I help you?";
    engLang[7378] = "Flowder City Gym\n...The door is locked tight. The Leader seems to be away.";
    engLang[7379] = "This is the Flowder City Gym. Leader Flowney is a master of Flying-type Pokémon that ride the wind.\nThey say Flowney's Pokémon strike as fast as the wind, so challengers lose before they can react.\nIf you plan to challenge, sign up at the reception inside first. And bring Pokémon that are strong against Flying types!";
    engLang[7380] = "Pokémon Trainer";
    engLang[7381] = "You're late! I thought you got lost in the forest.\n...Well, I just got here myself. Anyway!\nRemember our promise? A battle at the end of the road with the Pokémon we caught.\nThis is the end of Route 1. I caught two partners in the forest too.\nI've got the type advantage and higher levels. No holding back this time!";
    engLang[7382] = "Oh, there you are! So many Bug Pokémon in the forest, right? They kept startling me.\nBut I made some new friends thanks to them. Noroki and Atchi! Cute, huh?\nWe promised, remember? A battle at the end of the road with the Pokémon we caught.\nThis is the end of Route 1. And I got my handicap... I think I can win today?\nAlright, go easy on me!";
    engLang[7383] = "...Hmph, fine. You did better this time.\nDon't get the wrong idea, though. My Pokémon just haven't been with me long.\nFlowder City is up ahead. There's a Gym there, and I'm getting that Badge first!\nNext time we meet, I'm winning. Be ready!";
    engLang[7384] = "Haha, I lost. You're really strong.\nMy Pokémon tried so hard... I guess I'm still bad at giving orders.\nFlowder City is up ahead. There's a Gym, so I'll practice more there.\nNext time I'll win for real. Don't get too far ahead until then!";
    engLang[7401] = "What a wonderful battle. I could feel you and your Pokémon as one.";
    engLang[7402] = "Whoa! My Kkumbeok...!";
    engLang[7403] = "My Bug Pokémon lost like that!";
    engLang[7404] = "Lost before even reaching the forest...";
    engLang[7405] = "Ugh, even forest Bug Pokémon couldn't win!";
    engLang[7406] = "Oh my, I lost? You're pretty good.";
    engLang[7407] = "My Kricketot's song didn't work...";
    engLang[7408] = "Even Eevee lost...! That's the end of our walk.";
    engLang[7409] = "Even the lake's Bug Pokémon are no match for you.";
    engLang[7410] = "I said you were good, and you really are.";
    engLang[7411] = "Pikachu and I lost our way and the battle...";
    engLang[7412] = "No way... I had the type and level advantage!";
    engLang[7413] = "Wow... even with a handicap. You're amazing!";
    engLang[3901] = "Account Memo";
    engLang[5901] = "A note from the Professor with a Pokémon Center PC account written on it. Activate it at the PC in the corner of a Pokémon Center.";
    engLang[3902] = "Flowder Gym Pass";
    engLang[5902] = "A challenge application issued by the terminal in the Flowder Gym lobby. Proof that you may challenge Leader Flowney.";
    engLang[3903] = "Gym Potion";
    engLang[5903] = "A Potion that can only be used inside Flowder Gym. Restores 20 HP. Returned when you leave the Gym.";
    engLang[3904] = "Gym Revive";
    engLang[5904] = "A Revive that can only be used inside Flowder Gym. Revives a fainted Pokémon with half its HP. Returned when you leave the Gym.";
    engLang[7385] = "And take this note too.\nIt has a Pokémon Center PC account on it. Activate it at the PC in the corner of a Pokémon Center, and you can store the Pokémon you catch.";
    engLang[7386] = "There is a PC here.\nYou could activate it with the account memo from the Professor.";
    engLang[7387] = "Activate account";
    engLang[7388] = "Cancel";
    engLang[7389] = "The account was activated!\nYou can now store caught Pokémon in the PC.";
    engLang[7390] = "You turned on the PC.\nWhat would you like to do?";
    engLang[7391] = "Deposit Pokémon";
    engLang[7392] = "Withdraw Pokémon";
    engLang[7393] = "Log off";
    engLang[7394] = "{poke} was stored in the PC.";
    engLang[7395] = "{poke} was taken from the PC!";
    engLang[7396] = "You can't deposit your last Pokémon!";
    engLang[7397] = "The Boxes are full!";
    engLang[7398] = "Your party is full!";
    engLang[7399] = "Box {n}";
    engLang[7400] = "There are no Pokémon in the PC.";
    engLang[7420] = "Hardy";
    engLang[7421] = "Lonely";
    engLang[7422] = "Brave";
    engLang[7423] = "Adamant";
    engLang[7424] = "Naughty";
    engLang[7425] = "Bold";
    engLang[7426] = "Docile";
    engLang[7427] = "Relaxed";
    engLang[7428] = "Impish";
    engLang[7429] = "Lax";
    engLang[7430] = "Timid";
    engLang[7431] = "Hasty";
    engLang[7432] = "Serious";
    engLang[7433] = "Jolly";
    engLang[7434] = "Naive";
    engLang[7435] = "Modest";
    engLang[7436] = "Mild";
    engLang[7437] = "Quiet";
    engLang[7438] = "Bashful";
    engLang[7439] = "Rash";
    engLang[7440] = "Calm";
    engLang[7441] = "Gentle";
    engLang[7442] = "Sassy";
    engLang[7443] = "Careful";
    engLang[7444] = "Quirky";
    engLang[7445] = "Nature";
    engLang[7446] = "IVs";
    engLang[7447] = "EVs";
    engLang[7448] = "Pokémon Info";
    engLang[7449] = "Stats";
    engLang[7451] = "HP";
    engLang[7452] = "Attack";
    engLang[7453] = "Defense";
    engLang[7454] = "Sp. Atk";
    engLang[7455] = "Sp. Def";
    engLang[7456] = "Speed";
    engLang[7457] = "Welcome to Flowder Gym!\nIf you wish to challenge Leader Flowney, please get an application from the terminal next to the counter first.\nWith an application, the door to the arena will open for you.\nAnd please be careful. The winds inside the Gym are extremely strong. First-timers can barely stay on their feet!";
    engLang[7458] = "It's the Flowder Gym challenge terminal.\nThere's an \"Issue Application\" button on the screen.";
    engLang[7459] = "It's the door to the arena.\nThe roar of strong wind leaks through the gap...\nIt looks like you need an application to open it.";
    engLang[7460] = "Issue Application";
    engLang[7461] = "You've already received an application.\nThe Flowder Gym Pass is in the Key Items pocket.";
    engLang[7462] = "You put the Flowder Gym Pass in the Key Items pocket.";
    engLang[7463] = "You held the Flowder Gym Pass up to the door.\nThe door opened!";
    engLang[7470] = "Gym Trainer";
    engLang[7471] = "Haneul";
    engLang[7472] = "Mapa";
    engLang[7473] = "Nopsae";
    engLang[7474] = "If you landed on this platform, you know how to ride the wind!\nBut to reach Flowney, you'll have to get past me first!";
    engLang[7475] = "Not easy to stay up in this wind, is it?\nThis wind is home to my Pokémon. Bring it!";
    engLang[7476] = "Impressive, making it all the way up here!\nI guard the platform right below Flowney. I'll take you on!";
    engLang[7477] = "Whoa... the wind must be on your side!";
    engLang[7478] = "I lost...! Your wings are the real deal.";
    engLang[7479] = "Splendid! You may fly on to Flowney now!";
    engLang[7480] = "The trick is to land on the next platform before your lift runs out!";
    engLang[7481] = "You only get one booster, so save it!";
    engLang[7482] = "The Starly here are raised by the Gym. You can't catch them!";
    engLang[7483] = "On really windy days, even I fall sometimes.";
    engLang[7484] = "Flowney is on the top platform. Brace yourself before you fly up!";
    engLang[7485] = "The Leader's wind is on a whole other level!";
    engLang[7486] = "A glider lent out by the Gym is lying here.\nIt looks like you could ride the wind between platforms.";
    engLang[7487] = "Put it on";
    engLang[7488] = "You put on the glider!\nPress Z on a platform to take off. Your lift slowly drops over the sky and refills when you land on a platform.\nIf it runs out, you'll fall, so be careful! Press Z while flying to use a booster.";
    engLang[7489] = "A Gym staff member gave you 2 Gym Potions, 1 Gym Revive,\nand 1 booster!\n(Gym-only items are returned when you leave the Gym.)";
    engLang[7490] = "Lift";
    engLang[7491] = "Booster {n} (Z)";
    engLang[7492] = "Press Z to take off";
    engLang[7493] = "You lost your lift and fell...!\n...A safety net caught you, and you're back in the lobby.";
    engLang[7494] = "The Gym's Pokémon can't be caught!";
    engLang[7495] = "Oh! The Gym's {poke}";
    engLang[7496] = "This is where Leader Flowney stands.\n...No one is here yet.";
    engLang[7497] = "Wind: {d}";
    engLang[7498] = "↑ Up";
    engLang[7499] = "↗ Up-right";
    engLang[7500] = "→ Right";
    engLang[7501] = "↘ Down-right";
    engLang[7502] = "↓ Down (headwind)";
    engLang[7503] = "↙ Down-left";
    engLang[7504] = "← Left";
    engLang[7505] = "↖ Up-left";
    engLang[7506] = "Send to Box";
    engLang[7507] = "An electric current ran across the battlefield!";
    engLang[7508] = "Grass grew to cover the battlefield!";
    engLang[7509] = "Mist swirled around the battlefield!";
    engLang[7510] = "The battlefield got weird!";
    engLang[7511] = "The electricity disappeared from the battlefield.";
    engLang[7512] = "The grass disappeared from the battlefield.";
    engLang[7513] = "The mist disappeared from the battlefield.";
    engLang[7514] = "The weirdness disappeared from the battlefield!";
    engLang[7515] = "You lost your footing and fell...!\n...A safety net caught you, and you're back in the lobby.";   // Yupung Gym: off the platforms without flying (lib/gymFly.jbl)
    engLang[7516] = "Flowney";   // 유풍체육관 관장 휴린
    engLang[7517] = "Gym Leader";   // 유풍체육관 관장 휴린
    engLang[7518] = "A cool breeze... so it's you. The one who pushed through this wind.\nDon't take this lightly. You'll be blown away.";   // 유풍체육관 관장 휴린
    engLang[7519] = "...The wind has stopped. You were one step faster than the wind.\nAll right, this Flowd Badge is yours.";   // 유풍체육관 관장 휴린
    engLang[7520] = "You don't fight the wind. You ride it.\nSomeone who knows that can fly even higher.";   // 유풍체육관 관장 휴린
    engLang[7521] = "Next time, I'll have a stronger wind ready.\nTry not to get blown away then.";   // 유풍체육관 관장 휴린
    engLang[7522] = "You received the Flowd Badge from Flowney!";   // 유풍체육관 관장 휴린
    engLang[7238] = "Here, take these too.\nThey're Poké Balls, for catching Pokémon.";
    engLang[7239] = "You received {n} {item}s!";
    engLang[7240] = "Hillet Town Shop";
    engLang[7241] = "Welcome to the Hillet Town Shop!\nHow may I help you?";
    engLang[7242] = "All sorts of goods are lined up on the shelves.";
    engLang[7243] = "What? {poke} is evolving!";
    engLang[7244] = "Congratulations! Your {poke} evolved into {new}!";
    engLang[7245] = "Huh? {poke} stopped evolving!";
    engLang[7246] = "The rest of your team gained Exp. Points too!";
    engLang[7247] = "Export Report";
    engLang[7248] = "Import Report";
    engLang[7249] = "Your report was exported to a file.";
    engLang[7250] = "There is no report to export.\nPlease save first.";
    engLang[7251] = "Your game will be replaced with the imported report\nand you'll return to the title screen. Continue?";
    engLang[7252] = "The report was imported!\nReturning to the title screen.";
    engLang[7253] = "That is not a valid report file.";
    engLang[7254] = "X : Import a report";
    engLang[7255] = "Export your report to a file, or import one from a file.";
    engLang[7256] = "Boramae Forest";
    engLang[7257] = "The trees are too thick to go any further.";
    engLang[7258] = "Copyright";
    engLang[7280] = "\"Pokémon - AJ\" is a non-commercial fan game.\n\nPokémon names, characters, settings, original graphics and music are copyright of Nintendo, Creatures Inc., GAME FREAK inc. and The Pokémon Company.";
    engLang[7281] = "[Imported assets]\n· Pokémon, trainer and NPC sprites, item icons: GAME FREAK (original games)\n· Music, sound effects, cries: GAME FREAK (original games)\n· Some sprite and cry files: pret/pokeplatinum, PokeAPI\n· Pokémon overworld sprites: pret/pokeheartgold (HeartGold / SoulSilver)\n· Logo: GAME FREAK";
    engLang[7282] = "[Imported assets]\n· Font: Pokémon DPPt (FontStruct)\n  fontstruct.com/fontstructions/show/1951915/pokemon-dppt-4\n· Pokémon and move data: PokeAPI, Pokémon Showdown\n· Korean names: official game translations";
    engLang[7283] = "[Original]\n· Game code (Jawbreaker) and engine\n· Story, dialogue, characters, original Pokémon\n· Town, route and forest tiles and maps, interiors, region map\n· Type icons, battle graphics, UI graphics, game rules";
    engLang[7284] = "You blacked out!";
    engLang[7285] = "You gave ₩{m} to the winner, {tr}...";
    engLang[7286] = "First, let me restore your Pokémon to full health.";
    engLang[7287] = "Your Pokémon are fighting fit!\nPlease take care of them!";
    engLang[7288] = "{poke} is blocking the way!\nIt is glaring at you...";
    engLang[7289] = "One of {poke}'s HP gauges shattered!";
    engLang[7290] = "Stat changes have no effect on {poke}!";
    engLang[7291] = "It still has HP gauges left.\nIt can't be caught yet!";
    engLang[7292] = "You used the {item}!";
    engLang[7293] = "The effects of the previous\nspray are still lingering!";
    engLang[7294] = "The repellent wore off!";
    engLang[7299] = "Lass";
    engLang[7305] = "Minhyuk";
    engLang[7306] = "Sua";
    engLang[7307] = "Doyun";
    engLang[7308] = "Harin";
    engLang[7309] = "Siwoo";
    engLang[7310] = "Jia";
    engLang[7311] = "Yerin";
    engLang[7325] = "Welcome to Boramae Forest!\nThe bugs here are tougher than on Route 1!";
    engLang[7326] = "Oh, our eyes met?\nThen we have to battle!";
    engLang[7327] = "Let me show you what I caught in this grass!";
    engLang[7328] = "I was out for a walk with my Eevee.\nGet in the way and we battle!";
    engLang[7329] = "The lakeside is bug Pokémon heaven!\nLet's battle!";
    engLang[7330] = "You made it this far?\nMy Pokémon aren't pushovers either!";
    engLang[7331] = "Pikachu and I got lost in the forest...\nBut a battle's a battle!";
    engLang[7345] = "Ugh... I thought I'd be stronger in the forest!";
    engLang[7346] = "I lost... Next time I'll win with cuter Pokémon!";
    engLang[7347] = "My bug Pokémon...!";
    engLang[7348] = "Good job, Eevee...";
    engLang[7349] = "I almost fell into the lake...";
    engLang[7350] = "You're stronger than I thought...";
    engLang[7351] = "Sorry, Pikachu...";
    engLang[7360] = "The forest splits into many paths.\nYou can only jump down ledges, so be careful.";
    engLang[7361] = "Deep in the grass,\nScyther sometimes shows up!";
    engLang[7362] = "I heard Starly gets\nreally strong when it evolves.";
    engLang[7363] = "Fomantis loves basking in the sun.";
    engLang[7364] = "They say Atchi is hard to evolve.\nNobody knows when it evolves.";
    engLang[7365] = "Have you heard Kricketot's cry?";
    engLang[7366] = "Eevee can evolve into all kinds\nof forms with evolution stones!";
    engLang[7367] = "Bulbasaur and Chikorita often show up\nin the northern grass.";
    engLang[7368] = "Squirtle and Totodile live in the lake.\nRumor says someone even saw a Dratini!";
    engLang[7369] = "Kricketot evolves quickly. I like that.";
    engLang[7370] = "Drilbur digs all over.\nThat's why the forest floor is so bumpy.";
    engLang[7371] = "Did you see the huge Venusaur at the fork?\nIt looked so scary.";
    engLang[7372] = "I heard Pikachu evolves with a Thunder Stone.";
    engLang[7373] = "The southern path is still overgrown.\nYou can't get through.";
    engLang[7260] = "Bug Catcher";
    engLang[7261] = "Minsu";
    engLang[7262] = "Junho";
    engLang[7263] = "Taeyang";
    engLang[7264] = "Hey! Our eyes met!\nWanna see the bug Pokémon I just caught?";
    engLang[7265] = "I caught a ton of bug Pokémon in the grass!\nLet me show you!";
    engLang[7266] = "Heading to Boramae Forest, right?\nBattle me first!";
    engLang[7267] = "Ugh... Bug Pokémon are strong too!";
    engLang[7268] = "Next time I'll train them even more!";
    engLang[7269] = "They say even stronger bug Pokémon live in Boramae Forest.";
    engLang[7270] = "You got ₩{m} for winning!";
    engLang[7271] = "I think Modgit is way too weak.\nIt was cuter as a Noroki...";
    engLang[7272] = "Kumbeok dig around underground, so they're hard to catch.\nListen for footsteps in the grass.";
    engLang[7273] = "They say Acchi are hard to evolve.\nNobody knows when they evolve!";
    engLang[7274] = "Bug Pokémon evolve fast, which is great.\nBut my Kumbeok hasn't yet...";
    engLang[7275] = "Be careful deep in Boramae Forest. It's easy to get lost.";
    engLang[7276] = "I bought a new bug net,\nbut it turns out you can't catch Pokémon with a net.";
    engLang[7100] = "Gyeonghan Airport";
    engLang[7101] = "Flowder City";
    engLang[7102] = "Marto City";
    engLang[7103] = "Leafloat Town";
