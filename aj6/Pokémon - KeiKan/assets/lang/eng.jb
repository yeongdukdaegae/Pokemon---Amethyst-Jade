    engLang[2705] = "The user unleashes a strong beam. The recoil from this move harshly lowers the user's Sp. Atk stat.";
    engLang[2706] = "The user attacks by biting the target with its psychic capabilities. This move can also break barriers, such as Light Screen and Reflect.";
    engLang[2707] = "Driven by frustration, the user attacks the target. This move's power is doubled if the user's previous move failed.";
    engLang[2708] = "The user attacks by beating the target with a bone that contains a spirit. This may also lower the target’s Defense stat.";
    engLang[2709] = "The user smashes into the target at high speed. This move always goes first.";
    engLang[2710] = "The user slams into the target using a full-force blast of water. This may also lower the target's Defense stat.";
