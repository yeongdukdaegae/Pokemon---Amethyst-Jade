    engLang[2564] = "The user weaves a sticky net around the opposing team, which lowers their Speed stats upon switching into battle.";
    engLang[2565] = "When the user knocks out a target with this move, the user's Attack stat is boosted drastically.";
    engLang[2566] = "The user vanishes somewhere, then strikes the target on the next turn. This move hits even if the target protects itself.";
    engLang[2567] = "The user takes the target trick-or-treating. This adds Ghost type to the target’s type.";
    engLang[2568] = "Letting out a noble roar, the user intimidates the target and lowers the target's Attack and Sp. Atk stats.";
    engLang[2569] = "The user disperses electrically charged particles, which changes Normal-type moves to Electric-type moves.";
    engLang[2570] = "The user attacks everything around it. The user's HP is restored by half the damage taken by those hit.";
    engLang[2571] = "The user puts a forest curse on the target. This adds Grass type to the target's type.";
    engLang[2572] = "The user stirs up a violent petal blizzard and damages everything around it.";
    engLang[2573] = "The user rapidly cools the target. This may also leave the target frozen. This move is super effective on Water types.";
    engLang[2574] = "Letting out a charming cry, the user does emotional damage to opposing Pokémon. This attack never misses.";
    engLang[2575] = "With a parting threat, the user lowers the target's Attack and Sp. Atk stats. Then it switches places with a party Pokémon in waiting.";
    engLang[2576] = "All stat changes affecting the target turn topsy-turvy and become the opposite of what they were.";
    engLang[2577] = "The user steals the target's HP with a kiss. The user's HP is restored by over half the damage taken by the target.";
    engLang[2578] = "The user protects itself and its allies from status moves with a mysterious power. This does not stop moves that do damage.";
    engLang[2579] = "The user raises the Defense stats of all Grass-type Pokémon in battle with a mysterious power.";
    engLang[2580] = "The user turns the ground into Grassy Terrain for five turns. This restores the HP of Pokémon on the ground a little every turn and powers up Grass-type moves.";
    engLang[2581] = "This protects Pokémon on the ground from status conditions and halves damage from Dragon-type moves for five turns.";
    engLang[2582] = "If the target is electrified before it uses a move during that turn, the target’s move becomes Electric type.";
    engLang[2583] = "The user attacks by playing rough with the target. This may also lower the target's Attack stat.";
    engLang[2584] = "The user attacks by stirring up a fairy wind to strike the target.";
    engLang[2585] = "Borrowing the power of the moon, the user attacks the target. This may also lower the target's Sp. Atk stat.";
    engLang[2586] = "The user attacks everything around it with the destructive power of a terrible explosive sound.";
    engLang[2587] = "By locking down the battlefield, the user keeps all Pokémon from fleeing during the next turn.";
    engLang[2588] = "The user takes a defensive stance while it protects itself from damage. It also lowers the Attack stat of any attacker that makes direct contact.";
    engLang[2589] = "The user and the target become friends, and the target loses its will to fight. This lowers the target's Attack stat.";
    engLang[2590] = "The user tells the target a secret, and the target loses its ability to concentrate. This lowers the target's Sp. Atk stat.";
    engLang[2591] = "The user whips up a storm of diamonds to damage opposing Pokémon. This may also sharply boost the user's Defense stat.";
    engLang[2592] = "The user immerses the target in superheated steam. This may also leave the target with a burn.";
    engLang[2593] = "Using a hyperspace hole, the user appears right next to the target and strikes. This attack can hit a target using a move such as Protect or Detect.";
    engLang[2594] = "The user hits the target with throwing stars two to five times in a row. This move always goes first.";
    engLang[2595] = "The user attacks by breathing a special, hot fire. This also lowers the target's Sp. Atk stat.";
    engLang[2596] = "In addition to protecting the user from attacks, this move also damages any attacker that makes direct contact.";
    engLang[2597] = "The user boosts the Sp. Def stat of an ally Pokémon by using a mysterious aroma.";
    engLang[2598] = "The user's body generates an eerie impulse. Exposing the target to it harshly lowers the target's Sp. Atk stat.";
    engLang[2599] = "Opposing Pokémon are drenched in an odd poisonous liquid. This lowers the Attack, Sp. Atk, and Speed stats of a poisoned target.";
    engLang[2600] = "The user covers the target in a combustible powder. If the target uses a Fire-type move, the powder explodes and damages the target.";
    engLang[2601] = "The user absorbs energy and sharply raises its Sp. Atk, Sp. Def, and Speed stats on the next turn.";
    engLang[2602] = "The user manipulates magnetic fields, which boosts the Defense and Sp. Def stats of ally Pokémon with the Plus Ability or the Minus Ability.";
    engLang[2603] = "Using Happy Hour doubles the amount of prize money received after battle.";
    engLang[2604] = "The user turns the ground into Electric Terrain for five turns, powering up Electric-type moves. Pokémon on the ground can no longer fall asleep.";
    engLang[2605] = "The user damages opposing Pokémon by emitting a powerful flash.";
    engLang[2606] = "The Pokémon congratulates you on your special day!";
    engLang[2607] = "The user and an ally hold hands. This makes them very happy.";
    engLang[2608] = "The user stares at the target with its baby-doll eyes, which lowers the target's Attack stat. This move always goes first.";
    engLang[2609] = "The user attacks by nuzzling its electrified cheeks against the target. This also leaves the target with paralysis.";
    engLang[2610] = "The user holds back when it attacks, and the target is left with at least 1 HP.";
    engLang[2611] = "The target is infested and attacked for four to five turns. The target can't flee during this time.";
    engLang[2612] = "Striking opponents over and over makes the user’s fists harder. Hitting a target raises the Attack stat.";
    engLang[2613] = "The user absorbs its target’s HP. The user’s HP is restored by over half of the damage taken by the target.";
    engLang[2614] = "This move also hits opposing Pokémon that are in the air. Those Pokémon are knocked down to the ground.";
    engLang[2615] = "The user attacks with a wave that crawls along the ground. Those it hits can’t flee from battle.";
    engLang[2616] = "The user gathers the energy of the land and focuses that power on opposing Pokémon to damage them.";
    engLang[2617] = "Drawing power from the Eternal Flower, the user fires a powerful beam of light. This also damages the user quite a lot.";
    engLang[2618] = "The user attacks opposing Pokémon with countless beams of light that glow a deep and brilliant blue.";
    engLang[2619] = "The user attacks opposing Pokémon by manifesting the power of the land in fearsome blades of stone.";
    engLang[2620] = "The user attacks the target by dropping out of the sky at high speed. This also lowers the user's Defense and Sp. Def stats.";
    engLang[2621] = "Using its many arms, the user unleashes a barrage of attacks that ignore the effects of moves like Protect and Detect. This also lowers the user's Defense stat.";
    engLang[2659] = "The user restores its own HP by up to half its max HP. It regains more HP in a sandstorm.";
    engLang[2660] = "Although this move has great power, it works only on the first turn each time the user enters battle.";
    engLang[2661] = "In addition to protecting the user from attacks, this move also poisons any attacker that makes direct contact.";
    engLang[2662] = "The user attacks while simultaneously stitching the target's shadow to the ground to prevent the target from fleeing.";
    engLang[2663] = "The user swings both arms and hits the target. The target's stat changes don't affect the damage inflicted by this move.";
    engLang[2664] = "The user bursts into song, emitting many bubbles. Any Pokémon suffering from a burn will be cured by the touch of these bubbles.";
    engLang[2665] = "The user swings its strong, heavy fist at the target to inflict damage. This also lowers the user's Speed stat.";
    engLang[2666] = "The user restores the target's HP by up to half its max HP. More HP is restored when the ground is Grassy Terrain.";
    engLang[2667] = "The user fiercely attacks the target using its entire body.";
    engLang[2668] = "The user restores its own HP by the same amount as the target's Attack stat. It then lowers the target's Attack stat.";
    engLang[2669] = "The user gathers light on the first turn, then fills a blade with the light's energy and attacks on the next turn.";
    engLang[2670] = "The user attacks by pelting the target with leaves.";
    engLang[2671] = "The user shines a spotlight on the target so that only the target will be attacked during the turn.";
    engLang[2672] = "The user shoots poisonous threads to poison the target and lower the target's Speed stat.";
    engLang[2673] = "The user concentrates intensely. The attack on the next turn always results in a critical hit.";
    engLang[2674] = "The user engages its gears to raise the Attack and Sp. Atk stats of ally Pokémon with the Plus or Minus Ability.";
    engLang[2675] = "The user attacks the target's throat, and the resultant suffering prevents the target from using sound-based moves for two turns.";
    engLang[2676] = "The user attacks the enemy with a pollen puff that explodes. If the target is an ally, it gives the ally a pollen puff that restores its HP instead.";
    engLang[2677] = "The user entangles the target with its anchor chain while attacking. The target becomes unable to flee.";
    engLang[2678] = "This protects Pokémon on the ground from priority moves and powers up Psychic-type moves for five turns.";
    engLang[2679] = "The user makes a lunge at the target, attacking with full force. This also lowers the target's Attack stat.";
    engLang[2680] = "The user strikes the target with a burning lash. This also lowers the target's Defense stat.";
    engLang[2681] = "The user boasts its strength and attacks the target. The more the user's stats are boosted, the greater the move's power.";
    engLang[2682] = "To inflict massive damage, the user burns itself out. After using this move, the user will no longer be Fire type.";
    engLang[2683] = "The user exchanges Speed stats with the target.";
    engLang[2684] = "The user stabs the target with a sharp horn. This attack never misses.";
    engLang[2685] = "The user heals the target’s status condition. If the move succeeds, it also restores the user’s own HP.";
    engLang[2686] = "The user attacks the target by dancing with all its might. This move becomes the same type as the user's type.";
