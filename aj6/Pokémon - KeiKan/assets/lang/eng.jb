    engLang[2435] = "The user strikes everything around it by letting loose a flare of electricity. This may also leave those hit by the attack with paralysis.";
    engLang[2436] = "The user torches everything around it in an inferno of scarlet flames. This may also leave those it hits with a burn.";
    engLang[2437] = "The user whips up a storm of leaves around the target. The recoil from this move harshly lowers the user's Sp. Atk stat.";
    engLang[2438] = "The user violently whirls its vines, tentacles, or the like to lash the target.";
    engLang[2439] = "The user launches a huge boulder at the target to attack. The user can't move on the next turn.";
    engLang[2440] = "A slashing attack with a poisonous blade that may also poison the target. This move has a heightened chance of landing a critical hit.";
    engLang[2441] = "The user shoots filthy garbage at the target to attack. This may also poison the target.";
    engLang[2442] = "The user slams the target with its steel-hard head. This may also make the target flinch.";
    engLang[2443] = "The user launches steel bombs that stick to the target. This attack never misses.";
    engLang[2444] = "The user stabs the target with sharpened stones. This move has a heightened chance of landing a critical hit.";
    engLang[2445] = "If any opposing Pokémon is the opposite gender of the user, it is charmed, which harshly lowers its Sp. Atk stat.";
    engLang[2446] = "The user lays a trap of levitating stones around the opposing team. The trap damages opposing Pokémon that switch into battle.";
    engLang[2447] = "The user snares the target with grass and trips it. The heavier the target, the greater the move's power.";
    engLang[2448] = "The user attacks the target with sound waves of deafening chatter. This confuses the target.";
    engLang[2449] = "The user releases countless shots of light at the target. This move's type changes depending on the kind of plate held by the user.";
    engLang[2450] = "The user attacks by biting the target. If the target is holding a Berry, the user eats it and gains its effect.";
    engLang[2451] = "The user attacks the target with an electric charge. The residual electricity may also boost the user's Sp. Atk stat.";
    engLang[2452] = "The user slams its rugged body into the target to attack. This also damages the user quite a lot.";
    engLang[2453] = "The user lunges at the target to inflict damage, moving at blinding speed. This move always goes first.";
    engLang[2454] = "The user calls out its underlings to pummel the target. This move has a heightened chance of landing a critical hit.";
    engLang[2455] = "The user calls out its underlings to shield its body, boosting its Defense and Sp. Def stats.";
    engLang[2456] = "The user calls out its underlings to heal it. The user regains up to half of its max HP.";
    engLang[2457] = "The user attacks the target with a hazardous full-power headbutt. This also damages the user terribly.";
    engLang[2458] = "The user slams the target with a tail or the like. The target is hit twice in a row.";
    engLang[2459] = "The user blasts the target with power that distorts even time. The user can't move on the next turn.";
    engLang[2460] = "The user tears the target along with the space around it. This move has a heightened chance of landing a critical hit.";
    engLang[2461] = "The user faints. In return, the Pokémon taking its place will have its HP and PP restored and its status conditions cured.";
    engLang[2462] = "The target is crushed with great force. The more HP the target has left, the greater the move's power.";
    engLang[2463] = "The user traps the target inside a maelstrom of fire that inflicts damage for four to five turns.";
    engLang[2464] = "Opposing Pokémon are dragged into a world of total darkness that puts them to sleep.";
    engLang[2465] = "The user emits a shock wave from its body to attack its target. This may also harshly lower the target's Sp. Def stat.";
    engLang[2466] = "The user blasts the target with a gust of repulsive wind. This may also raise all the user’s stats at once.";
    engLang[2467] = "The user disappears on the first turn, then attacks on the next turn. This move hits even if the target protects itself.";
    engLang[2468] = "The user sharpens its claws to boost its Attack stat and accuracy.";
    engLang[2469] = "The user and its allies are protected from wide-ranging attacks for one turn.";
    engLang[2470] = "The user employs its psychic power to average its Defense and Sp. Def stats with those of the target.";
    engLang[2471] = "The user employs its psychic power to average its Attack and Sp. Atk stats with those of the target.";
    engLang[2472] = "The user creates a bizarre area in which Pokémon's Defense and Sp. Def stats are swapped for five turns.";
    engLang[2473] = "The user materializes an odd psychic wave to attack the target. This move deals physical damage.";
    engLang[2474] = "The user drenches the target in a special poisonous liquid. This move's power is doubled if the target is poisoned.";
    engLang[2475] = "The user sheds part of its body to make itself lighter and sharply raise its Speed stat.";
    engLang[2476] = "The user scatters a cloud of irritating powder to draw attention to itself. Opposing Pokémon aim only at the user.";
    engLang[2477] = "The user makes the target float with its psychic power. The target is easier to hit for three turns.";
    engLang[2478] = "The user creates a bizarre area in which Pokémon's held items lose their effects for five turns.";
    engLang[2479] = "The user throws a stone or similar projectile to attack the target. If the target is in the air, it will be knocked down to the ground.";
    engLang[2480] = "The user strikes the target with a fierce blow. This attack always results in a critical hit.";
    engLang[2481] = "The user attacks the target with a bursting flame. The bursting flame damages Pokémon next to the target as well.";
    engLang[2482] = "The user strikes everything around it by swamping the area with a giant sludge wave. This may also poison those it hits.";
    engLang[2483] = "The user lightly performs a beautiful, mystic dance. This boosts the user's Sp. Atk, Sp. Def, and Speed stats.";
    engLang[2484] = "The user slams into the target with its heavy body. The more the user outweighs the target, the greater the move's power.";
    engLang[2485] = "Using an odd shock wave, the user inflicts damage on any Pokémon of the same type in the area around it.";
    engLang[2486] = "The user hurls an electric orb at the target. The faster the user is than the target, the greater the move's power.";
    engLang[2487] = "The user shoots a torrent of water that changes the target's type to Water.";
    engLang[2488] = "Cloaking itself in flame, the user attacks the target. Then, building up momentum, the user boosts its Speed stat.";
    engLang[2489] = "The user coils up and concentrates. This boosts its Attack and Defense stats as well as its accuracy.";
    engLang[2490] = "The user makes a swift attack on the target's legs, which lowers the target's Speed stat.";
    engLang[2491] = "The user attacks by spitting fluid that works to melt the target. This also harshly lowers the target's Sp. Def stat.";
    engLang[2492] = "The user turns the target's strength against it. The higher the target's Attack stat, the greater the damage this move inflicts.";
    engLang[2493] = "The user emits a mysterious psychic wave that changes the target's Ability to Simple.";
    engLang[2494] = "The user dances with an odd rhythm that compels the target to mimic it, making the target's Ability the same as the user's.";
    engLang[2495] = "The user helps the target and makes it use its move right after the user.";
    engLang[2496] = "The user attacks the target with a song. If others use this move, they will act immediately after the initial user, and the power of their Rounds will be boosted.";
    engLang[2497] = "The user attacks the target with an echoing voice. If this move is used consecutively by any Pokémon, its power is boosted.";
    engLang[2498] = "Looking for an opening, the user strikes consistently. The target’s stat changes don’t affect this attack’s damage.";
    engLang[2499] = "The user attacks the target by throwing a clump of special mud. All stat changes are eliminated.";
    engLang[2500] = "The user attacks the target with stored power. The more the user's stats are boosted, the greater the move's power.";
    engLang[2501] = "The user protects itself and its allies from priority moves.";
    engLang[2502] = "The user teleports using a strange power and switches places with one of its allies. This move's chance of failing rises if it is used in succession.";
    engLang[2503] = "The user attacks by shooting boiling hot water at the target. This may also leave the target with a burn.";
    engLang[2504] = "The user breaks its shell, which lowers its Defense and Sp. Def stats but sharply boosts its Attack, Sp. Atk, and Speed stats.";
    engLang[2505] = "The user emits a healing pulse that restores the target's HP by up to half its max HP.";
    engLang[2506] = "This relentless attack does massive damage to a target affected by status conditions.";
    engLang[2507] = "The user takes the target into the sky, then drops it during the next turn. The target cannot attack while in the sky.";
    engLang[2508] = "The user rotates its gears, boosting its Attack stat and sharply boosting its Speed stat.";
    engLang[2509] = "The target is thrown, and a different Pokémon is dragged out. In the wild, this ends a battle against a single Pokémon.";
    engLang[2510] = "The user attacks opposing Pokémon with fire. If a Pokémon is holding a certain item, such as a Berry, the item becomes burned up and unusable.";
    engLang[2511] = "The user suppresses the target and makes its move go last.";
    engLang[2512] = "The user nimbly strikes the target. This attack does massive damage if the user isn't holding an item.";
    engLang[2513] = "The user reflects the target's type to become the same type as the target.";
    engLang[2514] = "The user takes revenge for a fainted ally. This move's power is boosted if an ally fainted in the previous turn.";
    engLang[2515] = "The user risks everything to attack the target. The user faints but inflicts damage equal to its own HP.";
    engLang[2516] = "The user passes its held item to the target when the target isn’t holding an item.";
    engLang[2517] = "The user attacks by engulfing the target in an intense fire. This leaves the target with a burn.";
    engLang[2518] = "A column of water hits the target. When used with its fire counterpart, this move's power is boosted and a rainbow appears.";
    engLang[2519] = "A column of fire hits the target. When used with its grass counterpart, this move's power is boosted and a vast sea of fire appears.";
    engLang[2520] = "A column of grass hits the target. When used with its water counterpart, this move's power is boosted and a vast swamp appears.";
    engLang[2521] = "After making its attack, the user rushes back to switch places with a party Pokémon in waiting.";
    engLang[2522] = "The user attacks by struggling against opposing Pokémon. This also lowers their Sp. Atk stats.";
    engLang[2523] = "The user strikes everything around it by stomping down on the ground. This lowers the Speed stats of those hit.";
    engLang[2524] = "The user attacks by blowing its cold breath on the target. This move always lands a critical hit.";
    engLang[2525] = "The target is knocked away, and a different Pokémon is dragged out. In the wild, this ends a battle against a single Pokémon.";
    engLang[2526] = "The user is roused, and its Attack and Sp. Atk stats are boosted.";
    engLang[2527] = "The user captures opposing Pokémon in an electric net to inflict damage. This also lowers their Speed stats.";
    engLang[2528] = "The user shrouds itself in electricity and smashes into its target. This also damages the user a little.";
    engLang[2529] = "The user crashes into the target while rotating its body like a drill. This move has a heightened chance of landing a critical hit.";
    engLang[2530] = "The user attacks its target by hitting it with brutal strikes. The target is hit twice in a row.";
    engLang[2531] = "The user unleashes a vicious blow after its cute act makes the target less wary. This may also make the target flinch.";
