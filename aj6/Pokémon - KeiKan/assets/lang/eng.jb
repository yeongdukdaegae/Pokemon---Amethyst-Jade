    engLang[2036] = "A reckless full-body charge attack for slamming into the target. This also damages the user a little.";
    engLang[2037] = "The user rampages and attacks for two to three turns. The user then becomes confused.";
    engLang[2038] = "A reckless life-risking tackle in which the user rushes the target. This also damages the user quite a lot.";
    engLang[2039] = "The user wags its tail cutely, making opposing Pokémon less wary. This lowers their Defense stats.";
    engLang[2040] = "The user stabs the target with a poisonous stinger to inflict damage. This may also poison the target.";
