    engLang[2375] = "Using its psychic power of suggestion, the user transfers its status conditions to the target.";
    engLang[2376] = "The fewer PP this move has, the greater its power.";
    engLang[2377] = "For five turns, the user prevents the opposing team from using any moves, Abilities, or held items that recover HP.";
