    engLang[2009] = "The target is attacked with an electrified punch. This may also leave the target with paralysis.";
    engLang[2010] = "Hard, pointed, sharp claws rake the target to inflict damage.";
    engLang[2011] = "The target is gripped and squeezed from both sides to inflict damage.";
    engLang[2012] = "A vicious tearing attack with big pincers. The target faints instantly if this attack hits.";
