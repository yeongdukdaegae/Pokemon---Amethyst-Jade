    engLang[3733] = "The opposing {poke} used {move}!";
    engLang[3734] = "The opposing {poke} fainted!";
    engLang[3735] = "The opposing {poke}";
    engLang[3740] = "Champion";
    engLang[3741] = "Cynthia";
    engLang[3510] = "You threw a {item}!";
    engLang[3511] = "Gotcha! {poke} was caught!";
    engLang[3512] = "Oh no! The Pokémon broke free!";
    engLang[3513] = "Aww! It appeared to be caught!";
    engLang[3514] = "Aargh! Almost had it!";
    engLang[3515] = "Gah! It was so close, too!";
    engLang[3519] = "What will you do with {poke}?";
    engLang[3520] = "Party";
    engLang[3521] = "PC";
    engLang[3522] = "Release";
    engLang[3523] = "Choose a Pokémon to send to the PC.";
    engLang[3524] = "{poke} was sent to the PC!";
    engLang[3525] = "{poke} was released. Bye, {poke}!";
    engLang[3526] = "{poke} joined your party!";
