    engLang[2350] = "The user attacks by hurling hard rocks at the target. This move hits two to five times in a row.";
    engLang[2351] = "The user strikes the target with a quick jolt of electricity. This attack never misses.";
    engLang[2352] = "The user attacks the target with a pulsing blast of water. This may also confuse the target.";
    engLang[2353] = "Two turns after this move is used, a concentrated bundle of light blasts the target.";
    engLang[2354] = "The user attacks the target with all its might. The recoil from this move harshly lowers the user's Sp. Atk stat.";
    engLang[2355] = "The user lands and rests its body. This move restores the user's HP by up to half its max HP.";
