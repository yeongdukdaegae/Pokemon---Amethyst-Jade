    engLang[2001] = "The target is physically pounded with a long tail, a foreleg, or the like.";
    engLang[2002] = "The target is attacked with a sharp chop. Critical hits land more easily.";
    engLang[2003] = "The target is slapped repeatedly, back and forth, two to five times in a row.";
    engLang[2004] = "The target is hit with a flurry of punches that strike two to five times in a row.";
    engLang[2005] = "The target is slugged by a punch thrown with muscle-packed power.";
    engLang[2006] = "Coins are hurled at the target to inflict damage. Money is earned after the battle.";
