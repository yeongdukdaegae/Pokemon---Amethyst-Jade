    engLang[2186] = "The user kisses the target with a sweet, angelic cuteness that causes confusion.";
    engLang[2187] = "The user maximizes its Attack stat but loses HP equal to half its max HP.";
    engLang[2188] = "The user hurls unsanitary sludge at the target to inflict damage. This may also poison the target.";
    engLang[2189] = "The user hurls mud in the target's face to inflict damage and lower its accuracy.";
    engLang[2190] = "The user attacks by spraying ink in the target’s face or eyes. This may also lower the target’s accuracy.";
    engLang[2191] = "The user lays a trap of spikes at the feet of the opposing team. The spikes will damage opposing Pokémon that switch into battle.";
    engLang[2192] = "The user attacks by firing an electric blast like a cannon. This also leaves the target with paralysis.";
    engLang[2193] = "Enables a Ghost-type target to be hit by Normal- and Fighting-type attacks. This also enables an evasive target to be hit.";
    engLang[2194] = "If the user is knocked out after using this move, the Pokémon that knocked it out will also faint. This move's chance of failing rises if it is used in succession.";
    engLang[2195] = "Any Pokémon that hears this song faints in three turns, unless it switches out of battle.";
    engLang[2196] = "The user attacks with a gust of chilled air. This also lowers opposing Pokémon's Speed stats.";
    engLang[2197] = "This move enables the user to protect itself from all attacks. Its chance of failing rises if it is used in succession.";
    engLang[2198] = "The user attacks by striking the target with a hard bone. This move hits two to five times in a row.";
    engLang[2199] = "The user takes sure aim at the target. This ensures the user's next move does not miss that target.";
    engLang[2200] = "The user rampages and attacks for two to three turns. The user then becomes confused.";
    engLang[2201] = "A five-turn sandstorm is summoned to damage all Pokémon except Rock, Ground, and Steel types. The sandstorm also boosts the Sp. Def stats of Rock types.";
    engLang[2202] = "A nutrient-draining attack. The user's HP is restored by up to half the damage taken by the target.";
    engLang[2203] = "The user endures any attack with at least 1 HP. This move's chance of failing rises if used in succession.";
    engLang[2204] = "The user gazes at the target rather charmingly, making it less wary. This harshly lowers the target's Attack stat.";
    engLang[2205] = "The user continually rolls into the target over five turns. This attack becomes more powerful each time it hits.";
    engLang[2206] = "A restrained attack that prevents the target from fainting. The target is left with at least 1 HP.";
    engLang[2207] = "The user enrages and confuses the target. However, this also sharply boosts the target's Attack stat.";
    engLang[2208] = "The user restores its own HP by up to half its max HP.";
    engLang[2209] = "The user attacks the target with an electrically charged tackle. This may also leave the target with paralysis.";
    engLang[2210] = "The user attacks by slashing the target with scythes, claws, or the like. This attack becomes more powerful if it hits in succession.";
    engLang[2211] = "The target is hit with wings of steel. This may also boost the user's Defense stat.";
    engLang[2212] = "The user pins the target with a dark, arresting look. The target becomes unable to flee.";
    engLang[2213] = "If the target is of the opposite gender to the user, it becomes infatuated with the user and will sometimes be unable to use its moves.";
    engLang[2214] = "The user randomly uses one of the moves it knows. This move can only be used while the user is asleep.";
    engLang[2215] = "The user makes a soothing bell chime to cure the status conditions of all its fellow party Pokémon and allies.";
    engLang[2216] = "This full-power attack grows more powerful the more the user likes its Trainer.";
    engLang[2217] = "The user attacks by giving the target a gift with a hidden trap. The gift restores HP sometimes, however.";
    engLang[2218] = "This full-power attack grows more powerful the less the user likes its Trainer.";
    engLang[2219] = "The user creates a protective field that prevents status conditions for five turns.";
    engLang[2220] = "The user adds its HP to the target's HP, then equally splits the combined HP between the target and itself.";
    engLang[2221] = "The target is razed with a mystical fire of great intensity. This may also leave the target with a burn.";
    engLang[2222] = "The user attacks everything around it with a ground-shaking quake. Its power varies.";
    engLang[2223] = "The user attacks by punching the target with full concentrated power. This also confuses the target.";
    engLang[2224] = "Using its tough and impressive horn, the user rams into the target with no letup.";
    engLang[2225] = "The user exhales a mighty gust that inflicts damage. This may also leave the target with paralysis.";
    engLang[2226] = "The user switches places with a party Pokémon in waiting and passes along any stat changes.";
    engLang[2227] = "The user compels the target to keep using the move it encored for three turns.";
    engLang[2228] = "The power of this attack move is doubled if it’s used on a target that’s switching out of battle.";
    engLang[2229] = "The user performs a spin attack that can also eliminate the effects of such moves as Bind, Wrap, and Leech Seed. This also boosts the user's Speed stat.";
    engLang[2230] = "The user releases a scent that harshly lowers opposing Pokémon's evasiveness.";
    engLang[2231] = "The target is slammed with a steel-hard tail. This may also lower the target's Defense stat.";
    engLang[2232] = "The target is raked with steel claws. This may also boost the user's Attack stat.";
    engLang[2233] = "The user attacks last. In return, this throw move never misses.";
    engLang[2234] = "The user restores its own HP. The amount of HP regained varies with the weather.";
    engLang[2235] = "The user restores its own HP. The amount of HP regained varies with the weather.";
    engLang[2236] = "The user restores its own HP. The amount of HP regained varies with the weather.";
    engLang[2237] = "A unique attack that varies in type depending on the Pokémon using it.";
    engLang[2238] = "The user delivers a double chop with its forearms crossed. This move has a heightened chance of landing a critical hit.";
    engLang[2239] = "The user whips up a vicious tornado to tear at opposing Pokémon. This may also make them flinch.";
    engLang[2240] = "The user summons a heavy rain that falls for five turns, powering up Water-type attacks. The rain also lowers the power of Fire-type attacks.";
    engLang[2241] = "The user intensifies the sun for five turns, powering up Fire-type attacks. The sunlight also lowers the power of Water-type attacks.";
    engLang[2242] = "The user crunches up the target with sharp fangs. This may also lower the target's Defense stat.";
    engLang[2243] = "A retaliatory attack that counters any special move, inflicting double the damage taken.";
    engLang[2244] = "The user hypnotizes itself into copying any stat change made by the target.";
    engLang[2245] = "The user charges the target at blinding speed. This move always goes first.";
    engLang[2246] = "The user attacks with a prehistoric power. This may also boost all the user's stats at once.";
    engLang[2247] = "The user attacks by hurling a shadowy blob at the target. This may also lower the target’s Sp. Def stat.";
    engLang[2248] = "Two turns after this move is used, a hunk of psychic energy attacks the target.";
    engLang[2249] = "The user attacks with a punch. This may also lower the target's Defense stat.";
    engLang[2250] = "The user traps the target inside a violent, swirling whirlpool that inflicts damage for four to five turns.";
    engLang[2251] = "The user gets all party Pokémon to attack the target. The more party Pokémon, the greater the number of attacks.";
    engLang[2252] = "This attack hits first and makes the target flinch. It works only on the first turn each time the user enters battle.";
    engLang[2253] = "The user attacks in an uproar for three turns. During that time, no Pokémon can fall asleep.";
    engLang[2254] = "The user stores power and boosts its Defense and Sp. Def stats. This move can be used up to three times.";
    engLang[2255] = "The power stored using the move Stockpile is released at once in an attack. The more power is stored, the greater the move's power.";
    engLang[2256] = "The power stored using the move Stockpile is absorbed by the user to restore its own HP. The more power is stored, the more HP is restored.";
    engLang[2257] = "The user attacks by exhaling hot breath on opposing Pokémon. This may also leave them with a burn.";
    engLang[2258] = "The user summons a hailstorm lasting five turns. It damages all Pokémon except Ice types.";
    engLang[2259] = "The user torments and enrages the target, making it incapable of using the same move twice in a row.";
    engLang[2260] = "Flattery is used to confuse the target. However, this also boosts the target's Sp. Atk stat.";
    engLang[2261] = "The user shoots a sinister flame at the target to inflict a burn.";
    engLang[2262] = "The user faints. In return, the target's Attack and Sp. Atk stats are harshly lowered.";
    engLang[2263] = "This move's power is doubled if the user is poisoned, burned, or paralyzed.";
    engLang[2264] = "The user focuses its mind before launching a punch. This move fails if the user is hit before using the move.";
    engLang[2265] = "This attack’s power is doubled when used on a target with paralysis. This also cures the target’s paralysis, however.";
    engLang[2266] = "The user draws attention to itself, making all opposing Pokémon take aim only at the user.";
    engLang[2267] = "This attack makes use of nature’s power. Its effects vary depending on the user’s environment.";
    engLang[2268] = "The user becomes charged, boosting the power of the next Electric-type move it uses. This also boosts the user's Sp. Def stat.";
    engLang[2269] = "The target is taunted into a rage that allows it to use only attack moves for three turns.";
    engLang[2270] = "The user assists an ally by boosting the power of that ally's attack.";
    engLang[2271] = "The user catches the target off guard and swaps the target's held item with its own.";
    engLang[2272] = "The user mimics the target completely, copying the target's Ability.";
    engLang[2273] = "One turn after this move is used, the user's or its replacement's HP is restored by up to half the user's max HP.";
    engLang[2274] = "The user hurriedly and randomly uses a move among those known by ally Pokémon.";
    engLang[2275] = "The user lays roots that restore its own HP every turn. Because the user is now rooted, it can't switch out.";
    engLang[2276] = "The user attacks the target with great power. This also lowers the user's Attack and Defense stats.";
    engLang[2277] = "Moves like Leech Seed and moves that inflict status conditions are blocked by a barrier and reflected back to the user of those moves.";
    engLang[2278] = "The user recycles a held item that has been used in battle so it can be used again.";
    engLang[2279] = "This attack move’s power is doubled if the user has been hurt by the opponent in the same turn.";
    engLang[2280] = "The user attacks with a swift chop. This move can also break barriers, such as Light Screen and Reflect.";
    engLang[2281] = "The user lets loose a huge yawn that lulls the target into falling asleep on the next turn.";
    engLang[2282] = "The user slaps down the target's held item, making it unusable for that battle. This move does more damage if the target has a held item.";
    engLang[2283] = "The user inflicts damage by cutting down the target's HP to roughly equal the user's HP.";
    engLang[2284] = "The user attacks opposing Pokémon with explosive fury. The lower the user's HP, the lower the move's power.";
    engLang[2285] = "The user employs its psychic power to exchange Abilities with the target.";
    engLang[2286] = "If opposing Pokémon know any move also known by the user, they are prevented from using it.";
    engLang[2287] = "The user rests to cure itself of poisoning, a burn, or paralysis.";
    engLang[2288] = "If the user faints, the user’s grudge fully depletes the PP of the opponent’s move that knocked it out.";
    engLang[2289] = "The user steals the effects of any attempts to use a healing or stat-changing move.";
    engLang[2290] = "The additional effects of this attack depend upon where it was used.";
    engLang[2291] = "The user dives on the first turn, then floats up and attacks on the next turn.";
    engLang[2292] = "The user attacks the target with open-palmed arm thrusts. This move hits two to five times in a row.";
    engLang[2293] = "The user’s type is changed depending on its environment, such as at water’s edge, in grass, or in a cave.";
    engLang[2294] = "The user stares at flashing lights to focus its mind, drastically boosting its Sp. Atk stat.";
    engLang[2295] = "The user lets loose a damaging burst of light. This may also lower the target's Sp. Def stat.";
    engLang[2296] = "A mist-like flurry of down envelops and damages the target. This may also lower the target's Sp. Atk stat.";
    engLang[2297] = "The user covers the target's body with a mass of down that harshly lowers its Attack stat.";
    engLang[2298] = "The user performs a wobbly dance that confuses every Pokémon around it.";
    engLang[2299] = "The user launches a kick that has a heightened chance of landing a critical hit. This may also leave the target with a burn.";
    engLang[2300] = "The user kicks up mud on the battlefield. This weakens Electric-type moves for five turns.";
    engLang[2301] = "The user attacks the target for five turns. The move’s power increases each time it hits.";
    engLang[2302] = "The user attacks by wildly swinging its thorny arms. This may also make the target flinch.";
