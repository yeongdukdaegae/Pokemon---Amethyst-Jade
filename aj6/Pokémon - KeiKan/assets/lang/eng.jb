    engLang[2312] = "The user releases a soothing scent that heals all status conditions affecting the user's party.";
    engLang[2313] = "The user feigns crying to fluster the target. This harshly lowers the target's Sp. Def stat.";
    engLang[2314] = "The user launches razor-like wind to slash opposing Pokémon. This move has a heightened chance of landing a critical hit.";
