    engLang[2714] = "The user emits a sinister ray to attack the target. This move can be used on the target regardless of its Ability.";
    engLang[2715] = "The user gets teary-eyed to make the target lose its combative spirit. This lowers the target's Attack and Sp. Atk stats.";
    engLang[2716] = "The user crashes into the target, delivering a powerful electric shock. This may also make the target flinch.";
    engLang[2717] = "The user hits the target with the force of nature. It halves the target’s HP.";
    engLang[2718] = "Cloaking itself in high energy, the user slams into the target. The memory held determines the move’s type.";
    engLang[2720] = "The user attacks everything around it by causing its own head to explode. This also damages the user.";
    engLang[2721] = "The user attacks with electrically charged fists. This move changes Normal-type moves to Electric-type moves.";
    engLang[2722] = "The user attacks the target with a pillar of light. This move inflicts damage using the Attack or Sp. Atk stat—whichever is higher for the user.";
    engLang[2729] = "The user attacks the target with bursts of electricity at high speed. This move always goes first and results in a critical hit.";
    engLang[2730] = "The user charges a huge wave with electricity and hits the opposing Pokémon with the wave. This may also leave the opposing Pokémon with paralysis.";
    engLang[2731] = "The user floats in the air, and then dives at a steep angle to attack the target. This may also make the target flinch.";
    engLang[2732] = "The more Pikachu loves its Trainer, the greater the move’s power. It never misses.";
    engLang[2733] = "The user attacks by shooting water bubbles at the target. It then absorbs water and restores its HP by half the damage taken by the target.";
    engLang[2734] = "The user shoots a jolt of electricity to attack the target. This also leaves the target with paralysis.";
    engLang[2735] = "The user cloaks itself in fire and charges at the target. This also leaves the target with a burn.";
    engLang[2736] = "The user bombards the target with telekinetic force. A wondrous wall of light is put up to weaken the power of the opposing Pokémon’s special moves.";
    engLang[2737] = "The user acts bad and attacks the target. A wondrous wall of light is put up to weaken the power of the opposing Pokémon’s physical moves.";
    engLang[2738] = "The user grows a gigantic stalk that scatters seeds to attack the target. The seeds drain the target’s HP every turn.";
    engLang[2739] = "The user attacks with a crystal made of cold frozen haze. It eliminates every stat change among all the Pokémon engaged in battle.";
    engLang[2740] = "The user attacks the target by wrapping it with a whirlwind of an overpowering scent. This also heals all status conditions of the user’s party.";
    engLang[2741] = "The more Eevee loves its Trainer, the greater the move’s power. It never misses.";
    engLang[2742] = "The user rotates, centering the hex nut in its chest, and then strikes with its arms twice in a row. This may also make the target flinch.";
    engLang[2744] = "The user condenses energy within its body and unleashes that energy from its core to inflict damage.";
    engLang[2745] = "The user ignores the effects of opposing Pokémon's moves and Abilities that draw in moves, allowing this move to hit the chosen target.";
    engLang[2746] = "This move prevents the user and the target from switching out until either of them faints. The effect goes away if either of the Pokémon leaves the field.";
    engLang[2747] = "The user eats its held Berry, then sharply boosts its Defense stat.";
    engLang[2748] = "This move boosts all the user's stats but prevents the user from switching out or fleeing.";
    engLang[2749] = "The user pours sticky tar over the target, lowering the target's Speed stat. The target becomes weaker to Fire-type moves.";
    engLang[2750] = "The user scatters a cloud of magic powder that changes the target's type to Psychic.";
    engLang[2751] = "The user attacks twice using Dreepy. If there are two opposing Pokémon, this move hits each of them once.";
    engLang[2752] = "The user has teatime with all the Pokémon currently in the battle. Each Pokémon eats its held Berry.";
    engLang[2753] = "The user locks the target in and prevents it from fleeing. This move also lowers the target’s Defense and Sp. Def every turn.";
    engLang[2754] = "The user stabs the target with its electrified beak. If the user attacks before the target, the power of this move is doubled.";
    engLang[2755] = "The user rends the target with its hard gills. If the user attacks before the target, the power of this move is doubled.";
    engLang[2756] = "With its mysterious power, the user swaps the effects on either side of the field.";
    engLang[2775] = "The user boosts all its stats by using some of its own HP.";
    engLang[2776] = "The user attacks by slamming its body into the target. The higher the user's Defense stat, the greater the damage this move deals.";
    engLang[2777] = "The user sharply boosts the target's Attack and Sp. Atk stats by decorating the target.";
    engLang[2778] = "The user plays its drum, controlling the drum's roots to attack the target. This also lowers the target's Speed stat.";
    engLang[2779] = "The user snares the target in a snap trap for four to five turns.";
    engLang[2780] = "The user attacks by igniting a small stone and launching it as a fiery ball at the target. This may also leave the target with a burn.";
    engLang[2781] = "The user becomes a gigantic sword and cuts the target. This move deals twice the damage if the target is Dynamaxed.";
    engLang[2782] = "The user becomes a gigantic shield and slams into the target. This move deals twice the damage if the target is Dynamaxed.";
    engLang[2783] = "Morpeko attacks and boosts its Speed stat with the energy stored in its cheeks. This move's type changes depending on the user's form.";
    engLang[2784] = "The user swings its tough tail wildly and attacks opposing Pokémon. This also lowers their Attack stats.";
    engLang[2785] = "The user attacks the target by poking it with a sharply pointed branch.";
    engLang[2786] = "The user attacks opposing Pokémon by twanging a guitar or bass guitar, causing a huge echo and strong vibration.";
    engLang[2787] = "The user attacks the target with an acidic liquid created from tart apples. This also lowers the target's Sp. Def stat.";
    engLang[2788] = "The user inflicts damage by dropping an apple from high above. This also lowers the target's Defense stat.";
    engLang[2789] = "The user attacks the target with so much force that it could break the target's spirit. This also lowers the target's Sp. Atk stat.";
    engLang[2790] = "The user attacks the target by emitting steam. This may also confuse the target.";
    engLang[2791] = "The user scatters mysterious water around and restores the HP of itself and its ally Pokémon currently in the battle.";
    engLang[2792] = "This move enables the user to protect itself from all attacks. Its chance of failing rises if it is used in succession. Direct contact harshly lowers the attacker’s Defense stat.";
    engLang[2793] = "The user pretends to bow its head, but then it stabs the target with its disheveled hair. This attack never misses.";
    engLang[2794] = "The user attacks wildly with its thick leek. The user can’t move on the next turn, because the force of this move makes it stagger.";
    engLang[2795] = "This is Eternatus’s most powerful attack in its original form. The user can’t move on the next turn.";
    engLang[2796] = "The user fires a beam of steel that it collected from its entire body. This also damages the user.";
    engLang[2797] = "The user attacks the target with its psychic power. When the ground is Psychic Terrain, this move's power is boosted and it damages all opposing Pokémon.";
    engLang[2798] = "The user attacks while destroying the terrain. This move fails if the ground hasn't turned into a terrain.";
    engLang[2799] = "The user attacks by shooting scales two to five times in a row. This move boosts the user's Speed stat but lowers its Defense stat.";
    engLang[2800] = "The user gathers energy from space and boosts its Sp. Atk stat on the first turn, then attacks on the next turn.";
    engLang[2801] = "This move is either physical or special—whichever will inflict more damage. This may also poison the target.";
    engLang[2802] = "The user attacks everything around it and faints upon using this move. This move's power is boosted on Misty Terrain.";
    engLang[2803] = "Gliding on the ground, the user attacks the target. This move always goes first on Grassy Terrain.";
    engLang[2804] = "The user attacks with electricity rising from the ground. This move's power is doubled if the target is on Electric Terrain.";
    engLang[2805] = "The user utilizes the energy of the terrain to attack. This move’s type and power change depending on the terrain at the time the move is used.";
    engLang[2806] = "The user skitters behind the target to attack. This also lowers the target's Sp. Atk stat.";
    engLang[2807] = "The user attacks with energy from jealousy. This leaves all opposing Pokémon that have had their stats boosted during the turn with a burn.";
    engLang[2808] = "The user lashes out to vent its frustration toward the target. This move's power is doubled if the user's stats were lowered during this turn.";
    engLang[2809] = "The user attacks by controlling the target's item. This move fails if the target isn't holding an item.";
    engLang[2810] = "The user surrounds everything around it with highly acidic gas and melts away items they hold.";
    engLang[2811] = "The user properly coaches its ally Pokémon, boosting their Attack and Defense stats.";
    engLang[2812] = "After making its attack, the user rushes back to switch places with a party Pokémon in waiting.";
    engLang[2813] = "A consecutive three-kick attack that becomes more powerful with each successful hit.";
    engLang[2814] = "The user slams the target with its wings to inflict damage. The target is hit twice in a row.";
    engLang[2815] = "The user throws scorching sand at the target to attack. This may also leave the target with a burn.";
    engLang[2816] = "The user becomes one with the jungle, restoring HP and curing status conditions for itself and its ally Pokémon currently in the battle.";
    engLang[2817] = "The user, having mastered the Dark style, strikes the target with a fierce blow. This move always lands a critical hit.";
    engLang[2818] = "The user, having mastered the Water style, strikes the target with a flowing motion three times in a row. This move always lands a critical hit.";
    engLang[2819] = "The user traps the target inside a cage of sparking electricity that inflicts damage for four to five turns.";
    engLang[2820] = "Converting its life-force into power, the user attacks opposing Pokémon. The lower the user's HP, the lower the move's power.";
    engLang[2821] = "The user shoots its psychic power from its eyes to attack. This may also leave the target frozen.";
    engLang[2822] = "The user transforms its wrath into a fire-like aura to attack. This may also make opposing Pokémon flinch.";
    engLang[2823] = "The user overwhelms the target with lightning-like movement before delivering a kick. This also lowers the target's Defense stat.";
    engLang[2824] = "The user attacks by hurling a blizzard-cloaked icicle lance at opposing Pokémon.";
    engLang[2825] = "The user attacks by sending a frightful amount of small ghosts at opposing Pokémon.";
    engLang[2826] = "The user attacks with its tremendous psychic power. This also drains 3 PP from the move last used by the target.";
    engLang[2827] = "The user lashes out at the target with ruinous claws. This may also leave the target poisoned, paralyzed, or asleep.";
    engLang[2828] = "Cloaking itself in psychic energy, the user slams into the target. This also boosts the user’s Defense stat.";
    engLang[2829] = "The user swaps its Attack and Defense stats.";
    engLang[2830] = "The user swings its stone axes at the target. Stone splinters left behind by this attack float around the target.";
    engLang[2831] = "The user attacks by wrapping opposing Pokémon in fierce winds brimming with love and hate. This may also lower their Attack stats.";
    engLang[2832] = "The user attacks by emitting a mysterious power. This also boosts the user’s Sp. Atk stat.";
    engLang[2833] = "The user rampages around spewing flames for two to three turns. The user then becomes confused.";
    engLang[2834] = "The user shrouds itself in water and slams into the target with its whole body to inflict damage. This also damages the user quite a lot.";
    engLang[2835] = "The user launches its amassed chlorophyll to inflict damage on the target. This also damages the user.";
    engLang[2836] = "The user hurls giant chunks of ice at the target to inflict damage. This may also make the target flinch.";
    engLang[2837] = "The user performs an intense dance to usher in victory, boosting its Attack, Defense, and Speed stats.";
    engLang[2838] = "The user smashes into the target in a full-body tackle. This also lowers the user’s Defense and Sp. Def stats.";
    engLang[2839] = "The user launches countless toxic barbs to inflict damage. This may also poison the target. This move’s power is doubled if the target is already poisoned.";
    engLang[2840] = "The user slashes the target with aura-enriched wings. This also boosts the user's Speed stat. This move has a heightened chance of landing a critical hit.";
    engLang[2841] = "The user attacks the target with spine-chilling resentment. This also lowers the target’s Attack stat.";
    engLang[2842] = "The user makes its skin as hard as an iron shield, sharply boosting its Defense stat.";
    engLang[2843] = "The user kicks, then fires three arrows. This move has a heightened chance of landing a critical hit and may also lower the target’s Defense stat or make it flinch.";
    engLang[2844] = "The user attacks with myriad fireballs. This may also leave the target with a burn. This move's power is doubled if the target has a status condition.";
    engLang[2845] = "The user slashes its shell blade at the target. Shell splinters left behind by this attack remain scattered under the target as spikes.";
    engLang[2846] = "The user attacks with savagely cold winds that cause both body and spirit to tremble. This may also lower the Speed stats of opposing Pokémon.";
    engLang[2847] = "The user summons a thunderous tempest and savagely attacks with lightning and wind. This may also leave opposing Pokémon with paralysis.";
    engLang[2848] = "The user attacks by wrapping opposing Pokémon in fierce winds and searingly hot sand. This may also leave them with a burn.";
    engLang[2849] = "The user receives a blessing from the crescent moon, restoring HP and curing status conditions for itself and its ally Pokémon currently in the battle.";
    engLang[2850] = "The user lifts its spirits, curing its own status conditions and boosting its Sp. Atk and Sp. Def stats.";
    engLang[2851] = "If the user has Terastallized, it unleashes energy of its Tera Type. This move inflicts damage using the Attack or Sp. Atk stat—whichever is higher for the user.";
    engLang[2852] = "The user spins a silken trap, protecting itself from damage while lowering the Speed stat of any attacker that makes direct contact.";
    engLang[2853] = "The user attacks by kicking up into the air and slamming its heel down upon the target. This may also confuse the target. If it misses, the user takes damage instead.";
    engLang[2854] = "The user attacks to avenge its allies. The more defeated allies there are in the user's party, the greater the move's power.";
    engLang[2855] = "The user attacks by unleashing a peculiar light that even affects the mind. This also harshly lowers the target's Sp. Def stat.";
    engLang[2856] = "The user attacks with elegant poise. If the user has a Tatsugiri in its mouth, this move boosts one of the user's stats based on the Tatsugiri's form.";
    engLang[2857] = "The user summons a torrent around its fist and punches at blinding speed. This move always goes first.";
    engLang[2858] = "The user emits an incredibly spicy extract, sharply boosting the target's Attack stat and harshly lowering the target's Defense stat.";
    engLang[2859] = "The user spins furiously by straining its legs, inflicting damage on the target. This also harshly lowers the user's Speed stat.";
    engLang[2860] = "The user’s fellows gather in droves to perform a combo attack that hits the target one to ten times in a row.";
    engLang[2861] = "The user covers its feet in thin ice and twirls around, slamming into the target. This move's spinning motion also destroys the terrain.";
    engLang[2862] = "The user throws its entire body into a reckless charge. After this move is used, attacks on the user cannot miss and will inflict double damage until the user’s next turn.";
    engLang[2863] = "The user bestows a loving blessing, reviving a party Pokémon that has fainted and restoring half that Pokémon's max HP.";
    engLang[2864] = "The user salt cures the target, inflicting damage every turn. Steel and Water types are more strongly affected by this move.";
    engLang[2865] = "The user performs a perfectly timed triple dive, hitting the target with splashes of water three times in a row.";
    engLang[2866] = "The user performs a spin attack that can also eliminate the effects of such moves as Bind, Wrap, and Leech Seed. This also poisons opposing Pokémon.";
    engLang[2867] = "The user captures the very essence of the target in a sketch. This changes the Abilities of the user and its ally Pokémon to that of the target.";
    engLang[2868] = "The user sharply boosts its Attack, Sp. Atk, and Speed stats by using its own HP.";
    engLang[2869] = "The user slashes at the target after kowtowing to make the target let down its guard. This attack never misses.";
    engLang[2870] = "The user throws a rigged bouquet of flowers at the target. This attack never misses and always lands a critical hit.";
    engLang[2871] = "The user blows out raging flames as if singing a song, scorching the target. This also boosts the user's Sp. Atk stat.";
    engLang[2872] = "The user toys with the target and attacks it using light and fluid dance steps. This also boosts the user's Speed stat.";
    engLang[2873] = "The user performs a tackle like a raging bull. This move's type depends on the user's form. It can also break barriers, such as Light Screen and Reflect.";
    engLang[2874] = "The user attacks by throwing out a mass of coins. This also lowers the user's Sp. Atk stat. Money is earned after the battle.";
    engLang[2875] = "The user rends the target with an ethereal blade. This move's power is boosted by 50 percent if the user is on Electric Terrain.";
    engLang[2876] = "The user blasts the target with boiling-hot water. This move's power is not lowered in harsh sunlight but rather boosted by 50 percent.";
    engLang[2877] = "The user summons a ruinous disaster. This cuts the target’s HP in half.";
    engLang[2878] = "The user transforms and crashes to the ground, causing a massive prehistoric explosion. This move's power is boosted more than usual if it’s a supereffective hit.";
    engLang[2879] = "The user races forward at ultrafast speeds, piercing its target with futuristic electricity. This move's power is boosted more than usual if it's a supereffective hit.";
    engLang[2880] = "The user creates a substitute for itself using its own HP before switching places with a party Pokémon in waiting.";
    engLang[2881] = "The user tells a chillingly bad joke before switching places with a party Pokémon in waiting. This summons a snowstorm lasting five turns.";
    engLang[2882] = "The user tidies up and removes the effects of Spikes, Stealth Rock, Sticky Web, Toxic Spikes, and Substitute. This also boosts the user’s Attack and Speed stats.";
    engLang[2883] = "The user summons a snowstorm lasting five turns. This boosts the Defense stats of Ice types.";
    engLang[2884] = "The user attacks by pouncing on the target. This also lowers the target's Speed stat.";
    engLang[2885] = "The user attacks suddenly as if leaping out from tall grass. The user's nimble footwork boosts its Speed stat.";
    engLang[2886] = "The user attacks the target by showering it with water that's so cold it saps the target's power. This also lowers the target's Attack stat.";
    engLang[2887] = "The user spins the pointed part of its body at high speed to pierce the target. This attack can hit a target using a move such as Protect or Detect.";
    engLang[2888] = "The user shoots mystical beams from its eyes to inflict damage. The target is hit twice in a row.";
    engLang[2889] = "The user converts its rage into energy to attack. The more times the user has been hit by attacks, the greater the move's power.";
    engLang[2890] = "The user shoots its own armor out as blazing projectiles. This also lowers the user’s Defense and Sp. Def stats.";
    engLang[2891] = "The user focuses its bitter feelings toward the world of the living into a slashing attack. The user's HP is restored by up to half the damage taken by the target.";
    engLang[2892] = "The user discharges all the electricity from its body to perform a high-damage attack. After using this move, the user will no longer be Electric type.";
    engLang[2893] = "The user swings its whole body around to attack with its huge hammer. This move can't be used twice in a row.";
    engLang[2894] = "The user retaliates with much greater force against the opponent that last inflicted damage on it.";
    engLang[2895] = "The user expels pressurized water to cut at the target like a blade. This move has a heightened chance of landing a critical hit.";
    engLang[2896] = "The user revs its blazing engine into the target. This may also leave the target with a burn.";
    engLang[2897] = "The user revs its engine into the target with malicious intent. This may put the target to sleep.";
    engLang[2898] = "The user revs its poisonous engine into the target. This may also poison the target.";
    engLang[2899] = "The user revs its engine forcefully into the target. This may also leave the target with paralysis.";
    engLang[2900] = "The user revs its fae-like engine into the target. This may also confuse the target.";
    engLang[2901] = "The user unleashes the full brunt of its spirit from a full moon that shines as red as blood. This move can't be used twice in a row.";
    engLang[2902] = "The user fires a blast of tea that it mixed. The user's HP is restored by up to half the damage taken by the target. This may also leave the target with a burn.";
    engLang[2903] = "The user sets off an explosion of sticky candy syrup, which coats the target and causes the target's Speed stat to drop each turn for three turns.";
    engLang[2904] = "The user strikes with an ivy-wrapped cudgel. This move's type changes depending on the mask worn by the user, and it has a heightened chance of landing a critical hit.";
    engLang[2905] = "The user gathers electricity on the first turn, boosting its Sp. Atk stat, then fires a high-voltage shot on the next turn. The shot will be fired immediately in rain.";
    engLang[2906] = "With the power of its crystals, the user bombards and eliminates the target. When used by Terapagos in its Stellar Form, this move damages all opposing Pokémon.";
    engLang[2907] = "The user shoots a beam of light to inflict damage. Sometimes all the user's heads shoot beams in unison, doubling the move's power.";
    engLang[2908] = "The user's intensely hot fur protects it from attacks and also burns any attacker that makes direct contact with it.";
    engLang[2909] = "This move enables the user to attack first with a jolt of electricity. This move fails if the target is not readying an attack.";
    engLang[2910] = "The user wields the light that has accumulated atop its head to cleave the target. This move hits even if the target protects itself.";
    engLang[2911] = "The user attacks by launching particle blades at the target twice in a row. This attack never misses.";
    engLang[2912] = "The target is crushed with an arm, a claw, or the like to inflict damage. The more HP the target has left, the greater the move's power.";
    engLang[2913] = "The user raises its allies’ morale with a draconic cry so that their future attacks have a heightened chance of landing critical hits. This rouses Dragon types more.";
    engLang[2914] = "The user attacks the target using its angelic voice. This also confuses the target if its stats have been boosted during the turn.";
    engLang[2915] = "Spurred by desperation, the user attacks the target. This move's power is doubled if the user's previous move failed.";
    engLang[2916] = "The user electrifies its body and drops onto the target to inflict damage. If this move misses, the user takes damage instead.";
    engLang[2917] = "The user attacks the target with unpleasant sound waves. For two turns, the target is prevented from recovering HP through moves, Abilities, or held items.";
    engLang[2918] = "The user reacts to the target's movement and strikes with the heel of its palm, making the target flinch. This move fails if the target is not readying a priority move.";
    engLang[2919] = "The user pours toxins into the target by wrapping them in a toxic, corrosive chain. This may also leave the target badly poisoned.";
    engLang[2920] = "The user slams down hard with the rock on its tail. This has a 10%% chance to make the target flinch.";
    engLang[2921] = "The user attacks with claws wrapped in heat. This leaves the target with a burn.";
    engLang[2923] = "The user slashes the target with a razor-sharp gust of wind. Critical hits land more easily.";
    engLang[2924] = "The user unleashes all the electricity stored in its body at once. The recoil from this move harshly lowers the user's Sp. Atk stat.";
    engLang[2922] = "The user gathers a lot of water into a small ball and fires it all at once. This has a 33%% chance of confusing the target.";
}
