    engLang[2308] = "The target is hit with a watery blast. The user can't move on the next turn.";
    engLang[2309] = "The target is hit with a hard punch fired like a meteor. This may also boost the user’s Attack stat.";
    engLang[2310] = "The user attacks the target by crying out in a startling fashion. This may also make the target flinch.";
