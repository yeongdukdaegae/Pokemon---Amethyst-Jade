    korLang[3829] = "▶ 8번도로";
    korLang[3830] = "과학의 힘은 대단해!\n컴퓨터나 휴대폰에서도 게임을 즐길 수 있대!";
    korLang[3831] = "설정";
    korLang[3832] = "리포트 작성";
    korLang[3833] = "지금까지의 활약을 리포트에 작성하시겠습니까?";
    korLang[3836] = "리포트를 작성하고 있습니다...";
    korLang[3837] = "리포트를 확실히 작성했다!";
    korLang[3838] = "타이틀 화면으로 나가시겠습니까?";
    korLang[3895] = "무사히 도망쳤다!";
    korLang[3896] = "도망칠 수 없었다!";
    korLang[3897] = "안 돼! 승부 중에\n상대에게 등을 보일 수는 없어!";
    korLang[3898] = "도망칠 수 없다!";
    korLang[3893] = "잠깐! 이 앞은 1번도로야.\n포켓몬 없이 덤불에 들어가는 건 위험하니까 돌아가렴.";
    korLang[3894] = "포켓몬이 있으니 1번도로에 가도 괜찮아!\n덤불에서는 야생 포켓몬이 튀어나오니 조심하렴.";
    korLang[3017] = "상처약";
    korLang[3018] = "해독제";
    korLang[3019] = "화상치료제";
