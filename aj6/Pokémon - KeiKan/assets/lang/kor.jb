    korLang[3028] = "기력의조각";
    korLang[5017] = "스프레이식 상처약. 포켓몬 1마리의 HP를 20만큼 회복한다.";
    korLang[5018] = "스프레이식 약. 포켓몬 1마리의 독 상태를 치료한다.";
    korLang[5019] = "스프레이식 약. 포켓몬 1마리의 화상 상태를 치료한다.";
    korLang[5020] = "스프레이식 약. 포켓몬 1마리의 얼음 상태를 치료한다.";
    korLang[5021] = "스프레이식 약. 포켓몬 1마리의 잠듦 상태를 치료한다.";
    korLang[5022] = "스프레이식 약. 포켓몬 1마리의 마비 상태를 치료한다.";
    korLang[5023] = "포켓몬 1마리의 HP를 모두 회복하고 상태 이상도 모두 치료한다.";
    korLang[5024] = "스프레이식 상처약. 포켓몬 1마리의 HP를 모두 회복한다.";
    korLang[5025] = "스프레이식 상처약. 포켓몬 1마리의 HP를 120만큼 회복한다.";
    korLang[5026] = "스프레이식 상처약. 포켓몬 1마리의 HP를 60만큼 회복한다.";
    korLang[5157] = "포켓몬에게 지니게 하는 열매. 지니게 하면 모든 상태 이상을 회복한다.";
    korLang[5282] = "지니게 하면 싸라기눈 (눈) 이 계속되는 시간이 늘어나는 차가운 바위.";
    korLang[5283] = "지니게 하면 모래바람이 계속되는 시간이 늘어나는 보송보송한 바위.";
    korLang[5082] = "특정 포켓몬을 진화시키는 이상한 돌. 오렌지색을 띠고 있다.";
    korLang[5083] = "특정 포켓몬을 진화시키는 이상한 돌. 번개 무늬가 있다.";
    korLang[5084] = "특정 포켓몬을 진화시키는 이상한 돌. 투명한 파란색이다.";
    korLang[5085] = "특정 포켓몬을 진화시키는 이상한 돌. 나뭇잎 무늬가 있다.";
    korLang[5849] = "특정 포켓몬을 진화시키는 이상한 돌. 눈꽃 무늬가 있다.";
    korLang[5252] = "실프주식회사에서 만든 투명한 장치. 이 게임에서는 폴리곤에게 사용하면 진화한다.";
    korLang[5324] = "수상한 데이터가 들어 있는 투명한 장치. 이 게임에서는 폴리곤2에게 사용하면 진화한다.";
    korLang[5079] = "사용하면 100걸음 동안 맨 앞 포켓몬보다 레벨이 낮은 야생 포켓몬이 나오지 않는다.";
    korLang[5076] = "사용하면 200걸음 동안 맨 앞 포켓몬보다 레벨이 낮은 야생 포켓몬이 나오지 않는다.";
    korLang[5077] = "사용하면 250걸음 동안 맨 앞 포켓몬보다 레벨이 낮은 야생 포켓몬이 나오지 않는다.";
    korLang[5284] = "지니게 하면 쾌청 상태가 계속되는 시간이 늘어나는 뜨거운 바위.";
    korLang[5285] = "지니게 하면 비가 계속되는 시간이 늘어나는 축축한 바위.";
    korLang[5158] = "포켓몬에게 지니게 하는 열매. 지니게 하면 HP가 절반 이하가 되었을 때 HP를 조금 회복한다.";
    korLang[5027] = "포켓몬 1마리의 모든 상태 이상을 치료한다.";
    korLang[5028] = "기절한 포켓몬 1마리를 되살리고 HP를 최대치의 절반까지 회복한다.";
    korLang[3840] = "{poke}의 HP가 {n} 회복되었다!";
    korLang[3841] = "{poke}(은)는 건강해졌다!";
    korLang[3842] = "{poke}(은)는 기운을 되찾았다!";
    korLang[3843] = "사용해도 효과가 없을 것 같다.";
    korLang[3844] = "사용";
    korLang[3845] = "소지금 {m}원";
    korLang[3853] = "기절";
    korLang[3854] = "누구에게 사용하시겠습니까?";
    korLang[3855] = "포켓몬이 없다.";
    korLang[3860] = "포켓몬센터에 어서 오세요!";
    korLang[3861] = "어머, 포켓몬을 데리고 있지 않네요.\n포켓몬을 회복시키려면 먼저 포켓몬이 필요해요!";
    korLang[3862] = "여기서는 지친 포켓몬의 체력을 회복시켜 드려요.";
    korLang[3863] = "포켓몬을 쉬게 하시겠어요?";
    korLang[3864] = "그럼 포켓몬을 잠시 맡아 둘게요.";
    korLang[3865] = "오래 기다리셨어요!\n맡기신 포켓몬은 모두 건강해졌어요!";
    korLang[3866] = "또 오세요!";
    korLang[3870] = "어서 오세요!\n무엇을 도와드릴까요?";
    korLang[3871] = "사러 왔다";
    korLang[3872] = "괜찮아요";
    korLang[3873] = "팔러 왔다";
    korLang[3874] = "구입하기";
    korLang[3875] = "{p}원";
    korLang[3876] = "소지금이 모자랍니다.";
    korLang[3877] = "{item}(을)를 몇 개 사시겠습니까?";
    korLang[3878] = "{item} {n}개, 합해서 {total}원입니다. 괜찮으십니까?";
    korLang[3879] = "감사합니다!";
    korLang[3882] = "판매하기";
    korLang[3883] = "{item}(을)를 몇 개 파시겠습니까?";
    korLang[3884] = "{item} {n}개라면 {total}원에 사겠습니다. 괜찮으십니까?";
    korLang[3885] = "팔 수 있는 물건이 없다.";
    korLang[3886] = "{item}(을)를 건네주고 {total}원을 받았다!";
    korLang[3880] = "PC가 놓여 있다. 지금은 쓸 수 없는 것 같다.";
    korLang[3881] = "간호순";
    korLang[3890] = "어려워 보이는 책이 빽빽이 꽂혀 있다.";
    korLang[3891] = "무언가를 분석하는 커다란 기계다.\n화면에 숫자가 쉴 새 없이 지나간다.";
    korLang[3892] = "연구 자료가 화면에 떠 있다.";
    korLang[7200] = "제때 왔네! 빨리 들어가자. 곧 있으면 시작할 거야.\n왜 벌써 왔냐고? 좋은 포켓몬을 고르려면 서둘러야 한다구.";
    korLang[7201] = "오! 빨리 왔네! 곧 있으면 열린대.\n덕분에 빨리 시작해서, 우린 좋은 포켓몬을 고를 수 있을 거야.";
    korLang[7202] = "일찍 왔구나들.";
    korLang[7203] = "이 세상에는 포켓몬스터, 줄여서 포켓몬이라 불리는 신기한 생물들이 살고 있단다.";
    korLang[7204] = "사람들은 포켓몬과 함께 지내기도 하고, 서로 배틀을 하며 함께 강해지기도 하지.";
    korLang[7205] = "오늘은 너희에게 포켓몬을 한 마리씩 맡기려고 한단다.\n탁자 위의 세 마리 중에서 마음에 드는 아이를 골라 보렴.";
    korLang[7206] = "네가 먼저 골라. 난 너 고르는 거 보고.";
    korLang[7207] = "{type} 타입 포켓몬, {poke}!";
    korLang[7208] = "이 스타팅으로 선택하시겠습니까?";
    korLang[7209] = "잘해보자! {poke}!";
    korLang[7210] = "그럼 나는...";
    korLang[7211] = "너무 미워하진 마. 이래뵈도 나, 승부욕 엄청 강하다구.";
    korLang[7212] = "그래도, 네가 나보단 배틀에 능숙할 거 아냐. 핸디캡은 있어야지.";
    korLang[7213] = "우리, 저 도로 끝에서 우리가 잡은 포켓몬으로 배틀하자. 오케이?";
    korLang[7214] = "미안하지만 이 앞은 아직 지나갈 수 없어.";
    korLang[7215] = "현정";
    korLang[7216] = "아직 포켓몬을 고르지 않았잖니? 탁자 위에서 골라 보렴.";
    korLang[7217] = "탁자 위의 세 마리 중에서 마음에 드는 아이를 골라 보렴.";
    korLang[7218] = "포켓몬과 함께 좋은 여행이 되길 바란다.";
    korLang[7219] = "정보";
    korLang[7220] = "아이템";
    korLang[7221] = "도감";
    korLang[7222] = "놓아주기";
    korLang[7223] = "정말 {poke}(을)를 놓아주시겠습니까?";
    korLang[7224] = "{poke}(을)를 놓아주었다.\n잘 지내, {poke}!";
    korLang[7225] = "스티커 볼에 든 포켓몬은 놓아줄 수 없다!";
    korLang[7226] = "마지막 남은 포켓몬은 놓아줄 수 없다!";
    korLang[7227] = "지니게 하기";
    korLang[7228] = "{poke}에게 {item}(을)를 지니게 했다.";
    korLang[7229] = "{poke}에게서 {old}(을)를 받고\n{item}(을)를 지니게 했다.";
    korLang[7230] = "포켓몬 정보   (Z: 기술 순서 바꾸기 · X: 나가기)";
    korLang[7231] = "{move}(을)를 배운다 — 잊을 기술을 고르세요";
    korLang[7232] = "사용하거나 지니게 할 아이템이 없다.";
    korLang[7233] = "도감은 아직 준비 중이다.";
    korLang[7234] = "{poke}(은)는 {move}(을)를 배우고 싶다...\n하지만 기술을 4개 이미 알고 있다!";
    korLang[7235] = "1, 2, 3... 짠!\n{poke}(은)는 {old}(을)를 깨끗이 잊었다!";
    korLang[7236] = "{poke}(은)는 {move}(을)를 배우지 않았다.";
    korLang[7237] = "아이템을 고르세요";
    korLang[7374] = "지닌 물건 받기";
    korLang[7375] = "{poke}에게서 {item}(을)를 받았다.";
    korLang[7376] = "유풍시티";
    korLang[7377] = "어서 오세요! 유풍시티 상점입니다.\n무엇을 도와드릴까요?";
    korLang[7378] = "유풍체육관\n…문이 굳게 잠겨 있다. 관장은 자리를 비운 것 같다.";
    korLang[7379] = "여기는 유풍체육관이야. 관장 휴린은 바람을 타는 비행 타입 포켓몬의 달인이지.\n휴린의 포켓몬은 바람처럼 빠르게 몰아붙여서, 도전자들이 손쓸 틈도 없이 진다더라.\n도전할 생각이라면 안의 접수처에서 신청부터 해. 그리고 비행 타입에 강한 포켓몬을 준비해 둬!";
    korLang[7380] = "포켓몬 트레이너";
    korLang[7381] = "늦었잖아! 숲에서 길이라도 잃은 줄 알았다구.\n…뭐, 나도 방금 도착하긴 했지만. 아무튼!\n약속 기억하지? 도로 끝에서 우리가 잡은 포켓몬으로 배틀하기로 한 거.\n여기가 딱 1번도로 끝이야. 나도 숲에서 동료를 둘이나 잡았거든.\n타입 상성도 내가 유리하고, 레벨도 내가 더 높을걸? 이번엔 봐주는 거 없다구!";
    korLang[7382] = "아, 왔다 왔다! 숲 안에 벌레 포켓몬 엄청 많지 않았어? 난 몇 번이나 놀랐는지 몰라.\n그래도 덕분에 동료가 좀 늘었어. 노로키랑 앗치! 귀엽지?\n약속했잖아. 도로 끝에서 우리가 잡은 포켓몬으로 배틀하자고.\n여기가 딱 1번도로 끝이네. 핸디캡도 받았으니까… 오늘은 나도 이길 수 있을 것 같은데?\n그럼, 잘 부탁해!";
    korLang[7383] = "…흥, 인정할게. 이번엔 네가 더 잘했어.\n그래도 착각하지 마. 내 포켓몬들은 아직 잡은 지 얼마 안 됐을 뿐이라구.\n이 앞이 유풍시티래. 거기 체육관도 있다던데, 내가 먼저 배지 따 버릴 거야!\n다음에 만나면 그땐 내가 이긴다. 각오해 두라구!";
    korLang[7384] = "하하, 졌다 졌어. 너 진짜 강하구나.\n내 포켓몬들도 열심히 해 줬는데… 내가 아직 지시를 잘 못 내리나 봐.\n이 앞이 유풍시티래. 체육관이 있다니까 거기서 나도 더 연습해 볼게.\n다음엔 진짜 이길 거야. 그때까지 너무 멀리 가 버리면 안 돼!";
    korLang[7401] = "멋진 승부였어. 너와 포켓몬의 마음이 하나가 된 게 느껴졌어.";
    korLang[7402] = "으앗! 내 꿈벅이…!";
    korLang[7403] = "벌레 포켓몬이 이렇게 지다니!";
    korLang[7404] = "숲에 가기도 전에 지다니…";
    korLang[7405] = "으으, 숲의 벌레 포켓몬으로도 못 이기다니!";
    korLang[7406] = "어머, 졌네? 너 꽤 하는구나.";
    korLang[7407] = "내 귀뚤뚜기의 노래가 안 통했어…";
    korLang[7408] = "이브이까지 졌어…! 산책은 여기까지야.";
    korLang[7409] = "호수의 벌레 포켓몬도 너한텐 안 되는구나.";
    korLang[7410] = "제법이라고 했는데, 진짜 제법이었네.";
    korLang[7411] = "피카츄랑 나, 길도 잃고 승부도 졌어…";
    korLang[7412] = "거짓말… 타입도 레벨도 내가 유리했는데!";
    korLang[7413] = "와… 핸디캡을 받고도 이렇게 되네. 역시 대단하다!";
    korLang[3901] = "계정 메모";
    korLang[5901] = "박사님께 받은 종이. 포켓몬센터 PC의 계정이 적혀 있다. 포켓몬센터 구석의 PC에서 계정을 활성화할 수 있다.";
    korLang[3902] = "유풍체육관 도전장";
    korLang[5902] = "유풍체육관 로비의 단말기에서 발급받은 도전 신청서. 관장 휴린에게 도전할 자격이 있다는 증표다.";
    korLang[3903] = "체육관 상처약";
    korLang[5903] = "유풍체육관 안에서만 쓸 수 있는 상처약. 포켓몬의 HP를 20 회복한다. 체육관을 나가면 반납한다.";
    korLang[3904] = "체육관 기력의조각";
    korLang[5904] = "유풍체육관 안에서만 쓸 수 있는 기력의조각. 기절한 포켓몬을 HP 절반으로 되살린다. 체육관을 나가면 반납한다.";
    korLang[7385] = "그리고 이 종이도 받으렴.\n포켓몬센터 PC의 계정이 적혀 있단다. 센터 구석의 PC에서 계정을 활성화하면, 잡은 포켓몬을 PC에 맡길 수 있지.";
    korLang[7386] = "PC가 놓여 있다.\n박사님께 받은 계정 메모로 계정을 활성화할 수 있을 것 같다.";
    korLang[7387] = "계정 활성화하기";
    korLang[7388] = "그만두기";
    korLang[7389] = "계정을 활성화했다!\n이제 잡은 포켓몬을 PC에 맡길 수 있다.";
    korLang[7390] = "PC를 켰다.\n무엇을 할까?";
    korLang[7391] = "포켓몬 맡기기";
    korLang[7392] = "포켓몬 데려가기";
    korLang[7393] = "끝내기";
    korLang[7394] = "{poke}(을)를 PC에 맡겼다.";
    korLang[7395] = "{poke}(을)를 데려왔다!";
    korLang[7396] = "마지막 남은 포켓몬은 맡길 수 없다!";
    korLang[7397] = "박스가 가득 찼다!";
    korLang[7398] = "지닌 포켓몬이 가득 찼다!";
    korLang[7399] = "박스 {n}";
    korLang[7400] = "PC에 맡긴 포켓몬이 없다.";
    korLang[7420] = "노력";
    korLang[7421] = "외로움";
    korLang[7422] = "용감";
    korLang[7423] = "고집";
    korLang[7424] = "개구쟁이";
    korLang[7425] = "대담";
    korLang[7426] = "온순";
    korLang[7427] = "무사태평";
    korLang[7428] = "장난꾸러기";
    korLang[7429] = "촐랑";
    korLang[7430] = "겁쟁이";
    korLang[7431] = "성급";
    korLang[7432] = "성실";
    korLang[7433] = "명랑";
    korLang[7434] = "천진난만";
    korLang[7435] = "조심";
    korLang[7436] = "의젓";
    korLang[7437] = "냉정";
    korLang[7438] = "수줍음";
    korLang[7439] = "덜렁";
    korLang[7440] = "차분";
    korLang[7441] = "얌전";
    korLang[7442] = "건방";
    korLang[7443] = "신중";
    korLang[7444] = "변덕";
    korLang[7445] = "성격";
    korLang[7446] = "개체값";
    korLang[7447] = "노력치";
    korLang[7448] = "포켓몬 정보";
    korLang[7449] = "능력";
    korLang[7451] = "HP";
    korLang[7452] = "공격";
    korLang[7453] = "방어";
    korLang[7454] = "특공";
    korLang[7455] = "특방";
    korLang[7456] = "스피드";
    korLang[7457] = "어서 오세요, 유풍체육관입니다!\n관장 휴린에게 도전하시려면 먼저 옆의 단말기에서 도전 신청서를 발급받아 주세요.\n신청서가 있으면 안쪽의 경기장 문이 열린답니다.\n그리고 꼭 알아 두세요. 체육관 안은 바람이 아주 거세답니다. 처음 오신 분들은 똑바로 서 있기도 힘들 정도예요!";
    korLang[7458] = "유풍체육관 도전 신청 단말기다.\n화면에 \"도전 신청서 발급\" 버튼이 있다.";
    korLang[7459] = "경기장으로 가는 문이다.\n틈새로 거센 바람 소리가 새어 나온다…\n도전 신청서가 있어야 열릴 것 같다.";
    korLang[7460] = "도전 신청서 발급";
    korLang[7461] = "도전 신청서는 이미 발급받았다.\n가방의 중요한 물건 칸에 유풍체육관 도전장이 있다.";
    korLang[7462] = "유풍체육관 도전장을 중요한 물건 주머니에 넣었다.";
    korLang[7463] = "유풍체육관 도전장을 문에 갖다 댔다.\n문이 열렸다!";
    korLang[7470] = "체육관 트레이너";
    korLang[7471] = "하늬";
    korLang[7472] = "마파";
    korLang[7473] = "높새";
    korLang[7474] = "이 발판에 내려앉았다는 건, 바람을 탈 줄 안다는 거네!\n하지만 휴린 님께 가려면 나부터 넘어서야 해!";
    korLang[7475] = "바람 속에서 버티는 게 쉽지 않지?\n내 포켓몬들은 이 바람이 집이야. 덤벼!";
    korLang[7476] = "여기까지 날아오다니 제법인걸!\n휴린 님 바로 아래 발판을 지키는 내가 상대해 주지!";
    korLang[7477] = "으앗… 바람이 너한테 붙었나 봐!";
    korLang[7478] = "졌다…! 네 날갯짓, 진짜야.";
    korLang[7479] = "훌륭해! 이제 휴린 님께 날아가도 좋아!";
    korLang[7480] = "양력이 떨어지기 전에 다음 발판에 내려앉는 게 요령이야!";
    korLang[7481] = "부스터는 하나뿐이니까 아껴 써!";
    korLang[7482] = "찌르꼬들은 체육관에서 기르는 포켓몬이야. 잡을 수는 없어!";
    korLang[7483] = "바람이 센 날엔 나도 가끔 떨어진다니까.";
    korLang[7484] = "휴린 님은 맨 위 발판에 계셔. 각오하고 날아가!";
    korLang[7485] = "관장님의 바람은 우리랑은 차원이 달라!";
    korLang[7486] = "체육관에서 빌려주는 글라이더가 놓여 있다.\n바람을 타고 발판 사이를 날 수 있을 것 같다.";
    korLang[7487] = "착용하기";
    korLang[7488] = "글라이더를 착용했다!\n발판 위에서 Z를 누르면 날아오른다. 하늘 위에서는 양력이 조금씩 줄어들고, 발판에 내려앉으면 다시 가득 찬다.\n양력이 다 떨어지면 떨어지니 조심하자! 날고 있을 때 Z를 누르면 부스터를 쓸 수 있다.";
    korLang[7489] = "체육관 직원에게서 체육관 상처약 2개와 체육관 기력의조각 1개,\n그리고 부스터 1개를 받았다!\n(체육관 전용 도구는 체육관을 나가면 반납한다.)";
    korLang[7490] = "양력";
    korLang[7491] = "부스터 {n} (Z)";
    korLang[7492] = "Z를 눌러 이륙";
    korLang[7493] = "양력을 잃고 떨어졌다…!\n…안전 그물에 걸려 로비로 돌아왔다.";
    korLang[7494] = "체육관의 포켓몬은 잡을 수 없다!";
    korLang[7495] = "앗! 체육관의 {poke}(이)가";
    korLang[7496] = "관장 휴린이 서는 자리다.\n…아직 아무도 없다.";
    korLang[7497] = "바람: {d}";
    korLang[7498] = "↑ 위";
    korLang[7499] = "↗ 오른쪽 위";
    korLang[7500] = "→ 오른쪽";
    korLang[7501] = "↘ 오른쪽 아래";
    korLang[7502] = "↓ 아래 (역풍)";
    korLang[7503] = "↙ 왼쪽 아래";
    korLang[7504] = "← 왼쪽";
    korLang[7505] = "↖ 왼쪽 위";
    korLang[7506] = "박스로 보내기";
    korLang[7507] = "발밑에 전기가 흐르기 시작했다!";
    korLang[7508] = "발밑에 풀이 무성해졌다!";
    korLang[7509] = "발밑에 안개가 자욱해졌다!";
    korLang[7510] = "발밑이 이상한 느낌으로 가득 찼다!";
    korLang[7511] = "발밑의 전기가 사라졌다!";
    korLang[7512] = "발밑의 풀이 사라졌다!";
    korLang[7513] = "발밑의 안개가 사라졌다!";
    korLang[7514] = "발밑의 이상한 느낌이 사라졌다!";
    korLang[7515] = "발을 헛디뎌 떨어졌다…!\n…안전 그물에 걸려 로비로 돌아왔다.";   // 유풍체육관: 날지 않는데 발판 밖 (lib/gymFly.jbl)
    korLang[7516] = "휴린";   // 유풍체육관 관장 휴린
    korLang[7517] = "체육관 관장";   // 유풍체육관 관장 휴린
    korLang[7518] = "시원한 바람, 너구나. 이 바람을 헤치고 온 게.\n너무 가볍게 마음 먹지 마. 날아가 버릴 테니.";   // 유풍체육관 관장 휴린
    korLang[7519] = "…바람이 멎었네. 네가 바람보다 한 발 빨랐어.\n좋아, 이 유풍배지는 네 거야.";   // 유풍체육관 관장 휴린
    korLang[7520] = "바람은 거스르는 게 아니라 타는 거야.\n그걸 아는 너라면 더 높이 날 수 있겠지.";   // 유풍체육관 관장 휴린
    korLang[7521] = "다음에 올 땐 더 센 바람을 준비해 둘게.\n그때도 날아가지 말고 버텨 봐.";   // 유풍체육관 관장 휴린
    korLang[7522] = "휴린에게서 유풍배지를 받았다!";   // 유풍체육관 관장 휴린
    korLang[7523] = "{poke}(은)는 {atk}의 공격을 면했다!";   // 판별로 피함 (battleManager.jb)
    korLang[7524] = "파일을 가져오는 중... (X: 그만두기)";   // 리포트 불러오기: 고른 파일이 들어오길 기다림 (fieldMenu.jb)
    korLang[7525] = "{poke}에게 뾰족한 바위가 박혔다!";   // 장판 기술 (battleManager.jb)
    korLang[7526] = "{poke}(은)는 압정뿌리기의 데미지를 입었다!";   // 장판 기술 (battleManager.jb)
    korLang[7527] = "{poke}(은)는 끈적끈적네트에 걸렸다!";   // 장판 기술 (battleManager.jb)
    korLang[7528] = "{poke}(은)는 독압정을 흡수해서 없앴다!";   // 장판 기술 (battleManager.jb)
    korLang[7529] = "상대 발밑에 압정이 뿌려졌다!";   // 장판 기술 (battleManager.jb)
    korLang[7530] = "우리 편 발밑에 압정이 뿌려졌다!";   // 장판 기술 (battleManager.jb)
    korLang[7531] = "상대 발밑에 독압정이 뿌려졌다!";   // 장판 기술 (battleManager.jb)
    korLang[7532] = "우리 편 발밑에 독압정이 뿌려졌다!";   // 장판 기술 (battleManager.jb)
    korLang[7533] = "상대 발밑에 끈적끈적네트가 깔렸다!";   // 장판 기술 (battleManager.jb)
    korLang[7534] = "우리 편 발밑에 끈적끈적네트가 깔렸다!";   // 장판 기술 (battleManager.jb)
    korLang[7535] = "{poke}(은)는 주변의 장판을 날려버렸다!";   // 장판 기술 (battleManager.jb)
    korLang[7536] = "양쪽 필드의 장판이 모두 사라졌다!";   // 장판 기술 (battleManager.jb)
    korLang[7238] = "그래, 이것도 가져가렴.\n포켓몬을 잡을 때 쓰는 몬스터볼이란다.";
    korLang[7239] = "{item} {n}개를 받았다!";
    korLang[7240] = "관산마을 상점";
    korLang[7241] = "어서 오세요! 관산마을 상점입니다.\n무엇을 도와드릴까요?";
    korLang[7242] = "여러 가지 상품이 가득 진열되어 있다.";
    korLang[7243] = "어라…!? {poke}의 모습이…!";
    korLang[7244] = "축하합니다! {poke}(은)는 {new}(으)로 진화했다!";
    korLang[7245] = "어라…? {poke}의 변화가 멈췄다!";
    korLang[7246] = "함께 있던 포켓몬들도 경험치를 얻었다!";
    korLang[7247] = "리포트 내보내기";
    korLang[7248] = "리포트 불러오기";
    korLang[7249] = "리포트를 파일로 내보냈습니다.";
    korLang[7250] = "내보낼 리포트가 없습니다.\n먼저 리포트를 작성하세요.";
    korLang[7251] = "불러온 리포트로 바꾸고 타이틀 화면으로 돌아갑니다.\n지금 진행 상황은 사라집니다. 괜찮습니까?";
    korLang[7252] = "리포트를 불러왔습니다!\n타이틀 화면으로 돌아갑니다.";
    korLang[7253] = "올바른 리포트 파일이 아닙니다.";
    korLang[7254] = "X : 리포트 불러오기";
    korLang[7255] = "리포트를 파일로 내보내거나, 내보낸 파일에서 불러옵니다.";
    korLang[7256] = "보라매숲";
    korLang[7257] = "나무가 우거져서 더 이상 들어갈 수 없다.";
    korLang[7258] = "저작권";
    korLang[7280] = "「Pokémon - AJ」는 비상업 팬게임입니다.\n\n포켓몬스터(Pokémon)의 이름 · 캐릭터 · 설정 · 원작 그래픽과 음악의 저작권은 Nintendo · Creatures Inc. · GAME FREAK inc. · The Pokémon Company 에 있습니다.";
    korLang[7281] = "[가져온 에셋]\n· 포켓몬 · 트레이너 · 사람 그림, 도구 아이콘 : GAME FREAK (원작 게임 그래픽)\n· 음악 · 효과음 · 울음소리 : GAME FREAK (원작 게임)\n· 그림 · 울음소리 파일 일부 : pret/pokeplatinum · PokeAPI\n· 포켓몬 필드 그림 : pret/pokeheartgold (하트골드 · 소울실버)\n· 로고 : GAME FREAK";
    korLang[7282] = "[가져온 에셋]\n· 글꼴 : Pokémon DPPt (FontStruct)\n  fontstruct.com/fontstructions/show/1951915/pokemon-dppt-4\n· 포켓몬 · 기술 데이터 : PokeAPI · Pokémon Showdown\n· 한국어 이름 : 본가 게임의 공식 표기";
    korLang[7283] = "[오리지널]\n· 게임 코드 (Jawbreaker) · 엔진\n· 이야기 · 대사 · 인물 · 오리지널 포켓몬\n· 마을 · 도로 · 숲 타일과 맵 · 건물 안 · 지역 지도\n· 타입 아이콘 · 배틀 화면 그림 · UI 그림 · 게임 규칙";
    korLang[7284] = "눈앞이 깜깜해졌다...";
    korLang[7285] = "{tr}에게 상금으로 {m}원을 건네주었다...";
    korLang[7286] = "먼저 포켓몬을 회복시켜 드릴게요.";
    korLang[7287] = "포켓몬이 모두 건강해졌어요!\n무리하지 마세요!";
    korLang[7288] = "{poke}(이)가 길을 막고 있다!\n이쪽을 노려보고 있다...";
    korLang[7289] = "{poke}의 체력 게이지가 하나 깨졌다!";
    korLang[7290] = "{poke}에게는 능력 변화가 통하지 않는다!";
    korLang[7291] = "체력 게이지가 남아 있어서\n잡을 수 없다!";
    korLang[7292] = "{item}(을)를 사용했다!";
    korLang[7293] = "아직 이전에 사용한\n스프레이의 효과가 남아 있다!";
    korLang[7294] = "벌레회피스프레이의 효과가 사라졌다!";
    korLang[7299] = "짧은치마";
    korLang[7305] = "민혁";
    korLang[7306] = "수아";
    korLang[7307] = "도윤";
    korLang[7308] = "하린";
    korLang[7309] = "시우";
    korLang[7310] = "지아";
    korLang[7311] = "예린";
    korLang[7325] = "보라매숲에 온 걸 환영해!\n여기 벌레 포켓몬은 1번도로보다 세다구!";
    korLang[7326] = "어머, 눈이 마주쳤네?\n그럼 승부할 수밖에 없지!";
    korLang[7327] = "이 덤불에서 잡은 포켓몬을 보여 줄게!";
    korLang[7328] = "이브이를 데리고 산책 중이었어.\n방해하면 승부야!";
    korLang[7329] = "호수 근처는 벌레 포켓몬 천국이야!\n한 판 하자!";
    korLang[7330] = "여기까지 오다니 제법인데?\n내 포켓몬도 만만치 않아!";
    korLang[7331] = "피카츄랑 숲에서 길을 잃었어…\n그래도 승부는 해야지!";
    korLang[7345] = "으윽… 숲에서는 내가 더 셀 줄 알았는데!";
    korLang[7346] = "졌다… 다음엔 귀여운 포켓몬으로 이길 거야!";
    korLang[7347] = "내 벌레 포켓몬이…!";
    korLang[7348] = "이브이, 수고했어…";
    korLang[7349] = "호수에 빠질 뻔했다…";
    korLang[7350] = "생각보다 강하네…";
    korLang[7351] = "피카츄, 미안해…";
    korLang[7360] = "보라매숲 안쪽은 길이 여러 갈래야.\n단차는 아래로만 내려갈 수 있으니까 조심해.";
    korLang[7361] = "덤불 깊은 곳에서는\n가끔 스라크가 나온대!";
    korLang[7362] = "찌르꼬는 진화하면\n엄청 강해진다던데.";
    korLang[7363] = "짜랑랑은 낮에 햇볕을 쬐는 걸 좋아해.";
    korLang[7364] = "앗치는 진화시키기 어렵대.\n언제 진화하는지 아무도 몰라.";
    korLang[7365] = "귀뚤뚜기 울음소리, 들어 봤어?";
    korLang[7366] = "이브이는 진화의 돌로\n여러 모습으로 진화한대!";
    korLang[7367] = "북쪽 덤불에서는 이상해씨랑\n치코리타가 자주 나와.";
    korLang[7368] = "호수에는 꼬부기랑 리아코가 살아.\n아주 가끔 미뇽도 봤다는 소문이 있어!";
    korLang[7369] = "귀뚤뚜기는 금방 진화해서 좋아.";
    korLang[7370] = "두더류는 땅을 파고 다녀.\n숲 바닥이 울퉁불퉁한 건 그 녀석 탓이야.";
    korLang[7371] = "갈림길의 커다란 이상해꽃,\n봤어? 엄청 무섭게 생겼더라.";
    korLang[7372] = "피카츄는 천둥의돌로 진화한대.";
    korLang[7373] = "남쪽 길은 아직 나무가 우거져서\n못 지나가.";
    korLang[7260] = "곤충채집소년";
    korLang[7261] = "민수";
    korLang[7262] = "준호";
    korLang[7263] = "태양";
    korLang[7264] = "앗! 눈이 마주쳤다!\n방금 잡은 벌레 포켓몬 실력 좀 볼래?";
    korLang[7265] = "덤불에서 벌레 포켓몬을 잔뜩 잡았어!\n내 자랑을 보여 줄게!";
    korLang[7266] = "보라매숲에 가려는 거지?\n그 전에 나랑 한 판 하자!";
    korLang[7267] = "으으... 벌레 포켓몬도 강하다구!";
    korLang[7268] = "다음엔 더 키워서 올 거야!";
    korLang[7269] = "보라매숲에는 더 강한 벌레 포켓몬이 산대.";
    korLang[7270] = "상금으로 {m}원을 받았다!";
    korLang[7271] = "모드깃은 너무 약한 것 같아.\n노로키였을 때가 더 귀여웠는데...";
    korLang[7272] = "꿈벅은 땅속을 파고 다녀서 잡기 힘들어.\n덤불에서 발소리를 잘 들어 봐.";
    korLang[7273] = "앗치는 진화시키기 어렵대.\n언제 진화하는지 아무도 모른다나?";
    korLang[7274] = "벌레 포켓몬은 금방 진화해서 좋아.\n그런데 내 꿈벅은 아직이야...";
    korLang[7275] = "보라매숲 안쪽은 길을 잃기 쉬우니까 조심해.";
    korLang[7276] = "벌레잡이 그물을 새로 샀는데,\n포켓몬은 그물로는 안 잡히더라.";
    korLang[7100] = "경한공항";
