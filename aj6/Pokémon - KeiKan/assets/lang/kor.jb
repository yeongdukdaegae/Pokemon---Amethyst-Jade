    korLang[5003] = "몬스터볼보다 포켓몬을 조금 더 잘 잡는 볼.";
    korLang[5004] = "야생 포켓몬에게 던져서 잡는 볼. 캡슐처럼 열리고 닫힌다.";
    korLang[5900] = "야생 포켓몬에게 던져서 잡는 볼. 캡슐처럼 열리고 닫힌다.";
    korLang[6900] = "파트너가 들어갈 몬스터볼이다. 오늘만을 기다렸다!";
