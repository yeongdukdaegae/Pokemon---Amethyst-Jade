    // 기술 설명: lang[2000 + 기술 id] (한 줄 · 화면에서 상자 폭에 맞춰 줄바꿈) — 9세대 일부 · 오리지널 기술은 직접 번역 · 작성
    korLang[2001] = "긴 꼬리나 손 등을 사용하여 상대를 때려서 공격한다.";
    korLang[2002] = "날카로운 당수로 상대를 때려서 공격한다. 급소에 맞기 쉽다.";
    korLang[2003] = "연속 뺨치기로 상대를 때려서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2004] = "노도 같은 펀치로 상대를 세게 때려서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2005] = "힘을 담은 펀치로 상대를 공격한다.";
    korLang[2006] = "상대의 몸에 돈을 세게 던져서 공격한다. 배틀 후에 돈을 받을 수 있다.";
    korLang[2007] = "불꽃을 담은 펀치로 상대를 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2008] = "냉기를 담은 펀치로 상대를 공격한다. 얼음 상태로 만들 때가 있다.";
    korLang[2009] = "전격을 담은 펀치로 상대를 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2010] = "단단하고 뾰족한 날카로운 손톱으로 상대를 할퀴어서 공격한다.";
    korLang[2011] = "상대를 양쪽에서 집어서 데미지를 준다.";
    korLang[2012] = "큰 집게로 상대를 베어 갈라 공격한다. 맞으면 일격에 기절한다.";
    korLang[2013] = "바람의 칼날을 만들어 2턴째에 상대를 공격한다. 급소에 맞기 쉽다.";
    korLang[2014] = "싸움의 춤을 격렬하게 춰서 기세를 높인다. 자신의 공격을 크게 올린다.";
    korLang[2015] = "낫이나 발톱 등으로 상대를 베어 공격한다.";
    korLang[2016] = "날개로 일으킨 격한 바람을 상대에게 부딪쳐서 공격한다.";
    korLang[2017] = "크게 펼친 훌륭한 날개를 상대에게 부딪쳐서 공격한다.";
    korLang[2018] = "상대를 날려버려서 교대할 포켓몬을 끌어낸다. 야생의 경우에는 배틀이 끝난다.";
    korLang[2019] = "1턴째에 하늘을 날아 2턴째에 상대를 공격한다.";
    korLang[2020] = "긴 몸이나 덩굴 등을 써서 4-5턴 동안 상대를 조여 공격한다.";
    korLang[2021] = "긴 꼬리나 덩굴 등을 사용해 상대를 힘껏 쳐서 공격한다.";
    korLang[2022] = "채찍처럼 휘어지는 가늘고 긴 덩굴로 상대를 힘껏 쳐서 공격한다.";
    korLang[2023] = "큰 발로 상대를 짓밟아서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2024] = "2개의 다리로 상대를 걷어차서 공격한다. 2회 연속으로 데미지를 준다.";
    korLang[2025] = "굉장한 힘을 담은 킥으로 상대를 걷어차서 공격한다.";
    korLang[2026] = "높이 점프해서 킥으로 상대를 공격한다. 빗나가면 자신이 데미지를 입는다.";
    korLang[2027] = "몸을 재빨리 회전시키며 걷어차서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2028] = "상대의 얼굴에 모래를 뿌려서 명중률을 떨어뜨린다.";
    korLang[2029] = "머리를 내밀어 곧장 돌진하여 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2030] = "날카롭고 뾰족한 뿔로 상대를 공격한다.";
    korLang[2031] = "뿔이나 부리로 상대를 찔러서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2032] = "회전하는 뿔을 상대에게 꿰찔러서 공격한다. 맞으면 일격에 기절한다.";
    korLang[2033] = "상대를 향해서 몸 전체를 부딪쳐가며 공격한다.";
    korLang[2034] = "몸 전체로 상대를 덮쳐눌러 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2035] = "긴 몸이나 덩굴 등을 사용해 4-5턴 동안 상대를 휘감아 공격한다.";
    korLang[2036] = "굉장한 기세로 상대에게 부딪쳐 공격한다. 자신도 조금 데미지를 입는다.";
    korLang[2037] = "2-3턴 동안 마구 난동 부려서 상대를 공격한다. 난동 부린 뒤에는 혼란에 빠진다.";
    korLang[2038] = "목숨을 걸고 상대에게 돌진하여 공격을 한다. 자신도 상당한 데미지를 입는다.";
    korLang[2039] = "꼬리를 좌우로 귀엽게 흔들어 방심을 유도한다. 상대의 방어를 떨어뜨린다.";
    korLang[2040] = "독이 있는 침을 상대에게 꿰찔러서 공격한다. 독 상태로 만들 때가 있다.";
    korLang[2041] = "2개의 침을 상대에게 꿰찔러 2회 연속으로 데미지를 준다. 독 상태로 만들 때가 있다.";
    korLang[2042] = "날카로운 침을 상대에게 발사해서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2043] = "날카로운 눈초리로 겁을 주어 상대의 방어를 떨어뜨린다.";
    korLang[2044] = "날카롭고 뾰족한 이빨로 물어서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2045] = "귀여운 울음소리를 들려주고 관심을 끌어 방심한 사이에 상대의 공격을 떨어뜨린다.";
    korLang[2046] = "상대를 도망가게 해서 교대할 포켓몬을 끌어낸다. 야생의 경우에는 배틀이 끝난다.";
    korLang[2047] = "기분 좋은 예쁜 노랫소리를 들려주고 상대를 잠듦 상태로 만든다.";
    korLang[2048] = "특수한 음파를 몸에서 발산하여 상대를 혼란시킨다.";
    korLang[2049] = "충격파를 상대에 부딪쳐서 공격한다. 언제나 20의 데미지를 준다.";
    korLang[2050] = "상대의 움직임을 막아 바로 전에 쓴 기술을 4턴 동안 사용할 수 없게 만든다.";
    korLang[2051] = "강한 산을 상대에게 끼얹어 공격한다. 상대의 특수방어를 떨어뜨릴 때가 있다.";
    korLang[2052] = "작은 불꽃을 상대에게 발사하여 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2053] = "세찬 불꽃을 상대에게 발사하여 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2054] = "하얀 안개로 몸을 덮는다. 5턴 동안 상대에 의해 능력이 떨어지지 않게 된다.";
    korLang[2055] = "물을 기세 좋게 상대에게 발사하여 공격한다.";
    korLang[2056] = "대량의 물을 세찬 기세로 상대에게 발사하여 공격한다.";
    korLang[2057] = "큰 파도로 자신의 주위에 있는 포켓몬을 공격한다.";
    korLang[2058] = "냉동빔을 상대에게 발사하여 공격한다. 얼음 상태로 만들 때가 있다.";
    korLang[2059] = "세찬 눈보라를 상대에게 내뿜어 공격한다. 얼음 상태로 만들 때가 있다.";
    korLang[2060] = "이상한 광선을 상대에게 발사하여 공격한다. 혼란시킬 때가 있다.";
    korLang[2061] = "거품을 기세 좋게 상대에게 발사하여 공격한다. 스피드를 떨어뜨릴 때가 있다.";
    korLang[2062] = "무지개색의 빔을 상대에게 발사하여 공격한다. 공격을 떨어뜨릴 때가 있다.";
    korLang[2063] = "강한 광선을 상대에게 발사하여 공격한다. 다음 턴은 움직일 수 없다.";
    korLang[2064] = "날카롭고 뾰족한 부리나 뿔로 상대를 쪼아서 공격한다.";
    korLang[2065] = "회전하면서 뾰족한 부리를 상대에게 꿰찔러 공격한다.";
    korLang[2066] = "땅에 자신과 함께 상대를 내던져 공격한다. 자신도 조금 데미지를 입는다.";
    korLang[2067] = "발을 강하게 걸고 상대를 넘어뜨려 공격한다. 상대가 무거울수록 위력이 올라간다.";
    korLang[2068] = "상대로부터 받은 물리공격의 데미지를 2배로 만들어 같은 상대에게 돌려준다.";
    korLang[2069] = "인력을 사용해 내던진다. 자신의 레벨과 똑같은 데미지를 상대에게 준다.";
    korLang[2070] = "혼신의 힘으로 상대를 세게 때려서 공격한다.";
    korLang[2071] = "양분을 흡수하여 공격한다. 상대에게 입힌 데미지의 절반에 해당하는 HP를 회복할 수 있다.";
    korLang[2072] = "양분을 흡수하여 공격한다. 상대에게 입힌 데미지의 절반에 해당하는 HP를 회복할 수 있다.";
    korLang[2073] = "씨가 뿌려진 상대의 HP를 매 턴 조금씩 흡수하여 자신의 HP를 회복한다.";
    korLang[2074] = "몸을 일시에 크게 성장시켜 공격과 특수공격을 올린다.";
    korLang[2075] = "잎사귀를 날려 상대를 베어 공격한다. 급소에 맞기 쉽다.";
    korLang[2076] = "1턴째에 빛을 가득 모아 2턴째에 빛의 다발을 발사하여 공격한다.";
    korLang[2077] = "독이 있는 가루를 많이 흩뿌려서 상대를 독 상태로 만든다.";
    korLang[2078] = "저리가루를 많이 흩뿌려서 상대를 마비 상태로 만든다.";
    korLang[2079] = "잠이 오는 가루를 많이 흩뿌려서 상대를 잠듦 상태로 만든다.";
    korLang[2080] = "2-3턴 동안 꽃을 흩뿌려서 상대를 공격한다. 흩뿌린 뒤에는 혼란에 빠진다.";
    korLang[2081] = "입에서 뿜어낸 실을 휘감아서 상대의 스피드를 크게 떨어뜨린다.";
    korLang[2082] = "분노의 충격파를 상대에게 부딪쳐서 공격한다. 언제나 40의 데미지를 준다.";
    korLang[2083] = "세차게 소용돌이치는 불꽃 속에 4-5턴 동안 상대를 가두어 공격한다.";
    korLang[2084] = "전기 자극을 상대에게 날려서 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2085] = "강한 전격을 상대에게 날려서 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2086] = "약한 전격을 날려서 상대를 마비 상태로 만든다.";
    korLang[2087] = "강한 번개를 상대에게 떨어뜨려 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2088] = "작은 바위를 들어올려 상대에게 내던져서 공격한다.";
    korLang[2089] = "지진의 충격으로 자신의 주위에 있는 포켓몬을 공격한다.";
    korLang[2090] = "땅이 갈라진 곳에 상대를 떨어뜨려 공격한다. 맞으면 일격에 기절한다.";
    korLang[2091] = "1턴째에 파고들어 2턴째에 상대를 공격한다.";
    korLang[2092] = "상대를 맹독의 상태로 만든다. 턴이 진행될수록 독의 데미지가 증가한다.";
    korLang[2093] = "약한 염동력을 상대에게 보내어 공격한다. 상대를 혼란시킬 때가 있다.";
    korLang[2094] = "강한 염동력을 상대에게 보내어 공격한다. 상대의 특수방어를 떨어뜨릴 때가 있다.";
    korLang[2095] = "졸음을 유도하는 암시를 걸어서 상대를 잠듦 상태로 만든다.";
    korLang[2096] = "잠들어 있는 힘을 몸속에서 끌어내어 자신의 공격을 올린다.";
    korLang[2097] = "힘을 빼고 몸을 가볍게 해서 고속으로 움직인다. 자신의 스피드를 크게 올린다.";
    korLang[2098] = "눈에 보이지 않는 굉장한 속도로 상대에게 돌진한다. 반드시 선제공격할 수 있다.";
    korLang[2099] = "기술을 썼을 때 공격을 받으면 분노의 힘으로 공격이 올라간다.";
    korLang[2100] = "교대할 포켓몬이 있을 때 사용하면 교체한다. 야생 포켓몬은 도망가 버린다.";
    korLang[2101] = "무시무시한 환상을 보게 해서 자신의 레벨과 똑같은 만큼의 데미지를 상대에게 준다.";
    korLang[2102] = "상대가 마지막에 사용한 기술을 배틀을 하는 동안 자신의 기술로 만들 수 있다.";
    korLang[2103] = "그만 귀를 막아버리고 싶은 싫은 소리를 내어 상대의 방어를 크게 떨어뜨린다.";
    korLang[2104] = "재빠른 움직임으로 분신을 만들어 상대를 혼란시켜 회피율을 올린다.";
    korLang[2105] = "세포를 재생시켜 자신의 최대 HP의 절반만큼 HP를 회복한다.";
    korLang[2106] = "전신에 힘을 담아 몸을 단단하게 해서 자신의 방어를 올린다.";
    korLang[2107] = "몸을 축소하여 작게 보임으로써 자신의 회피율을 크게 올린다.";
    korLang[2108] = "연기나 먹물을 내뿜어 상대의 명중률을 떨어뜨린다.";
    korLang[2109] = "이상한 빛을 상대에게 비춰 당황하게 한다. 상대를 혼란시킨다.";
    korLang[2110] = "껍질에 숨어 몸을 보호하여 자신의 방어를 올린다.";
    korLang[2111] = "몸을 둥글게 웅크려서 자신의 방어를 올린다.";
    korLang[2112] = "튼튼한 장막을 만들어 자신의 방어를 크게 올린다.";
    korLang[2113] = "5턴 동안 이상한 장막을 쳐서 상대로부터 받는 특수공격의 데미지를 약하게 한다.";
    korLang[2114] = "흑안개를 뿜어 배틀에 참가 중인 포켓몬 전원의 능력 변화를 원래대로 돌린다.";
    korLang[2115] = "5턴 동안 이상한 장막을 쳐서 상대로부터 받는 물리공격의 데미지를 약하게 한다.";
    korLang[2116] = "깊게 숨을 들이마셔 기합을 넣는다. 자신의 공격이 급소에 맞기 쉬워진다.";
    korLang[2117] = "2턴 동안 공격을 견뎌 입은 데미지를 2배로 만들어 상대에게 돌려준다.";
    korLang[2118] = "손가락을 흔들어 자신의 뇌를 자극해서 모든 기술 중 어느 하나를 날린다.";
    korLang[2119] = "상대가 사용한 기술을 흉내 내어 자신도 똑같은 기술을 쓴다.";
    korLang[2120] = "폭발을 일으켜서 자신의 주위에 있는 포켓몬을 공격한다. 쓰고 나서 기절하게 된다.";
    korLang[2121] = "큰 알을 온 힘을 다해 상대에게 내던져서 공격한다.";
    korLang[2122] = "긴 혀로 상대를 핥아서 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2123] = "더러운 가스를 상대에게 내뿜어 공격한다. 독 상태로 만들 때가 있다.";
    korLang[2124] = "더러운 오물을 상대에게 내던져서 공격한다. 독 상태로 만들 때가 있다.";
    korLang[2125] = "손에 들고 있는 뼈로 상대를 세게 때려서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2126] = "큰 대자의 불꽃으로 상대를 불태운다. 화상 상태로 만들 때가 있다.";
    korLang[2127] = "굉장한 기세로 상대에게 돌진한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2128] = "매우 튼튼하고 두꺼운 껍질에 4-5턴 동안 상대를 끼워서 공격한다.";
    korLang[2129] = "별 모양의 빛을 발사해서 상대를 공격한다. 공격은 반드시 명중한다.";
    korLang[2130] = "1턴째에 머리를 움츠려 방어를 올린다. 2턴째에 상대를 공격한다.";
    korLang[2131] = "날카로운 침을 상대에게 발사해서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2132] = "촉수나 덩굴 등을 휘감아서 공격한다. 상대의 스피드를 떨어뜨릴 때가 있다.";
    korLang[2133] = "머리를 비워서 순간적으로 무언가를 잊어버림으로써 자신의 특수방어를 크게 올린다.";
    korLang[2134] = "숟가락을 휘어서 주의를 끌어 상대의 명중률을 낮춘다.";
    korLang[2135] = "자신의 최대 HP 절반을 회복한다.";
    korLang[2136] = "점프해서 무릎차기로 상대를 공격한다. 빗나가면 자신이 데미지를 입는다.";
    korLang[2137] = "배의 무늬로 겁을 주어 상대를 마비 상태로 만든다.";
    korLang[2138] = "잠자고 있는 상대의 꿈을 먹어 공격한다. 데미지의 절반을 HP로 회복한다.";
    korLang[2139] = "독가스를 상대의 얼굴에 내뿜어 독 상태로 만든다.";
    korLang[2140] = "둥근 것을 상대에게 내던져서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2141] = "피를 빨아서 상대를 공격한다. 준 데미지의 절반을 HP로 회복한다.";
    korLang[2142] = "무서운 얼굴로 키스한다. 상대를 잠듦 상태로 만든다.";
    korLang[2143] = "2턴째에 상대를 공격한다. 가끔 풀죽게 만든다. 급소에도 맞기 쉽다.";
    korLang[2144] = "상대 포켓몬으로 변신하여 상대와 완전히 똑같은 기술을 사용할 수 있다.";
    korLang[2145] = "매우 많은 거품을 상대에게 내뿜어 공격한다. 상대의 스피드를 떨어뜨릴 때가 있다.";
    korLang[2146] = "리드미컬한 펀치를 날려 상대를 공격한다. 혼란시킬 때가 있다.";
    korLang[2147] = "최면 효과가 있는 포자를 훌훌 흩뿌려서 상대를 잠듦 상태로 만든다.";
    korLang[2148] = "눈이 부신 빛으로 상대의 명중률을 떨어뜨린다.";
    korLang[2149] = "이상한 염력파를 상대에게 발사하여 공격한다. 사용할 때마다 데미지가 바뀐다.";
    korLang[2150] = "공격도 하지 않고 팔딱팔딱 튈 뿐 아무 일도 일어나지 않는다...";
    korLang[2151] = "세포의 변화로 액체가 되어 자신의 방어를 크게 올린다.";
    korLang[2152] = "큰 집게를 상대에게 내리쳐서 공격한다. 급소에 맞기 쉽다.";
    korLang[2153] = "큰 폭발로 자신의 주위에 있는 포켓몬을 공격한다. 쓰고 나서는 기절한다.";
    korLang[2154] = "손톱이나 낫 등으로 상대를 할퀴어서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2155] = "손에 들고 있는 뼈를 상대에게 날려서 날아갈 때와 돌아올 때 2회 연속 데미지를 준다.";
    korLang[2156] = "2턴 동안 계속 잠잔다. 자신의 HP와 상태 이상을 모두 회복한다.";
    korLang[2157] = "큰 바위를 세차게 부딪쳐서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2158] = "날카로운 앞니로 강하게 물어서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2159] = "몸의 각을 늘려서 더욱 각지게 하여 자신의 공격을 올린다.";
    korLang[2160] = "자신의 타입을 배운 기술 중 가장 위에 있는 기술과 같은 타입으로 바꾼다.";
    korLang[2161] = "3개의 광선으로 공격한다. 마비, 화상 또는 얼음 상태 중 어느 하나로 만들 때가 있다.";
    korLang[2162] = "날카로운 앞니로 강하게 물어서 공격한다. 상대의 HP는 절반이 된다.";
    korLang[2163] = "발톱이나 낫 등으로 상대를 베어 갈라서 공격한다. 급소에 맞기 쉽다.";
    korLang[2164] = "자신의 HP를 조금 깎아서 분신을 만든다. 분신은 자신의 대타가 된다.";
    korLang[2165] = "자신의 PP가 떨어지면 발버둥 쳐 상대를 공격한다. 자신도 조금 데미지를 입는다.";
    korLang[2166] = "상대가 쓴 기술을 자신의 것으로 만든다. 한 번 사용하면 스케치는 사라진다.";
    korLang[2167] = "3회 연속으로 킥을 날려 공격한다. 기술이 맞을 때마다 위력이 올라간다.";
    korLang[2168] = "공격과 동시에 도구를 훔친다. 자신이 도구를 지니고 있을 경우에는 훔칠 수 없다.";
    korLang[2169] = "끈적끈적하고 가는 실을 칭칭 휘감아 상대를 배틀에서 도망칠 수 없게 한다.";
    korLang[2170] = "상대의 움직임을 마음으로 읽고 다음 공격이 반드시 상대에게 명중되게 한다.";
    korLang[2171] = "잠듦 상태의 상대에게 악몽을 꾸게 하여 매 턴 조금씩 HP를 떨어뜨려 간다.";
    korLang[2172] = "불꽃을 둘러 상대에게 돌진하여 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2173] = "자신이 잠들어 있을 때 소음을 내어 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2174] = "기술을 쓰는 포켓몬이 고스트타입일 때와 그 이외의 타입일 때는 효과가 다르다.";
    korLang[2175] = "바둥바둥 난동 부려서 공격한다. 자신의 HP가 적을수록 기술의 위력이 올라간다.";
    korLang[2176] = "상대가 마지막으로 쓴 기술에 저항할 수 있도록 자신의 타입을 변화시킨다.";
    korLang[2177] = "공기의 소용돌이를 발사하여 공격한다. 급소에 맞기 쉽다.";
    korLang[2178] = "솜처럼 폭신폭신한 포자를 착 달라붙게 해서 상대의 스피드를 크게 떨어뜨린다.";
    korLang[2179] = "힘을 쥐어짜서 공격한다. 자신의 HP가 적을수록 기술의 위력이 올라간다.";
    korLang[2180] = "상대가 마지막으로 사용한 기술에 원한을 품어 그 기술의 PP를 4만큼 줄인다.";
    korLang[2181] = "차가운 가랑눈을 상대에게 내뿜어 공격한다. 얼음 상태로 만들 때가 있다.";
    korLang[2182] = "상대의 공격을 전혀 받지 않는다. 연속으로 쓰면 실패하기 쉽다.";
    korLang[2183] = "눈에 보이지 않는 굉장한 속도로 펀치를 날린다. 반드시 선제공격을 할 수 있다.";
    korLang[2184] = "무서운 얼굴로 노려보고 겁주어 상대의 스피드를 크게 떨어뜨린다.";
    korLang[2185] = "슬금슬금 상대에게 다가가 방심한 틈을 타서 세게 때린다. 공격은 반드시 명중한다.";
    korLang[2186] = "천사처럼 귀엽게 키스하여 상대를 혼란시킨다.";
    korLang[2187] = "자신의 HP를 최대 HP의 절반만큼 감소시켜 자신의 공격을 최대로 올린다.";
    korLang[2188] = "더러운 오물을 상대에게 내던져서 공격한다. 독 상태로 만들 때가 있다.";
    korLang[2189] = "상대의 얼굴 등에 진흙을 내던져서 공격한다. 명중률을 떨어뜨린다.";
    korLang[2190] = "상대의 얼굴 등에 먹물을 내뿜어 공격한다. 명중률을 떨어뜨릴 때가 있다.";
    korLang[2191] = "상대의 발밑에 압정을 뿌린다. 교체된 상대 포켓몬에게 데미지를 준다.";
    korLang[2192] = "대포처럼 전기를 발사해서 공격한다. 상대를 마비 상태로 만든다.";
    korLang[2193] = "고스트타입에 효과가 없는 기술이나 회피율이 높은 상대라 할지라도 공격이 맞게 된다.";
    korLang[2194] = "기술을 쓴 뒤 상대의 공격으로 기절했을 때 공격 상대도 기절하게 한다. 연속으로 쓰면 실패한다.";
    korLang[2195] = "노래를 들은 포켓몬은 3턴이 지나면 기절한다. 교체되면 효과가 없어진다.";
    korLang[2196] = "차가운 냉기를 상대에게 내뿜어 공격한다. 상대의 스피드를 떨어뜨린다.";
    korLang[2197] = "상대의 공격을 전혀 받지 않는다. 연속으로 쓰면 실패하기 쉽다.";
    korLang[2198] = "단단한 뼈로 상대를 세게 때려서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2199] = "조준을 잘 맞춰 다음 공격이 반드시 상대에게 명중하도록 한다.";
    korLang[2200] = "2-3턴 동안 마구 난동 부려서 공격한다. 난동 부린 뒤에는 혼란에 빠진다.";
    korLang[2201] = "5턴 동안 모래바람을 일으켜 바위 땅, 강철타입 이외의 상대에게 데미지를 준다. 바위타입의 특수방어가 올라간다.";
    korLang[2202] = "양분을 흡수하여 공격한다. 입힌 데미지의 절반에 해당하는 HP를 회복할 수 있다.";
    korLang[2203] = "공격을 받아도 HP를 반드시 1만큼은 남긴다. 연속으로 쓰면 실패하기 쉽다.";
    korLang[2204] = "귀엽게 바라보고 방심을 유도하여 상대의 공격을 크게 떨어뜨린다.";
    korLang[2205] = "5턴 동안 구르기를 반복하여 공격한다. 기술이 맞을 때마다 위력이 올라간다.";
    korLang[2206] = "상대의 HP가 반드시 1만 남도록 조절하여 공격한다.";
    korLang[2207] = "상대를 화내게 해서 혼란시킨다. 분노로 상대의 공격은 크게 올라가 버린다.";
    korLang[2208] = "자신의 최대 HP 절반을 회복한다.";
    korLang[2209] = "전기를 둘러 상대에게 돌진하여 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2210] = "낫이나 발톱 등으로 상대를 베어 공격한다. 연속으로 맞히면 위력이 올라간다.";
    korLang[2211] = "단단한 날개를 상대에게 부딪쳐서 공격한다. 자신의 방어가 올라갈 때가 있다.";
    korLang[2212] = "빨려 들어갈 것 같은 까만 눈빛으로 가만히 응시하여 상대를 배틀에서 도망갈 수 없게 한다.";
    korLang[2213] = "수컷은 암컷을 암컷은 수컷을 유혹하여 헤롱헤롱하게 만든다. 상대가 기술을 쓰기 어려워진다.";
    korLang[2214] = "자신이 배운 기술 중 하나를 무작위로 날린다. 자신이 잠들어 있을 때만 쓸 수 있다.";
    korLang[2215] = "기분 좋은 방울소리를 들려주어 같은 편 전원의 상태 이상을 회복한다.";
    korLang[2216] = "트레이너를 위해 전력으로 상대를 공격한다. 친밀할수록 위력이 올라간다.";
    korLang[2217] = "덫을 설치한 상자를 상대에게 건네어 공격한다. HP가 회복돼버릴 때도 있다.";
    korLang[2218] = "불만을 풀기 위해 전력으로 상대를 공격한다. 친밀하지 않을수록 위력이 올라간다.";
    korLang[2219] = "5턴 동안 이상한 힘의 보호를 받아 상태 이상이 되지 않는다.";
    korLang[2220] = "자신의 HP와 상대의 HP를 합친 것을 자신과 상대가 사이좋게 나눈다.";
    korLang[2221] = "신비한 불꽃으로 상대를 태워서 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2222] = "땅을 흔들어서 자신의 주위에 있는 포켓몬을 공격한다. 기술의 위력이 여러모로 바뀐다.";
    korLang[2223] = "혼신의 힘으로 펀치를 날려서 공격한다. 상대를 반드시 혼란시킨다.";
    korLang[2224] = "단단하고 훌륭한 뿔로 마음껏 상대를 꿰찔러서 공격한다.";
    korLang[2225] = "굉장한 숨결을 상대에게 내뿜어 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2226] = "교대 포켓몬과 바뀐다. 능력 변화는 바뀐 포켓몬이 그대로 이어받는다.";
    korLang[2227] = "상대에게 앵콜시킨 기술을 3번 연속으로 쓰게 한다.";
    korLang[2228] = "상대 포켓몬이 교체될 때 기술을 쓰면 2배의 위력으로 공격할 수 있다.";
    korLang[2229] = "회전해서 상대를 공격한다. 조이기, 김밥말이, 씨뿌리기 등을 날려버린다. 자신의 스피드도 오른다.";
    korLang[2230] = "향기로 상대의 회피율을 크게 떨어뜨린다.";
    korLang[2231] = "단단한 꼬리로 상대를 힘껏 쳐서 공격한다. 상대의 방어를 떨어뜨릴 때가 있다.";
    korLang[2232] = "강철의 발톱으로 상대를 베어 갈라 공격한다. 자신의 공격이 올라갈 때도 있다.";
    korLang[2233] = "상대보다 나중에 공격한다. 그 대신 자신의 공격은 반드시 명중한다.";
    korLang[2234] = "자신의 HP를 회복한다. 날씨에 따라 회복량이 변한다.";
    korLang[2235] = "자신의 HP를 회복한다. 날씨에 따라 회복량이 변한다.";
    korLang[2236] = "자신의 HP를 회복한다. 날씨에 따라 회복량이 변한다.";
    korLang[2237] = "기술을 쓴 포켓몬에 따라 기술의 타입이 바뀐다.";
    korLang[2238] = "양손으로 당수를 상대에게 힘껏 쳐서 공격한다. 급소에 맞기 쉽다.";
    korLang[2239] = "회오리를 일으켜 상대를 끌어들여 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2240] = "5턴 동안 비를 내리게 해서 물타입 기술의 위력을 올린다. 불꽃타입의 위력은 떨어진다.";
    korLang[2241] = "5턴 동안 햇살을 강하게 해서 불꽃타입 기술의 위력을 올린다. 물타입의 위력은 떨어진다.";
    korLang[2242] = "날카로운 이빨로 상대를 깨물어 부숴서 공격한다. 상대의 방어를 떨어뜨릴 때가 있다.";
    korLang[2243] = "상대에게 받은 특수공격의 데미지를 2배로 만들어 그 상대에게 돌려준다.";
    korLang[2244] = "자신에게 암시를 걸어서 능력 변화 상태를 상대와 똑같은 상태로 만든다.";
    korLang[2245] = "눈에 보이지 않는 굉장한 속도로 상대에게 돌진하여 공격한다. 반드시 선제공격을 할 수 있다.";
    korLang[2246] = "원시의 힘으로 공격한다. 자신의 모든 능력이 오를 때가 있다.";
    korLang[2247] = "까만 그림자의 덩어리를 내던져서 공격한다. 상대의 특수방어를 떨어뜨릴 때가 있다.";
    korLang[2248] = "기술을 사용한 2턴 뒤에 상대에게 염동력의 덩어리를 보내어 공격한다.";
    korLang[2249] = "펀치로 공격한다. 상대의 방어를 떨어뜨릴 때가 있다.";
    korLang[2250] = "세차게 소용돌이치는 물속에 4-5턴 동안 상대를 가두어 공격한다.";
    korLang[2251] = "같은 편 전원이 공격한다. 동료 포켓몬이 많을수록 기술의 공격 횟수가 증가한다.";
    korLang[2252] = "선제공격으로 상대를 풀죽게 한다. 배틀에 나가서 바로 쓰지 않으면 성공할 수 없다.";
    korLang[2253] = "3턴 동안 소란 피워 공격한다. 그동안은 아무도 잠들지 않게 된다.";
    korLang[2254] = "힘을 비축해서 자신의 방어와 특수방어를 올린다. 최대 3회까지 비축할 수 있다.";
    korLang[2255] = "비축된 힘을 상대에게 부딪쳐서 공격한다. 비축된 만큼 위력이 올라간다.";
    korLang[2256] = "비축된 힘을 꿀꺽해서 자신의 HP를 회복한다. 비축된 만큼 회복한다.";
    korLang[2257] = "뜨거운 숨결을 상대에게 내뿜어 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2258] = "5턴 동안 싸라기눈을 내리게 해서 얼음타입이 아닌 포켓몬 모두에게 데미지를 준다.";
    korLang[2259] = "상대에게 트집을 잡아서 똑같은 기술을 2회 연속으로 쓸 수 없게 한다.";
    korLang[2260] = "상대를 부추겨서 혼란시킨다. 동시에 상대의 특수공격도 올라가 버린다.";
    korLang[2261] = "으스스하고 괴상한 불꽃을 쏘아 상대를 화상 상태로 만든다.";
    korLang[2262] = "자신은 기절하게 되지만 그 대신 상대의 공격과 특수공격을 크게 떨어뜨린다.";
    korLang[2263] = "자신이 독, 마비, 화상 상태일 때 날리면 기술의 위력이 2배가 된다.";
    korLang[2264] = "정신력을 높여 펀치를 날린다. 기술을 쓰기 전에 공격을 받으면 실패한다.";
    korLang[2265] = "마비 상태의 상대에게는 위력이 2배가 되지만 대신 상대의 마비가 풀린다.";
    korLang[2266] = "자신에게 주목시켜 상대로부터의 공격을 모두 자신에게 향하게 한다.";
    korLang[2267] = "자연의 힘으로 공격한다. 사용하는 장소에 따라 나오는 기술이 변화한다.";
    korLang[2268] = "다음 턴에 쓸 전기타입 기술의 위력을 올린다. 자신의 특수방어도 올라간다.";
    korLang[2269] = "상대를 화나게 한다. 3턴 동안 상대는 데미지를 주는 기술밖에 쓸 수 없게 된다.";
    korLang[2270] = "동료를 돕는다. 도움받은 포켓몬이 쓰는 기술의 위력은 여느 때보다 커진다.";
    korLang[2271] = "상대의 빈틈을 노려 자신과 상대가 지닌 물건을 바꿔치기한다.";
    korLang[2272] = "상대의 역할을 하여 자신도 상대와 같은 특성으로 변화한다.";
    korLang[2273] = "다음 턴에 자신 또는 교체한 포켓몬의 HP를 최대 HP의 절반만큼 회복한다.";
    korLang[2274] = "서둘러서 같은 편의 도움을 받아 같은 편 포켓몬이 기억하고 있는 기술 중 하나를 쓴다.";
    korLang[2275] = "대지에 뿌리를 박아 매 턴마다 자신의 HP를 회복한다. 뿌리 박고 있으므로 교체할 수 없다.";
    korLang[2276] = "엄청난 힘을 발휘하여 상대를 공격한다. 자신의 공격과 방어가 떨어진다.";
    korLang[2277] = "상대가 상태 이상이 되는 기술이나 씨뿌리기 등을 썼을 때 되받아친다.";
    korLang[2278] = "배틀 중에 사용하여 없어진 자신의 지닌 물건을 재생시켜 사용할 수 있게 한다.";
    korLang[2279] = "상대에게 기술을 받으면 그 상대에게 주는 데미지가 2배가 된다.";
    korLang[2280] = "수도로 기세 좋게 내려쳐서 상대를 공격한다. 빛의장막이나 리플렉터 등도 파괴할 수 있다.";
    korLang[2281] = "큰 하품으로 졸음을 유도한다. 다음 턴에 상대를 잠듦 상태로 만든다.";
    korLang[2282] = "상대의 지닌 물건을 탁 쳐서 떨어뜨려 배틀이 끝날 때까지 사용할 수 없게 한다. 물건을 가진 상대에게는 데미지를 더 준다.";
    korLang[2283] = "상대의 HP가 자신의 HP와 같아지도록 데미지를 준다.";
    korLang[2284] = "분노를 폭발시켜 상대를 공격한다. 자신의 HP가 적을수록 기술의 위력이 떨어진다.";
    korLang[2285] = "초능력으로 자신의 특성과 상대의 특성을 바꾼다.";
    korLang[2286] = "상대가 자신과 같은 기술을 배웠다면 상대만 그 기술을 사용할 수 없게 한다.";
    korLang[2287] = "몸을 쉬게 하여 자신이 입은 독, 마비, 화상의 상태 이상을 치료한다.";
    korLang[2288] = "상대의 기술로 기절하면 원념을 담아 그 기술의 PP를 0으로 만든다.";
    korLang[2289] = "상대가 사용하려고 한 회복 기술이나 능력 변화의 기술을 빼앗아 자신에게 쓴다.";
    korLang[2290] = "사용하는 장소에 따라 추가 효과가 변화하는 공격이다.";
    korLang[2291] = "1턴째에 잠수했다가 2턴째에 떠올라 공격한다.";
    korLang[2292] = "펼친 양손으로 상대를 번갈아 쳐서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2293] = "물가나 풀밭, 동굴 등 있는 장소에 맞춰서 자신의 타입을 바꾼다.";
    korLang[2294] = "깜빡거리는 빛을 바라보고 자신의 정신을 통일하여 특수공격을 매우 크게 올린다.";
    korLang[2295] = "눈부신 빛을 발산하여 공격한다. 상대의 특수방어를 떨어뜨릴 때가 있다.";
    korLang[2296] = "안개의 깃털로 둘러싸 공격한다. 상대의 특수공격을 떨어뜨릴 때가 있다.";
    korLang[2297] = "깃털을 흩뿌려 상대의 몸에 휘감는다. 상대의 공격을 크게 떨어뜨린다.";
    korLang[2298] = "흔들흔들 댄스를 춰서 주위에 있는 포켓몬을 혼란 상태로 만든다.";
    korLang[2299] = "공격한 상대를 화상 상태로 만들 때가 있다. 급소에도 맞기 쉽다.";
    korLang[2300] = "주위를 진흙투성이로 만든다. 5턴 동안 전기타입의 기술을 약하게 한다.";
    korLang[2301] = "5턴 동안 상대를 공격한다. 기술이 맞을 때마다 위력이 올라간다.";
    korLang[2302] = "바늘팔을 세차게 흔들어 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2303] = "게으름 피우며 쉰다. 자신의 HP를 최대 HP의 절반만큼 회복한다.";
    korLang[2304] = "시끄럽게 울리는 큰 진동을 상대에게 전달하여 공격한다.";
    korLang[2305] = "독이 있는 이빨로 상대를 물어서 공격한다. 맹독을 주입할 때가 있다.";
    korLang[2306] = "단단하고 날카로운 손톱으로 베어 갈라서 공격한다. 상대의 방어를 떨어뜨릴 때가 있다.";
    korLang[2307] = "폭발하는 불꽃으로 상대를 태워서 공격한다. 다음 턴은 움직일 수 없다.";
    korLang[2308] = "물의 대포를 상대에게 발사해서 공격한다. 다음 턴은 움직일 수 없다.";
    korLang[2309] = "혜성과 같은 펀치를 날려서 상대를 공격한다. 자신의 공격이 올라갈 때가 있다.";
    korLang[2310] = "큰 소리 등으로 불시에 놀래켜서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2311] = "사용했을 때의 날씨에 따라서 기술 타입과 위력이 바뀐다.";
    korLang[2312] = "기분 좋은 평온한 향기를 맡게 하여 같은 편 모두의 상태 이상을 회복한다.";
    korLang[2313] = "우는 척을 하며 눈물을 흘린다. 난처하게 만들어 상대의 특수방어를 크게 떨어뜨린다.";
    korLang[2314] = "날카로운 바람으로 상대를 베어 공격한다. 급소에 맞기 쉽다.";
    korLang[2315] = "풀 파워로 상대를 공격한다. 쓰면 반동으로 자신의 특수공격이 크게 떨어진다.";
    korLang[2316] = "고스트타입에 효과가 없는 기술이나 회피율이 높은 상대라 할지라도 공격이 맞게 된다.";
    korLang[2317] = "암석을 내던져서 공격한다. 상대의 움직임을 봉인함으로써 스피드를 떨어뜨린다.";
    korLang[2318] = "바람에 날개 가루를 날려서 상대를 공격한다. 자신의 모든 능력이 올라갈 때가 있다.";
    korLang[2319] = "금속을 긁을 때 나는 듯한 싫은 소리를 들려준다. 상대의 특수방어를 크게 떨어뜨린다.";
    korLang[2320] = "기분 좋은 피리 소리를 들려주어 상대를 잠듦 상태로 만든다.";
    korLang[2321] = "몸을 간질여 웃게 만들어서 상대의 공격과 방어를 떨어뜨린다.";
    korLang[2322] = "우주로부터 신비한 힘을 손에 넣음으로써 자신의 방어와 특수방어를 올린다.";
    korLang[2323] = "바닷물을 내뿜어 공격한다. 자신의 HP가 적을수록 기술의 위력이 떨어진다.";
    korLang[2324] = "이상한 빛을 발사해서 공격한다. 상대를 혼란시킬 때가 있다.";
    korLang[2325] = "그림자에 섞여 펀치를 날린다. 공격은 반드시 명중한다.";
    korLang[2326] = "보이지 않는 이상한 힘을 보내어 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2327] = "하늘을 향하는 듯한 높은 업퍼로 상대를 밀어올려 공격한다.";
    korLang[2328] = "세차게 불어대는 모래바람 속에 4-5턴 동안 상대를 가두어 공격한다.";
    korLang[2329] = "상대를 일격에 기절시킨다. 얼음타입 이외의 포켓몬이 사용하면 잘 맞지 않는다.";
    korLang[2330] = "탁해진 물을 상대에게 발사하여 공격한다. 명중률을 떨어뜨릴 때가 있다.";
    korLang[2331] = "씨앗을 기세 좋게 상대에게 발사하여 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2332] = "재빠른 움직임으로 상대를 농락해 벤다. 공격은 반드시 명중한다.";
    korLang[2333] = "날카로운 고드름을 상대에게 발사하여 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2334] = "피부를 쇠처럼 단단하게 만듦으로써 자신의 방어를 크게 올린다.";
    korLang[2335] = "양팔을 벌려 막아서서 상대의 도주로를 가로막아 도망칠 수 없게 한다.";
    korLang[2336] = "큰 소리로 짖고 기합을 높여 자신과 같은 편의 공격을 올린다.";
    korLang[2337] = "날카롭고 뾰족한 거대한 발톱으로 상대를 베어 갈라서 공격한다.";
    korLang[2338] = "큰 나무로 상대를 힘껏 쳐서 공격한다. 다음 턴은 움직일 수 없게 된다.";
    korLang[2339] = "몸에 힘을 담아 근육을 두껍게 해서 자신의 공격과 방어를 올린다.";
    korLang[2340] = "하늘 높이 뛰어올라 2턴째에 상대를 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2341] = "진흙 덩어리를 상대에게 내던져서 공격한다. 동시에 상대의 스피드를 떨어뜨린다.";
    korLang[2342] = "꼬리로 때린다. 독 상태로 만들 때가 있고 급소에도 맞기 쉽다.";
    korLang[2343] = "귀엽게 애교 부리며 상대에게 다가가 지니고 있는 도구를 뺏는다.";
    korLang[2344] = "전기를 한데 모아 돌진한다. 자신도 상당한 데미지를 입는다. 마비 상태로 만들 때가 있다.";
    korLang[2345] = "상대를 추적하는 이상한 잎사귀를 흩뿌린다. 공격은 반드시 명중한다.";
    korLang[2346] = "주위를 물로 흠뻑 젖게 만든다. 5턴 동안 불꽃타입의 기술을 약하게 한다.";
    korLang[2347] = "조용히 정신을 통일하고 마음을 가라앉혀서 자신의 특수공격과 특수방어를 올린다.";
    korLang[2348] = "잎사귀를 칼처럼 이용해 상대를 베어 공격한다. 급소에 맞기 쉽다.";
    korLang[2349] = "신비롭고 힘센 춤을 격렬하게 춘다. 자신의 공격과 스피드를 올린다.";
    korLang[2350] = "단단한 암석을 상대에게 발사하여 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2351] = "전격을 재빠르게 상대에게 날린다. 공격은 반드시 명중한다.";
    korLang[2352] = "물의 진동을 상대에게 가하여 공격한다. 상대를 혼란시킬 때가 있다.";
    korLang[2353] = "기술을 사용한 2턴 뒤에 무수한 빛의 다발이 상대를 공격한다.";
    korLang[2354] = "풀 파워로 상대를 공격한다. 쓰면 반동으로 자신의 특수공격이 크게 떨어진다.";
    korLang[2355] = "땅에 내려와 몸을 쉬게 한다. 최대 HP의 절반만큼 HP를 회복한다.";
    korLang[2356] = "5턴 동안 부유나 비행타입에 땅타입의 기술이 맞게 된다. 공중으로 나는 기술도 사용할 수 없다.";
    korLang[2357] = "악타입에 효과가 없는 기술이나 회피율이 높은 상대라 할지라도 공격이 맞게 된다.";
    korLang[2358] = "잠듦 상태의 상대에게 큰 데미지를 준다. 대신 상대는 잠에서 깬다.";
    korLang[2359] = "강하고 무거운 주먹을 휘둘러 데미지를 준다. 자신의 스피드가 떨어진다.";
    korLang[2360] = "몸을 고속으로 회전시켜 몸통박치기한다. 상대보다 스피드가 낮을수록 위력은 올라간다.";
    korLang[2361] = "자신은 기절하지만 교대하여 나오는 포켓몬의 상태 이상과 HP를 회복한다.";
    korLang[2362] = "상대가 HP의 절반 정도 상처를 입고 있으면 기술의 위력이 2배가 된다.";
    korLang[2363] = "나무열매에서 힘을 얻어 공격한다. 지니게 한 나무열매에 따라 기술의 타입과 위력이 바뀐다.";
    korLang[2364] = "방어나 판별 등을 하고 있는 상대에게 공격할 수 있다. 방어 효과를 해제시킨다.";
    korLang[2365] = "부리로 공격한다. 상대가 나무열매를 지니고 있을 때 먹어서 나무열매의 효과를 받을 수 있다.";
    korLang[2366] = "세차게 불어대는 바람의 소용돌이를 만들어 4턴 동안 같은 편 모두의 스피드를 올린다.";
    korLang[2367] = "경혈을 눌러 몸을 활성화시킨다. 능력 중 하나를 크게 올린다.";
    korLang[2368] = "기술을 쓰기 전에 마지막으로 받은 기술의 데미지를 늘려서 기술을 쓴 상대에게 돌려준다.";
    korLang[2369] = "공격한 뒤 굉장한 스피드로 돌아와서 교대 포켓몬과 교체한다.";
    korLang[2370] = "방어를 포기하고 상대 쪽으로 깊숙이 돌격한다. 자신의 방어와 특수방어가 떨어진다.";
    korLang[2371] = "모아서 공격한다. 상대보다 나중에 공격할 수 있으면 기술의 위력은 2배가 된다.";
    korLang[2372] = "그 턴에 상대가 이미 데미지를 입었다면 기술의 위력은 2배가 된다.";
    korLang[2373] = "지니게 한 도구를 5턴 동안 쓸 수 없게 한다. 트레이너도 그 포켓몬에게는 도구를 쓸 수 없다.";
    korLang[2374] = "지니게 한 도구를 재빠르게 내던져서 공격한다. 도구에 따라 위력과 효과가 바뀐다.";
    korLang[2375] = "초능력으로 암시를 걸어서 자신에게 걸려 있는 상태 이상을 상대에게 옮긴다.";
    korLang[2376] = "마지막수단의 남은 PP가 적으면 적을수록 기술의 위력이 올라간다.";
    korLang[2377] = "5턴 동안 기술이나 특성, 지니고 있는 도구에 의한 HP 회복을 할 수 없게 한다.";
    korLang[2378] = "강하게 조여 공격을 한다. 상대의 HP가 많이 남아 있을수록 위력이 올라간다.";
    korLang[2379] = "초능력으로 자신의 공격과 방어의 힘을 교환한다.";
    korLang[2380] = "상대의 몸에 위액을 내뱉는다. 달라붙은 위액은 상대의 특성 효과를 지운다.";
    korLang[2381] = "하늘을 향해 기도를 올려 5턴 동안 상대의 공격을 급소에 맞지 않게 한다.";
    korLang[2382] = "위력을 올려 상대가 쓰려고 하는 기술을 먼저 쓴다. 먼저 쓰지 않으면 실패한다.";
    korLang[2383] = "직전에 나온 기술을 흉내 내어 같은 기술을 쓴다. 기술이 나오지 않았으면 실패한다.";
    korLang[2384] = "초능력으로 자신과 상대의 공격과 특수공격의 능력 변화를 교체한다.";
    korLang[2385] = "초능력으로 자신과 상대의 방어와 특수방어의 능력 변화를 교체한다.";
    korLang[2386] = "능력 변화로 상대가 파워업한 만큼 기술의 위력이 올라간다.";
    korLang[2387] = "배틀 중에 기억하고 있는 기술을 모두 사용하면 그때부터 쓸 수 있는 필살기이다.";
    korLang[2388] = "마음을 괴롭히는 씨앗을 심는다. 상대를 잠잘 수 없게 해서 특성을 불면으로 만든다.";
    korLang[2389] = "상대보다 먼저 공격할 수 있다. 상대가 쓴 기술이 공격기술이 아니면 실패한다.";
    korLang[2390] = "상대의 발밑에 독 압정을 뿌린다. 교체로 나온 상대 포켓몬에게 독을 퍼지게 한다.";
    korLang[2391] = "초능력으로 자신과 상대에 걸려 있는 능력 변화를 교체한다.";
    korLang[2392] = "자신의 몸 주변을 물로 만든 베일로 덮는다. 매 턴 HP를 회복한다.";
    korLang[2393] = "전기로 만든 자력의 힘으로 허공에 뜬다. 5턴 동안 부유할 수 있다.";
    korLang[2394] = "불꽃을 두르고 돌진한다. 자신도 상당한 데미지를 입는다. 화상 상태로 만들 때가 있다.";
    korLang[2395] = "상대의 몸에 충격파를 부딪쳐 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2396] = "몸속에서 파동의 힘을 끌어내 상대에게 쏜다. 공격은 반드시 명중한다.";
    korLang[2397] = "자신의 몸을 갈아 공기의 저항을 적게 한다. 스피드를 크게 올릴 수 있다.";
    korLang[2398] = "독에 물든 촉수나 팔로 상대를 꿰찌른다. 독 상태로 만들 때가 있다.";
    korLang[2399] = "몸에서 악의로 가득한 무서운 오라를 발한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2400] = "순간적으로 틈을 노려 상대를 베어 버린다. 급소에 맞기 쉽다.";
    korLang[2401] = "세차게 날뛰는 거친 파도와 같이 큰 꼬리를 흔들어서 상대를 공격한다.";
    korLang[2402] = "단단한 껍질을 가지고 있는 큰 씨앗을 위에서 힘껏 내던져 상대를 공격한다.";
    korLang[2403] = "하늘까지 베어 가르는 공기의 칼날로 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2404] = "낫이나 발톱을 가위처럼 교차시키면서 상대를 베어 가른다.";
    korLang[2405] = "진동으로 음파를 일으켜서 공격한다. 상대의 특수방어를 떨어뜨릴 때가 있다.";
    korLang[2406] = "큰 입으로 충격파를 일으켜서 상대를 공격한다.";
    korLang[2407] = "굉장한 살기로 위압하면서 몸통박치기한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2408] = "보석처럼 반짝이는 빛을 발사하여 상대를 공격한다.";
    korLang[2409] = "주먹으로 상대의 힘을 흡수한다. 입힌 데미지의 절반에 해당하는 HP를 회복할 수 있다.";
    korLang[2410] = "주먹을 흔들어 진공의 파도를 일으킨다. 반드시 선제공격을 할 수 있다.";
    korLang[2411] = "기합을 높여서 혼신의 힘을 방출한다. 상대의 특수방어를 떨어뜨릴 때가 있다.";
    korLang[2412] = "자연으로부터 모은 생명의 힘을 발사한다. 상대의 특수방어를 떨어뜨릴 때가 있다.";
    korLang[2413] = "날개를 접어 저공비행으로 돌격한다. 자신도 상당한 데미지를 입는다.";
    korLang[2414] = "상대의 발밑에 대지의 힘을 방출한다. 상대의 특수방어를 떨어뜨릴 때가 있다.";
    korLang[2415] = "눈에 보이지 않는 속도로 자신과 상대가 지닌 물건을 교환한다.";
    korLang[2416] = "가진 힘을 모두 사용해서 상대에게 돌격한다. 다음 턴은 움직일 수 없다.";
    korLang[2417] = "나쁜 일을 생각해서 머리를 활성화시킨다. 자신의 특수공격을 크게 올린다.";
    korLang[2418] = "탄환처럼 빠르고 단단한 펀치를 상대에게 날린다. 반드시 선제공격을 할 수 있다.";
    korLang[2419] = "상대로부터 기술을 받으면 그 상대에 대해서 기술의 위력이 2배가 된다.";
    korLang[2420] = "얼음덩어리를 순식간에 만들어 상대에게 빠르게 쏜다. 반드시 선제공격을 할 수 있다.";
    korLang[2421] = "그림자로 만든 날카로운 발톱으로 상대를 베어 가른다. 급소에 맞기 쉽다.";
    korLang[2422] = "전기를 모은 이빨로 문다. 상대를 풀죽게 하거나 마비 상태로 만들 때가 있다.";
    korLang[2423] = "냉기를 품은 이빨로 문다. 상대를 풀죽게 하거나 얼음 상태로 만들 때가 있다.";
    korLang[2424] = "불꽃을 두른 이빨로 문다. 상대를 풀죽게 하거나 화상 상태로 만들 때가 있다.";
    korLang[2425] = "그림자를 늘려 상대의 배후에서 공격한다. 반드시 선제공격할 수 있다.";
    korLang[2426] = "단단한 진흙구슬을 상대에게 발사하여 공격한다. 명중률을 떨어뜨릴 때가 있다.";
    korLang[2427] = "실체화시킨 마음의 칼날로 상대를 베어 가른다. 급소에 맞기 쉽다.";
    korLang[2428] = "사념의 힘을 이마에 모아서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2429] = "갈고닦은 몸에서 섬광의 힘을 상대에게 쏜다. 명중률을 떨어뜨릴 때가 있다.";
    korLang[2430] = "몸의 빛을 한곳에 모아서 힘을 방출한다. 상대의 특수방어를 떨어뜨릴 때가 있다.";
    korLang[2431] = "굉장한 기세로 상대에게 돌진하여 공격한다. 상대를 혼란시킬 때가 있다.";
    korLang[2432] = "강한 바람으로 상대의 리플렉터나 빛의장막 등을 제거한다. 회피율도 떨어뜨린다.";
    korLang[2433] = "이상한 공간을 만든다. 5턴 동안 느린 포켓몬부터 행동할 수 있다.";
    korLang[2434] = "천공에서 운석을 상대에게 떨어뜨린다. 사용하면 반동으로 자신의 특수공격이 크게 떨어진다.";
    korLang[2435] = "눈부신 전격으로 자신의 주위에 있는 포켓몬을 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2436] = "새빨간 불꽃으로 자신의 주위에 있는 포켓몬을 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2437] = "뾰족한 잎사귀로 상대에게 돌풍을 일으킨다. 사용하면 반동으로 자신의 특수공격이 크게 떨어진다.";
    korLang[2438] = "덩굴이나 촉수를 세차게 흔들어 상대를 힘껏 쳐서 공격한다.";
    korLang[2439] = "거대한 바위를 상대에게 발사하여 공격한다. 다음 턴은 움직일 수 없게 된다.";
    korLang[2440] = "독 칼날로 상대를 베어 가른다. 독 상태로 만들 때가 있고 급소에도 맞기 쉽다.";
    korLang[2441] = "더러운 쓰레기를 상대에게 부딪쳐서 공격한다. 독 상태로 만들 때가 있다.";
    korLang[2442] = "강철과 같은 단단한 머리로 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2443] = "상대에게 달라붙는 강철의 폭탄을 발사한다. 공격은 반드시 명중한다.";
    korLang[2444] = "뾰족한 바위를 상대에게 꿰찔러서 공격한다. 급소에 맞기 쉽다.";
    korLang[2445] = "수컷은 암컷을 암컷은 수컷을 유혹하여 상대의 특수공격을 크게 떨어뜨린다.";
    korLang[2446] = "상대의 주위에 무수한 바위를 띄워 교체해서 나온 상대 포켓몬에게 데미지를 준다.";
    korLang[2447] = "풀을 휘감아서 상대를 쓰러뜨린다. 상대가 무거울수록 위력이 올라간다.";
    korLang[2448] = "매우 시끄럽고 수다스러운 음파로 상대를 공격한다. 상대를 혼란시킨다.";
    korLang[2449] = "무수한 광탄을 상대에게 방출한다. 자신이 가지고 있는 플레이트에 따라 타입이 바뀐다.";
    korLang[2450] = "물어서 공격한다. 상대가 나무열매를 지니고 있을 때 먹어서 나무열매의 효과를 받을 수 있다.";
    korLang[2451] = "전격의 다발을 상대에게 발사한다. 전기를 모아서 자신의 특수공격을 올릴 때가 있다.";
    korLang[2452] = "단단한 몸통을 상대에게 부딪쳐서 공격한다. 자신도 상당한 데미지를 입는다.";
    korLang[2453] = "눈에 보이지 않는 굉장한 속도로 상대에게 돌진한다. 반드시 선제공격할 수 있다.";
    korLang[2454] = "부하를 불러내어 상대를 향해서 공격시킨다. 급소에 맞기 쉽다.";
    korLang[2455] = "부하를 불러내어 자신의 몸을 뒤덮게 한다. 방어와 특수방어를 올릴 수 있다.";
    korLang[2456] = "부하를 불러내어 상처를 회복한다. 최대 HP의 절반만큼 자신의 HP를 회복한다.";
    korLang[2457] = "목숨을 걸고 혼신의 힘으로 상대에게 박치기를 한다. 자신도 굉장한 데미지를 입는다.";
    korLang[2458] = "꼬리 등을 써서 상대를 때려 공격한다. 2회 연속으로 데미지를 준다.";
    korLang[2459] = "시간이 뒤틀릴 정도의 힘을 사용해서 상대를 공격한다. 다음 턴은 움직일 수 없다.";
    korLang[2460] = "주위의 공간과 더불어 상대를 찢어서 데미지를 준다. 급소에 맞기 쉽다.";
    korLang[2461] = "자신은 기절하지만 교대하여 나오는 포켓몬의 모든 상태를 회복한다.";
    korLang[2462] = "굉장한 힘으로 상대를 묵사발로 만든다. 상대의 HP가 남아 있을수록 위력이 올라간다.";
    korLang[2463] = "세차게 타오르는 불꽃 속에 4-5턴 동안 상대를 가두어 공격한다.";
    korLang[2464] = "암흑의 세계로 끌고 가서 떨어뜨려 상대를 잠듦 상태로 만든다.";
    korLang[2465] = "몸속에서 충격파를 발생시킨다. 상대의 특수방어를 크게 떨어뜨릴 때가 있다.";
    korLang[2466] = "소름이 끼칠 만한 돌풍으로 상대를 공격한다. 자신의 모든 능력이 올라갈 때가 있다.";
    korLang[2467] = "1턴째에 모습을 감춰 2턴째에 상대를 공격한다. 방어하고 있어도 공격은 맞는다.";
    korLang[2468] = "손톱을 갈아 날카롭게 한다. 자신의 공격과 명중률을 올린다.";
    korLang[2469] = "같은 편 전원에게 향하는 공격을 1턴 동안 막는다.";
    korLang[2470] = "초능력으로 자신과 상대의 방어와 특수방어를 더해서 반으로 나눈다.";
    korLang[2471] = "초능력으로 자신과 상대의 공격과 특수공격을 더해서 반으로 나눈다.";
    korLang[2472] = "이상한 공간을 만든다. 5턴 동안 모든 포켓몬의 방어와 특수방어가 바뀐다.";
    korLang[2473] = "이상한 염력파를 실체화하여 상대를 공격한다. 물리적인 데미지를 준다.";
    korLang[2474] = "특수한 독액을 끼얹는다. 독 상태의 상대에게는 위력이 2배가 된다.";
    korLang[2475] = "몸의 쓸모없는 부분을 깎는다. 자신의 스피드를 크게 올리고 체중도 가벼워진다.";
    korLang[2476] = "안절부절못하게 하는 가루를 자신에게 뿌려서 주의를 끈다. 상대의 공격은 모두 자신에게 향한다.";
    korLang[2477] = "초능력으로 상대를 띄운다. 3턴 동안 공격이 상대에게 맞기 쉬워진다.";
    korLang[2478] = "이상한 공간을 만든다. 5턴 동안 모든 포켓몬의 도구의 효과가 사라진다.";
    korLang[2479] = "돌이나 구슬을 던져서 날고 있는 상대를 공격한다. 맞은 상대는 땅에 떨어진다.";
    korLang[2480] = "강렬한 일격을 상대에게 날린다. 공격은 반드시 급소에 맞는다.";
    korLang[2481] = "맞으면 튀는 불꽃으로 상대를 공격한다. 튕긴 불꽃은 옆의 상대에게도 쏟아진다.";
    korLang[2482] = "오물 파도로 자신의 주위에 있는 포켓몬을 공격한다. 독 상태로 만들 때가 있다.";
    korLang[2483] = "신비롭고 아름다운 춤을 경쾌하게 춘다. 자신의 특수공격과 특수방어와 스피드를 올린다.";
    korLang[2484] = "무거운 몸으로 상대에게 부딪쳐 공격한다. 자신이 상대보다 무거울수록 위력이 올라간다.";
    korLang[2485] = "이상한 전파로 주위에 있는 자신과 같은 타입의 포켓몬에게 데미지를 준다.";
    korLang[2486] = "전기 덩어리를 상대에게 부딪쳐서 공격한다. 상대보다 스피드가 빠를수록 위력이 올라간다.";
    korLang[2487] = "많은 물을 끼얹어서 상대를 물타입으로 바꾼다.";
    korLang[2488] = "불꽃을 둘러 상대를 공격한다. 힘을 모아서 자신의 스피드를 올린다.";
    korLang[2489] = "똬리를 틀어서 집중한다. 자신의 공격과 방어와 명중률을 올린다.";
    korLang[2490] = "재빠른 움직임으로 상대의 다리를 노려 공격한다. 상대의 스피드를 떨어뜨린다.";
    korLang[2491] = "상대를 녹이는 액체를 토해내서 공격한다. 상대의 특수방어를 크게 떨어뜨린다.";
    korLang[2492] = "상대의 힘을 이용한다. 싸우고 있는 상대의 공격이 높을수록 데미지가 올라간다.";
    korLang[2493] = "수수께끼의 염력파를 상대에게 보낸다. 염력파를 받은 상대는 특성이 단순으로 바뀐다.";
    korLang[2494] = "이상한 리듬으로 춤춘다. 움직임을 흉내 내게 해서 자신과 상대의 특성을 똑같게 만든다.";
    korLang[2495] = "상대의 행동을 도와서 자신이 행동한 뒤에 바로 움직일 수 있도록 한다.";
    korLang[2496] = "노래로 상대를 공격한다. 함께 돌림노래를 하면 계속해서 쓸 수 있고 위력도 올라간다.";
    korLang[2497] = "울리는 목소리로 상대를 공격한다. 매 턴 누군가 이 기술을 계속해서 쓰면 위력이 올라간다.";
    korLang[2498] = "틈을 보며 착실하게 공격한다. 상대의 능력 변화에 관계없이 데미지를 준다.";
    korLang[2499] = "특수한 진흙 덩어리를 상대에게 내던져서 공격한다. 능력 변화를 원래대로 돌린다.";
    korLang[2500] = "축적된 파워로 상대를 공격한다. 자신의 능력이 올라가 있는 만큼 위력이 오른다.";
    korLang[2501] = "자신과 같은 편을 상대의 선제공격으로부터 지킨다.";
    korLang[2502] = "이상한 힘으로 순간이동하여 자신과 같은 편의 위치를 바꾼다.";
    korLang[2503] = "뜨겁게 끓어오르는 물을 상대에게 발사해서 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2504] = "껍질을 깨서 자신의 방어와 특수방어를 떨어뜨리지만 공격과 특수공격, 스피드를 크게 올린다.";
    korLang[2505] = "치유파동을 날려서 최대 HP의 절반만큼 상대의 HP를 회복한다.";
    korLang[2506] = "엎친 데 덮친 격으로 공격한다. 상태 이상인 상대에게 큰 데미지를 준다.";
    korLang[2507] = "1턴째에 상대를 하늘로 끌고 가서 2턴째에 떨어뜨려 공격한다. 끌려간 상대는 움직일 수 없다.";
    korLang[2508] = "톱니바퀴를 돌려서 자신의 공격을 올리는 것뿐만 아니라 스피드도 크게 올린다.";
    korLang[2509] = "상대를 내던져서 교대할 포켓몬을 끌어낸다. 야생의 경우에는 배틀이 끝난다.";
    korLang[2510] = "불꽃으로 상대를 공격한다. 상대가 나무열매 등을 지니고 있을 때 불태워서 쓸 수 없게 만든다.";
    korLang[2511] = "상대를 억눌러서 행동의 순서를 마지막으로 만든다.";
    korLang[2512] = "경쾌하게 상대를 공격한다. 자신이 도구를 지니고 있지 않을 때 큰 데미지를 준다.";
    korLang[2513] = "상대의 타입을 반사해서 자신도 똑같은 타입이 된다.";
    korLang[2514] = "쓰러진 같은 편의 원수를 갚는다. 앞 턴에서 같은 편이 쓰러지면 위력이 올라간다.";
    korLang[2515] = "목숨을 걸고 상대를 공격한다. 자신은 기절하게 되지만 상대에게 HP만큼의 데미지를 준다.";
    korLang[2516] = "상대가 도구를 지니고 있지 않을 때 자신이 지니고 있는 도구를 상대에게 건넨다.";
    korLang[2517] = "격렬한 불꽃으로 상대를 둘러싸 공격한다. 화상 상태로 만든다.";
    korLang[2518] = "물기둥으로 공격한다. 불꽃과 조합하면 위력이 올라가고 하늘에 무지개가 걸린다.";
    korLang[2519] = "불꽃기둥으로 공격한다. 풀과 조합하면 위력이 올라가고 주위가 불바다가 된다.";
    korLang[2520] = "풀기둥으로 공격한다. 물과 조합하면 위력이 올라가고 주변이 습지초원이 된다.";
    korLang[2521] = "공격한 뒤 굉장한 스피드로 돌아와서 교대 포켓몬과 교체한다.";
    korLang[2522] = "저항해서 상대를 공격한다. 상대의 특수공격을 떨어뜨린다.";
    korLang[2523] = "땅을 힘껏 밟아 자신의 주위에 있는 포켓몬을 공격한다. 상대의 스피드를 떨어뜨린다.";
    korLang[2524] = "차가운 숨결을 상대에게 내뿜어 공격한다. 반드시 급소에 맞는다.";
    korLang[2525] = "상대를 튕겨내서 교대할 포켓몬을 끌어낸다. 야생의 경우에는 배틀이 끝난다.";
    korLang[2526] = "스스로 분발해서 공격과 특수공격을 올린다.";
    korLang[2527] = "전기 네트로 상대를 붙잡아서 공격한다. 상대의 스피드를 떨어뜨린다.";
    korLang[2528] = "전기를 두르고 상대에게 부딪쳐 공격한다. 자신도 조금 데미지를 입는다.";
    korLang[2529] = "드릴처럼 몸을 회전시켜서 상대에게 몸통박치기한다. 급소에 맞기 쉽다.";
    korLang[2530] = "몸의 단단한 부분으로 상대를 때려 공격한다. 2회 연속으로 데미지를 준다.";
    korLang[2531] = "귀여운 모습으로 방심시켜서 강렬한 일격을 날린다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2532] = "뿔을 꿰찔러서 상대의 양분을 흡수한다. 입힌 데미지의 절반에 해당하는 HP를 회복할 수 있다.";
    korLang[2533] = "긴 뿔로 베어 공격한다. 상대의 능력 변화에 관계없이 데미지를 준다.";
    korLang[2534] = "날카로운 조개껍질로 베어 공격한다. 상대의 방어를 떨어뜨릴 때가 있다.";
    korLang[2535] = "불타는 몸으로 상대에게 부딪쳐서 공격한다. 자신이 상대보다 무거울수록 위력이 올라간다.";
    korLang[2536] = "날카로운 잎사귀로 상대를 둘러싸서 공격한다. 명중률을 떨어뜨릴 때가 있다.";
    korLang[2537] = "둥글게 뭉친 몸을 회전하여 상대를 뭉개 버린다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2538] = "푹신푹신한 솜털로 자신의 몸을 둘러싸서 지킨다. 방어를 매우 크게 올린다.";
    korLang[2539] = "암흑의 충격파를 날려서 상대를 공격한다. 명중률을 떨어뜨릴 때가 있다.";
    korLang[2540] = "이상한 염력파를 실체화하여 상대를 공격한다. 물리적인 데미지를 준다.";
    korLang[2541] = "단단한 꼬리로 상대를 때려서 공격한다. 2-5회 동안 연속으로 쓴다.";
    korLang[2542] = "강렬한 바람으로 상대를 둘러싸서 공격한다. 상대를 혼란시킬 때가 있다.";
    korLang[2543] = "굉장한 아프로 머리로 상대에게 돌진하여 공격한다. 자신도 조금 데미지를 입는다.";
    korLang[2544] = "강철의 기어를 상대에게 던져서 공격한다. 2회 연속으로 데미지를 준다.";
    korLang[2545] = "새빨간 불꽃으로 자신의 주위에 있는 포켓몬을 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2546] = "광탄을 상대에게 방출한다. 자신이 지니고 있는 카세트에 의해 타입이 바뀐다.";
    korLang[2547] = "옛 노래를 상대에게 들려주고 마음에 호소하여 공격한다. 잠듦 상태로 만들 때가 있다.";
    korLang[2548] = "긴 뿔로 베어 공격한다. 뿔이 머금은 이상한 힘은 물리적인 데미지를 준다.";
    korLang[2549] = "차가운 냉기를 상대에게 내뿜어 공격한다. 상대의 스피드를 떨어뜨린다.";
    korLang[2550] = "방대한 전기를 몸에 둘러 상대에게 돌진해서 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2551] = "아름다우면서도 격렬한 푸른불꽃으로 상대를 둘러싸서 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2552] = "불꽃을 두른 날개를 쳐서 공격한다. 자신의 특수공격이 오를 때가 있다.";
    korLang[2553] = "전기를 두른 얼음덩어리로 2턴째에 상대를 내리친다. 마비 상태로 만들 때가 있다.";
    korLang[2554] = "모든 것을 얼려버리는 격렬한 냉기로 2턴째에 상대를 둘러싼다. 화상 상태로 만들 때가 있다.";
    korLang[2555] = "호되게 호통을 쳐서 상대의 특수공격을 떨어뜨린다.";
    korLang[2556] = "큰 고드름을 격렬하게 부딪쳐서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2557] = "작열하는 불꽃을 이마에서 발생시켜 이판사판으로 몸통박치기한다. 방어, 특수방어, 스피드가 떨어진다.";
    korLang[2558] = "거대한 불꽃을 내리친다. 거대한 천둥의 영향을 받아 기술의 위력이 올라간다.";
    korLang[2559] = "거대한 천둥을 내리친다. 거대한 불꽃의 영향을 받아 기술의 위력이 올라간다.";
    korLang[2560] = "공중에서 상대에게 다이브한다. 이 기술은 격투타입임과 동시에 비행타입이기도 하다.";
    korLang[2561] = "뒤집어 세운 마룻바닥을 방패로 하여 자신과 같은 편으로 향하는 기술 데미지를 막는다. 변화 기술은 막을 수 없다.";
    korLang[2562] = "상대를 향해 트림을 하여 데미지를 준다. 나무열매를 먹지 않으면 쓸 수 없다.";
    korLang[2563] = "땅을 일구어 초목이 자라기 쉽게 한다. 풀타입의 공격과 특수공격이 오른다.";
    korLang[2564] = "상대의 주위에 끈적끈적한 네트를 둘러 펼쳐 교체되어 나온 상대의 스피드를 떨어뜨린다.";
    korLang[2565] = "이 기술을 사용하여 상대를 쓰러뜨리면 공격이 매우 크게 오른다.";
    korLang[2566] = "1턴째에 어디론가 사라져서 2턴째에 상대를 공격한다. 기술 방어를 무시하고 공격할 수 있다.";
    korLang[2567] = "상대를 핼러윈으로 초대한다. 상대 타입에 고스트타입이 추가된다.";
    korLang[2568] = "우렁차게 부르짖어서 상대를 위협하여 상대의 공격과 특수공격을 떨어뜨린다.";
    korLang[2569] = "전기를 띤 입자를 확산시켜 노말타입 기술을 전기타입으로 바꿔버린다.";
    korLang[2570] = "주위에 있는 모든 포켓몬에게 데미지를 준다. 준 데미지의 절반을 자신이 회복한다.";
    korLang[2571] = "상대에게 숲의 저주를 건다. 저주에 걸린 상대는 타입에 풀타입이 추가된다.";
    korLang[2572] = "세찬 꽃보라를 일으켜서 주위에 있는 포켓몬을 공격하여 데미지를 준다.";
    korLang[2573] = "상대를 급격히 차갑게 하여 얼음 상태로 만들 때가 있다. 물타입 포켓몬에게도 효과가 굉장해진다.";
    korLang[2574] = "매혹적인 울음소리를 내어 상대에게 정신적 데미지를 준다. 공격은 반드시 명중한다.";
    korLang[2575] = "막말을 내뱉어 상대를 위협하여 공격과 특수공격을 떨어뜨린 후 교대 포켓몬과 교체한다.";
    korLang[2576] = "상대에게 걸려 있는 모든 능력 변화를 뒤집어서 반대로 만든다.";
    korLang[2577] = "키스로 상대의 HP를 흡수한다. 준 데미지의 반 이상 HP를 회복한다.";
    korLang[2578] = "이상한 힘을 사용하여 같은 편을 공격하는 변화 기술을 막는다. 데미지 기술은 받는다.";
    korLang[2579] = "이상한 힘을 사용하여 배틀에 나와 있는 모든 풀타입 포켓몬의 방어를 올린다.";
    korLang[2580] = "5턴 동안 그래스필드로 만든다. 땅에 있으면 매 턴 회복한다. 풀타입의 위력이 올라간다.";
    korLang[2581] = "5턴 동안 땅에 있으면 상태 이상이 되지 않고 드래곤타입 기술의 데미지도 절반이 된다.";
    korLang[2582] = "상대가 기술을 쓰기 전에 송전하면 그 턴에 상대가 사용하는 기술은 전기타입이 된다.";
    korLang[2583] = "상대에게 치근거리며 공격한다. 상대의 공격을 떨어뜨릴 때가 있다.";
    korLang[2584] = "요정의 바람을 일으켜 상대에게 몰아쳐서 공격한다.";
    korLang[2585] = "달의 파워를 빌려서 상대를 공격한다. 상대의 특수공격을 떨어뜨릴 때가 있다.";
    korLang[2586] = "무시무시한 폭음의 파괴력으로 주위에 있는 포켓몬을 공격한다.";
    korLang[2587] = "록을 걸어 다음 턴의 모든 포켓몬을 도망가지 못하게 한다.";
    korLang[2588] = "상대의 공격을 막음과 동시에 방어 태세를 갖춘다. 접촉한 상대의 공격을 떨어뜨린다.";
    korLang[2589] = "상대와 친해져서 싸울 마음을 잃게 하여 상대의 공격을 떨어뜨린다.";
    korLang[2590] = "비밀 이야기를 해서 상대의 집중력을 잃게 하여 특수공격을 떨어뜨린다.";
    korLang[2591] = "다이아 폭풍을 일으켜 데미지를 준다. 자신의 방어를 크게 올릴 때가 있다.";
    korLang[2592] = "상대에게 굉장히 뜨거운 증기를 뿜는다. 상대는 화상을 입기도 한다.";
    korLang[2593] = "다른차원홀로 갑자기 상대 바로 옆에 나타나 공격한다. 방어나 판별 등도 무시할 수 있다.";
    korLang[2594] = "점액으로 만든 수리검을 2-5회 동안 연속으로 던진다. 반드시 선제공격할 수 있다.";
    korLang[2595] = "입에서 내뱉는 아주 뜨거운 불꽃으로 공격한다. 상대의 특수공격을 떨어뜨린다.";
    korLang[2596] = "상대의 공격을 막음과 동시에 접촉한 상대의 체력을 떨어뜨린다.";
    korLang[2597] = "신비한 아로마 향으로 같은 편의 특수방어를 올린다.";
    korLang[2598] = "몸에서 발생시킨 괴전파를 상대에게 쏘아 특수공격을 크게 떨어뜨린다.";
    korLang[2599] = "특수한 독액을 끼얹는다. 독 상태인 상대는 공격, 특수공격, 스피드가 떨어진다.";
    korLang[2600] = "분진을 뒤집어쓴 상대가 불꽃 기술을 쓰면 폭발하여 데미지를 준다.";
    korLang[2601] = "1턴째에 에너지를 흡수하여 2턴째에 특수공격, 특수방어, 스피드를 크게 올린다.";
    korLang[2602] = "자기장 조작으로 인해 특성 플러스와 마이너스의 방어, 특수방어가 오른다.";
    korLang[2603] = "해피타임 기술을 쓰면 배틀 후에 받을 수 있는 돈이 배가 된다.";
    korLang[2604] = "5턴 동안 일렉트릭필드로 만든다. 땅에 있는 포켓몬은 잠들지 않는다. 전기타입의 위력이 올라간다.";
    korLang[2605] = "강력한 빛을 내어 상대에게 데미지를 준다.";
    korLang[2606] = "포켓몬이 매우 행복한 당신을 축하해 준다.";
    korLang[2607] = "같은 편 포켓몬끼리 손에 손을 잡는다. 굉장히 행복한 기분이 들게 된다.";
    korLang[2608] = "초롱초롱한 눈동자로 상대를 바라보며 공격을 떨어뜨린다. 반드시 선제공격할 수 있다.";
    korLang[2609] = "전기가 흐르는 볼을 비벼서 공격한다. 상대를 마비 상태로 만든다.";
    korLang[2610] = "적당히 공격하여 상대의 HP를 반드시 1은 남긴다.";
    korLang[2611] = "4-5턴 동안 상대에게 엉겨 붙어서 공격한다. 그동안 상대는 도망갈 수 없다.";
    korLang[2612] = "반복하여 때리면 점점 주먹이 단단해진다. 상대를 때리면 공격이 오른다.";
    korLang[2613] = "조준한 상대로부터 HP를 흡수한다. 준 데미지의 반 이상 HP를 회복한다.";
    korLang[2614] = "떠 있는 포켓몬도 맞힐 수 있다. 떠 있던 상대는 맞아서 땅에 떨어진다.";
    korLang[2615] = "땅 위를 뻗어 나가는 파도로 공격한다. 파도에 휩쓸린 상대는 전투에서 도망칠 수 없게 된다.";
    korLang[2616] = "대지의 힘을 모으고 그 힘을 상대에게 집중시켜서 데미지를 준다.";
    korLang[2617] = "영원의 꽃의 파워를 빌려서 강력한 광선을 쏜다. 자신도 상당한 데미지를 입는다.";
    korLang[2618] = "파랗게 빛나는 무수한 광선으로 상대를 공격한다.";
    korLang[2619] = "대지의 힘을 칼날로 바꿔 상대를 공격한다.";
    korLang[2620] = "넓은 하늘에서 급속으로 강하하여 상대를 공격한다. 자신의 방어와 특수방어가 떨어진다.";
    korLang[2621] = "많은 팔로 방어와 판별 등을 무시하는 연속 공격이다. 자신의 방어가 떨어진다.";
    korLang[2659] = "자신의 최대 HP 절반을 회복한다. 모래바람일 때는 많이 회복한다.";
    korLang[2660] = "위력이 높은 기술이지만 배틀에 나가서 바로 쓰지 않으면 성공할 수 없다.";
    korLang[2661] = "상대의 공격을 막음과 동시에 접촉한 상대에게 독을 퍼뜨린다.";
    korLang[2662] = "공격과 동시에 상대의 그림자를 꿰매 도망칠 수 없게 한다.";
    korLang[2663] = "양팔을 돌려 상대에게 부딪친다. 상대의 능력 변화에 상관없이 데미지를 준다.";
    korLang[2664] = "노래 부르는 것으로 많은 벌룬을 방출한다. 기술에 맞으면 화상이 낫는다.";
    korLang[2665] = "강하고 무거운 주먹을 휘둘러 데미지를 준다. 자신의 스피드가 떨어진다.";
    korLang[2666] = "최대 HP의 절반만큼 상대의 HP를 회복한다. 그래스필드일 때 효과가 올라간다.";
    korLang[2667] = "온몸을 써서 상대에게 맹렬히 어택한다.";
    korLang[2668] = "상대 공격력과 동일하게 자신의 HP를 회복한다. 그리고 상대의 공격을 떨어뜨린다.";
    korLang[2669] = "1턴째에 빛을 가득 모아 2턴째에 그 힘을 검에 담아 공격한다.";
    korLang[2670] = "잎을 상대에 맞춰 공격한다.";
    korLang[2671] = "포켓몬에게 스포트라이트를 비춰 그 턴에서 그 포켓몬만 공격할 수 있게 한다.";
    korLang[2672] = "독이 섞인 실을 뿜어낸다. 상대를 독 상태로 만들고 스피드를 떨어뜨린다.";
    korLang[2673] = "정신을 집중해서 다음 공격을 반드시 급소에 맞춘다.";
    korLang[2674] = "기어를 넣는 것으로 특성 플러스와 마이너스의 공격과 특수공격이 올라간다.";
    korLang[2675] = "이 기술에 맞은 상대는 지옥의 고통 때문에 2턴 동안 소리 기술을 낼 수 없다.";
    korLang[2676] = "상대에게는 폭발하는 경단을 사용하여 공격한다. 같은 편에게는 회복하는 경단을 준다.";
    korLang[2677] = "앵커를 상대에게 휘감아서 공격한다. 상대는 도망칠 수 없게 된다.";
    korLang[2678] = "5턴 동안 땅에 있으면 선제공격을 받지 않는다. 에스퍼타입의 위력이 올라간다.";
    korLang[2679] = "전력으로 상대에게 덤벼들며 공격한다. 상대의 공격을 떨어뜨린다.";
    korLang[2680] = "불타는 채찍으로 상대를 친다. 공격을 받은 상대는 방어가 떨어진다.";
    korLang[2681] = "자신의 강함을 뻐기고 공격한다. 자신의 능력이 올라가 있는 만큼 위력이 오른다.";
    korLang[2682] = "전신의 불꽃을 모두 태워서 큰 데미지를 준다. 자신의 불꽃타입이 없어진다.";
    korLang[2683] = "상대의 스피드와 자신의 스피드를 교체한다.";
    korLang[2684] = "뾰족한 뿔로 상대를 꿰찔러서 공격한다. 공격은 반드시 명중한다.";
    korLang[2685] = "상대의 상태 이상을 회복한다. 회복하면 자신은 HP를 회복할 수 있다.";
    korLang[2686] = "전력으로 춤추며 공격한다. 이 기술의 타입은 자신의 타입과 같아진다.";
    korLang[2687] = "데미지를 준 상대가 이미 행동을 끝냈다면 상대의 특성을 없애버린다.";
    korLang[2688] = "남쪽 나라에서 유래된 뜨거운 킥을 상대에게 날린다. 상대의 공격을 떨어뜨린다.";
    korLang[2689] = "상대에게 지시하여 상대가 쓴 기술을 다시 한번 쓰게 할 수 있다.";
    korLang[2690] = "먼저 부리를 가열시킨 다음 공격을 날린다. 가열 중에 만지면 화상을 입는다.";
    korLang[2691] = "전신의 비늘을 비벼서 큰 소리를 내 공격한다. 공격 후 자신의 방어가 떨어진다.";
    korLang[2692] = "몸을 해머처럼 써서 상대를 덮쳐 데미지를 준다.";
    korLang[2693] = "자신의 몸을 세차게 휘둘러서 상대에게 데미지를 준다.";
    korLang[2694] = "5턴 동안 물리와 특수 기술의 데미지를 약하게 한다. 싸라기눈일 때만 쓸 수 있다.";
    korLang[2704] = "껍질의 트랩을 설치한다. 상대가 물리 기술을 쓰면 폭발해서 데미지를 준다.";
    korLang[2705] = "강력한 빔을 발산한 후 자신의 특수공격이 크게 떨어진다.";
    korLang[2706] = "사이코 파워로 물어서 상대를 공격한다. 빛의장막이나 리플렉터도 파괴할 수 있다.";
    korLang[2707] = "분함을 발판 삼아 공격한다. 앞 턴에서 기술이 빗나갔다면 위력이 배가 된다.";
    korLang[2708] = "영혼이 머물고 있는 뼈로 상대를 세게 때려서 공격한다. 상대의 방어를 떨어뜨릴 때가 있다.";
    korLang[2709] = "재빠른 스피드로 상대에게 부딪쳐서 공격한다. 반드시 선제공격할 수 있다.";
    korLang[2710] = "물의 힘으로 상대에게 부딪쳐서 공격한다. 상대의 방어를 떨어뜨릴 때가 있다.";
    korLang[2711] = "프리즘의 힘으로 강력한 광선을 발사한다. 다음 턴은 움직일 수 없다.";
    korLang[2712] = "상대의 그림자에 숨어들어 상대의 능력이 올라가는 것을 뺏어 공격한다.";
    korLang[2713] = "유성 같은 기세로 돌진한다. 상대의 특성을 무시하고 공격할 수 있다.";
    korLang[2714] = "괴상한 광선을 쏘아 공격한다. 상대의 특성을 무시하고 공격할 수 있다.";
    korLang[2715] = "눈물을 그렁그렁거려 상대의 전의를 상실하게 한다. 상대의 공격과 특수공격이 떨어진다.";
    korLang[2716] = "상대에게 부딪쳐 강력한 전기를 날려서 찌리리따끔따끔하게 만든다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2717] = "자연의 분노를 상대에게 부딪친다. 상대의 HP는 절반이 된다.";
    korLang[2718] = "높은 에너지를 둘러싸 상대에게 부딪쳐 공격한다. 메모리에 따라 타입이 바뀐다.";
    korLang[2720] = "자신의 머리를 폭발시켜 주위의 모든 것을 공격한다. 자신도 데미지를 받는다.";
    korLang[2721] = "전기를 두른 주먹으로 공격한다. 노말타입 기술을 전기타입으로 바꿔버린다.";
    korLang[2722] = "빛의 기둥으로 공격한다. 공격과 특수공격을 비교해서 높은 쪽으로 데미지를 준다.";
    korLang[2729] = "맹렬한 속도의 전격 공격. 반드시 선제공격할 수 있고 급소에 맞는다.";
    korLang[2730] = "커다란 파도에 전기를 날리고 상대에게 부딪쳐서 공격한다. 마비 상태로 만들 때가 있다.";
    korLang[2731] = "두둥실 떠오른 다음 단숨에 급강하해서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2732] = "트레이너를 좋아하는 피카츄의 마음이 강할수록 위력이 올라가는 전격. 반드시 명중한다.";
    korLang[2733] = "물덩어리를 부딪쳐서 공격한다. 물을 흡수하여 데미지의 절반만큼 HP를 회복한다.";
    korLang[2734] = "전기를 상대에게 날려서 공격한다. 상대를 마비 상태로 만든다.";
    korLang[2735] = "불꽃을 두른 몸으로 기세 좋게 상대에게 부딪친다. 상대를 화상 상태로 만든다.";
    korLang[2736] = "염동력을 한가득 날린다. 상대의 특수공격을 약하게 만드는 이상한 장막을 만든다.";
    korLang[2737] = "악함을 어필해서 공격한다. 상대의 물리공격을 약하게 만드는 이상한 장막을 만든다.";
    korLang[2738] = "거대한 덩굴을 자라게 하고 씨를 흩뿌려서 공격한다. 씨는 매 턴 상대의 HP를 흡수한다.";
    korLang[2739] = "차갑게 얼어붙은 흑안개의 결정으로 공격한다. 전원의 능력 변화를 원래대로 돌린다.";
    korLang[2740] = "숨 막힐 듯 진한 향기의 회오리로 상대를 휘감아 공격한다. 같은 편의 상태 이상을 회복한다.";
    korLang[2741] = "트레이너를 좋아하는 이브이의 마음이 강할수록 위력이 올라가는 몸통박치기. 반드시 명중한다.";
    korLang[2742] = "가슴의 너트를 축으로 회전시켜 2번 연속 팔로 힘껏 친다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2744] = "코어에서 빔을 발사해서 공격한다. 상대가 다이맥스 중이면 데미지가 2배가 된다.";
    korLang[2745] = "상대의 기술을 끌어모으는 특성이나 기술의 영향을 무시하고 선택한 상대를 공격할 수 있다.";
    korLang[2746] = "어느 한쪽이 기절할 때까지 교체할 수 없게 된다. 한쪽의 포켓몬이 없어지면 효과가 사라진다.";
    korLang[2747] = "지니고 있는 나무열매를 먹고 방어를 크게 올린다.";
    korLang[2748] = "자신의 모든 능력이 올라가지만 교체하거나 도망칠 수 없게 된다.";
    korLang[2749] = "끈적끈적한 타르를 날려서 상대의 스피드를 떨어뜨린다. 상대는 불꽃이 약점이 된다.";
    korLang[2750] = "마법가루를 날려서 상대를 에스퍼타입으로 바꾼다.";
    korLang[2751] = "드라꼰으로 2번 공격한다. 상대가 2마리일 때는 각각 1번씩 공격한다.";
    korLang[2752] = "다과회를 열어서 배틀에 나와 있는 포켓몬이 각각 지니고 있는 나무열매를 먹는다.";
    korLang[2753] = "상대를 도망칠 수 없게 한다. 굳히기에 당한 상대는 매 턴 방어와 특수방어가 떨어진다.";
    korLang[2754] = "전기를 두른 부리로 찌른다. 상대보다 먼저 공격하면 기술의 위력은 2배가 된다.";
    korLang[2755] = "단단한 아가미로 문다. 상대보다 먼저 공격하면 기술의 위력은 2배가 된다.";
    korLang[2756] = "이상한 힘으로 서로의 필드 효과를 교체한다.";
    korLang[2775] = "자신의 HP를 조금 깎아서 모든 능력을 올린다.";
    korLang[2776] = "몸을 부딪쳐서 공격한다. 방어가 높을수록 주는 데미지가 올라간다.";
    korLang[2777] = "데코레이션을 해서 상대의 공격과 특수공격을 크게 올린다.";
    korLang[2778] = "드럼의 뿌리를 연주로 조종해서 공격하는 것으로 상대의 스피드를 떨어뜨린다.";
    korLang[2779] = "집게덫으로 붙잡은 뒤 4-5턴 동안 상대를 끼워서 공격한다.";
    korLang[2780] = "작은 돌을 태운 불꽃의 공으로 상대를 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2781] = "거대한 검이 되어 베어버린다. 상대가 다이맥스 중이면 데미지가 2배가 된다.";
    korLang[2782] = "거대한 방패가 되어 부딪친다. 상대가 다이맥스 중이면 데미지가 2배가 된다.";
    korLang[2783] = "볼주머니에 저장해둔 에너지로 공격하고 자신의 스피드를 올린다. 모르페코의 모습에 따라 타입이 바뀐다.";
    korLang[2784] = "강인한 꼬리를 세차게 휘둘러서 상대를 공격한다. 상대의 공격을 떨어뜨린다.";
    korLang[2785] = "날카롭고 뾰족한 가지로 상대를 찔러서 공격한다.";
    korLang[2786] = "기타나 베이스를 쳐서 큰 울림과 강한 진동을 상대에게 전달하여 공격한다.";
    korLang[2787] = "새콤한 사과에서 만들어 낸 산성 액체로 공격한다. 상대의 특수방어를 떨어뜨린다.";
    korLang[2788] = "높은 곳에서 사과를 떨어뜨려서 데미지를 준다. 상대의 방어를 떨어뜨린다.";
    korLang[2789] = "맞으면 기가 꺾여버릴 것 같은 기세로 공격한다. 상대의 특수공격을 떨어뜨린다.";
    korLang[2790] = "연기를 분출해서 상대를 공격한다. 혼란시킬 때가 있다.";
    korLang[2791] = "신비한 물을 흩뿌려서 자신과 배틀에 나와 있는 같은 편의 HP를 회복한다.";
    korLang[2792] = "상대의 공격을 전혀 받지 않는다. 연속으로 쓰면 실패하기 쉽다. 접촉한 상대의 방어를 크게 떨어뜨린다.";
    korLang[2793] = "고개를 숙이는 척하면서 흐트러진 머리카락으로 찌른다. 공격은 반드시 명중한다.";
    korLang[2794] = "굵은 줄기를 휘둘러서 공격한다. 단 자신도 비틀거리기 때문에 다음 턴은 움직일 수 없다.";
    korLang[2795] = "본래의 모습이 된 무한다이노 최대의 공격. 다음 턴은 움직일 수 없다.";
    korLang[2796] = "전신에서 끌어모은 강철을 빔으로 바꿔 세차게 발사한다. 자신도 데미지를 받는다.";
    korLang[2797] = "사이코 파워로 상대를 공격한다. 사이코필드일 때는 위력이 오르며 모든 상대에게 데미지를 준다.";
    korLang[2798] = "필드를 파괴하면서 공격한다. 필드가 어떤 상태로든 변해 있지 않은 경우 기술은 실패한다.";
    korLang[2799] = "비늘을 쏘아서 공격한다. 2-5회 동안 연속으로 쓴다. 스피드가 올라가지만 방어가 떨어진다.";
    korLang[2800] = "1턴째에 우주의 힘을 모아서 특수공격을 올리고 2턴째에 상대를 공격한다.";
    korLang[2801] = "물리와 특수 중 더 많은 데미지를 줄 수 있는 능력으로 공격한다. 독 상태로 만들 때가 있다.";
    korLang[2802] = "자신의 주위에 있는 모두를 공격하지만 사용하면 기절한다. 미스트필드일 때 위력이 올라간다.";
    korLang[2803] = "지면에 미끄러지듯 상대를 공격한다. 그래스필드일 때 반드시 선제공격할 수 있다.";
    korLang[2804] = "지면에서 올라오는 전격으로 공격한다. 상대가 일렉트릭필드 위에 있을 때 기술의 위력이 2배가 된다.";
    korLang[2805] = "필드의 힘을 빌려서 공격한다. 사용했을 때의 필드 상태에 따라서 기술 타입과 위력이 바뀐다.";
    korLang[2806] = "배후에서 엄습해서 공격한다. 상대의 특수공격을 떨어뜨린다.";
    korLang[2807] = "질투의 에너지로 상대를 공격한다. 그 턴에 능력이 올라간 포켓몬을 화상 상태로 만든다.";
    korLang[2808] = "상대에 대한 울분이 담긴 공격을 한다. 그 턴에 능력이 떨어져 있으면 기술의 위력이 2배가 된다.";
    korLang[2809] = "상대의 지닌 물건을 조종해서 공격한다. 상대가 도구를 지니고 있지 않으면 실패한다.";
    korLang[2810] = "주위에 있는 모든 것을 강력한 산성 가스로 뒤덮어서 지니고 있는 도구를 녹여버린다.";
    korLang[2811] = "적절한 지도를 통해서 같은 편 전원의 공격과 방어를 올린다.";
    korLang[2812] = "공격한 뒤 굉장한 스피드로 돌아와서 교대 포켓몬과 교체한다.";
    korLang[2813] = "3회 연속으로 킥을 날려 공격한다. 기술이 맞을 때마다 위력이 올라간다.";
    korLang[2814] = "날개를 상대에게 부딪쳐서 공격한다. 2회 연속으로 데미지를 준다.";
    korLang[2815] = "뜨겁게 달궈진 모래를 상대에게 부딪쳐서 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2816] = "정글과 하나가 되어 자신과 배틀에 나와 있는 같은 편의 HP와 모든 상태를 회복한다.";
    korLang[2817] = "악의 태세가 극에 달하여 강렬한 일격을 날린다. 반드시 급소에 맞는다.";
    korLang[2818] = "물의 태세가 극에 달하여 물 흐르듯 3회의 연격을 날린다. 반드시 급소에 맞는다.";
    korLang[2819] = "전기가 흐르는 우리 안에 4-5턴 동안 상대를 가두어 공격한다.";
    korLang[2820] = "생명력을 파워로 바꿔서 상대를 공격한다. 자신의 HP가 적을수록 기술의 위력이 떨어진다.";
    korLang[2821] = "두 눈에서 사이코 파워를 발사해서 공격한다. 얼음 상태로 만들 때가 있다.";
    korLang[2822] = "분노를 불꽃 같은 오라로 바꿔서 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2823] = "번개 같은 움직임으로 상대를 농락하며 킥을 날린다. 상대의 방어를 떨어뜨린다.";
    korLang[2824] = "눈보라를 두른 얼음의 창을 상대에게 던져서 공격한다.";
    korLang[2825] = "수많은 작은 영체를 상대에게 부딪쳐서 공격한다.";
    korLang[2826] = "강력한 사이코 파워로 공격한다. 상대가 마지막으로 사용한 기술의 PP를 3만큼 줄인다.";
    korLang[2827] = "파멸의 발톱으로 상대를 할퀸다. 독이나 마비나 잠듦 상태로 만들 때가 있다.";
    korLang[2828] = "사이코 에너지를 두르고 상대에게 부딪친다. 자신의 방어가 올라간다.";
    korLang[2829] = "자신의 공격과 방어를 맞바꾼다.";
    korLang[2830] = "돌도끼를 휘둘러 공격한다. 흩어진 돌 조각이 상대 주변에 떠다닌다.";
    korLang[2831] = "사랑과 미움이 담긴 거센 바람으로 상대를 감싸 공격한다. 공격을 떨어뜨릴 때가 있다.";
    korLang[2832] = "신비한 힘을 내뿜어 공격한다. 자신의 특수공격이 올라간다.";
    korLang[2833] = "2~3턴 동안 불꽃을 뿜으며 날뛴다. 날뛴 뒤에는 혼란에 빠진다.";
    korLang[2834] = "물을 두르고 온몸으로 부딪친다. 자신도 꽤 큰 피해를 입는다.";
    korLang[2835] = "모아 둔 엽록소를 쏘아 공격한다. 자신도 피해를 입는다.";
    korLang[2836] = "거대한 얼음덩이를 던져 공격한다. 상대를 풀죽게 만들 때가 있다.";
    korLang[2837] = "승리를 부르는 격렬한 춤을 춰서 자신의 공격과 방어와 스피드가 올라간다.";
    korLang[2838] = "온몸으로 들이받아 공격한다. 자신의 방어와 특수방어가 떨어진다.";
    korLang[2839] = "수많은 독침을 쏘아 공격한다. 독 상태로 만들 때가 있으며 상대가 독 상태면 위력이 2배가 된다.";
    korLang[2840] = "오라를 두른 날개로 벤다. 자신의 스피드가 올라가며 급소에 맞기 쉽다.";
    korLang[2841] = "등골이 오싹해지는 원한으로 공격한다. 상대의 공격을 떨어뜨린다.";
    korLang[2842] = "피부를 철판처럼 단단하게 만들어 자신의 방어를 크게 올린다.";
    korLang[2843] = "발차기 후 화살 3발을 쏜다. 급소에 맞기 쉽고 상대의 방어를 떨어뜨리거나 풀죽게 만들 때가 있다.";
    korLang[2844] = "수많은 도깨비불로 공격한다. 화상 상태로 만들 때가 있으며 상대가 상태 이상이면 위력이 2배가 된다.";
    korLang[2845] = "껍질 칼로 벤다. 흩어진 껍질 조각이 상대 발밑에 압정처럼 남는다.";
    korLang[2846] = "몸도 마음도 떨리게 하는 찬바람으로 공격한다. 상대의 스피드를 떨어뜨릴 때가 있다.";
    korLang[2847] = "번개를 동반한 폭풍을 불러 공격한다. 상대를 마비 상태로 만들 때가 있다.";
    korLang[2848] = "뜨거운 모래바람으로 상대를 감싸 공격한다. 화상 상태로 만들 때가 있다.";
    korLang[2849] = "초승달의 축복을 받아 자신과 같은 편의 HP를 회복하고 상태 이상을 고친다.";
    korLang[2850] = "마음을 다잡아 자신의 상태 이상을 고치고 특수공격과 특수방어를 올린다.";
    korLang[2851] = "테라스탈했을 때 테라 타입의 에너지를 내뿜는다. 공격과 특수공격 중 높은 쪽으로 피해를 준다.";
    korLang[2852] = "실로 덫을 쳐 공격을 막는다. 직접 닿은 상대의 스피드를 떨어뜨린다.";
    korLang[2853] = "높이 차올린 발꿈치를 내리찍는다. 혼란에 빠뜨릴 때가 있으며 빗나가면 자신이 피해를 입는다.";
    korLang[2854] = "쓰러진 동료의 원수를 갚는다. 쓰러진 동료가 많을수록 위력이 올라간다.";
    korLang[2855] = "마음까지 닿는 신비한 빛을 쏘아 공격한다. 상대의 특수방어를 크게 떨어뜨린다.";
    korLang[2856] = "우아한 자세로 공격한다. 입안의 싸리용 모습에 따라 자신의 능력 하나가 올라간다.";
    korLang[2857] = "주먹에 물살을 두르고 눈에 보이지 않는 속도로 친다. 반드시 먼저 공격할 수 있다.";
    korLang[2858] = "엄청나게 매운 엑기스를 뿜는다. 상대의 공격을 크게 올리고 방어를 크게 떨어뜨린다.";
    korLang[2859] = "다리에 힘을 주고 맹렬히 회전해 공격한다. 자신의 스피드가 크게 떨어진다.";
    korLang[2860] = "동료들이 우르르 몰려와 1~10번 연속으로 공격한다.";
    korLang[2861] = "발에 얇은 얼음을 두르고 빙글빙글 돌며 부딪친다. 회전으로 필드를 없앤다.";
    korLang[2862] = "온몸을 던져 무작정 돌격한다. 다음 자신의 턴까지 받는 공격은 반드시 맞고 피해가 2배가 된다.";
    korLang[2863] = "사랑이 담긴 기도로 쓰러진 동료 하나를 HP 절반으로 되살린다.";
    korLang[2864] = "상대를 소금에 절여 매 턴 피해를 준다. 강철과 물 타입은 더 큰 피해를 입는다.";
    korLang[2865] = "호흡이 딱 맞는 트리플 다이브로 물보라를 일으켜 3번 연속 공격한다.";
    korLang[2866] = "회전 공격으로 조이기나 씨뿌리기 같은 효과를 없앤다. 상대를 독 상태로 만든다.";
    korLang[2867] = "상대의 본모습을 그림에 담아 자신과 같은 편의 특성을 상대의 특성으로 바꾼다.";
    korLang[2868] = "자신의 HP를 깎아 공격과 특수공격과 스피드를 크게 올린다.";
    korLang[2869] = "엎드려 절해 상대가 방심한 틈에 벤다. 반드시 맞는다.";
    korLang[2870] = "장치가 숨겨진 꽃다발을 던진다. 반드시 맞고 반드시 급소에 맞는다.";
    korLang[2871] = "노래하듯 불꽃을 뿜어 태운다. 자신의 특수공격이 올라간다.";
    korLang[2872] = "가볍고 부드러운 스텝으로 상대를 농락하며 공격한다. 자신의 스피드가 올라간다.";
    korLang[2873] = "성난 소처럼 몸통박치기를 한다. 모습에 따라 타입이 바뀌며 빛의장막이나 리플렉터를 깬다.";
    korLang[2874] = "동전을 마구 던져 공격한다. 자신의 특수공격이 떨어진다. 배틀이 끝나면 돈을 받는다.";
    korLang[2875] = "실체 없는 칼날로 벤다. 일렉트릭필드에서는 위력이 1.5배가 된다.";
    korLang[2876] = "펄펄 끓는 물을 내뿜는다. 쾌청일 때 위력이 떨어지지 않고 오히려 1.5배가 된다.";
    korLang[2877] = "파멸의 재앙을 부른다. 상대의 HP를 절반으로 만든다.";
    korLang[2878] = "모습을 바꿔 땅에 부딪치며 태고의 대폭발을 일으킨다. 효과가 굉장할 때 위력이 더 올라간다.";
    korLang[2879] = "초고속으로 달려 미래의 전기로 꿰뚫는다. 효과가 굉장할 때 위력이 더 올라간다.";
    korLang[2880] = "자신의 HP로 대타를 만들고 대기 중인 포켓몬과 교체한다.";
    korLang[2881] = "썰렁한 개그를 하고 대기 중인 포켓몬과 교체한다. 5턴 동안 눈이 내린다.";
    korLang[2882] = "정리 정돈해서 압정뿌리기, 스텔스록, 끈적끈적네트, 독압정, 대타출동을 없앤다. 자신의 공격과 스피드가 올라간다.";
    korLang[2883] = "5턴 동안 눈을 내리게 한다. 얼음 타입의 방어가 올라간다.";
    korLang[2884] = "상대에게 달려들어 공격한다. 상대의 스피드를 떨어뜨린다.";
    korLang[2885] = "풀숲에서 뛰쳐나오듯 갑자기 공격한다. 경쾌한 발놀림으로 자신의 스피드가 올라간다.";
    korLang[2886] = "힘이 빠질 만큼 차가운 물을 끼얹는다. 상대의 공격을 떨어뜨린다.";
    korLang[2887] = "몸의 뾰족한 부분을 고속 회전시켜 꿰뚫는다. 방어 같은 기술을 쓴 상대에게도 맞는다.";
    korLang[2888] = "두 눈에서 신비한 빛을 쏜다. 2번 연속으로 공격한다.";
    korLang[2889] = "분노를 힘으로 바꿔 공격한다. 공격을 많이 받았을수록 위력이 올라간다.";
    korLang[2890] = "자신의 갑옷을 불타는 포탄으로 쏜다. 자신의 방어와 특수방어가 떨어진다.";
    korLang[2891] = "산 자에 대한 원한을 담아 벤다. 준 피해의 절반만큼 자신의 HP를 회복한다.";
    korLang[2892] = "몸의 전기를 모두 내보내 큰 피해를 준다. 쓰고 나면 전기 타입이 아니게 된다.";
    korLang[2893] = "온몸을 휘둘러 거대한 해머로 공격한다. 2번 연속으로 쓸 수 없다.";
    korLang[2894] = "마지막으로 자신에게 피해를 준 상대에게 훨씬 강한 힘으로 앙갚음한다.";
    korLang[2895] = "압축한 물을 칼날처럼 쏘아 벤다. 급소에 맞기 쉽다.";
    korLang[2896] = "불타는 엔진을 돌려 들이받는다. 화상 상태로 만들 때가 있다.";
    korLang[2897] = "악의를 품은 엔진을 돌려 들이받는다. 잠듦 상태로 만들 때가 있다.";
    korLang[2898] = "독을 품은 엔진을 돌려 들이받는다. 독 상태로 만들 때가 있다.";
    korLang[2899] = "엔진을 힘껏 돌려 들이받는다. 마비 상태로 만들 때가 있다.";
    korLang[2900] = "요정 같은 엔진을 돌려 들이받는다. 혼란에 빠뜨릴 때가 있다.";
    korLang[2901] = "피처럼 붉은 보름달에서 기운을 모두 쏟아낸다. 2번 연속으로 쓸 수 없다.";
    korLang[2902] = "직접 우린 차를 쏘아 공격한다. 준 피해의 절반만큼 HP를 회복하고 화상 상태로 만들 때가 있다.";
    korLang[2903] = "끈적한 사탕 시럽을 터뜨려 뒤집어씌운다. 3턴 동안 매 턴 상대의 스피드가 떨어진다.";
    korLang[2904] = "담쟁이를 감은 방망이로 친다. 쓰고 있는 가면에 따라 타입이 바뀌며 급소에 맞기 쉽다.";
    korLang[2905] = "첫 턴에 전기를 모아 특수공격을 올리고 다음 턴에 고전압을 쏜다. 비가 오면 바로 쏜다.";
    korLang[2906] = "결정의 힘으로 상대를 쏘아 없앤다. 테라파고스 스텔라폼이 쓰면 상대 전체에게 피해를 준다.";
    korLang[2907] = "빛줄기를 쏘아 공격한다. 가끔 모든 머리가 함께 쏴서 위력이 2배가 된다.";
    korLang[2908] = "뜨거운 털로 공격을 막고 직접 닿은 상대를 화상 상태로 만든다.";
    korLang[2909] = "전격으로 먼저 공격한다. 상대가 공격하려는 때가 아니면 실패한다.";
    korLang[2910] = "머리 위에 모은 빛으로 벤다. 상대가 방어해도 맞는다.";
    korLang[2911] = "입자의 칼날을 2번 연속으로 날린다. 반드시 맞는다.";
    korLang[2912] = "팔이나 집게로 짓눌러 공격한다. 상대의 남은 HP가 많을수록 위력이 올라간다.";
    korLang[2913] = "용의 외침으로 같은 편의 사기를 높여 급소에 맞기 쉽게 한다. 드래곤 타입은 더 크게 올라간다.";
    korLang[2914] = "천사 같은 목소리로 공격한다. 이번 턴에 능력이 올라간 상대를 혼란에 빠뜨린다.";
    korLang[2915] = "자포자기한 마음으로 공격한다. 바로 전에 쓴 기술이 실패했으면 위력이 2배가 된다.";
    korLang[2916] = "몸에 전기를 두르고 내리꽂는다. 빗나가면 자신이 피해를 입는다.";
    korLang[2917] = "불쾌한 음파로 공격한다. 2턴 동안 상대는 기술이나 특성이나 도구로 HP를 회복할 수 없다.";
    korLang[2918] = "상대의 움직임에 반응해 손바닥으로 쳐서 풀죽게 만든다. 상대가 선제공격 기술을 쓰려는 때가 아니면 실패한다.";
    korLang[2919] = "부식성 독 사슬로 감아 독을 흘려 넣는다. 맹독 상태로 만들 때가 있다.";
    korLang[2920] = "꼬리의 바위로 힘차게 내려 찍어 공격한다. 10%% 확률로 상대를 풀죽인다.";
    korLang[2921] = "발톱에 열기를 감아 공격한다. 상대를 화상 상태로 만든다.";
    korLang[2923] = "날카로운 바람으로 상대를 베어 공격한다. 급소에 맞기 쉽다.";
    korLang[2924] = "몸에 모은 전기를 한꺼번에 쏟아부어 공격한다. 쓰면 반동으로 자신의 특수공격이 크게 떨어진다.";
    korLang[2925] = "사이코 파워를 한 곳에 끌어모아 상대의 생각을 이리저리 뒤섞는다. 특수공격이 2랭크 떨어진다.";
    korLang[2922] = "많은 물을 작게 모아 한번에 발사한다. 33%% 확률로 상대를 혼란으로 만든다.";
}
