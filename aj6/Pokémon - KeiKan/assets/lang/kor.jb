    korLang[3511] = "신난다! {poke}(을)를 잡았다!";
    korLang[3512] = "앗! 포켓몬이 볼에서 나와 버렸다!";
    korLang[3513] = "아아! 잡았다고 생각했는데!";
    korLang[3514] = "아깝다! 조금만 더 했으면!";
    korLang[3515] = "아쉽다! 조금만 더 하면 잡을 수 있었는데!";
    korLang[3519] = "{poke}(을)를 어떻게 할까?";
