// 불러오기: 리포트 파일을 읽어 검사하고, 맞으면 값을 public 변수에 넣어 둠 (장면 이동은 하지 않음)
//   리포트 형식: ["keikan", 2, usingLang, isBoy, place, x, y, 내 포켓몬들]
//   · 버전 1 (내 포켓몬 없음 · 7칸) 도 읽음 → 내 포켓몬은 1번 한 마리로 새로 만듦
//   · 처음 두 칸(표시 · 버전)이 맞고 칸 수가 맞을 때만 씀 — 예전 형식 · 깨진 파일은 무시하고 새 게임
//   · 실제로 이어서 시작하는 것은 타이틀 화면에서 고름 (continuing = 1 → enterPlace.jb 가 그 장소로)
Use jawbreaker call jaw;
Use pokeGen call pg;

var public compound call saveData;
var public compound call myParty;   // 내 포켓몬들
var public compound call pcBox;     // PC 에 맡긴 포켓몬들 (리포트 9 번째 칸 · 없던 리포트는 빈 채로)
var public bit call hasSave;      // 쓸 수 있는 리포트가 있음
var public bit call continuing;   // 이어하기로 장소에 들어가는 중 (장소 파일이 위치를 쓰고 0 으로)
var public float call loadX;
var public float call loadY;
var public list call learnsetIds;   // pokeDataManager.jb 가 채움 (자력기)
var public compound call movedex;   // moveManager.jb 가 채움 (기술 데이터 · PP)

var public int call money;   // 소지금 (리포트 13 번째 칸)
var public int call story;
var public int call stPick;
var public int call badges;
var public list call trDone;
var public list call fiTaken;   // 주운 필드 도구 (리포트 12 번째 칸 · lib/fieldItem.jbl)
var public int call pcOn;      // PC 계정 활성화 (리포트 18 번째 칸)
var public int call pcBoxN;    // PC 박스 수 (리포트 19 번째 칸 · 처음 2)
var public compound call gyRes;   // 유풍체육관 상태 (리포트 20 번째 칸 · lib/gymFly.jbl 의 enter 가 씀)
run{
    loop [learnsetIds.length == 0] or [movedex.length == 0]{   // 포켓몬 · 기술 데이터가 준비될 때까지 — 예전 리포트의 기술 · PP 칸을 채울 때 씀
        wait(1);
    }
    hasSave = 0;
    pcBox = [];
    bag = [];
    fiTaken = [];
    story = 0;
    stPick = 0;
    badges = 0;
    trDone = [];
    money = 3000;   // 소지금: 새 게임 · 소지금 칸이 없던 리포트는 3000 원
    pcOn = 0;       // 새 게임: PC 는 박사에게 계정 메모를 받아 포켓몬센터에서 활성화해야 씀
    pcBoxN = 2;
    gyRes = [];
    gMonth = 0;
    continuing = 0;
    usingLang = 1;   // 리포트가 없을 때의 기본 언어 (한국어)
    if [fileExists("data/save/save.json")]{
        loadJson("data/save/save.json", "saveData");
        if ([saveData.length == 7] and [saveData[2] == 1] or [saveData.length == 8] and [saveData[2] == 2] or [saveData.length == 9] and [saveData[2] == 2] or [saveData.length == 10] and [saveData[2] == 2] or [saveData.length == 11] and [saveData[2] == 2] or [saveData.length == 12] and [saveData[2] == 2] or [saveData.length == 13] and [saveData[2] == 2] or [saveData.length == 15] and [saveData[2] == 2] or [saveData.length == 16] and [saveData[2] == 2] or [saveData.length == 17] and [saveData[2] == 2] or [saveData.length == 18] and [saveData[2] == 2] or [saveData.length == 19] and [saveData[2] == 2] or [saveData.length == 20] and [saveData[2] == 2]) and [saveData[1] == "keikan"]{
            usingLang = saveData[3];
            isBoy = saveData[4];
            place = saveData[5];
            loadX = saveData[6];
            loadY = saveData[7];
            myParty = [];
            if [saveData.length >= 15]{   // 이야기 진행 · 고른 스타팅 (없던 리포트는 처음부터)
                story = saveData[14];
                stPick = saveData[15];
            }
            if [saveData.length >= 16]{   // 배지 수 (레벨캡)
                badges = saveData[16];
            }
            if [saveData.length >= 17]{   // 이긴 트레이너
                var compound call ldTr = saveData[17];
                var int call tq = 1;
                loop [tq <= ldTr.length]{
                    trDone.add(ldTr[tq]);
                    tq = tq + 1;
                }
            }
            pcOn = 1;   // PC 칸이 없던 예전 리포트: PC 가 있는 것으로 (임시 · 다음 버전에서 지울 것)
            if [saveData.length >= 18]{   // PC 계정 활성화
                pcOn = saveData[18];
            }
            if [saveData.length >= 19]{   // PC 박스 수
                pcBoxN = saveData[19];
            }
            if [saveData.length >= 20]{   // 유풍체육관 안에서 저장했으면 그 상태 (글라이더 · 양력 등)
                gyRes = saveData[20];
            }
            if [saveData.length >= 13]{   // 소지금
                money = saveData[13];
            }
            if [saveData.length >= 12]{   // 주운 필드 도구 (없던 리포트는 모두 안 주운 것으로)
                var compound call ldF = saveData[12];   // loadJson 이 읽은 [ ] 는 모두 compound → 리스트로 한 칸씩 옮김
                var int call fq = 1;
                loop [fq <= ldF.length]{
                    fiTaken.add(ldF[fq]);
                    fq = fq + 1;
                }
            }
            if [saveData.length >= 11]{   // 가방 (없던 리포트는 방에 들어갈 때 처음 가방으로)
                bag = saveData[11];
            }
            if [saveData.length >= 10]{   // 시간 · 날짜 (없던 리포트는 timeManager.jb 가 처음 값으로)
                var compound call ldT = saveData[10];   // loadJson 이 읽은 [ ] 는 compound (list 로 받으면 오류)
                gMonth = ldT[1];
                gDay = ldT[2];
                gWeek = ldT[3];
                gHour = ldT[4];
                gMin = ldT[5];
            }
            if [saveData.length >= 9]{
                pcBox = saveData[9];
            }
            if [saveData[2] == 2]{
                myParty = saveData[8];
                var int call i = 1;
                loop [i <= myParty.length]{   // 예전 형식의 포켓몬을 지금 형식 (24칸) 으로
                    var compound call pk = myParty[i];
                    if [pk.length == 19]{   // 레벨 칸이 없던 리포트: 2번째에 레벨 5
                        pk.insert(2, 5);
                    }
                    if [pk.length == 20]{   // 지닌 도구 칸이 없던 리포트: 맨 뒤에 0 (없음)
                        pk.add(0);
                    }
                    if [pk.length == 21]{   // 기술 칸이 없던 리포트: 그 레벨까지의 자력기
                        pk.add(pg.movesAt(pk[1], pk[2]));
                    }
                    if [pk.length == 22]{   // PP 칸이 없던 리포트: 기술마다 최대 PP
                        var compound call mvs = pk[22];
                        var compound call pps = [];
                        var int call q = 1;
                        loop [q <= mvs.length]{
                            pps.add(movedex[mvs[q]][7]);
                            q = q + 1;
                        }
                        pk.add(pps);
                    }
                    if [pk.length == 23]{   // 포인트업 칸이 없던 리포트: 기술마다 0
                        var compound call ups = [];
                        var compound call mv2 = pk[22];
                        var int call q2 = 1;
                        loop [q2 <= mv2.length]{
                            ups.add(0);
                            q2 = q2 + 1;
                        }
                        pk.add(ups);
                    }
                    if [pk.length == 24]{   // 남은 체력 칸이 없던 리포트: 최대 체력
                        pk.add(pg.calcStat(pg.baseStat(pk[1], 1), pk[3], pk[9], pk[2], 1));
                    }
                    if [pk.length == 25]{   // 경험치 칸이 없던 리포트: 그 레벨의 시작 경험치
                        pk.add(pg.expAt(pg.growth(pk[1]), pk[2]));
                    }
                    if [pk.length == 26]{   // 상태 이상 칸이 없던 리포트: 없음
                        pk.add(0);
                    }
                    if [pk.length == 27]{   // 특성 칸이 비어 있던 리포트: 특성을 정하고 숨겨진 특성 여부 칸 추가
                        pk[16] = pg.rollAbility(pk[1]);
                        pk.add(0);
                    }
                    if [pk.length == 28]{   // 모습 (폼) 칸이 없던 리포트: 0
                        pk.add(0);
                    }
                    myParty[i] = pk;
                    i = i + 1;
                }
            }
            else{
                myParty = [];   // 예전 리포트: 내 포켓몬이 없었음 → 없는 그대로
            }
            hasSave = 1;
            log("리포트 불러옴: 장소 %place% · [%loadX%, %loadY%] · 내 포켓몬 %myParty.length%마리");
        }
        else if [saveData.length == 0]{
            log("리포트가 비어 있습니다 (리셋됨 · 새 게임으로 시작)");
        }
        else{
            log("리포트 형식이 맞지 않아 무시합니다 (새 게임으로 시작)");
        }
    }
}
