            loop [fwi <= myParty.length]{
                pg.addFriend(fwi, 1);
                fwi = fwi + 1;
            }
            log("친밀도: 128 걸음 → 모두 +1");
        }
        // 필드 음악: 포켓몬센터 안 = pokecenter · 1번도로 (마을 서쪽 경계 x = -248 바깥) = route1 (한 바퀴 구간 반복) · 그 밖 = pallet — 바뀔 때만 다시 틂
        var string call wantBgm = "pallet";
        if [place == 2] or [place == 9]{
            wantBgm = "pokecenter";
        }
        if [place == 1] and [obj.prtg.Xpos < -248]{
            wantBgm = "route1";
        }
        if [place == 5]{   // 보라매숲: 상록숲 (하트골드 · 소울실버)
            wantBgm = "forest";
        }
        if [place == 6]{   // 1번도로 서쪽: 1번도로 음악
            wantBgm = "route1";
        }
        if [place == 7] or [place == 8] or [place == 11]{   // 유풍시티 · 상점 · 체육관 로비 (제작자 제공 음악)
            wantBgm = "yupungCity";
        }
        if [place == 12]{   // 유풍체육관 안 (제작자 제공 음악)
            wantBgm = "gymInside";
        }
        if [wantBgm != curBgm]{
            sou.break("global", true);
            if [wantBgm == "gymInside"]{   // gymInside.mp3 = 원본 (105 초 · 한 바퀴 32.008 초) 의 앞 41 초만 (한 바퀴가 정확히 32008 밀리초가 되게 7 ppm 줄임 · 소리 크기를 1번도로 음악에 맞춤) → 처음부터 재생 → 8.000 ~ 40.008 초 구간을 반복 (2026-11-25)
                sou.introPart("global", "gymInside", 8000, 40008);
            }
            else if [wantBgm == "route1"]{   // route1.mp3 = 원본 (같은 곡 두 바퀴 · 156 초) 의 앞 100 초만 (한 바퀴가 정확히 77833 밀리초가 되게 4 ppm 줄임) → 처음부터 재생 → 18.339 ~ 96.172 초 구간을 반복 (2026-11-20 최적화)
                sou.introPart("global", "route1", 18339, 96172);
            }
