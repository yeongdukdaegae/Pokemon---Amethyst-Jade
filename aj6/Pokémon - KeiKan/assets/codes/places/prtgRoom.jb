            bStart = 1;
            bGo = 1;
        }
        if [bGo == 1]{
            battleForm = bStart;
            trainerId = 1;
            if [pendTr != 0]{   // 필드의 트레이너 (lib/trainers.jbl)
                trainerId = pendTr;
                pendTr = 0;
            }
            canMove = 0;
            // ── 배틀 돌입 연출 (모두 2400 밀리초: 여기서 1700 → 배틀 장면에서 커튼 250 + 야생 포켓몬 슬라이드 450) ──
            //   노래가 시작되면서 플레이어가 클로즈업되고 화면이 점점 하얘짐 → 배틀 장면은 하얀 커튼으로 시작 (battleManager.jb)
            sou.break("global", true);
            if [battleForm == 1]{
                sou.introPart("global", "wildBattle", 2600, 90000);   // wildBattle.mp3 = 원본의 90 ~ 181 초만 잘라 둔 파일 → 처음 (원본 90 초) 부터 재생 → 그 뒤 2.6 ~ 90 초 (원본 92.6 ~ 180 초) 구간을 반복
            }
            else if [trainerId == 16]{   // 유풍체육관 관장 휴린: 관장 배틀 음악 — gymLeader.mp3 = 원본 (180 초 · 한 바퀴 44.42 초) 의 앞 61.4 초만 (한 바퀴가 정확히 44420 밀리초가 되게 7 ppm 늘임 · 소리 크기를 트레이너 배틀 음악에 맞춤) → 처음부터 재생 → 16.000 ~ 60.420 초 구간을 반복 (2026-11-25)
                sou.introPart("global", "gymLeader", 16000, 60420);
            }
            else{
                sou.introPart("global", "trainerBattle", 17117, 100611);   // 트레이너 배틀 음악: trainerBattle.mp3 = 원본 (같은 곡을 9 번 넘게 이어 붙인 12 분 46 초) 의 앞 106 초만 (한 바퀴가 정확히 83494 밀리초가 되게 3.5 ppm 늘임) → 처음부터 재생 → 17.117 ~ 100.611 초 구간을 반복 (2026-11-20 최적화)
            }
            var float call baseZ = 720 / 240;   // 지금 카메라 배율 (PC 3 · 모바일 4)
            if [dis.idWidthmode == 1]{
