                log("트레이너와 눈이 마주침: " + tq);
                wait(700);
                dis.removeObj("trEx");
                var int call wdx = 0;
                var int call wdy = 0;
                if [npDir[tq] == 1]{
                    wdx = -1;
                }
                if [npDir[tq] == 2]{
                    wdx = 1;
                }
                if [npDir[tq] == 3]{
                    wdy = 1;
                }
                if [npDir[tq] == 4]{
                    wdy = -1;
                }
                trBackK = tq;   // 배틀이 끝나면 원래 자리로 돌아감
                trBackC = npCol[tq];
                trBackR = npRow[tq];
                fn.walk(tq, wdx * (trDist - 1), wdy * (trDist - 1), (trDist - 1) * 12);
            }
            else{
                fn.face(tq, npDir[tq]);
            }
            if [npDir[tq] == 1]{   // 플레이어가 트레이너 쪽을 봄
                direction = 2;
            }
            if [npDir[tq] == 2]{
                direction = 1;
            }
            if [npDir[tq] == 3]{
                direction = 4;
            }
            if [npDir[tq] == 4]{
                direction = 3;
            }
            ft.open(lang[npName[tq]]);
            ft.say(lang[tr.introL(npTr[tq])]);
            ft.close();
            pendTr = npTr[tq];
            bStart = 2;
            bGo = 1;
        }
        if [bStart == 2] and [battleZ == 1] and [canMove == 1] and [fsNow == 0]{   // 임시 Z 배틀 (X 는 메뉴라서 야생 배틀은 그대로 봉인)
            bGo = 1;
        }
        if [bossTalk != 0] and [bGo == 0]{   // 레이드 보스 (lib/fieldNpc.jbl 의 npKind 8 · lib/bossCore.jbl): 대사 → 야생 배틀 (정해진 구성 · 체력 4 줄)
            var int call bk = bossTalk;
            bossTalk = 0;
            canMove = 0;
            ft.open("");
            ft.say(replaceStr(lang[7288], "{poke}", lang[50 + 103]));
            ft.close();
            wildId = 103;
            wildLv = 35;
            bossId = npTr[bk];
