            wx = 8984;
            wy = 3000;
            wd = 1;
        }
        if [place == 5] and [canMove == 1] and [obj.prtg.Xpos > 9010]{   // 보라매숲 동쪽 끝 → 1번도로 서쪽 끝 (두 칸 안)
            warp = 1;
            wx = -848;
            wy = 1072;
            wd = 2;
        }
