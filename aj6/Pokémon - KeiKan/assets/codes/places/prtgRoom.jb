        if [place == 6] and [canMove == 1] and [obj.prtg.Xpos < 10590]{   // 1번도로 서쪽의 서쪽 끝 (0 열) → 유풍시티 동쪽 끝 (98 열)
            warp = 7;
            wx = 13000;
            wy = min(3016, max(2968, 3000 + floor((obj.prtg.Ypos - 3000) / 16.0 + 0.5) * 16));   // 유풍시티 큰길 (35 ~ 38 줄)
            wd = 1;
        }
        if [place == 7] and [canMove == 1] and [obj.prtg.Xpos > 13010]{   // 유풍시티 동쪽 끝 → 1번도로 서쪽의 서쪽 끝 한 칸 안 (1 열)
