            warp = 6;
            wx = 11000;
            wy = 3000 + floor((obj.prtg.Ypos - 3000) / 16.0 + 0.5) * 16 - 288;
            wd = 1;
        }
        if [place == 6] and [canMove == 1] and [obj.prtg.Xpos > 11010]{   // 1번도로 서쪽의 동쪽 끝 (27 열) → 보라매숲 서쪽 출구 한 칸 안 (1 열)
            warp = 5;
            wx = 7784;
            wy = min(3320, max(3256, 3000 + floor((obj.prtg.Ypos - 3000) / 16.0 + 0.5) * 16 + 288));
