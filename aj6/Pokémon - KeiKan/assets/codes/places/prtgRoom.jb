            }
            setup("assets/codes/saveManager.jb");   // 배틀이 끝나면 자동 저장 (리포트 작성) — 진화한 뒤
            curBgm = "";   // 필드 음악을 다시 (아래 반복이 장소에 맞춰)
            loop [ky.x()]{ dis.waitF(1); }
            loop [ky.z()]{ dis.waitF(1); }   // 배틀을 끝낸 Z 로 바로 난천과 배틀하지 않게   // 누르고 있던 X 로 바로 다시 배틀하지 않게
            canMove = 1;
