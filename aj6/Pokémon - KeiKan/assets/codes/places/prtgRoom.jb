                            bStart = 1;
                            bGo = 1;
                        }
                    }
                }
            }
        }
        // ── 보라매숲: 단차 (그쪽 방향키 → 단차 너머 칸으로 걸어감) · 덤불 · 호수 ──
        //   출현율: 칸을 옮길 때마다 18.75 / 180 (1번도로의 3/4)
        //   덤불 (구역 1): 숲의 포켓몬 (bmSp) · 5% 이브이나 피카츄 · 서쪽일수록 7% 에 가깝게 스라크 ("!" · 1/3 은 귀뚤뚜기 — "!" 없음)
        //   가장 북쪽의 일자 덤불 (구역 2): 이상해씨 · 치코리타가 자주 (각 25%) · 3% 히스이 포푸니 ("!") · 그 밖은 구역 1 과 같음
        //   물 포켓몬 (꼬부기 42 · 리아코 42 · 잉어킹 14 "!" · 미뇽 2 "!"): 물가 덤불 (구역 4 · 물에서 3 칸 안) 70% · 그 밖의 덤불 (구역 1 · 2) 20% — 물 (구역 3) 은 들어갈 수 없음
        //   평균 레벨: 동쪽 (입구) 6 → 서쪽 8
        if ([place == 5] or [place == 6]) and [canMove == 1]{   // 1번도로 서쪽 (place 6) 도 같은 단차 · 덤불 코드 (lib/westMap.jbl)
            var int call fc5 = floor((obj.prtg.Xpos - fsOx) / 16.0 + fsZx + 0.5);
            var int call fr5 = floor(fsZy + 0.5 - (obj.prtg.Ypos - fsOy) / 16.0);
            var int call kd5 = 0;
            if [isKeyInput("left")]{
                kd5 = 1;
            }
            if [isKeyInput("right")]{
                kd5 = 2;
            }
            if [isKeyInput("down")]{
                kd5 = 3;
            }
            if [isKeyInput("up")]{
                kd5 = 4;
            }
            if [kd5 != 0]{
                var int call ldx = 0;
                var int call ldy = 0;
                if [kd5 == 1]{
                    ldx = -1;
                }
                if [kd5 == 2]{
                    ldx = 1;
                }
                if [kd5 == 3]{
                    ldy = 1;
                }
                if [kd5 == 4]{
                    ldy = -1;
                }
                var float call cx5 = fsOx + (fc5 - fsZx) * 16;   // 지금 칸 가운데
                var float call cy5 = fsOy + (fsZy - fr5) * 16;
                var float call ofx = obj.prtg.Xpos - cx5;
                var float call ofy = obj.prtg.Ypos - cy5;
                var int call lq = 1;
                loop [lq < bmLdg.length]{
                    if [bmLdg[lq] == fc5 + ldx] and [bmLdg[lq + 1] == fr5 + ldy] and [bmLdg[lq + 2] == kd5]{
                        var int call lc2 = fc5 + ldx * 2;
                        var int call lr2 = fr5 + ldy * 2;
                        var int call lok = 0;
                        if [lc2 >= 0] and [lc2 < fsW] and [lr2 >= 0] and [lr2 < fsH]{
                            if [fsSolid[lr2 * fsW + lc2 + 1] == 0]{
                                lok = 1;
                            }
                        }
                        if [ldx != 0] and ([ofy > 6] or [ofy < -6]){   // 단차와 줄이 맞을 때만
                            lok = 0;
                        }
                        if [ldy != 0] and ([ofx > 6] or [ofx < -6]){
                            lok = 0;
                        }
                        if [lok == 1]{
                            canMove = 0;
                            dis.waitF(1);
                            var float call ljx = obj.prtg.Xpos;
                            var float call ljy = obj.prtg.Ypos;
                            var float call ltx = fsOx + (lc2 - fsZx) * 16;
                            var float call lty = fsOy + (fsZy - lr2) * 16;
                            var float call ldist = (ltx - ljx) * ldx - (lty - ljy) * ldy;
                            var int call lfn = floor(ldist * 60 / 64.0) + 1;   // 걷는 빠르기 (초당 64) 그대로 걸어감
                            var int call lf = 1;
                            loop [lf <= lfn]{
                                var float call lt = lf / (lfn * 1.0);
                                dis.setObjPos("prtg", [ljx + (ltx - ljx) * lt, ljy + (lty - ljy) * lt]);
                                fc.update(obj.prtg.Xpos, obj.prtg.Ypos);
                                dis.waitF(1);
                                lf = lf + 1;
                            }
                            dis.setObjPos("prtg", [ltx, lty]);
                            direction = kd5;
                            log("단차를 내려감 (맵 %place% · %lc2% %lr2%)");
                            fc5 = lc2;
                            fr5 = lr2;
                            canMove = 1;
                            lq = bmLdg.length;
                        }
                    }
                    lq = lq + 3;
                }
            }
            if [fc5 != encC] or [fr5 != encR]{
                encC = fc5;
                encR = fr5;
                var int call z5 = 0;
                if [fc5 >= 0] and [fc5 < fsW] and [fr5 >= 0] and [fr5 < fsH]{
                    z5 = bmZone[fr5 * fsW + fc5 + 1];
                }
                if [z5 != 0] and [myParty.length > 0]{
                    var float call eRate5 = 18.75;
                    if [place == 6]{
                        eRate5 = 25;   // 1번도로 서쪽: 1번도로와 같은 출현율
                    }
                    if [jaw.random(0, 180) < eRate5]{   // 보라매숲 출현율: 1번도로 (25 / 180) 의 3/4
                        var float call wst = (fsW - 1 - fc5) / (fsW - 1.0);   // 0 동쪽 (입구) → 1 서쪽
                        var int call sp5 = 0;
                        var int call ex5 = 0;   // 1 = 드문 포켓몬 ("!")
                        var float call rl5 = jaw.random(0, 100);
                        var float call wPct = 20;
                        if [z5 == 4]{
                            wPct = 70;
                        }
                        if [rl5 < wPct]{   // 물 포켓몬
                            var float call rw = jaw.random(0, 100);
                            sp5 = 107;
                            if [rw >= 42]{
                                sp5 = 126;
                            }
                            if [rw >= 84]{
                                sp5 = 117;
                                ex5 = 1;
                            }
                            if [rw >= 98]{
                                sp5 = 112;
                                ex5 = 1;
                            }
                        }
                        else{
                            var float call r5 = jaw.random(0, 100);
                            if [r5 < 5]{   // 덤불 불문 5%: 이브이 · 피카츄
                                sp5 = 179;
                                if [jaw.random(0, 2) < 1]{
                                    sp5 = 85;
                                }
                            }
                            else if [r5 < 5 + 7 * wst]{   // 서쪽일수록 7% 에 가깝게: 스라크 ("!") · 1/3 은 귀뚤뚜기
                                sp5 = 93;
                                ex5 = 1;
                                if [jaw.random(0, 3) < 1]{
                                    sp5 = 72;
                                    ex5 = 0;
                                }
                            }
                            else if [z5 == 2] and [r5 < 8 + 7 * wst]{   // 가장 북쪽의 일자 덤불: 3% 히스이 포푸니 ("!")
                                sp5 = 151;
                                ex5 = 1;
                            }
                            else if [z5 == 2] and [r5 < 58]{   // 가장 북쪽의 일자 덤불: 이상해씨 · 치코리타
                                sp5 = 101;
                                if [jaw.random(0, 2) < 1]{
                                    sp5 = 120;
                                }
                            }
                            else{
                                var float call roll5 = jaw.random(0, 100);
                                var int call ek5 = 1;
                                var float call acc5 = bmPct[1];
                                loop [roll5 >= acc5] and [ek5 < bmSp.length]{
                                    ek5 = ek5 + 1;
                                    acc5 = acc5 + bmPct[ek5];
                                }
                                sp5 = bmSp[ek5];
                            }
                        }
                        wildId = sp5;
                        wildLv = floor(6 + 2 * wst + jaw.random(-1, 1) + 0.5);
                        if [place == 6]{   // 1번도로 서쪽 덤불: 1번도로의 포켓몬 (encSp · encPct) · Lv.7 ~ 9 (보라매숲 서쪽 끝 다음)
                            var float call roll6 = jaw.random(0, 100);
                            var int call ek6 = 1;
                            var float call acc6 = encPct[1];
                            loop [roll6 >= acc6] and [ek6 < encSp.length]{
                                ek6 = ek6 + 1;
                                acc6 = acc6 + encPct[ek6];
                            }
                            sp5 = encSp[ek6];
                            wildId = sp5;
                            ex5 = 0;
                            wildLv = 7 + floor(jaw.random(0, 3));
                        }
                        var compound call rpLead5 = myParty[1];
                        var int call rpOff = 0;
                        if [repelSteps > 0] and [wildLv < rpLead5[2]]{   // 벌레회피스프레이: 맨 앞 포켓몬보다 레벨이 낮으면 나오지 않음
                            rpOff = 1;
                            ex5 = 0;
                            log("벌레회피스프레이로 막음: %sp5% Lv.%wildLv%");
                        }
                        if [ex5 == 1]{   // 드문 포켓몬: 플레이어 머리 위에 "!" · 효과음
                            canMove = 0;
                            dis.setText([obj.prtg.Xpos, obj.prtg.Ypos + 18], "!", "wildEx", 14, true, "#ff3a3a");
                            dis.setObjLayer("wildEx", 40);
                            sou.setSpeaker("ui");
                            sou.playSfx("ui", "exclaim", 2000);
                            wait(800);
                            dis.removeObj("wildEx");
                            canMove = 1;
                        }
                        if [rpOff == 0]{
                            log("야생 포켓몬: %wildId% Lv.%wildLv% (맵 %place% · 구역 %z5% · %fc5% %fr5%)");
                            bStart = 1;
                            bGo = 1;
                        }
                    }
                }
            }
        }
        if [place == 12]{   // 유풍체육관 안 (lib/gymFly.jbl): 양력 · 부스터 · 찌르꼬 · 들어온 뒤 대사
            var int call gr = gf.tick(obj.prtg.Xpos, obj.prtg.Ypos, canMove);
            if [gr == 2]{   // 들어오자마자: 체육관 전용 도구 · 부스터를 받음
                canMove = 0;
                ft.open("");
                ft.say(lang[7489]);
                ft.close();
                canMove = 1;
            }
            if [gr == 1] or [gr == 3]{   // 양력 0 (1) · 날지 않는데 하늘 위 (3): 떨어짐 → 로비 접수처 앞
                canMove = 0;
                sou.playSfx("ui", "choose", 2000);
                ft.open("");
                if [gr == 1]{
                    ft.say(lang[7493]);
                }
                else{
                    ft.say(lang[7515]);
                }
                ft.close();
                canMove = 1;
                gyFall = 1;
            }
            if [gr >= 100] and [bGo == 0]{   // 찌르꼬와 부딪힘: 체육관의 포켓몬 (잡을 수 없음)
                canMove = 0;
                wildId = 77;
                wildLv = 10;
                noCatch = 1;
                log("체육관 찌르꼬 배틀 (%gr%)");
                bStart = 1;
                bGo = 1;
            }
        }
        if [place == 12] and [canMove == 1] and [storyGo == 0] and [trSeen == 0] and [bGo == 0] and [gyFly == 0]{   // 체육관 트레이너 (lib/fieldNpc.jbl 31 ~ 33): 5 x 5 발판에 올라서면 (날아왔으면 미끄러지다 멈춘 뒤) 붙잡음
            var int call gtk = gf.trainerAt(obj.prtg.Xpos, obj.prtg.Ypos);
            if [gtk != 0]{
                trSeen = gtk;
                trDist = 1;
            }
        }
        // ── 트레이너 (lib/fieldNpc.jbl 의 npKind 7): 보는 쪽으로 4 칸 안에 플레이어가 들어오면 (막힌 칸이 없을 때) "!" → 다가와서 대사 → 배틀 · Z 로 말을 걸어도 배틀 ──
        if [canMove == 1] and [storyGo == 0] and [trTalk == 0] and [place != 12]{   // 유풍체육관 안은 발판에 올라서면 (위)
            var int call tpc = floor((obj.prtg.Xpos - fsOx) / 16.0 + fsZx + 0.5);
            var int call tpr = floor(fsZy + 0.5 - (obj.prtg.Ypos - fsOy) / 16.0);
            var int call tk = 1;
            loop [tk <= npKind.length]{
                if [npKind[tk] == 7] and [npPlace[tk] == place] and [trDone.find(npTr[tk]) == 0]{
                    var int call tdx = 0;
                    var int call tdy = 0;
                    if [npDir[tk] == 1]{
                        tdx = -1;
                    }
                    if [npDir[tk] == 2]{
                        tdx = 1;
                    }
                    if [npDir[tk] == 3]{
                        tdy = 1;
                    }
                    if [npDir[tk] == 4]{
                        tdy = -1;
                    }
                    var int call ts = 1;
                    loop [ts <= 4]{
                        var int call tc2 = npCol[tk] + tdx * ts;
                        var int call tr2 = npRow[tk] + tdy * ts;
                        if [tc2 == tpc] and [tr2 == tpr]{
                            trSeen = tk;
                            trDist = ts;
                            break();
                        }
                        if [tc2 < 0] or [tc2 >= fsW] or [tr2 < 0] or [tr2 >= fsH]{
                            break();
                        }
                        if [fsSolid[tr2 * fsW + tc2 + 1] == 1]{
                            break();
                        }
                        ts = ts + 1;
                    }
                }
                tk = tk + 1;
            }
        }
        if [place == 5] and [canMove == 1] and [storyGo == 0] and [trSeen == 0] and [trDone.find(12) == 0]{   // 라이벌 (lib/fieldNpc.jbl 25 번 · 보라매숲 서쪽 출구 3 열 19 줄): 출구 쪽 (0 ~ 8 열 · 17 ~ 21 줄) 에 들어서면 붙잡음
            var int call rvc = floor((obj.prtg.Xpos - fsOx) / 16.0 + fsZx + 0.5);
            var int call rvr = floor(fsZy + 0.5 - (obj.prtg.Ypos - fsOy) / 16.0);
            if [rvc <= 8] and [rvr >= 17] and [rvr <= 21]{
                trSeen = 25;
                trDist = 1;
            }
        }
        if [trTalk != 0] and [trSeen == 0]{   // Z 로 말을 건 트레이너 (fieldSelect.jb)
            trSeen = trTalk;
            trDist = 1;
        }
        if [trSeen != 0]{
            var int call tq = trSeen;
            trSeen = 0;
            trTalk = 0;
            canMove = 0;
            dis.waitF(2);
            if [trDist > 1]{   // 눈이 마주침: 머리 위에 "!" → 플레이어 바로 앞까지 걸어옴
                var float call ex = fsOx + (npCol[tq] - fsZx) * 16;
                var float call ey = fsOy + (fsZy - npRow[tq]) * 16 + 24;
                dis.setText([ex, ey], "!", "trEx", 14, true, "#ff3a3a");
                dis.setObjLayer("trEx", 40);
