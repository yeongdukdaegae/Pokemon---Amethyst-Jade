            ];
        }
        fi.show(place);   // 이 맵에 놓인 (아직 안 주운) 도구
        fn.show(place);   // 이 맵의 사람
        log("맵: %place%");
        curMap = place;
    }
    startX = 0;
    startY = 0;
    if [fromLoad == 1]{   // 리포트를 불러옴: 기록한 위치에서
        startX = loadX;
        startY = loadY;
    }
    dis.setObject([startX, startY], "prtg", [16, 16], "#ffffff");
    setup("assets/codes/saveManager.jb");   // 들어오면 바로 리포트 작성 (플레이어를 만든 뒤)
    seo.setUpCam();
    col.setColliderVisible(false);   // 히트박스 (콜라이더) 표시 끔 — 보려면 true
    // 카메라: 보이지 않는 오브젝트 camt 를 따라감 — 매 프레임 fc.update 가 camt 를 옮김 (문 밖에서는 마을 · 1번도로의 끝을 넘지 않게 · lib/fieldCam.jbl)
    dis.setObject([startX, startY], "camt", [1, 1], "#ffffff");
    dis.setObjAlpha("camt", 0);
    seo.cam.default.follow("camt");
    if [dis.idWidthmode]{
        seo.cam.default.setZoom(720/240);
    }
    else{
        dis.setObject([loadX, loadY - dis.displayY/16], "anchor", [100, 100], "#ffffff");
        dis.setParent() ("anchor") as ("prtg");
        dis.setObjAlpha("anchor", 0);
        seo.cam.default.setZoom(4);
    }
    fc.start(startX, startY);
    if [fromLoad == 0]{
        wait(1000);
        dis.setObjAlpha("curtain2", 0) for 2500;
        wait(2500);
    }
    curBgm = "";   // 필드 음악은 아래 반복이 장소에 맞춰 틂
    evoQ = [];
    setup("assets/codes/characters/jahui.jb");
    setup("assets/codes/ui/fieldSelect.jb");   // 바라보는 앞 칸 표시 + Z 로 상호작용
    setup("assets/codes/ui/fieldMenu.jb");     // X 로 여는 메뉴 (2 x 3)
    setup("assets/codes/ui/placeName.jb");     // 구역을 옮기면 왼쪽 위에 장소 이름
    setup("assets/codes/timeManager.jb");      // 시간 · 날짜 (1 초 = 게임 1 분) + 실외의 빛
    speed = 1;
    canMove = 1;
    if [worldMade == 0]{
        can.setScene("battle");
        worldMade = 1;
    }
    loop [ky.z()]{ dis.waitF(1); }   // 들어올 때 누르고 있던 Z 로 바로 배틀하지 않게
    loop{
        if [quitTitle == 1]{
            // 리포트 작성 뒤 "타이틀 화면으로" (fieldMenu.jb): 검은 화면으로 덮고 → 다른 필드 코드 (fieldSelect · placeName · timeManager) 가 멈추길 기다림
            //   → 필드 (맵 · 도구 · 사람 · 플레이어) 를 모두 지우고 타이틀로 — 이어하기는 방금 쓴 리포트의 위치 · 시각에서
            canMove = 0;
            if [dis.idWidthmode == 1]{
                dis.setObject([0, 0], "warpblk", [dis.displayX, dis.displayY + 250], "#000000");
            }
            else{
                dis.setObject([0, dis.displayY / 4 + 50], "warpblk", [dis.displayX, dis.displayY / 2 + 100], "#000000");
            }
            can.setUi("warpblk");
            dis.setObjLayer("warpblk", 95);
            dis.setObjAlpha("warpblk", 0);
            dis.setObjAlpha("warpblk", 255) for 400;
            sou.break("global", true);
            wait(450);
            loadX = obj.prtg.Xpos;   // 리포트를 쓴 뒤로 움직이지 않음 → 리포트의 위치 그대로
            loadY = obj.prtg.Ypos;
            gMonth = qMo;   // 시각은 리포트를 쓴 때로 (fieldMenu.jb 가 적어 둠)
            gDay = qDa;
            gWeek = qWe;
            gHour = qHo;
            gMin = qMi;
            fi.hide(curMap);
            fn.hide(curMap);
            var string call oldId3 = "room1";
            var int call oldL3 = 2;
            var int call oldC3 = 7;
            if [curMap == 3]{
                oldId3 = "lab1";
                oldL3 = 2;
                oldC3 = 19;
            }
            if [curMap == 2]{
                oldId3 = "center1";
                oldL3 = 2;
                oldC3 = 13;
            }
            if [curMap == 9]{
                oldId3 = "center1";
                oldL3 = 2;
                oldC3 = 13;
            }
            if [curMap == 12]{
                oldId3 = "gym1";
                oldL3 = 2;
                oldC3 = 1;
                gf.suspend();   // 글라이더 · 찌르꼬 · 투명벽을 지우되 상태 (글라이더 · 양력 · …) 와 체육관 전용 도구는 남김 → 이어하기에서 그대로
            }
            if [curMap == 11]{
                oldId3 = "gymlobby1";
                oldL3 = 2;
                oldC3 = 15;
            }
            if [curMap == 1]{
                oldId3 = "road1";
                oldL3 = 3;
                oldC3 = 66;
            }
            if [curMap == 4]{
                oldId3 = "mart1";
                oldL3 = 2;
                oldC3 = 11;
            }
            if [curMap == 8]{
                oldId3 = "mart1";
                oldL3 = 2;
                oldC3 = 11;
            }
            if [curMap == 5]{
                oldId3 = "boramae1";
                oldL3 = 3;
                oldC3 = 139;
            }
            if [curMap == 6]{
                oldId3 = "road1w";
                oldL3 = 3;
                oldC3 = 4;
            }
            if [curMap == 7]{
                oldId3 = "yupung1";
                oldL3 = 3;
                oldC3 = 34;
            }
            var int call mk3 = 0;
            loop [mk3 < oldL3]{
                dis.removeObj("%oldId3%.layer%mk3%");
                mk3 = mk3 + 1;
            }
            loop [mk3 < oldL3 + oldC3]{
                dis.removeObj("%oldId3%.col%mk3%");
                mk3 = mk3 + 1;
            }
            dis.removeObj("prtg");   // 귀속된 jahui.jb 도 함께 멈춤
            dis.removeObj("camt");
            if [dis.idWidthmode == 0]{
                dis.removeObj("anchor");
            }
            if [fromLoad == 0]{
                dis.removeObj("curtain2");
            }
            dis.removeObj("warpblk");
            log("타이틀 화면으로 (장소 %place% · [%loadX%, %loadY%])");
            sendto("assets/codes/ui/titleScreen.jb");
        }
        // ── 이야기 (lib/storyCore.jbl): 연구소에서 첫 포켓몬 ──
        if [storyGo == 1]{   // 스타팅을 골랐음: 검은 화면 → 둘이 연구소 문 밖으로 (라이벌은 문 왼쪽 앞)
            storyGo = 0;
            canMove = 0;
            if [dis.idWidthmode == 1]{
                dis.setObject([0, 0], "warpblk", [dis.displayX, dis.displayY + 250], "#000000");
            }
            else{
                dis.setObject([0, dis.displayY / 4 + 50], "warpblk", [dis.displayX, dis.displayY / 2 + 100], "#000000");
            }
            can.setUi("warpblk");
            dis.setObjLayer("warpblk", 95);
            dis.setObjAlpha("warpblk", 0);
            dis.setObjAlpha("warpblk", 255) for 180;
            wait(200);
            dis.setObjPos("prtg", [456, 812]);
            direction = 3;
            place = 1;
            warpIn = 1;
        }
        if [canMove == 1] and [place == 1] and [story == 0] and [obj.prtg.Xpos > 440] and [obj.prtg.Xpos < 472] and [obj.prtg.Ypos >= 806]{
            // 연구소 문 앞: 라이벌이 말을 걸고 → 자동문이 열리고 → 라이벌 · 주인공 순서로 들어감 (주인공이 문 칸에 들어서면 아래의 순간이동으로 연구소 안)
            canMove = 0;
            dis.waitF(1);
            dis.setObjPos("prtg", [464, 816]) for 150;
            direction = 4;
            wait(170);
            fn.face(9, 2);
            ft.open(sc.rivalName());
            ft.say(lang[sc.rivalLine(7200)]);
            ft.close();
            sc.doorOpen();
            fn.walk(9, 1, 0, 16);
            fn.walk(9, 0, -1, 16);
            fn.hideOne(9);
            story = 1;
            dis.setObjPos("prtg", [464, 834]) for 250;
            wait(270);
            canMove = 1;
        }
        if [canMove == 1] and [place == 3] and [story == 1]{
            // 연구소 안: 둘이 탁자 앞까지 걸어감 → 박사 현정의 설명 → 라이벌 "네가 먼저 골라" → 고르기 (이야기 2)
            canMove = 0;
            sc.doorRemove();
            wait(300);
            dis.setObjPos("prtg", [5008, 3064]) for 750;
            direction = 4;
            fn.walk(10, 0, -3, 45);
            wait(150);
            ft.open(lang[7215]);
            ft.say(lang[7202]);
            ft.say(lang[7203]);
            ft.say(lang[7204]);
            ft.say(lang[7205]);
            ft.close();
            fn.face(10, 1);
            ft.open(sc.rivalName());
            ft.say(lang[7206]);
            ft.close();
            fn.face(10, 4);
            story = 2;
            var int call sk = 5;
            loop [sk <= 7]{   // 탁자 위의 스타팅에 말을 걸 수 있게 (이야기 2 에서만)
                fn.unmark(sk);
                fn.mark(sk);
                sk = sk + 1;
            }
            canMove = 1;
        }
        if [canMove == 1] and [place == 3] and [story == 2] and [obj.prtg.Ypos < 3004]{   // 고르기 전에는 못 나감
            canMove = 0;
            ft.open(lang[7215]);
            ft.say(lang[7216]);
            ft.close();
            dis.setObjPos("prtg", [obj.prtg.Xpos, 3020]);
            direction = 4;
            canMove = 1;
        }
        if [canMove == 1] and [place == 1] and [story == 3]{
            // 연구소 밖: 라이벌 "저 도로 끝에서 배틀하자" → 1번도로 쪽 (서쪽) 으로 뛰어가 사라짐
            canMove = 0;
            wait(200);
            fn.face(9, 2);
            direction = 1;
            ft.open(sc.rivalName());
            ft.say(lang[7213]);
            ft.close();
            fn.walk(9, 0, 1, 16);
            fn.walk(9, -12, 0, 110);   // 1번도로 쪽으로 (한 칸에 약 0.15 초)
            dis.setObjAlpha("npc9", 0) for 250;
            wait(270);
            fn.hideOne(9);
            story = 4;
            canMove = 1;
        }
        // 임시: X = 야생 포켓몬과의 배틀 · Z = 챔피언 난천과의 트레이너 배틀 (대화 없이 바로) — 지금은 봉인 (battleOn = 0 · 1 로 바꾸면 다시 켜짐)
        var int call bStart = 0;
        if [ky.x()]{
            bStart = 1;
        }
        if [ky.z()]{
            bStart = 2;
        }
        var int call bGo = 0;
        if [bStart != 0] and [battleOn == 1]{
            bGo = 1;
        }
        // ── 1번도로: 경비원 · 단차 · 덤불 ──
        if [place == 1] and [canMove == 1]{
            if [myParty.length == 0] and [obj.prtg.Xpos < -234]{   // 경비원 (사람 8 번): 포켓몬이 없으면 1번도로로 못 감 — 경계 (x = -248) 한 칸 전 (마을 마지막 칸에 들어서면) 에서 막음
                canMove = 0;
                fn.face(8, 1);
                ft.open("");
                ft.say(lang[3893]);
                ft.close();
                dis.setObjPos("prtg", [-212, obj.prtg.Ypos]);   // 마을 쪽으로 돌려보냄
                direction = 2;
                fn.face(8, 3);
                canMove = 1;
            }
            var int call pc = floor((obj.prtg.Xpos - fsOx) / 16.0 + fsZx + 0.5);
            var int call pr = floor(fsZy + 0.5 - (obj.prtg.Ypos - fsOy) / 16.0);
            // 단차: 19 열의 서쪽 (18 열) 에서 오른쪽을 누르면 동쪽 (20 열 가운데 x = -400) 으로 뛰어내림 — 동쪽에서는 막힘
            if [isKeyInput("right")] and [pr >= 43] and [pr <= 46] and [obj.prtg.Xpos > -440] and [obj.prtg.Xpos < -426]{
                canMove = 0;
                dis.waitF(1);
                var float call jx = obj.prtg.Xpos;
                var float call jy = obj.prtg.Ypos;
                var int call jf = 1;
                var int call jfn = floor((-400 - jx) * 60 / 64.0) + 1;   // 단차 넘기: 걷는 빠르기 (초당 64) 그대로 옆으로 걸어감
                loop [jf <= jfn]{
                    var float call jt = jf / (jfn * 1.0);
                    dis.setObjPos("prtg", [jx + (-400 - jx) * jt, jy]);
                    fc.update(obj.prtg.Xpos, jy);   // 카메라는 높이를 따라가지 않음 (뛰는 모습이 보이게)
                    dis.waitF(1);
                    jf = jf + 1;
                }
                dis.setObjPos("prtg", [-400, jy]);
                direction = 2;
                log("단차를 뛰어내림");
                canMove = 1;
                pc = 30;
            }
            // 뒤쪽 단차 (상하반전된 쪽 · 꺾인 길): 16 열 · 29 ~ 32 줄 (뛰어내릴 17 열의 길 안인 30 ~ 32 줄에서만) — 15 열에서 오른쪽을 누르면 17 열 가운데 (x = -608) 로 뛰어내림
            if [isKeyInput("right")] and [pr >= 30] and [pr <= 32] and [obj.prtg.Xpos > -648] and [obj.prtg.Xpos < -634]{
                canMove = 0;
                dis.waitF(1);
                var float call jx2 = obj.prtg.Xpos;
                var float call jy2 = obj.prtg.Ypos;
                var int call jf2 = 1;
                var int call jf2n = floor((-608 - jx2) * 60 / 64.0) + 1;   // 단차 넘기: 걷는 빠르기 (초당 64) 그대로 옆으로 걸어감
                loop [jf2 <= jf2n]{
                    var float call jt2 = jf2 / (jf2n * 1.0);
                    dis.setObjPos("prtg", [jx2 + (-608 - jx2) * jt2, jy2]);
                    fc.update(obj.prtg.Xpos, jy2);   // 카메라는 높이를 따라가지 않음 (뛰는 모습이 보이게)
                    dis.waitF(1);
                    jf2 = jf2 + 1;
                }
                dis.setObjPos("prtg", [-608, jy2]);
                direction = 2;
                log("단차를 뛰어내림");
                canMove = 1;
                pc = 17;
            }
            if [pc != encC] or [pr != encR]{   // 칸이 바뀜 → 덤불이면 야생 포켓몬
                encC = pc;
                encR = pr;
                var int call encZone = 0;   // 덤불: 열마다 위 줄 · 아래 줄 · 구역 (1 앞쪽 · 2 뒤쪽 (평균 레벨 +1) · 3 사이의 대각선 (평균 +0.5)) — 1번도로가 45 도로 꺾여서 열마다 다름
                if [pc >= 0] and [pc < encZn.length]{
                    if [encZn[pc + 1] != 0] and [pr >= encTop[pc + 1]] and [pr <= encBot[pc + 1]]{
                        encZone = encZn[pc + 1];
                    }
                }
                if [encZone != 0] and [myParty.length > 0]{
                    if [jaw.random(0, 180) < 25]{
                        var float call roll = jaw.random(0, 100);
                        var int call ek = 1;
                        var float call acc = encPct[1];
                        loop [roll >= acc] and [ek < encSp.length]{
                            ek = ek + 1;
                            acc = acc + encPct[ek];
                        }
                        wildId = encSp[ek];
                        wildLv = 2 + floor(jaw.random(0, 3));
                        if [encZone == 2]{   // 뒤쪽 덤불: 1 레벨 더 (평균 +1)
                            wildLv = wildLv + 1;
                        }
                        if [encZone == 3] and [jaw.random(0, 100) < 50]{   // 사이의 대각선 덤불: 50 % 로 1 레벨 더 (평균 +0.5)
                            wildLv = wildLv + 1;
                        }
                        var compound call rpLead = myParty[1];
                        if [repelSteps > 0] and [wildLv < rpLead[2]]{   // 벌레회피스프레이: 맨 앞 포켓몬보다 레벨이 낮으면 나오지 않음
                            log("벌레회피스프레이로 막음: %wildId% Lv.%wildLv%");
                        }
                        else{
