                }
                trBackK = 0;
            }
            if [whiteOut == 1]{   // 전멸: 가장 가까운 포켓몬센터의 카운터 앞으로 (검은 화면 "warpblk" 은 battleManager.jb 가 덮어 둠 → 맵이 바뀐 뒤 아래 warpIn 이 걷음)
                whiteOut = 0;
                // (유풍체육관 트레이너: 한 번 이기면 지나가도 다시 걸어오지 않음 · 말을 걸면 재대결 — fieldSelect.jb)
                // 가장 가까운 포켓몬센터: 관산마을 (place 2) · 보라매숲 (5) 부터 서쪽 (6 · 7 · 8 · 9) 은 유풍시티 (place 9)
                var int call woC = 2;
                var float call woX = 3000;   // 간호순 (5 열 2 줄) 바로 아래 · 카운터 앞 (4 줄)
                var float call woY = 3080;
                if [place >= 5]{   // 보라매숲 · 1번도로 서쪽 · 유풍시티 (상점 · 센터 포함): 유풍시티 포켓몬센터
                    woC = 9;
                    woX = 17000;
