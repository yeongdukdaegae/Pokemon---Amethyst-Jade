        if [evPendI != 0] and [canMove == 1]{   // 진화의 돌 (fieldMenu.jb): 메뉴가 닫힌 뒤 진화 화면
            canMove = 0;
            var int call epI = evPendI;
            evPendI = 0;
            sou.break("global", true);
            ev.evolveTo(epI, evPendTo);
            setup("assets/codes/saveManager.jb");
            curBgm = "";
            loop [ky.z()]{ dis.waitF(1); }
            canMove = 1;
        }
        // 친밀도: 128 걸음 (2048 픽셀) 마다 지닌 포켓몬 모두 +1 — 순간이동처럼 한 번에 크게 옮긴 것은 세지 않음
        var float call fwdx = obj.prtg.Xpos - fwX;
        var float call fwdy = obj.prtg.Ypos - fwY;
        if [fwdx < 0]{
            fwdx = 0 - fwdx;
        }
        if [fwdy < 0]{
            fwdy = 0 - fwdy;
        }
        if [fwdx + fwdy < 40]{
            fwD = fwD + fwdx + fwdy;
        }
        if [repelSteps > 0] and [fwdx + fwdy < 40]{   // 벌레회피스프레이: 16 픽셀 = 한 걸음
            rpD = rpD + fwdx + fwdy;
            loop [rpD >= 16] and [repelSteps > 0]{
                rpD = rpD - 16;
                repelSteps = repelSteps - 1;
            }
            if [repelSteps == 0] and [canMove == 1]{   // 효과가 끝남
                rpD = 0;
                canMove = 0;
                ft.open("");
                ft.say(lang[7294]);
                ft.close();
                log("벌레회피스프레이 효과 끝");
                canMove = 1;
            }
        }
        fwX = obj.prtg.Xpos;
        fwY = obj.prtg.Ypos;
