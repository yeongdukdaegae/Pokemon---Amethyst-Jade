                ];
            }
            fi.show(place);   // 이 맵에 놓인 (아직 안 주운) 도구
            fn.show(place);   // 이 맵의 사람
            log("맵: %place%");
            curMap = place;
            setup("assets/codes/saveManager.jb");   // 맵이 바뀌면 리포트 작성
        }
        if [warpIn == 1]{   // 순간이동 뒤: 검은 화면이 걷힘
            warpIn = 0;
            fc.update(obj.prtg.Xpos, obj.prtg.Ypos);   // 카메라를 먼저 새 자리로 (걷힐 때 빈 화면이 보이지 않게)
            fn.depth(obj.prtg.Ypos);
            wait(120);
            dis.setObjAlpha("warpblk", 0) for 180;
            wait(200);
            dis.removeObj("warpblk");
            if [woNurse == 0]{   // 전멸 뒤라면 간호순 대사가 끝날 때까지 못 움직임 (그 사이 선택 키로 간호순과 또 말하지 않게)
                canMove = 1;
            }
        }
        if [woNurse == 1]{   // 전멸 뒤: 간호순이 먼저 회복시켜 줌
            woNurse = 0;
            canMove = 0;
            ft.open(lang[3881]);
            ft.say(lang[7286]);
            wait(1500);
            hc.healAll();
            log("전멸 뒤 포켓몬센터: 모두 회복");
            ft.say(lang[7287]);
            ft.close();
            setup("assets/codes/saveManager.jb");   // 회복한 상태로 리포트
            loop [ky.z()]{ dis.waitF(1); }
            wait(150);   // 마지막 대사를 넘긴 선택 키가 바로 간호순 말 걸기로 이어지지 않게
            canMove = 1;
        }
        fn.depth(obj.prtg.Ypos);   // 사람과 플레이어의 앞뒤
        fc.update(obj.prtg.Xpos, obj.prtg.Ypos);   // 카메라
        dis.waitF(1);
    }
}
