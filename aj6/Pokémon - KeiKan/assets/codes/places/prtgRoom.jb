                woNurse = 1;
                canMove = 0;
                log("전멸 → 포켓몬센터 (place %woC%)");
            }
            if [bossWon == 1]{   // 보스를 쓰러뜨리거나 잡음 → 다시 나오지 않음 (리포트에 남음) · 필드에서 사라짐
                bossWon = 0;
                if [trDone.find(1000 + bossNo) == 0]{
                    trDone.add(1000 + bossNo);
                }
                var int call bh = 1;
