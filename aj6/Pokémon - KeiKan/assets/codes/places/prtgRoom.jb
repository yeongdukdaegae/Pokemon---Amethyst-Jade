            log("필드 음악: " + wantBgm);
        }
        // 건물 출입: 바깥 문 칸에 들어서면 안으로 · 안의 매트 (맨 아래) 를 밟으면 밖으로 (검은 화면으로 덮고 순간이동)
        //   포켓몬센터 (place 2 · 사거리 왼쪽 위): 문 21 · 22 열 (20 줄) ↔ 안 [3008, 3016]
        //   연구소 (place 3 · 사거리 오른쪽 위 흰 건물): 문 56 · 57 열 (20 줄) ↔ 안 [5008, 3016]
        var int call warp = 0;
        var float call wx = 0;
        var float call wy = 0;
        var int call wd = 3;
        if [place == 1] and [canMove == 1] and [obj.prtg.Ypos > 828]{
            if [obj.prtg.Xpos > -120] and [obj.prtg.Xpos < -88]{
                warp = 2;
                wx = 3008;
                wy = 3016;
                wd = 4;
            }
            if [obj.prtg.Xpos > 200] and [obj.prtg.Xpos < 232]{   // 상점 (place 4 · 과학의 힘 아저씨 오른쪽 집): 문 58 · 59 열 (20 줄) ↔ 안 [7008, 3016]
                warp = 4;
                wx = 7008;
                wy = 3016;
                wd = 4;
            }
            if [obj.prtg.Xpos > 440] and [obj.prtg.Xpos < 472]{
                warp = 3;
                wx = 5008;
                wy = 3016;
                wd = 4;
            }
        }
