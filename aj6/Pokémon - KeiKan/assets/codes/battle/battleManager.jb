                                        if [battleForm == 2]{
                                            loop [hiJ <= oppHpL.length]{
                                                if [hiJ != oppIdx] and [oppHpL[hiJ] > 0]{
                                                    hiC.add(hiJ);
                                                }
                                                hiJ = hiJ + 1;
                                            }
                                        }
                                    }
                                    var int call hiAlive = myHp;   // 때린 쪽이 서 있어야 함
                                    if [side == 2]{
                                        hiAlive = oppHp;
                                    }
                                    if [hiC.length > 0] and [hiAlive > 0]{
                                        hiUse = 1;
                                        bc.waitMsg(700);
                                        if [dItem == 542]{
                                            forceSw = side;
                                            forceIdx = hiC[floor(jaw.random(0, hiC.length)) + 1];
                                            bc.setMsg("wildappeared", replaceStr(lang[3710], "{poke}", hiNm), msgS, msgW);
                                            log("레드카드: %forceSw% 쪽의 %forceIdx% 번 칸을 끌어냄");
                                        }
                                        else{
                                            pivotBy = 3 - side;
                                            if [side == 1]{   // 교체로 나온 포켓몬은 이번 턴에 움직이지 않음 (들어간 포켓몬이 고른 기술을 대신 쓰지 않게)
                                                oppSwitched = 1;
                                            }
                                            else{
                                                mySwitched = 1;
                                            }
                                            bc.setMsg("wildappeared", replaceStr(lang[3711], "{poke}", hiNm), msgS, msgW);
                                            log("탈출버튼: %pivotBy% 쪽이 교체");
                                        }
                                        bc.waitMsg(900);
                                    }
                                }
                                if [hiUse == 1]{
                                    if [side == 1]{
                                        oppItem = 0;
                                        oppPoke[21] = 0;
                                    }
                                    else{
                                        myItem = 0;
                                        myPoke[21] = 0;
                                        myParty[myIdx] = myPoke;
                                    }
                                    dItem = 0;
                                }
                            }
                            if [tLeft > 0] and [dAb == 133] and [um[2] == 0]{   // 깨어진갑옷: 물리 기술을 맞으면 방어 -1 · 스피드 +2
                                ab.pop(3 - side, dPk, dAb);
                                ab.changeStage(3 - side, 3, -1, 0, 0);
                                ab.changeStage(3 - side, 6, 2, 0, 0);
                            }
                            if [tLeft > 0] and [dAb == 154] and [um[6] == 16]{   // 정의의마음: 악 기술을 맞으면 공격 +1
                                ab.pop(3 - side, dPk, dAb);
                                ab.changeStage(3 - side, 2, 1, 0, 0);
                            }
                            if [tLeft > 0] and [dAb == 155] and ([um[6] == 12] or [um[6] == 14] or [um[6] == 16]){   // 주눅: 벌레 · 고스트 · 악 기술을 맞으면 스피드 +1
                                ab.pop(3 - side, dPk, dAb);
                                ab.changeStage(3 - side, 6, 1, 0, 0);
                            }
                            if [tLeft == 0] and [aAb == 153]{   // 자기과신: 상대를 쓰러뜨리면 공격 +1
                                var int call mxAlive = myHp;
                                if [side == 2]{
                                    mxAlive = oppHp;
                                }
                                if [mxAlive > 0]{
                                    ab.pop(side, aPk, aAb);
                                    ab.changeStage(side, 2, 1, 0, 0);
                                }
                            }
                            if [tLeft > 0] and [aAb == 143] and [bc.hasFlag(uMove, 1) == 1] and [jaw.random(0, 10) < 3]{   // 독수: 접촉 기술로 30% 독
                                var int call ptSt = oppStatus;
                                if [side == 2]{
                                    ptSt = myStatus;
                                }
                                if [ptSt == 0] and [bc.ailImmune(3, dT1, dT2) == 0] and [ab.blocksAil(dAb, 3, weather) == 0]{
                                    ab.pop(side, aPk, aAb);
                                    if [side == 1]{
                                        oppStatus = 3;
                                    }
                                    else{
                                        myStatus = 3;
                                    }
                                    su.setStatus(tBox, 3);
                                    bc.setMsg("wildappeared", replaceStr(lang[1373], "{poke}", dPk), msgS, msgW);
                                    bc.waitMsg(900);
                                }
                            }
                        }
                        // 얼음 상태인 상대가 불꽃 기술에 맞으면 얼음이 풀림
                        if [dmg > 0] and [um[6] == 2] and [tHp - dmg > 0]{
                            if [side == 1] and [oppStatus == 6]{
                                oppStatus = 0;
                                su.setStatus("oppstat", 0);
                            }
                            if [side == 2] and [myStatus == 6]{
                                myStatus = 0;
                                su.setStatus("mystat", 0);
                            }
                        }
                        if [aItem == 253] and [dmg > 0]{   // 조개껍질방울: 준 데미지의 1/8 만큼 회복
                            var int call sbHp = myHp;
                            var int call sbMax = myStats[1];
                            var string call sbBox = "mystat";
                            if [side == 2]{
                                sbHp = oppHp;
                                sbMax = oppStats[1];
                                sbBox = "oppstat";
                            }
                            if [sbHp > 0] and [sbHp < sbMax]{
                                var int call sbNew = floor(min(sbMax, sbHp + max(1, floor(dmg / 8.0))));
                                bc.waitMsg(900);
                                su.drainHpMs(sbBox, sbHp, sbNew, sbMax, 500);
                                if [side == 1]{
                                    myHp = sbNew;
                                }
                                else{
                                    oppHp = sbNew;
                                }
                                bc.setMsg("wildappeared", replaceStr(replaceStr(lang[3704], "{poke}", aName), "{item}", lang[3253]), msgS, msgW);
                            }
                        }
                        // 체력 흡수 · 반동: 준 데미지의 % (최소 1)
                        var int call drn = bc.drainOf(uMove);
                        if [aAb == 69] and [drn < 0]{   // 돌머리: 반동 데미지를 받지 않음
                            drn = 0;
                        }
                        if [dmg > 0] and [drn != 0]{
                            var int call aHp = myHp;
                            var int call aMax = myStats[1];
                            var string call aBox = "mystat";
                            if [side == 2]{
                                aHp = oppHp;
                                aMax = oppStats[1];
                                aBox = "oppstat";
                            }
                            var int call amt = floor(dmg * abs(drn) / 100.0);
                            if [aItem == 296] and [drn > 0]{   // 큰뿌리: 흡수하는 양 1.3 배
                                amt = floor(amt * 1.3);
                            }
                            if [amt < 1]{
                                amt = 1;
                            }
                            var int call aNew = aHp + amt;
                            if [drn < 0]{
                                aNew = aHp - amt;
                            }
                            if [aNew > aMax]{
                                aNew = aMax;
                            }
                            if [aNew < 0]{
                                aNew = 0;
                            }
                            if [aNew != aHp]{
                                bc.waitMsg(900);
                                su.drainHpMs(aBox, aHp, aNew, aMax, 500);
                                if [drn > 0]{
                                    bc.setMsg("wildappeared", replaceStr(lang[1360], "{poke}", dName), msgS, msgW);
                                }
                                else{
                                    bc.setMsg("wildappeared", replaceStr(lang[1361], "{poke}", aName), msgS, msgW);
                                }
                                log(aName + " 흡수·반동 %drn% → 체력 %aHp% → %aNew%");
                                if [side == 1]{
                                    myHp = aNew;
                                }
                                else{
                                    oppHp = aNew;
                                }
                            }
                        }
                        // 왕의징표석 · 예리한이빨: 풀죽음 효과가 없는 공격에 10% 풀죽음
                        if [dmg > 0] and [k == 1] and [tHp - dmg > 0] and [dAb != 39] and [bc.flinch(uMove) == 0] and ([aItem == 221] or [aItem == 327]) and [jaw.random(0, 10) < 1]{
                            flinchSide = 3 - side;
                        }
                        // 풀죽음: 맞은 쪽이 아직 기술을 쓰기 전이고 쓰러지지 않았을 때만
                        if [dmg > 0] and [k == 1] and [tHp - dmg > 0] and [sheer == 0] and [dAb != 39] and [pg.random(100, bc.flinch(uMove) + 1) == 1]{   // 정신력은 풀죽지 않음
                            flinchSide = 3 - side;
                        }
                    }
                    // 회복기: 최대 체력의 % 만큼 회복 (이미 가득이면 실패)
                    var int call hl = bc.healOf(uMove);
                    if [hit == 1] and [hl > 0]{
                        var int call hHp = myHp;
                        var int call hMax = myStats[1];
                        var string call hBox = "mystat";
                        if [side == 2]{
                            hHp = oppHp;
                            hMax = oppStats[1];
                            hBox = "oppstat";
                        }
                        if [hHp >= hMax]{
                            bc.setMsg("wildappeared", lang[1307], msgS, msgW);
                        }
                        else{
                            var int call hNew = hHp + max(1, floor(hMax * hl / 100.0));
                            if [hNew > hMax]{
                                hNew = hMax;
                            }
                            su.drainHpMs(hBox, hHp, hNew, hMax, 500);
                            bc.setMsg("wildappeared", replaceStr(lang[1362], "{poke}", aName), msgS, msgW);
                            log(aName + " 회복 → %hNew%");
                            if [side == 1]{
                                myHp = hNew;
                            }
                            else{
                                oppHp = hNew;
                            }
                        }
                    }
                    // 상태 이상: 변화기는 맞으면 · 공격기는 데미지를 준 뒤 확률로 — 이미 상태 이상이거나 타입 때문에 안 걸리면 실패
                    var int call ail = bc.ailOf(uMove);
                    if [ail == 7]{   // 트라이어택: 화상 · 마비 · 얼음 중 하나
                        var int call tri = floor(jaw.random(0, 3));
                        ail = 1;
                        if [tri == 1]{
                            ail = 2;
                        }
                        if [tri == 2]{
                            ail = 6;
                        }
                    }
                    if [hit == 1] and [ail > 0] and [sheer == 0] and ([um[2] == 2] or [dealt > 0]){
                        var int call tSt = oppStatus;
                        var int call tAlive = oppHp;
                        var string call tName = replaceStr(oppPreT, "{poke}", nowPokeName);
                        if [side == 2]{
                            tSt = myStatus;
                            tAlive = myHp;
                            tName = myName;
                        }
                        var int call imm = bc.ailImmune(ail, dT1, dT2);
                        if [sSafe[3 - side] > 0]{   // 신비의부적: 상태 이상에 걸리지 않음
                            imm = 1;
                        }
                        if [ab.blocksAil(dAb, ail, weather) == 1]{   // 면역 · 리프가드 등
                            imm = 1;
                        }
                        if [uMove == 86] and [bc.typeEff(um[6], dT1, dT2) == 0]{   // 전기자석파는 땅 타입에 안 통함
                            imm = 1;
                        }
                        var int call aOk = 1;
                        if [tAlive == 0] or [imm == 1] or [tSt != 0]{
                            aOk = 0;
                        }
                        if [um[2] != 2] and [pg.random(100, bc.ailCh(uMove) + 1) == 0]{
                            aOk = 0;
                        }
                        if [aOk == 0] and [um[2] == 2] and [tAlive > 0]{   // 변화기가 안 통했을 때만 알림
                            if [imm == 1]{
                                bc.setMsg("wildappeared", replaceStr(lang[29], "{poke}", dName), msgS, msgW);
                            }
                            else{
                                bc.setMsg("wildappeared", lang[1307], msgS, msgW);
                            }
                        }
                        if [aOk == 1]{
                            if [dealt > 0]{
                                bc.waitMsg(900);
                            }
                            if [side == 1]{
                                oppStatus = ail;
                                oppCnt = 0;
                                oppTox = 0;
                            }
                            else{
                                myStatus = ail;
                                myCnt = 0;
                                myTox = 0;
                            }
                            su.setStatus(tBox, ail);
                            bc.setMsg("wildappeared", replaceStr(lang[1370 + ail], "{poke}", tName), msgS, msgW);
                            log(tName + " 상태 이상 → %ail%");
                            if [dAbRaw == 28] and [ail >= 1] and [ail <= 4]{   // 싱크로: 화상 · 마비 · 독을 건 상대도 같은 상태로
                                var int call syS = myStatus;
                                var string call syBox = "mystat";
                                var string call syNm = myName;
                                if [side == 2]{
                                    syS = oppStatus;
                                    syBox = "oppstat";
                                    syNm = replaceStr(oppPreT, "{poke}", nowPokeName);
                                }
                                if [syS == 0] and [bc.ailImmune(ail, aT1, aT2) == 0] and [ab.blocksAil(aAb, ail, weather) == 0]{
                                    bc.waitMsg(900);
                                    ab.pop(3 - side, dPk, dAbRaw);
                                    if [side == 1]{
                                        myStatus = ail;
                                    }
                                    else{
                                        oppStatus = ail;
                                    }
                                    su.setStatus(syBox, ail);
                                    bc.setMsg("wildappeared", replaceStr(lang[1370 + ail], "{poke}", syNm), msgS, msgW);
                                }
                            }
                        }
                    }
                    // 혼란: 변화기는 맞으면 · 공격기는 데미지를 준 뒤 확률로 (이미 혼란이면 변화기는 실패)
                    var int call cfc = bc.confOf(uMove);
                    if [hit == 1] and [cfc > 0] and [sheer == 0] and [dAb != 20] and ([um[2] == 2] or [dealt > 0]){   // 마이페이스는 혼란 안 됨
                        var int call cNow = oppConf;
                        var int call cAlive = oppHp;
                        var string call cName = replaceStr(oppPreT, "{poke}", nowPokeName);
                        if [side == 2]{
                            cNow = myConf;
                            cAlive = myHp;
                            cName = myName;
                        }
                        var int call cOk = 1;
                        if [cAlive == 0] or [cNow > 0]{
                            cOk = 0;
                        }
                        if [um[2] != 2] and [pg.random(100, cfc + 1) == 0]{
                            cOk = 0;
                        }
                        if [cOk == 0] and [um[2] == 2] and [cAlive > 0]{
                            bc.setMsg("wildappeared", lang[1307], msgS, msgW);
                        }
                        if [cOk == 1]{
                            if [dealt > 0]{
                                bc.waitMsg(900);
                            }
                            if [side == 1]{
                                oppConf = floor(jaw.random(2, 6));
                            }
                            else{
                                myConf = floor(jaw.random(2, 6));
                            }
                            bc.setMsg("wildappeared", replaceStr(lang[1390], "{poke}", cName), msgS, msgW);
                            log(cName + " 혼란");
                        }
                    }
                    // 고유 효과: 떨어뜨리기 · 사우전드애로 (비행 타입을 땅에 떨어뜨림) · 지옥찌르기 (2 턴 소리 기술 봉인) · 타르샷 (불꽃 약점) · 씨뿌리기 · 쑥쑥봄버 (씨앗)
                    if [hit == 1] and ([um[2] == 2] or [dealt > 0]){
                        var int call tgAlive = oppHp;
                        var string call tgName = replaceStr(oppPreT, "{poke}", nowPokeName);
                        if [side == 2]{
                            tgAlive = myHp;
                            tgName = myName;
                        }
                        if [um[2] == 2] and [bc.hasSp(uMove) == 1]{   // 변화 기술 중 따로 만든 이펙트가 있는 것 (손톱갈기 등 · lib/battleCore.jbl 의 spFx)
                            if [side == 1]{
                                bc.fxFrom(myTexNow, mySz);
                                bc.moveFx(uMove, obj.mypoke.Xpos, obj.mypoke.Ypos, obj.opppoke.Xpos, obj.opppoke.Ypos, pfS, mu.typeCol(um[6]));
                            }
                            else{
                                bc.fxFrom(oppTex, oppSz);
                                bc.moveFx(uMove, obj.opppoke.Xpos, obj.opppoke.Ypos, obj.mypoke.Xpos, obj.mypoke.Ypos, pfS, mu.typeCol(um[6]));
                            }
                        }
                        if ([uMove == 479] or [uMove == 614]) and [tgAlive > 0] and ([dT1 == 10] or [dT2 == 10]){
                            var int call wasG = oppGround;
                            if [side == 2]{
                                wasG = myGround;
                            }
                            if [wasG == 0]{
                                if [side == 1]{
                                    oppGround = 1;
                                }
                                else{
                                    myGround = 1;
                                }
                                bc.waitMsg(900);
                                bc.setMsg("wildappeared", replaceStr(lang[1399], "{poke}", tgName), msgS, msgW);
                            }
                        }
                        var int call wMv = 0;   // 날씨 기술: 쾌청 · 비바라기 · 모래바람 · 싸라기눈 · 설경 (5 턴)
                        if [uMove == 241]{
                            wMv = 1;
                        }
                        if [uMove == 240]{
                            wMv = 2;
                        }
                        if [uMove == 201]{
                            wMv = 3;
                        }
                        if [uMove == 258] or [uMove == 883]{
                            wMv = 4;
                        }
                        if [wMv > 0]{
                            if [weather == wMv]{
                                bc.setMsg("wildappeared", lang[1409], msgS, msgW);
                            }
                            else{
                                weather = wMv;
                                weatherT = 5;
                                var int call wItm = myItem;
                                if [side == 2]{
                                    wItm = oppItem;
                                }
                                var list call wRock = [284, 285, 283, 282];   // 날씨 바위 (지니면 그 날씨 8 턴): 쾌청 뜨거운바위 · 비 축축한바위 · 모래바람 보송보송바위 · 싸라기눈 (눈) 차가운바위
                                if [wItm == wRock[wMv]]{
                                    weatherT = 8;
                                }
                                bc.setMsg("wildappeared", lang[1409 + wMv], msgS, msgW);
                            }
                        }
                        if [uMove == 675] and [tgAlive > 0]{
                            if [side == 1]{
                                oppThroat = 2;
                            }
                            else{
                                myThroat = 2;
                            }
                        }
                        if [uMove == 749] and [tgAlive > 0]{
                            if [side == 1]{
                                oppTar = 1;
                            }
                            else{
                                myTar = 1;
                            }
                            bc.setMsg("wildappeared", replaceStr(lang[1400], "{poke}", tgName), msgS, msgW);
                            bc.waitMsg(900);
                        }
                        // ── 변화 기술의 고유 효과 (쓰는 쪽: uHp · uMax · uBox) ──
                        var int call uHp = myHp;
                        var int call uMax = myStats[1];
                        var string call uBox = "mystat";
                        var int call uNew = -1;   // 0 이상이면 쓰는 쪽 체력을 이 값으로
                        if [side == 2]{
                            uHp = oppHp;
                            uMax = oppStats[1];
                            uBox = "oppstat";
                        }
                        if [uMove == 187]{   // 배북: 최대 체력의 반을 깎아 공격을 최대로
                            if [uHp * 2 <= uMax] or [aSt[2] >= 6]{
                                bc.setMsg("wildappeared", lang[1307], msgS, msgW);
                            }
                            else{
                                uNew = uHp - floor(uMax / 2.0);
                                bc.setMsg("wildappeared", replaceStr(lang[1469], "{poke}", aName), msgS, msgW);
                                su.drainHpMs(uBox, uHp, uNew, uMax, 500);
                                bc.waitMsg(900);
                                ab.changeStage(side, 2, 12, 0, 0);
                            }
                        }
                        if [uMove == 504]{   // 껍질깨기: 방어 · 특방 -1 · 공격 · 특공 · 스피드 +2
                            ab.changeStage(side, 3, -1, 0, 0);
                            ab.changeStage(side, 5, -1, 0, 0);
                            ab.changeStage(side, 2, 2, 0, 0);
                            ab.changeStage(side, 4, 2, 0, 0);
                            ab.changeStage(side, 6, 2, 0, 0);
                        }
                        if [uMove == 254]{   // 비축하기: 3 번까지 · 방어 · 특방 +1
                            if [sStock[side] >= 3]{
                                bc.setMsg("wildappeared", lang[1307], msgS, msgW);
                            }
                            else{
                                sStock[side] = sStock[side] + 1;
                                bc.setMsg("wildappeared", replaceStr(replaceStr(lang[1470], "{poke}", aName), "{n}", "" + sStock[side]), msgS, msgW);
                                bc.waitMsg(900);
                                ab.changeStage(side, 3, 1, 0, 0);
                                ab.changeStage(side, 5, 1, 0, 0);
                            }
                        }
                        if [uMove == 150]{   // 튀어오르기
                            bc.setMsg("wildappeared", lang[1471], msgS, msgW);
                        }
                        if [uMove == 220] and [tgAlive > 0]{   // 아픔나누기: 두 포켓몬의 체력을 더해 반씩
                            var int call psAvg = floor((myHp + oppHp) / 2.0);
                            var int call psMy = floor(min(myStats[1], psAvg));
                            var int call psOp = floor(min(oppStats[1], psAvg));
                            bc.setMsg("wildappeared", lang[1472], msgS, msgW);
                            su.drainHpMs("mystat", myHp, psMy, myStats[1], 500);
                            su.drainHpMs("oppstat", oppHp, psOp, oppStats[1], 500);
                            myHp = psMy;
                            oppHp = psOp;
                        }
                        if [uMove == 262] and [tgAlive > 0]{   // 추억의선물: 자신은 쓰러지고 상대의 공격 · 특공 -2
                            ab.changeStage(3 - side, 2, -2, 1, 0);
                            ab.changeStage(3 - side, 4, -2, 1, 0);
                            uNew = 0;
                            su.drainHpMs(uBox, uHp, 0, uMax, 500);
                        }
                        if [uMove == 388] and [tgAlive > 0]{   // 고민씨: 상대의 특성을 불면으로
                            if [side == 1]{
                                oppAb = 15;
                            }
                            else{
                                myAb = 15;
                            }
