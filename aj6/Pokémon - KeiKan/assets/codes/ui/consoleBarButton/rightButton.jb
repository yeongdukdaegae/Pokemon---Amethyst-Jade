Use jawbreaker call jaw;
Use Canvas call can;
Use DisPlayer call dis;

run{
    dis.BelongObj("rightButton");
    if [dis.idWidthmode == 1]{
        dis.disableObj("rightButton");
    }
    can.setUpScene();
    dis.setupObject();
    can.setasButton("rightButton");
    can.obj.setExistableScene("*", "");
    can.bindInput("") to ("right");
    loop{
        if [can.obj.IsButtonPushed == 1]{
            dis.setObjColor("", "#bfbfbf");
        }
        else if  [can.obj.IsButtonReleased == 1]{
            dis.setObjColor("", "#dfdfdf");
        }
        dis.waitF(1);   // 화면 프레임마다 한 번만 확인 (쉬지 않고 돌면 다른 코드가 느려짐)
    }
}

