var public list call mvWindSlash;   // 923 바람베기 · Wind Slash (찌르호크 계열 전용기 · 급소에 맞기 쉬움 · 베기 + 바람 · 비접촉)
var public list call mvMindForce;   // 925 마인드포스 · Mind Force (에스퍼 · 쓰면 자신의 특공이 크게 떨어짐 · 이 게임 오리지널)
var public list call mvOvercharge;   // 924 오버차지 · Overcharge (오버히트의 전기 판 · 쓰면 자신의 특공이 크게 떨어짐)
var public list call mvHydroBall;   // 922 하이드로볼 · Hydro Ball (한달 계열 전용기 · 33% 혼란 — 혼란은 아직 구현 전)
var public compound call movedex;
var public list call moveFlinch;   // 풀죽음 확률 (%): moveFlinch[기술 id] (없는 기술은 0)
var public list call moveCrit;     // 급소 단계: moveCrit[기술 id] — 0 = 1/24 · 1 = 1/8 · 2 = 1/2 · 3 이상 = 반드시 급소
var public list call moveStatAt;   // 랭크 변화: moveStatAt[기술 id] = moveStatData 에서 그 기술 기록이 시작하는 자리 (0 = 없음)
var public list call moveStatData; // 기록 = 대상 (1 자신 · 2 상대), 확률 %, 개수, (능력, 변화량) × 개수 — 능력: 2 공격 · 3 방어 · 4 특공 · 5 특방 · 6 스피드 · 7 명중 · 8 회피
var public list call moveAil;      // 상태 이상: moveAil[기술 id] = 1 화상 · 2 마비 · 3 독 · 4 맹독 · 5 잠듦 · 6 얼음 (0 = 없음)
var public list call moveAilCh;    //   걸릴 확률 % (변화기는 100)
var public list call moveDrain;    // 체력 흡수: 준 데미지의 % 만큼 회복 (음수 = 반동 데미지)
var public list call moveHeal;     // 회복기: 최대 체력의 % 만큼 회복
var public list call moveSelfT;    // 상대를 겨냥하지 않는 기술 id (자신 · 자기 편 · 필드 대상 — 땅속 · 하늘에 숨은 상대에게도 빗나가지 않음)
var public list call moveConf;     // 혼란: moveConf[기술 id] = 상대를 혼란시킬 확률 % (0 = 없음)
var public list call moveFlags;    // 기술 분류 (합친 값): 1 접촉 · 2 펀치 · 4 물기 · 8 소리 · 16 파동 · 32 베기 · 64 탄 · 128 바람 · 256 가루 · 512 춤 · 1024 얼음을 녹임
var public list call moveHitMin;   // 연타: 때리는 횟수 최소 · 최대 (0 = 한 번) — 2 ~ 5 번은 35% · 35% · 15% · 15%
var public list call moveHitMax;
var public list call movePrio;   // 우선도: movePrio[기술 id] (0 이 아닌 기술만 적음 · 나머지는 0) — 높을수록 먼저, 같으면 스피드 순

