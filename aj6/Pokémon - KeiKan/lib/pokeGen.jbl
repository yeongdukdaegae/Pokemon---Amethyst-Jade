// 레벨캡 (하드캡): 배지 수 b (0 ~ 8) · 리그를 이기면 9 → 100
func int levelCap(int b){
    var list call caps = [11, 13, 20, 26, 33, 37, 42, 46, 50, 100];
    if [b < 0]{
        return(11);
    }
    if [b > 9]{
        return(100);
    }
    return(caps[b + 1]);
}
// 포획률: keidex 항목 [10]
func int catchRate(int id){
    var int call i = 1;
    loop [i <= keidex.length]{
        if [keidex[i][1] == id]{
            return(keidex[i][10]);
        }
        i = i + 1;
    }
    return(45);
}
func int baseExp(int id){
    var int call i = 1;
    loop [i <= keidex.length]{
        if [keidex[i][1] == id]{
            return(keidex[i][13]);
        }
        i = i + 1;
    }
    return(0);
}
func int growth(int id){
    var int call i = 1;
    loop [i <= keidex.length]{
        if [keidex[i][1] == id]{
            return(keidex[i][14]);
        }
        i = i + 1;
    }
    return(0);
}

// 그 레벨이 되는 데 필요한 누적 경험치 (본가 공식) — 성장 속도 0 보통 빠름 · 1 보통 느림 · 2 빠름 · 3 느림
func int expAt(int g, int level){
    if [level <= 1]{
        return(0);
    }
    var float call n = level;
    if [g == 1]{
        return(floor(1.2 * n * n * n - 15 * n * n + 100 * n - 140));
    }
    if [g == 2]{
        return(floor(0.8 * n * n * n));
    }
    if [g == 3]{
        return(floor(1.25 * n * n * n));
    }
    return(floor(n * n * n));
}

// 얻는 경험치 (야생 · 본가 7세대 이후 공식): [ 기초 경험치 × 상대 레벨 / 5 × { (2 × 상대 레벨 + 10) / (상대 레벨 + 내 레벨 + 10) } ^ 2.5 ] + 1
func int expGain(int base, int foeLevel, int myLevel){
    return(floor(base * foeLevel / 5.0 * pow((2.0 * foeLevel + 10) / (foeLevel + myLevel + 10), 2.5) * 0.85) + 1);   // 본가 식의 85 % (15 % 줄임)
}

// 경험치 바 비율 (0 ~ 1): 지금 레벨에서 다음 레벨까지 얼마나 찼는지
func float expRatio(int g, int level, int exp){
    if [level >= 100]{
        return(0);
    }
    var float call a = expAt(g, level);
    var float call b = expAt(g, level + 1);
    var float call r = (exp - a) / (b - a);
    if [r < 0]{
        r = 0;
    }
    if [r > 1]{
        r = 1;
    }
    return(r);
}

// 종족값: keidex 에서 id 인 포켓몬의 k 번째 능력 (1 체력 · 2 공격 · 3 방어 · 4 특공 · 5 특방 · 6 스피드)
//   keidex 항목 = [pokeID, h, a, b, c, d, s, …] → k 번째 능력은 [k + 1]
func int baseStat(int id, int k){
    var int call i = 1;
    loop [i <= keidex.length]{
        if [keidex[i][1] == id]{
            return(keidex[i][k + 1]);
        }
        i = i + 1;
    }
    return(0);
}

// 실능치 (k: 1 체력 · 2~6 그 외)
//   체력   = [ { (종족값 × 2) + 개체값 + (노력치 / 4) + 100 } × 레벨 / 100 ] + 10
//   그 외  = [ { (종족값 × 2) + 개체값 + (노력치 / 4) } × 레벨 / 100 + 5 ] × 성격 보정 (지금은 1 = 노력)
//   [ ] · 노력치 / 4 는 소수점 버림
// 성격 (본가 순서 0 ~ 24): 올리는 능력 = 성격 / 5 · 내리는 능력 = 성격 % 5 (순서 [공격, 방어, 스피드, 특수공격, 특수방어]) · 같으면 보정 없음
//   natUp · natDown: 이 화면의 능력 번호 (2 공격 · 3 방어 · 4 특공 · 5 특방 · 6 스피드 · 0 = 없음)
func int natUp(int n){
    var list call ord = [2, 3, 6, 4, 5];
    var int call u = floor(n / 5);
    var int call d = n - floor(n / 5) * 5;
    if [u == d] or [n < 0] or [n > 24]{
        return(0);
    }
    return(ord[u + 1]);
}
func int natDown(int n){
    var list call ord = [2, 3, 6, 4, 5];
    var int call u = floor(n / 5);
    var int call d = n - floor(n / 5) * 5;
    if [u == d] or [n < 0] or [n > 24]{
        return(0);
    }
    return(ord[d + 1]);
}
// 성격까지 넣은 실능치 (nat = 포켓몬 데이터 [18])
func int calcStatN(int base, int iv, int ev, int level, int k, int nat){
    if [k == 1]{
        return(calcStat(base, iv, ev, level, 1));
    }
    var float call mul = 1;
    if [natUp(nat) == k]{
        mul = 1.1;
    }
    if [natDown(nat) == k]{
        mul = 0.9;
    }
    return(floor((floor((base * 2 + iv + floor(ev / 4)) * level / 100) + 5) * mul));
}

func int calcStat(int base, int iv, int ev, int level, int k){
    if [k == 1]{
        return(floor((base * 2 + iv + floor(ev / 4) + 100) * level / 100) + 10);
    }
    var float call nature = 1;
    return(floor((floor((base * 2 + iv + floor(ev / 4)) * level / 100) + 5) * nature));
}

// 확률: 1 ~ range 사이 무작위 정수보다 fool 이 크면 1, 아니면 0
//   예: pg.random(100, 기술[4]) → 명중하면 1 (명중률 101 = 반드시 1)
func int random(int range, int fool){
    var int call r = floor(jaw.random(1, range + 1));   // 1 ~ range (jaw.random(a, b) = 기본 무작위: a 이상 b 미만의 실수)
    if [fool > r]{
        return(1);
    }
    return(0);
}

// 최대 PP: 기본 PP × (5 + 포인트업 횟수) / 5 (소수점 버림) — 포인트업 3 번이면 1.6 배
func int maxPP(int moveId, int ups){
    return(floor(movedex[moveId][7] * (5 + ups) / 5));
}

// 포켓몬 타입: k = 1 (첫째) · 2 (둘째, 없으면 0) — keidex 항목 [11] · [12]
func int speciesType(int id, int k){
    var int call i = 1;
    loop [i <= keidex.length]{
        if [keidex[i][1] == id]{
            return(keidex[i][10 + k]);
        }
        i = i + 1;
    }
    return(0);
}

// 타입 이름: lang[30 + 타입 번호] (번호는 pokeDataManager.jb 참고)
func string typeName(int t){
    return(lang[30 + t]);
}

// 이름: 별명이 "" 면 도감 이름 (lang[50 + id])
func string pokeName(int id, string nick){
    if [nick != ""]{
        return(nick);
    }
    return(lang[50 + id]);
}

var public list call lang;
