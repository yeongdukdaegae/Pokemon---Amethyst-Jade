Lib id moveUi;
Use jawbreaker call jaw;
Use DisPlayer call dis;
Use Canvas call can;
Use Magellan call mag;

// 기술 버튼 한 줄 (싸운다 → 기술 4 개)
//   [타입 아이콘] 기술 이름          [ PP / 최대 PP ]
//   · 막대 색 = 기술 타입 색 · 아이콘 = assets/textures/types/type_타입번호.png (흰색 · 원본 svg 는 svg 폴더)
//   · 자속 (내 포켓몬 타입과 같은 기술) 이면 PP 칸에 사선 두 줄 · 비자속은 굵은 사선 한 줄
//   · 기술이 없으면 (id 0) 어두운 빈 막대 · PP 칸 = 남은 PP / 최대 PP (포인트업 횟수 반영)
//   · 겉에 얇은 테두리 (타입 색보다 어둡게) · 글자는 위아래 가운데 (숫자 · 한글은 아래로 처지는 획이 없어 조금 내림)
//   id 로 만든 오브젝트: id · id%bd · id%icon · id%name · id%ppbg · id%pa · id%pb · id%pp  (removeMoveButton 으로 모두 지움)

var public compound call movedex;
var public list call lang;
var list call typeColor;   // 타입 번호 + 1 번째 = 그 타입 색
var list call typeDark;    // 테두리: 타입 색보다 어둡게 (× 0.68)

func setColors(){
    typeColor = ["#68a090", "#949495", "#e56c3e", "#5185c5", "#66a945", "#fbb917", "#6dc8eb",
        "#e09c30", "#735198", "#9c7743", "#a2c3e7", "#dd6b7b", "#9fa244", "#bfb889",
        "#684870", "#535ca8", "#4c4948", "#69a9c7", "#dab4d4", "#949495", "#40b5a5"];
    typeDark = ["#466c61", "#646465", "#9b492a", "#375a85", "#45722e", "#aa7d0f", "#4a889f",
        "#986a20", "#4e3767", "#6a502d", "#6e849d", "#964853", "#6c6e2e", "#817d5d",
        "#46304c", "#383e72", "#333130", "#477287", "#947a90", "#646465", "#2b7b70"];
}

// 타입 색 (배틀 이펙트 등에서 씀)
func string typeCol(int t){
    setColors();
    return(typeColor[t + 1]);
}

func makeMoveButton(string id, float x, float y, float w, float h, int moveId, int pp, int ppUp, int stab){
    setColors();
    var float call left = x - w / 2;
    var float call bt = max(2, h * 0.05);   // 테두리 두께
    if [moveId == 0]{   // 기술 없음: 어두운 빈 막대
        dis.setObject([x, y], "%id%bd", [w + bt * 2, h + bt * 2], "#2f3131");
        can.setUi("%id%bd");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObjLayer("%id%bd", 8);
        dis.setObject([x, y], "%id%", [w, h], "#4c4e4e");
        can.setUi("%id%");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObjLayer("%id%", 9);
        dis.setObject([x, y], "%id%icon", [1, 1], "#ffffff");   // 빈 자리 (removeMoveButton 이 같은 이름을 지우므로)
        can.setUi("%id%icon");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObject([x, y], "%id%name", [1, 1], "#ffffff");
        can.setUi("%id%name");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObject([x, y], "%id%ppbg", [1, 1], "#ffffff");
        can.setUi("%id%ppbg");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObject([x, y], "%id%pa", [1, 1], "#ffffff");
        can.setUi("%id%pa");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObject([x, y], "%id%pb", [1, 1], "#ffffff");
        can.setUi("%id%pb");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObject([x, y], "%id%pp", [1, 1], "#ffffff");
        can.setUi("%id%pp");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObjAlpha("%id%icon", 0);
        dis.setObjAlpha("%id%name", 0);
        dis.setObjAlpha("%id%ppbg", 0);
        dis.setObjAlpha("%id%pa", 0);
        dis.setObjAlpha("%id%pb", 0);
        dis.setObjAlpha("%id%pp", 0);
    }
    else{
        var list call mv = movedex[moveId];
        var int call t = mv[6];
        var int call maxpp = floor(mv[7] * (5 + ppUp) / 5);   // 포인트업 1 번마다 기본 PP 의 1/5 씩
        dis.setObject([x, y], "%id%bd", [w + bt * 2, h + bt * 2], typeDark[t + 1]);
        can.setUi("%id%bd");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObjLayer("%id%bd", 8);
        dis.setObject([x, y], "%id%", [w, h], typeColor[t + 1]);
        can.setUi("%id%");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObjLayer("%id%", 9);
        // 아이콘
        dis.setObject([left + h * 0.55, y], "%id%icon", [h * 0.78, h * 0.78], "#ffffff");
        can.setUi("%id%icon");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        mag.setObjTexture("%id%icon", "type_%t%", [0, 0], [96, 96]);
        dis.setObjLayer("%id%icon", 10);
        // PP 칸: 흰 사각형 (위아래 조금 안쪽) + 사선 (자속 두 줄 · 비자속 한 줄)
        var float call b1 = left + w * 0.631;
        var float call b2 = left + w * 0.884;
        var float call top = y + h / 2;
        var float call bot = y - h / 2;
        dis.setObject([(b1 + b2) / 2, y], "%id%ppbg", [b2 - b1, h * 0.74], "#ffffff");
        can.setUi("%id%ppbg");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setObjLayer("%id%ppbg", 10);
        if [stab == 1]{
            dis.setObjPlg([left + w * 0.700, top], [left + w * 0.749, top], [left + w * 0.705, bot], [left + w * 0.651, bot], "%id%pa", "#ffffff");
            dis.setObjPlg([left + w * 0.812, top], [left + w * 0.856, top], [left + w * 0.817, bot], [left + w * 0.763, bot], "%id%pb", "#ffffff");
        }
        else{
            dis.setObjPlg([left + w * 0.700, top], [left + w * 0.856, top], [left + w * 0.817, bot], [left + w * 0.651, bot], "%id%pa", "#ffffff");
            dis.setObjPlg([b1, y], [b1, y], [b1, y], "%id%pb", "#ffffff");   // 자리만 (지울 때 같은 이름)
            dis.setObjAlpha("%id%pb", 0);
        }
        dis.setObjLayer("%id%pa", 10);
        dis.setObjLayer("%id%pb", 10);
        // PP 글자
        var float call ps = h * 0.42;
        var float call ty = y - ps * 0.085;   // 숫자는 아래로 처지는 획이 없어 글자 상자 가운데보다 조금 내려야 눈으로 가운데
        dis.setText([(b1 + b2) / 2, ty], "%pp% / %maxpp%", "%id%pp", ps, false, "#000000");
        can.setUi("%id%pp");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        var float call pw = 0;
        dis.getVar("%id%pp", "scale[1, 1]") as pw;
        if [pw > (b2 - b1) * 0.8]{   // PP 칸에 안 들어가면 글자를 줄임 (양옆 여유)
            ps = ps * (b2 - b1) * 0.8 / pw;
            dis.setText([(b1 + b2) / 2, y - ps * 0.085], "%pp% / %maxpp%", "%id%pp", ps, false, "#000000");
            can.setUi("%id%pp");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        }
        dis.setObjLayer("%id%pp", 11);
        // 기술 이름 (PP 칸 앞까지 안 들어가면 글자를 줄임)
        var float call ns = h * 0.5;
        var string call nm = lang[300 + moveId];
        var float call nx = left + h * 1.05;
        dis.setText([nx, y - ns * 0.085], nm, "%id%name", ns, false, "#ffffff");
        can.setUi("%id%name");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        dis.setTextNudge("%id%name", "left");
        var float call room = left + w * 0.62 - nx;
        var float call nw = 0;
        dis.getVar("%id%name", "scale[1, 1]") as nw;
        if [nw > room]{
            dis.setText([nx, y - ns * room / nw * 0.085], nm, "%id%name", ns * room / nw, false, "#ffffff");
            can.setUi("%id%name");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
        }
        dis.setObjLayer("%id%name", 11);
    }
}

// 고른 기술 강조: on = 1 이면 테두리를 두껍게, 0 이면 원래 (타입 색보다 어둡게)
//   강조 테두리 색 = 상대에게 주는 상성 eff: 약점 (2 배 이상) 밝은 파랑 · 반감 이하 (무효 포함) 밝은 빨강 · 그 외 흰색
//   변화 기술 · 빈 칸은 상성과 상관없이 흰색
func highlight(string id, int moveId, float w, float h, int on, float eff){
    setColors();
    var float call bt = max(2, h * 0.05);
    if [on == 1]{
        var string call bc = "#ffffff";
        if [moveId != 0]{
            if [movedex[moveId][2] != 2]{
                if [eff > 1]{
                    bc = "#6fc0ff";
                }
                if [eff < 1]{
                    bc = "#ff6f6f";
                }
            }
        }
        dis.setObjColor("%id%bd", bc);
        dis.setObjScale("%id%bd", [w + bt * 4, h + bt * 4]);
    }
    else{
        if [moveId == 0]{
            dis.setObjColor("%id%bd", "#2f3131");
        }
        else{
            dis.setObjColor("%id%bd", typeDark[movedex[moveId][6] + 1]);
        }
        dis.setObjScale("%id%bd", [w + bt * 2, h + bt * 2]);
    }
}

// 글자를 폭 maxW 에 맞춰 줄바꿈 (띄어쓰기 기준) — 잠깐 보이지 않는 글자 오브젝트로 폭을 재 봄
func string wrapText(string s, float size, float maxW){
    var list call words = splitStr(s, " ");
    var string call out = "";
    var string call line = "";
    var string call tryLine = "";
    var float call ww = 0;
    var int call i = 1;
    loop [i <= words.length]{
        if [line == ""]{
            tryLine = words[i];
        }
        else{
            tryLine = line + " " + words[i];
        }
        dis.setText([0, 0], tryLine, "wrapTmp", size, false, "#000000");
        dis.setObjAlpha("wrapTmp", 0);
        dis.getVar("wrapTmp", "scale[1, 1]") as ww;
        if [ww > maxW] and [line != ""]{
            out = out + line + "\n";
            line = words[i];
        }
        else{
            line = tryLine;
        }
        i = i + 1;
    }
    dis.removeObj("wrapTmp");
    return(out + line);
}

// 기술 정보 (커서를 올린 기술) — 상자 [x, y] · 폭 w · 높이 h 안에
//   기술 이름 (왼쪽 맞춤)
//   위력 00 | 명중 00 | 유형 (가운데)
//   설명 (가운데 · 상자 폭에 맞춰 줄바꿈 · 넘치면 글자를 줄임)
//   만든 오브젝트: minfo1 · minfo2 · minfo3 (hideMoveInfo 로 지움)
func showMoveInfo(int moveId, float x, float y, float w, float h){
    var list call mv = movedex[moveId];
    var float call pad = h * 0.12;
    var float call top = y + h / 2;
    // 이름
    dis.setText([x - w / 2 + pad, top - h * 0.2], lang[300 + moveId], "minfo1", h / 6, false, "#ffffff");
    can.setUi("minfo1");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
    dis.setTextNudge("minfo1", "left");
    dis.setObjLayer("minfo1", 6);
    // 위력 · 명중 · 유형 (위력 없음 · 반드시 맞음 = -)
    var string call pw = "-";
    if [mv[3] > 0]{
        pw = "" + mv[3];
    }
    var string call ac = "-";
    if [mv[4] <= 100]{
        ac = "" + mv[4];
    }
    dis.setText([x, top - h * 0.42], lang[20] + " " + pw + "  |  " + lang[21] + " " + ac + "  |  " + lang[22 + mv[2]], "minfo2", h / 9, false, "#ffffff");
    can.setUi("minfo2");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
    dis.setObjLayer("minfo2", 6);
    // 설명: 남은 높이 안에 들어갈 때까지 글자를 줄여 가며 줄바꿈
    var float call ds = h / 9.5;
    var float call areaTop = top - h * 0.53;
    var float call areaBot = y - h / 2 + pad * 0.6;
    var string call desc = wrapText(lang[2000 + moveId], ds, w - pad * 2);
    var list call ln = splitStr(desc, "\n");
    var int call tries = 0;
    loop [ln.length * ds * 1.2 > areaTop - areaBot] and [tries < 6]{
        ds = ds * 0.88;
        desc = wrapText(lang[2000 + moveId], ds, w - pad * 2);
        ln = splitStr(desc, "\n");
        tries = tries + 1;
    }
    dis.setText([x, (areaTop + areaBot) / 2], desc, "minfo3", ds, false, "#e8ecff");   // 남은 자리의 가운데
    can.setUi("minfo3");   // 배틀 UI: 화면에 고정 (카메라가 흔들려도 그대로)
    dis.setObjLayer("minfo3", 6);
}

// 기술 버튼 전체에 색을 덧씌움 (고를 수 없는 기술: 회색 · 투명도 a) — 버튼을 이루는 오브젝트 모두에
func overlayButton(string id, string col, int a){
    dis.setObjOverlay("%id%bd", col, a);
    dis.setObjOverlay("%id%", col, a);
    dis.setObjOverlay("%id%icon", col, a);
    dis.setObjOverlay("%id%name", col, a);
    dis.setObjOverlay("%id%ppbg", col, a);
    dis.setObjOverlay("%id%pa", col, a);
    dis.setObjOverlay("%id%pb", col, a);
    dis.setObjOverlay("%id%pp", col, a);
}

// 떠 있는 기술 정보를 흐리게 (고를 수 없는 기술: 구애 시리즈로 다른 기술에 고정됐을 때)
func dimMoveInfo(){
    dis.setObjAlpha("minfo1", 95);
    dis.setObjAlpha("minfo2", 95);
    dis.setObjAlpha("minfo3", 95);
}

func hideMoveInfo(){
    dis.removeObj("minfo1");
    dis.removeObj("minfo2");
    dis.removeObj("minfo3");
}

func removeMoveButton(string id){
    dis.removeObj("%id%icon");
    dis.removeObj("%id%name");
    dis.removeObj("%id%ppbg");
    dis.removeObj("%id%pa");
    dis.removeObj("%id%pb");
    dis.removeObj("%id%pp");
    dis.removeObj("%id%");
    dis.removeObj("%id%bd");
}
