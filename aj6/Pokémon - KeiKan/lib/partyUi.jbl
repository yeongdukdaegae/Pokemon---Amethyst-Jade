Lib id partyUi;
Use jawbreaker call jaw;
Use DisPlayer call dis;
Use Magellan call mag;
Use soundMaster call sou;
Use pokeGen call pg;
Use Canvas call can;
Use keyIn call ky;   // Z · X (스페이스 · Esc 도)

// 포켓몬 교체 화면
//   대화 상자 안쪽 색 (#2f5f9f) 바탕 위에 대화 상자 모양의 칸 6 개 (2 x 3) — 칸마다 작게 줄인 포켓몬 그림 · 이름 · 성별 · 레벨 · 체력바 · 모습 (폼이 있는 포켓몬)
//   방향키로 고르고 Z 로 결정 · X 로 돌아감 (forced = 1 이면 X 로 못 돌아감: 쓰러진 뒤 다음 포켓몬을 고를 때)
//   만든 오브젝트: pubg · pu1 ~ pu6 + bd · sp · nm · gn · lv · hb · hf · hp · fm (choose 가 끝날 때 모두 지움)

var public compound call myParty;
var public list call partyHp;     // 내 포켓몬들의 남은 체력 (배틀 중)
var public list call lang;
var public int call puResult;
var public int call badges;   // 배지 수 → 레벨캡 (pg.levelCap)
var public int call puAny;
var public int call puKeep;    // 1 = 고른 뒤에도 창을 남겨 둠 (필드의 포켓몬 메뉴 · 그 위에 정보 · 아이템 등이 뜸)     // 1 = 쓰러진 포켓몬도 고를 수 있음 (필드의 포켓몬 메뉴)     // choose 의 결과: 고른 칸 번호 (0 = X 로 돌아감) — 기다리는 명령을 쓰는 함수는 값을 돌려줄 수 없어 여기에 적음
var list call frontIds;           // 앞모습 그림이 있는 포켓몬 (도감 번호)

func string cellCol(int i, int sel, int cur){
    if [i == sel]{
        return("#ffe040");   // 고른 칸: 노란 테두리
    }
    if [i == cur]{
        return("#ffffff");   // 지금 나가 있는 포켓몬: 흰 테두리
    }
    return("#9fbfff");
}

func paint(int sel, int cur){
    var int call i = 1;
    loop [i <= 6]{
        dis.setObjColor("pu%i%bd", cellCol(i, sel, cur));
        i = i + 1;
    }
}

// 고른 칸 번호를 puResult 에 적음 (0 = X 로 돌아감) — busted = 1 이면 지금 나가 있는 따라큐는 들킨 모습
func choose(float cx, float cy, float w, float h, int cur, int forced, int busted){
    frontIds = [67, 68, 69, 70, 71, 74, 75, 76, 77, 78, 79, 88, 89, 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 111, 112, 113, 114, 115, 116, 117, 118, 120, 121, 122, 123, 124, 125, 126, 127, 128, 131, 132, 133, 134, 135, 136, 139, 140, 141, 142, 143, 144, 145, 146, 147, 148, 149, 150, 153, 154, 155, 156, 157, 158, 159, 160, 161, 162, 163, 164, 165, 166, 167, 168, 175, 176, 80, 177, 178, 10, 12, 179, 180, 181, 182, 183, 184, 185, 186, 187, 81, 82, 83, 84, 85, 86, 72, 73, 151];
    dis.setObject([cx, cy], "pubg", [w, h], "#2f5f9f");
    dis.setObjLayer("pubg", 40);
    var float call m = h * 0.035;
    var float call cw = (w - m * 3) / 2;
    var float call ch = (h - m * 4) / 3;
    var float call bt = max(2, ch * 0.03);
    var int call i = 1;
    loop [i <= 6]{
        var int call c = i - 1 - floor((i - 1) / 2) * 2;
        var int call r = floor((i - 1) / 2);
        var float call x = cx - w / 2 + m + cw / 2 + c * (cw + m);
        var float call y = cy + h / 2 - m - ch / 2 - r * (ch + m);
        var float call left = x - cw / 2 + bt;
        var float call right = x + cw / 2 - bt;
        var float call top = y + ch / 2 - bt;
        var float call p = ch * 0.08;
        var float call sp = ch * 0.86;       // 포켓몬 그림 (정사각형)
        var int call narrow = 0;             // 칸이 좁으면 (모바일): 그림을 줄이고 레벨을 아랫줄 왼쪽으로
        if [cw < ch * 3.6]{
            narrow = 1;
            sp = ch * 0.7;
        }
        var float call tx = left + p + sp + p;   // 글자 · 체력바가 시작하는 곳
        var float call ns = ch * 0.2;
        var string call inner = "#2f5f9f";
        var string call nm = "";
        var string call gn = "";
        var string call gc = "#ffffff";
        var string call lv = "";
        var string call hpT = "";
        var string call fm = "";    // 모습 (폼) — 이름 위에 작게
        var int call itm = 0;       // 지닌 도구 (아이콘: 포켓몬 그림의 오른쪽 아래)
        var string call ko = "";    // 기절 표시 (아랫줄 왼쪽)
        var string call tex = "";
        var float call ratio = 0;
        var string call hc = "#5fd67a";
        var string call lvc = "#ffffff";
        if [i <= myParty.length]{
            var compound call pk = myParty[i];
            var int call mx = pg.calcStat(pg.baseStat(pk[1], 1), pk[3], pk[9], pk[2], 1);
            var int call hp = partyHp[i];
            nm = pg.pokeName(pk[1], pk[17]);
            itm = pk[21];
            lv = "Lv.%pk[2]%";
            if [pk[2] >= pg.levelCap(badges)]{   // 레벨캡: 레벨 글자를 빨간색으로
                lvc = "#ff5a5a";
            }
            hpT = "%hp% / %mx%";
            ratio = hp / (mx * 1.0);
            if [pk[15] == 0]{
                gn = "♂";
                gc = "#6fb4ff";
            }
            if [pk[15] == 1]{
                gn = "♀";
                gc = "#ff7f9f";
            }
            if [ratio <= 0.5]{
                hc = "#f0c040";
            }
            if [ratio <= 0.2]{
                hc = "#f05050";
            }
            if [hp <= 0]{
                inner = "#27406b";   // 쓰러진 포켓몬: 어두운 칸
                ko = lang[1454];
            }
            tex = "backNone";
            if [frontIds.find(pk[1]) != 0]{
                tex = "%pk[1]%f";
            }
            if [pk[1] == 71]{   // 따라큐: 모습
                fm = lang[1452];
                if [i == cur] and [busted == 1]{
                    fm = lang[1453];
                    tex = "71_1f";
                }
            }
            if [pk[1] == 143]{   // 배쓰나이: 적색근 · 청색근의 모습 ([29])
                fm = lang[1497];
                if [pk.length >= 29]{
                    if [pk[29] == 1]{
                        fm = lang[1498];
                        tex = "143_1f";
                    }
                }
            }
        }
        else{
            inner = "#27406b";
        }
        dis.setObject([x, y], "pu%i%bd", [cw, ch], "#9fbfff");
        dis.setObjLayer("pu%i%bd", 41);
        dis.setObject([x, y], "pu%i%", [cw - bt * 2, ch - bt * 2], inner);
        dis.setObjLayer("pu%i%", 42);
        dis.setObject([left + p + sp / 2, y], "pu%i%sp", [sp, sp], "#ffffff");
        dis.setObjLayer("pu%i%sp", 43);
        if [tex != ""]{
            mag.setObjTexture("pu%i%sp", tex, [0, 0], [96, 96]);
        }
        else{
            dis.setObjAlpha("pu%i%sp", 0);
        }
        var float call nmY = top - p - ns / 2 - ns * 0.45;   // 이름 줄: 모습 (폼) 을 그 위에 작게 쓸 자리를 두고 조금 내림 — 폼이 없는 포켓몬도 같은 높이
        var float call its = sp * 0.42;
        dis.setObject([left + p + sp - its * 0.4, y - sp / 2 + its * 0.45], "pu%i%it", [its, its], "#ffffff");
        dis.setObjLayer("pu%i%it", 44);
        if [itm > 0]{
            mag.setObjTexture("pu%i%it", "item_%itm%", [0, 0], [32, 32]);
        }
        else{
            dis.setObjAlpha("pu%i%it", 0);
        }
        dis.setText([tx, nmY], nm, "pu%i%nm", ns, false, "#ffffff");
        dis.setTextNudge("pu%i%nm", "left");
        dis.setObjLayer("pu%i%nm", 43);
        var float call nw = 0;
        dis.getVar("pu%i%nm", "scale[1, 1]") as nw;
        var float call room = right - p - tx - ns * 1.1;   // 성별 기호 자리를 뺀 폭 — 이름이 안 들어가면 글자를 줄임
        if [nw > room]{
            dis.setText([tx, nmY], nm, "pu%i%nm", ns * room / nw, false, "#ffffff");
            dis.setTextNudge("pu%i%nm", "left");
            dis.setObjLayer("pu%i%nm", 43);
            nw = room;
        }
        dis.setText([tx + nw + p * 0.5, nmY], gn, "pu%i%gn", ns, false, gc);
        dis.setTextNudge("pu%i%gn", "left");
        dis.setObjLayer("pu%i%gn", 43);
        if [narrow == 1]{
            if [ko != ""]{
                lv = "";
            }
            if [cw < ch * 2.6]{   // 아주 좁은 칸 (모바일): 체력 숫자는 빼고 체력바 · 레벨만
                hpT = "";
            }
            dis.setText([tx, y - ch * 0.02 - ch * 0.05 - p * 0.6 - ns * 0.4], lv, "pu%i%lv", ns * 0.8, false, lvc);
            dis.setTextNudge("pu%i%lv", "left");
        }
        else{
            dis.setText([right - p, top - p - ns / 2], lv, "pu%i%lv", ns * 0.85, false, lvc);
            dis.setTextNudge("pu%i%lv", "right");
        }
        dis.setObjLayer("pu%i%lv", 43);
        var float call bw = right - p - tx;   // 체력바
        var float call bh = ch * 0.1;
        var float call by = y - ch * 0.02;
        var string call bbg = "#1c2c48";
        if [i > myParty.length]{
            bbg = inner;
        }
        dis.setObject([tx + bw / 2, by], "pu%i%hb", [bw, bh], bbg);
        dis.setObjLayer("pu%i%hb", 43);
        var float call fw = max(1, (bw - 4) * ratio);
        dis.setObject([tx + 2 + fw / 2, by], "pu%i%hf", [fw, bh - 4], hc);
        dis.setObjLayer("pu%i%hf", 44);
        if [ratio <= 0]{
            dis.setObjAlpha("pu%i%hf", 0);
        }
        dis.setText([right - p, by - bh / 2 - p * 0.6 - ns * 0.4], hpT, "pu%i%hp", ns * 0.8, false, "#ffffff");
        dis.setTextNudge("pu%i%hp", "right");
        dis.setObjLayer("pu%i%hp", 43);
        dis.setText([tx, top - p * 0.45 - ns * 0.28], fm, "pu%i%fm", ns * 0.55, false, "#cfe0ff");   // 모습: 이름 위에 작게
        dis.setText([tx, by - bh / 2 - p * 0.6 - ns * 0.4], ko, "pu%i%ko", ns * 0.7, false, "#cfe0ff");
        dis.setTextNudge("pu%i%ko", "left");
        dis.setObjLayer("pu%i%ko", 43);
        dis.setTextNudge("pu%i%fm", "left");
        dis.setObjLayer("pu%i%fm", 43);
        i = i + 1;
    }
    // 화면에 고정 (필드 메뉴에서 쓸 때 카메라를 따라가지 않게 · 배틀에서는 카메라가 가운데라 그대로)
    can.setUi("pubg");
    var int call ui = 1;
    loop [ui <= 6]{
        can.setUi("pu%ui%bd");
        can.setUi("pu%ui%");
        can.setUi("pu%ui%sp");
        can.setUi("pu%ui%nm");
        can.setUi("pu%ui%gn");
        can.setUi("pu%ui%lv");
        can.setUi("pu%ui%hb");
        can.setUi("pu%ui%hf");
        can.setUi("pu%ui%hp");
        can.setUi("pu%ui%fm");
        can.setUi("pu%ui%it");
        can.setUi("pu%ui%ko");
        ui = ui + 1;
    }
    var int call sel = cur;
    if [sel < 1]{
        sel = 1;
    }
    paint(sel, cur);
    sou.setSpeaker("ui");
    loop [ky.z()] for 500{
        dis.waitF(1);
    }
    var int call out = -1;
    loop [out < 0]{
        var int call dst = sel;
        var string call held = "";
        if [isKeyInput("right")] or [isKeyInput("left")]{   // 좌우: 같은 줄의 옆 칸
            held = "right";
            if [isKeyInput("left")]{
                held = "left";
            }
            if [sel - floor(sel / 2) * 2 == 1]{
                dst = sel + 1;
            }
            else{
                dst = sel - 1;
            }
        }
        if [isKeyInput("down")]{
            held = "down";
            dst = sel + 2;
            if [dst > 6]{
                dst = sel - 4;
            }
        }
        if [isKeyInput("up")]{
            held = "up";
            dst = sel - 2;
            if [dst < 1]{
                dst = sel + 4;
            }
        }
        if [held != ""]{
            if [dst >= 1] and [dst <= myParty.length] and [dst != sel]{   // 빈 칸으로는 못 감
                sel = dst;
                paint(sel, cur);
                sou.setSpeaker("ui");   // 스피커가 아직 없을 수 있음 (리포트를 불러오자마자 등) — 이미 있으면 그대로
                sou.playSfx("ui", "choose", 2000);
            }
            loop [isKeyInput(held)] for 300{
                dis.waitF(1);
            }
        }
        if [ky.z()]{
            loop [ky.z()]{
                dis.waitF(1);
            }
            var int call okSel = puAny;
            if [partyHp[sel] > 0]{
                okSel = 1;
            }
            if [sel != cur] and [okSel == 1]{   // 지금 나가 있는 포켓몬 · 쓰러진 포켓몬은 고를 수 없음
                out = sel;
            }
        }
        if [ky.x()] and [forced == 0]{
            loop [ky.x()]{
                dis.waitF(1);
            }
            out = 0;
        }
        dis.waitF(1);
    }
    if [puKeep == 0]{   // puKeep = 1 이면 창을 남겨 둠 (나중에 close 로 지움)
        close();
    }
    puResult = out;
}

// 포켓몬 창 지우기 (choose 가 남겨 둔 것)
func close(){
    var int call i = 1;
    dis.removeObj("pubg");
    loop [i <= 6]{
        dis.removeObj("pu%i%bd");
        dis.removeObj("pu%i%");
        dis.removeObj("pu%i%sp");
        dis.removeObj("pu%i%nm");
        dis.removeObj("pu%i%gn");
        dis.removeObj("pu%i%lv");
        dis.removeObj("pu%i%hb");
        dis.removeObj("pu%i%hf");
        dis.removeObj("pu%i%hp");
        dis.removeObj("pu%i%fm");
        dis.removeObj("pu%i%it");
        dis.removeObj("pu%i%ko");
        i = i + 1;
    }
}
