Lib id aiCore;
Use jawbreaker call jaw;
Use pokeGen call pg;
Use battleCore call bc;
Use abilityCore call ab;

// 트레이너 인공지능의 예상 데미지 계산 (4 등급 이상 · battleManager.jb 가 씀)
//   쓰기 전에: aiA = 쓰는 쪽 포켓몬 데이터 · aiD = 맞는 쪽 · aiAS / aiDS = 두 쪽의 랭크 (대기 중인 포켓몬은 모두 0) · aiBrn = 쓰는 쪽이 화상이면 1
//   dmg(기술) = 예상 데미지 (난수는 가운데 값 92.5% · 급소 없음) — 상성 · 자속 · 막는 특성 (틀깨기면 무시) · 풍선 · 구애 / 생명의구슬 / 타입 강화 도구 · 화상 · 연타 (평균 횟수)
//   best() = PP 가 남은 기술 중 가장 큰 예상 데미지 (그 기술 칸은 aiBestSlot · 없으면 0)

var public compound call movedex;
var public list call moveHitMin;
var public list call moveHitMax;
var public compound call aiA;
var public compound call aiD;
var public list call aiAS;
var public list call aiDS;
var public int call aiBrn;
var public int call aiBestSlot;

func int dmg(int moveId){
    var list call m = movedex[moveId];
    if [m[2] == 2]{
        return(0);
    }
    var int call d1 = pg.speciesType(aiD[1], 1);
    var int call d2 = pg.speciesType(aiD[1], 2);
    var float call ef = bc.typeEff(m[6], d1, d2);
    if [aiA[16] != 104]{
        if [ab.blockKind(aiD[16], moveId, m[6]) > 0]{
            ef = 0;
        }
    }
    if [aiD[21] == 541] and [m[6] == 9]{
        ef = 0;
    }
    if [ef == 0]{
        return(0);
    }
    var float call pw = m[3];
    if [pw < 1]{
        pw = 60;
    }
    if [moveId <= moveHitMax.length]{
        if [moveHitMax[moveId] > 1]{
            pw = pw * (moveHitMin[moveId] + moveHitMax[moveId]) / 2.0;
        }
    }
    var int call aj = 2;
    var int call dj = 3;
    if [m[2] == 1]{
        aj = 4;
        dj = 5;
    }
    var int call lv = aiA[2];
    var float call a = pg.calcStatN(pg.baseStat(aiA[1], aj), aiA[2 + aj], aiA[8 + aj], lv, aj, aiA[18]) * bc.stageMul(aiAS[aj]);
    var float call d = pg.calcStatN(pg.baseStat(aiD[1], dj), aiD[2 + dj], aiD[8 + dj], aiD[2], dj, aiD[18]) * bc.stageMul(aiDS[dj]);
    if [aiD[21] == 640] and [m[2] == 1]{   // 돌격조끼
        d = d * 1.5;
    }
    var float call v = floor(floor(floor(lv * 2 / 5.0 + 2) * pw * a / d) / 50.0) + 2;
    v = v * 0.925;
    if [m[6] != 0] and ([m[6] == pg.speciesType(aiA[1], 1)] or [m[6] == pg.speciesType(aiA[1], 2)]){
        v = v * 1.5;
    }
    v = v * ef;
    var int call it = aiA[21];
    if [it == 220] and [m[2] == 0]{
        v = v * 1.5;
    }
    if [it == 297] and [m[2] == 1]{
        v = v * 1.5;
    }
    if [it == 270]{
        v = v * 1.3;
    }
    if [bc.itemType(it) == m[6]] and [m[6] != 0]{
        v = v * 1.2;
    }
    if [aiBrn == 1] and [m[2] == 0]{
        v = v / 2;
    }
    return(floor(v));
}

func int best(){
    var compound call mv = aiA[22];
    var compound call pp = aiA[23];
    var int call b = 0;
    aiBestSlot = 0;
    var int call k = 1;
    loop [k <= mv.length]{
        if [pp[k] > 0]{
            var int call v = dmg(mv[k]);
            if [v > b]{
                b = v;
                aiBestSlot = k;
            }
        }
        k = k + 1;
    }
    return(b);
}
