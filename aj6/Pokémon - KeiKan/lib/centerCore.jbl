Lib id centerCore;
Use jawbreaker call jaw;
Use DisPlayer call dis;
Use Canvas call can;
Use Magellan call mag;
Use soundMaster call sou;
Use moveUi call mu;
Use fieldTalk call ft;
Use fieldMenu call fm;
Use healCore call hc;
Use bagCore call bg;
Use keyIn call ky;   // Z · X (스페이스 · Esc 도)

// 포켓몬센터: 간호순 (회복) · 점원 (구입)
//   nurse(이름): 포켓몬이 없으면 포켓몬이 필요하다고 말함 · 있으면 쉬게 할지 묻고 (예 / 아니오) → 예면 모두 회복 (hc.healAll)
//   clerk(): 사러 왔는지 묻고 → 구입 화면 (shop) → "또 오세요!"
//   shop(): 화면 전체 (모바일은 조작부 위) — 맨 위 제목 · 소지금 / 가운데 도구 목록 (5 줄씩 · 위아래로 넘김) / 아래 설명 (아이콘 + 설명)
//     Z → 개수 고르기 (위아래 ±1 · 좌우 ±10 · 많아야 99 개 · 소지금으로 살 수 있는 만큼) → Z → "…괜찮으십니까?" 예 / 아니오 → 소지금에서 빼고 가방에 넣음
//     X → 나감 · 파는 도구: shStock (센터마다 정함 · 값은 bg.price = 본가 값 × 1.2)
//   만든 오브젝트 (구입 화면 · 끝날 때 모두 지움): shbg · shhdr · shtt · shmn · shr1 ~ shr5 + bd · a · b · shup · shdn · shdbd · shd · shdic · shd1 ~ shd3 · (개수) shqbd · shq · shqa · shqb

var public compound call myParty;
var public compound call bag;
var public list call lang;
var public int call ftResult;
var public int call fmResult;
var public list call fmLabels;
var public list call fmOff;
var public int call money;
var public list call shStock;   // 지금 센터에서 파는 도구 (본가 번호)
var public int call place;
var public int call shPct;    // 이 가게의 값 (%) — 관산 100 · 유풍시티 상점 90 (prtgRoom.jb)
var public int call shHeal;   // 회복 도구 값 (%) — 센터 100 · 상점 (관산마을 상점) 150 (prtgRoom.jb 가 맵을 깔 때 정함)

func nurse(string who){
    ft.open(who);
    ft.say(lang[3860]);
    if [myParty.length == 0]{
        ft.say(lang[3861]);
        ft.close();
    }
    else{
        ft.say(lang[3862]);
        ft.type(lang[3863]);
        ft.yesNo(lang[1456], lang[1457]);
        if [ftResult == 1]{
            ft.type(lang[3864]);
            wait(1500);   // 회복하는 동안 (아직 회복 소리 · 기계 연출은 없음)
            hc.healAll();
            log("포켓몬센터: 모두 회복");
            ft.say(lang[3865]);
        }
        ft.say(lang[3866]);
        ft.close();
    }
}

func clerk(){
    ft.open("");
    if [place == 4]{   // 관산마을 상점
        ft.type(lang[7241]);
    }
    else if [place == 8]{   // 유풍시티 상점
        ft.type(lang[7377]);
    }
    else{
        ft.type(lang[3870]);
    }
    ft.choose3(lang[3871], lang[3873], lang[3872]);   // 사러 왔다 · 팔러 왔다 · 괜찮아요
    if [ftResult == 1]{
        ft.close();
        shop(0);
        ft.open("");
    }
    if [ftResult == 2]{
        var compound call sl = sellList();
        if [sl.length == 0]{
            ft.say(lang[3885]);   // 팔 수 있는 물건이 없다
        }
        else{
            ft.close();
            shop(1);
            ft.open("");
        }
    }
    ft.say(lang[3866]);
    ft.close();
}

// 가방에 n 개 넣음 (같은 도구가 있으면 개수만 늘림)
func addBag(int id, int n){
    var int call found = 0;
    var int call i = 1;
    loop [i <= bag.length]{
        var compound call b = bag[i];
        if [b[1] == id]{
            b[2] = b[2] + n;
            bag[i] = b;
            found = 1;
        }
        i = i + 1;
    }
    if [found == 0]{
        var compound call nb = [id, n];
        bag.add(nb);
    }
}

// 설명 칸 채우기 (아이콘 + 글 · 폭에 맞춰 많아야 3 줄)
func desc(int id, string text, float x0, float y0, float w0, float h0){
    if [id > 0]{
        mag.setObjTexture("shdic", "item_" + id, [0, 0], [32, 32]);
        dis.setObjAlpha("shdic", 255);
    }
    else{
        dis.setObjAlpha("shdic", 0);
    }
    var float call ls = h0 * 0.17;
    var list call dl = splitStr(mu.wrapText(text, ls, w0 - h0 * 1.2), "\n");
    var int call q = 1;
    loop [q <= 3]{
        var string call lt = "";
        if [q <= dl.length]{
            lt = dl[q];
        }
        dis.setTxtContent("shd%q%", lt);
        q = q + 1;
    }
}

// 팔 수 있는 가방의 도구 (가방 순서 · 값이 0 인 중요한 물건은 뺌)
func compound sellList(){
    var compound call r = [];
    var int call i = 1;
    loop [i <= bag.length]{
        var compound call b = bag[i];
        if [bg.sellPrice(b[1]) > 0] and [b[2] > 0]{
            r.add(b[1]);
        }
        i = i + 1;
    }
    return(r);
}

// 이 가게의 값: 회복 도구 (분류 2) 는 shHeal % 로
func int shopPrice(int id){
    var int call p = bg.price(id);
    if [bg.cat(id) == 2] and [shHeal > 0]{
        p = floor(p * shHeal / 100.0);
    }
    if [shPct > 0] and [shPct != 100]{   // 유풍시티 상점: 관산보다 조금 쌈
        p = floor(p * shPct / 100.0);
    }
    return(p);
}

// sellMode 0 = 사기 (shStock · shopPrice) · 1 = 팔기 (가방의 도구 · bg.sellPrice · 많아야 가진 개수 · 소지금에 더하고 가방에서 뺌)
func shop(int sellMode){
    var float call cx = 0;
    var float call cy = 0;
    var float call w = dis.displayX;
    var float call h = dis.displayY;
    if [dis.idWidthmode == 0]{
        cy = dis.displayY / 4;
        h = dis.displayY / 2;
    }
    var compound call stock = [];
    if [sellMode == 1]{
        stock = sellList();
    }
    else{
        var int call si = 1;
        loop [si <= shStock.length]{
            stock.add(shStock[si]);
            si = si + 1;
        }
    }
    var int call n = stock.length;
    var int call V = 5;   // 한 번에 보이는 줄
    var float call m = h * 0.03;
    var float call bt = max(2, h * 0.008);
    var float call hH = h * 0.1;
    var float call dH = h * 0.24;
    var string call ttl = lang[3874];
    if [sellMode == 1]{
        ttl = lang[3882];
    }
    // 바탕 · 맨 위 (제목 · 소지금)
    dis.setObject([cx, cy], "shbg", [w, h], "#2f5f9f");
    dis.setObject([cx, cy + h / 2 - hH / 2], "shhdr", [w, hH], "#263f6b");
    dis.setText([cx - w / 2 + hH * 0.4, cy + h / 2 - hH / 2 - hH * 0.05], ttl, "shtt", hH * 0.5, false, "#ffffff");
    dis.setTextNudge("shtt", "left");
    dis.setText([cx + w / 2 - hH * 0.4, cy + h / 2 - hH / 2 - hH * 0.05], replaceStr(lang[3845], "{m}", bg.comma(money)), "shmn", hH * 0.5, false, "#ffe9a8");
    dis.setTextNudge("shmn", "right");
    // 아래 (설명)
    var float call dY = cy - h / 2 + m + dH / 2;
    var float call dW = w - m * 2;
    dis.setObject([cx, dY], "shdbd", [dW, dH], "#9fbfff");
    dis.setObject([cx, dY], "shd", [dW - bt * 2, dH - bt * 2], "#2f5f9f");
    var float call ic = dH * 0.62;
    dis.setObject([cx - dW / 2 + dH * 0.15 + ic / 2, dY], "shdic", [ic, ic], "#ffffff");
    var float call ls = dH * 0.17;
    var int call q = 1;
    loop [q <= 3]{
        dis.setText([cx - dW / 2 + dH * 0.3 + ic, dY + ls * 1.4 - (q - 1) * ls * 1.4], "", "shd%q%", ls, false, "#cfe0ff");
        dis.setTextNudge("shd%q%", "left");
        q = q + 1;
    }
    // 가운데 (목록)
    var float call lTop = cy + h / 2 - hH - m;
    var float call lBot = dY + dH / 2 + m;
    var float call rh = (lTop - lBot - m * (V - 1)) / V;
    var float call rw = w - m * 2 - rh * 0.9;
    var float call rx = cx - w / 2 + m + rw / 2;
    var int call k = 1;
    loop [k <= V]{
        var float call ry = lTop - rh / 2 - (k - 1) * (rh + m);
        dis.setObject([rx, ry], "shr%k%bd", [rw, rh], "#9fbfff");
        dis.setObject([rx, ry], "shr%k%", [rw - bt * 2, rh - bt * 2], "#2f5f9f");
        dis.setText([rx - rw / 2 + rh * 0.4, ry - rh * 0.04], "", "shr%k%a", rh * 0.45, false, "#ffffff");
        dis.setTextNudge("shr%k%a", "left");
        dis.setText([rx + rw / 2 - rh * 0.4, ry - rh * 0.04], "", "shr%k%b", rh * 0.45, false, "#ffe9a8");
        dis.setTextNudge("shr%k%b", "right");
        k = k + 1;
    }
    var float call ax = cx + w / 2 - m - rh * 0.45;
    dis.setText([ax, lTop - rh * 0.4], "▲", "shup", rh * 0.4, false, "#cfe0ff");
    dis.setText([ax, lBot + rh * 0.4], "▼", "shdn", rh * 0.4, false, "#cfe0ff");
    can.setUi("shbg");
    can.setUi("shhdr");
    can.setUi("shtt");
    can.setUi("shmn");
    can.setUi("shdbd");
    can.setUi("shd");
    can.setUi("shdic");
    can.setUi("shup");
    can.setUi("shdn");
    dis.setObjLayer("shbg", 60);
    dis.setObjLayer("shhdr", 61);
    dis.setObjLayer("shtt", 62);
    dis.setObjLayer("shmn", 62);
    dis.setObjLayer("shdbd", 61);
    dis.setObjLayer("shd", 62);
    dis.setObjLayer("shdic", 63);
    dis.setObjLayer("shup", 63);
    dis.setObjLayer("shdn", 63);
    q = 1;
    loop [q <= 3]{
        can.setUi("shd%q%");
        dis.setObjLayer("shd%q%", 63);
        q = q + 1;
    }
    k = 1;
    loop [k <= V]{
        can.setUi("shr%k%bd");
        can.setUi("shr%k%");
        can.setUi("shr%k%a");
        can.setUi("shr%k%b");
        dis.setObjLayer("shr%k%bd", 61);
        dis.setObjLayer("shr%k%", 62);
        dis.setObjLayer("shr%k%a", 63);
        dis.setObjLayer("shr%k%b", 63);
        k = k + 1;
    }
    var int call sel = 1;
    var int call tp = 1;          // 맨 윗줄에 보이는 도구
    var int call redraw = 1;
    sou.setSpeaker("ui");
    loop [ky.z()] for 500{ dis.waitF(1); }
    var int call out = 0;
    loop [out == 0]{
        if [redraw == 1]{
            redraw = 0;
            k = 1;
            loop [k <= V]{
                var int call it = tp + k - 1;
                var string call na = "";
                var string call pa = "";
                if [it <= n]{
                    na = lang[3000 + stock[it]];
                    var int call pv = shopPrice(stock[it]);
                    if [sellMode == 1]{
                        pv = bg.sellPrice(stock[it]);
                    }
                    pa = replaceStr(lang[3875], "{p}", bg.comma(pv));
                }
                dis.setTxtContent("shr%k%a", na);
                dis.setTxtContent("shr%k%b", pa);
                if [it == sel]{
                    dis.setObjColor("shr%k%bd", "#ffe040");
                }
                else{
                    dis.setObjColor("shr%k%bd", "#9fbfff");
                }
                k = k + 1;
            }
            if [tp > 1]{
                dis.setObjAlpha("shup", 255);
            }
            else{
                dis.setObjAlpha("shup", 0);
            }
            if [tp + V - 1 < n]{
                dis.setObjAlpha("shdn", 255);
            }
            else{
                dis.setObjAlpha("shdn", 0);
            }
            if [n > 0]{
                desc(stock[sel], lang[5000 + stock[sel]], cx, dY, dW, dH);
            }
        }
        var string call held = "";
        if [isKeyInput("down")] and [sel < n]{
            held = "down";
            sel = sel + 1;
        }
        else if [isKeyInput("up")] and [sel > 1]{
            held = "up";
            sel = sel - 1;
        }
        if [held != ""]{
            if [sel < tp]{
                tp = sel;
            }
            if [sel > tp + V - 1]{
                tp = sel - V + 1;
            }
            redraw = 1;
            sou.setSpeaker("ui");   // 스피커가 아직 없을 수 있음 (리포트를 불러오자마자 등) — 이미 있으면 그대로
            sou.playSfx("ui", "choose", 2000);
            loop [isKeyInput(held)] for 250{ dis.waitF(1); }
        }
        if [ky.z()]{
            loop [ky.z()]{ dis.waitF(1); }
            sou.setSpeaker("ui");   // 스피커가 아직 없을 수 있음 (리포트를 불러오자마자 등) — 이미 있으면 그대로
            sou.playSfx("ui", "choose", 2000);
            var int call id = stock[sel];
            var int call pr = shopPrice(id);
            var int call most = floor(money / pr);
            if [sellMode == 1]{
                pr = bg.sellPrice(id);
                most = bg.countOf(id);
            }
            if [most > 99]{
                most = 99;
            }
            if [most < 1]{
                desc(id, lang[3876], cx, dY, dW, dH);   // 소지금이 모자랍니다
                loop [ky.z() == 0] and [ky.x() == 0]{ dis.waitF(1); }
                loop [ky.z()] or [ky.x()]{ dis.waitF(1); }
                redraw = 1;
            }
            else{
                // 개수 고르기: 설명 칸 오른쪽 위에 작은 상자 (x 개수 · 합계)
                var int call askL = 3877;   // {item}(을)를 몇 개 사시겠습니까?
                if [sellMode == 1]{
                    askL = 3883;            // {item}(을)를 몇 개 파시겠습니까?
                }
                desc(id, replaceStr(lang[askL], "{item}", lang[3000 + id]), cx, dY, dW, dH);
                var float call qw = max(w * 0.3, dH * 2.4);
                var float call qh = dH * 0.62;
                var float call qx = cx + w / 2 - m - qw / 2;
                var float call qy = dY + dH / 2 + qh / 2 + m * 0.5;
                dis.setObject([qx, qy], "shqbd", [qw, qh], "#ffe040");
                dis.setObject([qx, qy], "shq", [qw - bt * 2, qh - bt * 2], "#263f6b");
                dis.setText([qx - qw / 2 + qh * 0.3, qy - qh * 0.04], "", "shqa", qh * 0.4, false, "#ffffff");
                dis.setTextNudge("shqa", "left");
                dis.setText([qx + qw / 2 - qh * 0.3, qy - qh * 0.04], "", "shqb", qh * 0.4, false, "#ffe9a8");
                dis.setTextNudge("shqb", "right");
                can.setUi("shqbd");
                can.setUi("shq");
                can.setUi("shqa");
                can.setUi("shqb");
                dis.setObjLayer("shqbd", 64);
                dis.setObjLayer("shq", 65);
                dis.setObjLayer("shqa", 66);
                dis.setObjLayer("shqb", 66);
                var int call cnt = 1;
                var int call qOut = 0;   // 1 = 정함 · 2 = 그만둠
                var int call qDraw = 1;
                loop [qOut == 0]{
                    if [qDraw == 1]{
                        qDraw = 0;
                        dis.setTxtContent("shqa", "x " + cnt);
                        dis.setTxtContent("shqb", replaceStr(lang[3875], "{p}", bg.comma(cnt * pr)));
                    }
                    var int call nc = cnt;
                    var string call qh2 = "";
                    if [isKeyInput("up")]{
                        qh2 = "up";
                        nc = cnt + 1;
                    }
                    if [isKeyInput("down")]{
                        qh2 = "down";
                        nc = cnt - 1;
                    }
                    if [isKeyInput("right")]{
                        qh2 = "right";
                        nc = cnt + 10;
                    }
                    if [isKeyInput("left")]{
                        qh2 = "left";
                        nc = cnt - 10;
                    }
                    if [qh2 != ""]{
                        if [nc > most]{
                            nc = most;
                        }
                        if [nc < 1]{
                            nc = 1;
                        }
                        if [nc != cnt]{
                            cnt = nc;
                            qDraw = 1;
                            sou.setSpeaker("ui");   // 스피커가 아직 없을 수 있음 (리포트를 불러오자마자 등) — 이미 있으면 그대로
                            sou.playSfx("ui", "choose", 2000);
                        }
                        loop [isKeyInput(qh2)] for 180{ dis.waitF(1); }
                    }
                    if [ky.z()]{
                        loop [ky.z()]{ dis.waitF(1); }
                        sou.setSpeaker("ui");   // 스피커가 아직 없을 수 있음 (리포트를 불러오자마자 등) — 이미 있으면 그대로
                        sou.playSfx("ui", "choose", 2000);
                        qOut = 1;
                    }
                    if [ky.x()]{
                        loop [ky.x()]{ dis.waitF(1); }
                        qOut = 2;
                    }
                    dis.waitF(1);
                }
                dis.removeObj("shqbd");
                dis.removeObj("shq");
                dis.removeObj("shqa");
                dis.removeObj("shqb");
                if [qOut == 1]{
                    var int call total = cnt * pr;
                    var int call cfL = 3878;
                    if [sellMode == 1]{
                        cfL = 3884;
                    }
                    var string call cf = replaceStr(replaceStr(replaceStr(lang[cfL], "{item}", lang[3000 + id]), "{n}", "" + cnt), "{total}", bg.comma(total));
                    desc(id, cf, cx, dY, dW, dH);   // {item} {n}개, 합해서 {total}원입니다. 괜찮으십니까?
                    fmLabels = [];
                    fmLabels.add(lang[1456]);
                    fmLabels.add(lang[1457]);
                    fmOff = [0, 0];
                    fm.choice(cx, cy, w, h);
                    if [fmResult == 1] and [sellMode == 1]{   // 팔기: 소지금에 더하고 가방에서 뺌 → 목록을 다시 (다 팔면 그 줄이 사라짐)
                        money = money + total;
                        bg.take(id, cnt);
                        log("판매: " + id + " x " + cnt + " = " + total + " · 소지금 " + money);
                        dis.setTxtContent("shmn", replaceStr(lang[3845], "{m}", bg.comma(money)));
                        desc(id, replaceStr(replaceStr(lang[3886], "{item}", lang[3000 + id]), "{total}", bg.comma(total)), cx, dY, dW, dH);
                        loop [ky.z() == 0] and [ky.x() == 0]{ dis.waitF(1); }
                        loop [ky.z()] or [ky.x()]{ dis.waitF(1); }
                        stock = sellList();
                        n = stock.length;
                        if [sel > n]{
                            sel = n;
                        }
                        if [tp > 1] and [tp + V - 1 > n]{
                            tp = max(1, n - V + 1);
                        }
                        if [n == 0]{
                            out = 1;
                        }
                    }
                    if [fmResult == 1] and [sellMode == 0]{
                        money = money - total;
                        addBag(id, cnt);
                        log("구입: " + id + " x " + cnt + " = " + total + " · 소지금 " + money);
                        dis.setTxtContent("shmn", replaceStr(lang[3845], "{m}", bg.comma(money)));
                        desc(id, lang[3879], cx, dY, dW, dH);   // 감사합니다!
                        loop [ky.z() == 0] and [ky.x() == 0]{ dis.waitF(1); }
                        loop [ky.z()] or [ky.x()]{ dis.waitF(1); }
                    }
                }
                redraw = 1;
            }
        }
        if [ky.x()]{
            loop [ky.x()]{ dis.waitF(1); }
            out = 1;
        }
        dis.waitF(1);
    }
    dis.removeObj("shbg");
    dis.removeObj("shhdr");
    dis.removeObj("shtt");
    dis.removeObj("shmn");
    dis.removeObj("shdbd");
    dis.removeObj("shd");
    dis.removeObj("shdic");
    dis.removeObj("shup");
    dis.removeObj("shdn");
    q = 1;
    loop [q <= 3]{
        dis.removeObj("shd%q%");
        q = q + 1;
    }
    k = 1;
    loop [k <= V]{
        dis.removeObj("shr%k%bd");
        dis.removeObj("shr%k%");
        dis.removeObj("shr%k%a");
        dis.removeObj("shr%k%b");
        k = k + 1;
    }
}
