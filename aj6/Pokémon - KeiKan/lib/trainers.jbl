Lib id trainers;
Use jawbreaker call jaw;
Use pokeGen call pg;

// 트레이너 정보: load(번호) 가 상대 포켓몬들 (oppParty) · 그림 (trTex) · 직함과 이름의 lang 번호 (trClassL · trNameL) 를 채움
//   포켓몬 = pg.makeSet(도감 번호, 레벨, 0, 특성, 기술 4 개, 노력치 H A B C D S) — 개체값 31 · [15] 성별 (0 수컷 · 1 암컷) · [21] 지닌 도구
//   칸 순서대로 나옴 (마지막 칸 = 에이스)
//   1 = 챔피언 난천 (이벤트 매치 · Lv.50 까지 · 인공지능 5 등급)
//   2 ~ 4 = 1번도로의 곤충채집소년 (민수 · 준호 · 태양) — 초반 벌레 포켓몬 (노로키 · 꿈벅) · 평균 레벨 6 · 인공지능 2 등급
//   5 ~ 11 = 보라매숲의 곤충채집소년 · 짧은치마
//   13 ~ 15 = 유풍체육관 트레이너 (하늬 · 마파 · 높새) — 비행 포켓몬 두 마리씩 · 평균 Lv.9.5 · 상금 800 원
//   16 = 유풍체육관 관장 휴린 — 앗치 Lv.12 · 찌르꼬 Lv.12 · 아크치 Lv.14 (에이스) · 개체값 6V · 노력치 · 레벨보다 앞선 기술 배치 · 인공지능 4 등급 · 이기면 유풍배지 (Flowd Badge)
//   12 = 라이벌 (보라매숲 서쪽 출구) — 주인공이 남자면 지현 · 여자면 재휘 · 노로키 Lv.8 · 앗치 Lv.9 · 스타팅 Lv.11 (개체값 3V · 주인공에게 유리한 타입) · 기술은 자력기 · 상금 1000 원

var public compound call oppParty;
var public string call trTex;
var public int call trClassL;
var public int call trNameL;
var public int call trTexS;   // 트레이너 그림 크기 (정사각형 · 난천 128 · DPPt 트레이너 80)
var public int call trFoot;   // 그림에서 발끝 줄 (발판 가운데에 옴)
var public int call trPrize;  // 상금 단위 (마지막 포켓몬 레벨 × 이 값)
var public int call trPrizeFix;   // 0 이 아니면 상금을 이 값으로 (라이벌 1000 원)
var public int call trAi;
var public int call trLoseL;   // 배틀에서 졌을 때 (플레이어가 이겼을 때) 트레이너의 대사 lang 번호 (0 = 없음) — battleManager.jb 가 "승부에서 이겼다!" 다음에 띄움
var public bit call isBoy;     // 주인공이 남자면 1 (라이벌 = 지현) · 여자면 0 (라이벌 = 재휘)
var public int call stPick;    // 주인공이 고른 스타팅 (1 · 4 · 7) → 라이벌은 유리한 스타팅   // 인공지능 등급 1 ~ 5 (battleManager.jb 의 설명 참고): 1 무작위 · 2 가장 잘 듣는 공격 · 3 + 변화 기술 · 4 + 예상 데미지 · 후내밀기 · 5 + 교체 · 대면조작 · 예측

func load(int id){
    oppParty = [];
    trAi = 3;
    trTexS = 128;
    trFoot = 79;
    trPrize = 0;
    trPrizeFix = 0;
    trLoseL = 0;
    if [id >= 1] and [id <= 11]{
        trLoseL = 7400 + id;
    }
    if [id == 12]{   // 라이벌 (아직 빈 텍스쳐 틀) — 포켓몬: 개체값 무작위 · 그 레벨까지의 자력기 (pg.newPoke) · 스타팅만 3V (pg.newStarter)
        trTex = "trRival";
        trTexS = 80;
        trFoot = 79;
        trPrize = 120;
        trPrizeFix = 1000;   // 라이벌 승리 보상: 1000 원 (정해진 값)
        trClassL = 7380;
        trNameL = 3768;
        trLoseL = 7413;
        if [isBoy == 1]{
            trNameL = 3767;
            trLoseL = 7412;
        }
        trAi = 3;
        var int call rvSt = 1;   // 주인공 풀 → 불 · 불 → 물 · 물 → 풀 (lib/storyCore.jbl 의 rivalPick 과 같음)
        if [stPick == 1]{
            rvSt = 4;
        }
        if [stPick == 4]{
            rvSt = 7;
        }
        oppParty.add(pg.newPoke(10, 8, 1));     // 노로키 Lv.8
        oppParty.add(pg.newPoke(14, 9, 1));     // 앗치 Lv.9
        oppParty.add(pg.newStarter(rvSt, 11, 1));   // 스타팅 Lv.11 (에이스 · 3V)
    }
    if [id == 1]{
        trTex = "trCynthia";
        trClassL = 3740;
        trNameL = 3741;
        trAi = 5;
        var compound call c1 = pg.makeSet(116, 47, 0, 46, 247, 399, 261, 94, 252, 0, 4, 252, 0, 0);     // 화강돌: 프레셔 · 섀도볼 · 악의파동 · 도깨비불 · 사이코키네시스
        c1[21] = 234;   // 먹다남은음식
        oppParty.add(c1);
        var compound call c2 = pg.makeSet(164, 47, 0, 114, 503, 414, 58, 105, 252, 0, 252, 4, 0, 0);    // 트리토돈: 마중물 · 열탕 · 대지의힘 · 냉동빔 · HP회복
        c2[21] = 540;   // 울퉁불퉁멧
        oppParty.add(c2);
        var compound call c3 = pg.makeSet(69, 48, 0, 36, 585, 94, 85, 347, 4, 0, 0, 252, 0, 252);       // 가디안: 트레이스 · 문포스 · 사이코키네시스 · 10만볼트 · 명상
        c3[21] = 157;   // 리샘열매
        oppParty.add(c3);
        var compound call c4 = pg.makeSet(141, 48, 0, 5, 85, 430, 521, 86, 252, 0, 0, 252, 4, 0);       // 자포코일: 옹골참 · 10만볼트 · 러스터캐논 · 볼트체인지 · 전기자석파
        c4[21] = 541;   // 풍선
        oppParty.add(c4);
        var compound call c5 = pg.makeSet(150, 49, 0, 47, 89, 556, 420, 444, 4, 252, 0, 0, 0, 252);     // 맘모꾸리: 두꺼운지방 · 지진 · 고드름떨구기 · 얼음뭉치 · 스톤에지
        c5[21] = 275;   // 기합의띠
        oppParty.add(c5);
        var compound call c6 = pg.makeSet(147, 50, 0, 24, 89, 337, 444, 14, 4, 252, 0, 0, 0, 252);      // 한카리아스 (에이스): 까칠한피부 · 지진 · 드래곤클로 · 스톤에지 · 칼춤
        c6[15] = 1;
        c6[21] = 158;   // 자뭉열매
        oppParty.add(c6);
    }
    if [id >= 2] and [id <= 4]{   // 곤충채집소년 (DPPt 그림 80 x 80 · 발끝 78 줄)
        trTex = "trBugCatcher";
        trTexS = 80;
        trFoot = 78;
        trPrize = 16;
        trClassL = 7260;
        trNameL = 7259 + id;
        trAi = 2;
        if [id == 2]{   // 민수 (1번도로 초입): 꿈벅 Lv.6
            oppParty.add(pg.newPoke(12, 6, 1));
        }
        if [id == 3]{   // 준호 (대각선 덤불 위): 노로키 Lv.5 · 꿈벅 Lv.7
            oppParty.add(pg.newPoke(10, 5, 1));
            oppParty.add(pg.newPoke(12, 7, 1));
        }
        if [id == 4]{   // 태양 (끝 · 보라매숲 앞): 꿈벅 Lv.5 · 노로키 Lv.7
            oppParty.add(pg.newPoke(12, 5, 1));
            oppParty.add(pg.newPoke(10, 7, 1));
        }
    }
    // 5 ~ 11 = 보라매숲 (평균 레벨: 1번도로 쪽 입구 7 → 서쪽으로 갈수록 9) — 곤충채집소년 5 · 7 · 9 / 짧은치마 6 · 8 · 10 · 11 (두더류 · 찌르꼬 · 짜랑랑 · 드물게 이브이 · 피카츄)
    if [id == 5] or [id == 7] or [id == 9]{
        trTex = "trBugCatcher";
        trTexS = 80;
        trFoot = 78;
        trPrize = 16;
        trClassL = 7260;
        trNameL = 7300 + id;
        trAi = 2;
        if [id == 5]{   // 민혁 (입구 쪽): 꿈벅 Lv.6 · 귀뚤뚜기 Lv.7
            oppParty.add(pg.newPoke(12, 6, 1));
            oppParty.add(pg.newPoke(72, 7, 1));
        }
        if [id == 7]{   // 도윤 (위쪽 띠): 노로키 Lv.7 · 귀뚤뚜기 Lv.8
            oppParty.add(pg.newPoke(10, 7, 1));
            oppParty.add(pg.newPoke(72, 8, 1));
        }
        if [id == 9]{   // 시우 (호숫가): 귀뚤뚜기 Lv.7 · 꿈벅 Lv.8 · 노로키 Lv.8
            oppParty.add(pg.newPoke(72, 7, 1));
            oppParty.add(pg.newPoke(12, 8, 1));
            oppParty.add(pg.newPoke(10, 8, 1));
        }
    }
    if [id >= 13] and [id <= 15]{   // 유풍체육관 트레이너 (하늘 위 5 x 5 발판 · 올라서면 배틀) — 비행 포켓몬 두 마리 (평균 Lv.9.5) · 상금 800 원 · 아직 빈 텍스쳐 틀
        trTex = "trRival";
        trTexS = 80;
        trFoot = 79;
        trPrize = 60;
        trPrizeFix = 800;
        trClassL = 7470;
        trNameL = 7471 + (id - 13);
        trLoseL = 7477 + (id - 13);
        trAi = 3;
        if [id == 13]{   // 하늬: 찌르꼬 Lv.9 · 갈모매 Lv.10
            oppParty.add(pg.newPoke(77, 9, 0));
            oppParty.add(pg.newPoke(131, 10, 0));
        }
        if [id == 14]{   // 마파: 콩둘기 Lv.9 · 또르박쥐 Lv.10
            oppParty.add(pg.newPoke(94, 9, 1));
            oppParty.add(pg.newPoke(165, 10, 1));
        }
        if [id == 15]{   // 높새: 갈모매 Lv.9 · 찌르꼬 Lv.10 (찌르버드는 진화 레벨 14 전이라 쓰지 않음)
            oppParty.add(pg.newPoke(131, 9, 1));
            oppParty.add(pg.newPoke(77, 10, 1));
        }
    }
    if [id == 16]{   // 유풍체육관 관장 휴린 (아직 빈 텍스쳐 틀) — 기술 배치는 조금 어렵게: 레벨보다 조금 앞선 기술 · 일반 특성 · 노력치 공격 · 스피드
        trTex = "trRival";
        trTexS = 80;
        trFoot = 79;
        trPrize = 100;
        trClassL = 7517;
        trNameL = 7516;
        trLoseL = 7519;
        trAi = 4;
        var compound call hy1 = pg.makeSet(14, 12, 0, 51, 365, 98, 64, 45, 0, 252, 0, 0, 4, 252);    // 앗치 Lv.12: 날카로운눈 (일반 특성) · 쪼아대기 · 전광석화 · 쪼기 · 울음소리
        hy1[15] = 1;
        oppParty.add(hy1);
        var compound call hy2 = pg.makeSet(77, 12, 0, 120, 17, 98, 33, 45, 0, 252, 0, 0, 4, 252);    // 찌르꼬: 이판사판 · 날개치기 · 전광석화 · 몸통박치기 · 울음소리
        hy2[15] = 1;
        oppParty.add(hy2);
        var compound call hy3 = pg.makeSet(15, 14, 0, 51, 332, 365, 98, 343, 4, 252, 0, 0, 0, 252);   // 아크치 (에이스): 날카로운눈 (일반 특성) · 제비반환 · 쪼아대기 · 전광석화 · 탐내다
        hy3[15] = 1;
        oppParty.add(hy3);
    }
    if [id == 6] or [id == 8] or [id == 10] or [id == 11]{
        trTex = "trLass";
        trTexS = 80;
        trFoot = 79;
        trPrize = 16;
        trClassL = 7299;
        trNameL = 7300 + id;
        trAi = 2;
        if [id == 6]{   // 수아 (입구 쪽 위): 찌르꼬 Lv.7 · 짜랑랑 Lv.8
            oppParty.add(pg.newPoke(77, 7, 0));
            oppParty.add(pg.newPoke(177, 8, 0));
        }
        if [id == 8]{   // 하린 (가장 북쪽 덤불 위): 짜랑랑 Lv.7 · 이브이 Lv.8
            oppParty.add(pg.newPoke(177, 7, 0));
            oppParty.add(pg.newPoke(179, 8, 0));
        }
        if [id == 10]{   // 지아 (왼쪽 세로 길): 두더류 Lv.8 · 찌르꼬 Lv.9
            oppParty.add(pg.newPoke(175, 8, 0));
            oppParty.add(pg.newPoke(77, 9, 0));
        }
        if [id == 11]{   // 예린 (남쪽): 짜랑랑 Lv.7 · 피카츄 Lv.8
            oppParty.add(pg.newPoke(177, 7, 0));
            oppParty.add(pg.newPoke(85, 8, 0));
        }
    }
}

// 눈이 마주쳤을 때 대사의 lang 번호 · 이긴 뒤 잡담 (두 가지 중 하나 · 이 번호 + 0 또는 1)
func int introL(int id){
    if [id == 16]{   // 휴린
        return(7518);
    }
    if [id >= 13] and [id <= 15]{   // 유풍체육관 트레이너
        return(7474 + (id - 13));
    }
    if [id == 12]{   // 라이벌: 지현 7381 · 재휘 7382
        if [isBoy == 1]{
            return(7381);
        }
        return(7382);
    }
    if [id <= 4]{
        return(7262 + id);
    }
    return(7320 + id);
}
func int chatL(int id){
    if [id == 16]{   // 휴린: 이긴 뒤 (7520 · 7521)
        return(7520);
    }
    if [id >= 13] and [id <= 15]{
        return(7480 + (id - 13) * 2);
    }
    if [id <= 4]{
        return(7271 + (id - 2) * 2);
    }
    return(7360 + (id - 5) * 2);
}
