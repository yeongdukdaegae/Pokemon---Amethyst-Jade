    var list call seIdx = [21, 120, 30, 21, 64, 72, 38, 58, 114, 88, 119, 119, 79, 107, 25, 46, 124, 47, 43, 8, 109, 8, 64, 59, 63, 59, 64, 85, 51, 54, 54, 54, 109, 109, 8, 109, 64, 109, 108, 54, 54, 54, 60, 9, 118, 118, 91, 101, 80, 62, 115, 34, 41, 68, 15, 55, 102, 11, 10, 76, 17, 77, 56, 54, 54, 121, 59, 82, 121, 98, 1, 2, 1, 97, 79, 95, 75, 75, 75, 74, 99, 32, 40, 114, 113, 112, 113, 83, 33, 33, 27, 115, 77, 76, 101, 97, 31, 109, 109, 111, 71, 92, 89, 31, 70, 49, 67, 50, 22, 49, 49, 5, 81, 50, 81, 19, 19, 65, 65, 90, 90, 61, 115, 115, 12, 41, 122, 24, 106, 109, 54, 8, 97, 111, 66, 59, 60, 44, 50, 90, 1, 4, 43, 111, 14, 29, 75, 26, 77, 16, 3, 24, 36, 88, 12, 125, 83, 9, 49, 111, 116, 9, 25, 31, 109, 92, 59, 37, 99, 62, 71, 39, 94, 71, 82, 111, 57, 75, 82, 71, 58, 26, 21, 60, 37, 4, 7, 115, 85, 55, 83, 113, 62, 71, 73, 58, 26, 12, 62, 64, 87, 44, 49, 20, 109, 25, 103, 66, 114, 25, 124, 60, 4, 94, 52, 109, 90, 109, 81, 2, 84, 33, 64, 54, 32, 6, 35, 37, 117, 105, 64, 88, 120, 70, 70, 69, 106, 120, 117, 78, 70, 9, 81, 97, 109, 83, 22, 76, 13, 123, 21, 30, 118, 19, 96, 66, 53, 48, 103, 42, 34, 71, 109, 64, 30, 35, 65, 19, 104, 35, 111, 92, 52, 65, 1, 64, 81, 65, 82, 13, 125, 30, 82, 53, 111, 62, 52, 71, 37, 109, 28, 21, 67, 19, 76, 68, 47, 110, 38, 85, 58, 54, 125, 118, 9, 88, 36, 55, 64, 61, 106, 105, 16, 80, 41, 62, 83, 46, 89, 45, 110, 23, 102, 77, 37, 77, 93, 86, 10, 102, 21, 25, 58, 49, 60, 118, 88, 74, 7, 43, 85, 64, 4, 113, 79, 16, 97, 25, 107, 83, 112, 18, 23, 76, 124, 111, 111, 120, 120, 119, 111, 102, 109, 109, 124, 46, 65, 119, 109, 64, 9, 9, 103, 9, 111, 106, 111, 106, 111, 75, 65, 65, 65, 111, 111, 9, 109, 1, 9, 75, 111, 16, 112, 38, 120, 57, 49, 54, 77, 25, 122, 90, 80, 25, 118, 32, 88, 83, 44, 57, 57, 95, 43, 33, 103, 109, 103, 119, 58, 58, 88, 9, 9, 9, 61, 90, 25, 51, 57, 57, 109, 47, 111, 32, 113, 41, 95, 79, 83, 54, 115, 51, 119, 83, 65, 83, 95, 46, 106, 54, 113, 79, 122, 54, 99, 99, 109, 109, 32, 32, 111, 109, 41, 103, 95, 71, 61, 103, 49, 111, 111, 111, 76, 115, 49, 99, 111, 111, 83, 120, 41, 115, 99, 109, 76, 113, 16, 38, 75, 120, 115, 9, 65, 65, 65, 106, 106, 109, 115, 76, 7, 111, 55, 65, 111, 71, 124, 49, 120, 41, 103, 124, 65, 109, 57, 65, 41, 102, 41, 95, 113, 100, 33, 10, 88, 65, 113, 114, 27, 88, 109, 79, 120, 122, 109, 95, 54, 1, 37, 76, 109, 117, 109, 119, 41, 106, 106, 57, 10, 114, 41, 41, 58, 10, 37, 58, 38, 41, 114, 120, 7, 115, 85, 99, 54, 61, 22, 65, 112, 113, 1, 79, 10, 69, 103, 103, 4, 20, 20, 1, 20, 112, 30, 69, 69, 118, 20, 49, 65, 65, 83, 102, 76, 102, 41, 1, 20, 112, 75, 99, 20, 112, 65, 112, 26, 65, 65, 20, 114, 109, 100, 120, 46, 27, 27, 27, 69, 102, 27, 124, 9, 85, 54, 75, 61, 9, 102, 58, 20, 33, 1, 79, 79, 65, 75, 65, 49, 9, 100, 119, 111, 54, 38, 9, 41, 111, 119, 75, 106, 32, 79, 111, 124, 32, 88, 9, 68, 41, 69, 109, 33, 61, 83, 122, 76, 61, 119, 71, 65, 114, 69, 109, 41, 114, 76, 114, 102, 124, 113, 102, 113, 38, 76, 37, 79, 10, 69, 109, 119, 32, 102, 9, 65, 7, 49, 111, 88, 65, 7, 114, 122, 65, 107, 120, 20, 79, 79, 38, 119, 119, 114, 88, 79, 118, 95, 79, 30, 69, 16, 103, 9, 120, 32, 57, 76, 119, 88, 83, 115, 69, 79, 113, 106, 54, 41, 9, 61, 75, 7, 122, 58, 124, 33, 1, 9, 122, 113, 32, 76, 37, 120, 58, 71, 76, 54, 109, 65, 83, 69, 76, 38, 122, 95, 58, 7, 27, 54, 76, 71, 49, 120, 71, 9, 46, 113, 33, 111, 111, 106, 99, 120, 61, 76, 88, 122, 1, 119, 109, 58, 88, 65, 83, 122, 54, 65, 65, 9, 79, 41, 122, 109, 57, 109, 102, 37, 120, 113, 65, 68, 65, 68, 54, 79, 102, 109, 76, 61, 41, 38, 114, 119, 9, 122, 38, 9, 54, 120, 30, 106, 95, 95, 79, 113, 106, 32, 34, 113, 83, 57, 119, 107, 69, 38, 114, 76, 120, 115, 83, 38, 102, 124, 113];
    var int call at = seMoves.find(mv);
