// ── 기술 이펙트 (픽셀 원 pxCirc + 빛 번짐 dis.setGlow · 2026-11-22) — 맞는 이펙트 (hitFx) 앞에 · 첫 타에만
//   종류 (fxKind): 1 구슬 (큰 빛 구슬 하나가 날아감) · 2 연사 (작은 구슬 셋) · 3 광선 (구슬 줄기) · 4 충격 (맞는 곳에서 빛이 퍼짐) · 5 전기 (맞는 곳 둘레에 번쩍임) · 6 파동 (맞는 곳에서 고리가 세 번 퍼짐)
//   색 = 기술 타입 색 · 크기 s = 포켓몬 그림 크기 · 오브젝트 mfx1 ~ mfx8 (끝나면 모두 지움)
func int fxKind(int mv){
    var list call k1 = [247, 412, 192, 411, 406, 595, 408, 922, 188, 920, 921];
    var list call k2 = [40, 42, 129, 341, 189, 403, 17, 64, 365];   // 52 · 55 는 spFx (텍스쳐) 로
    var list call k3 = [53, 58, 56, 315];   // 빔 기술 (451 · 76 · 63 · 61 · 62) 은 spFx 로 옮김 — 53 · 58 · 56 · 315 도 spFx 가 먼저
    var list call k4 = [33, 98, 29, 36, 38, 370, 280, 409, 89, 57, 399, 405, 44, 10, 163, 404, 282, 7, 8, 9, 424, 423, 422];
    var list call k5 = [85, 351];   // 84 · 87 은 spFx (스파크 텍스쳐) 로
    var list call k6 = [352, 48, 103, 319];
    if [k1.find(mv) != 0]{
        return(1);
    }
    if [k2.find(mv) != 0]{
        return(2);
    }
    if [k3.find(mv) != 0]{
        return(3);
    }
    if [k5.find(mv) != 0]{
        return(5);
    }
    if [k6.find(mv) != 0]{
        return(6);
    }
    if [k4.find(mv) != 0]{
        return(4);
    }
    return(0);
}

// 픽셀 원: 원 그림 (fx_circle · 16 x 16 픽셀) 을 지름 2r 로 · 색 col
func pxCirc(float x, float y, string id, float r, string col){
    dis.setObject([x, y], id, [r * 2, r * 2], col);
    mag.setObjTexture(id, "fxcirc", [0, 0], [16, 16]);
    dis.setObjColor(id, col);   // 그림을 처음 입히면 색이 흰색이 됨 → 다시 그 색으로
}

func moveFx(int mv, float ax, float ay, float tx, float ty, float s, string col){
    var int call k = fxKind(mv);
    if [hasSp(mv) == 1]{   // 따로 만든 이펙트가 있는 기술 (spFx)
        k = 0;
        log("기술 이펙트: %mv% (따로)");
        spFx(mv, ax, ay, tx, ty, s);
    }
    if [k != 0]{
        log("기술 이펙트: %mv% (종류 %k%)");
    }
    if [k == 1]{   // 구슬: 커지며 날아감
        pxCirc(ax, ay, "mfx1", s * 0.06, col);
        dis.setGlow("mfx1", col, s * 0.14);
        dis.setObjLayer("mfx1", 6);
        var int call f = 1;
        loop [f <= 22]{
            var float call t = f / 22.0;
            dis.setObjPos("mfx1", [ax + (tx - ax) * t, ay + (ty - ay) * t + sin(t * 180) * s * 0.12]);
            dis.setObjScale("mfx1", [s * (0.12 + 0.1 * t), s * (0.12 + 0.1 * t)]);
            wait(16);
            f = f + 1;
        }
        dis.removeObj("mfx1");
    }
    if [k == 2]{   // 연사: 작은 구슬 셋이 차례로
        var int call j = 1;
        loop [j <= 3]{
            pxCirc(ax, ay, "mfx%j%", s * 0.04, col);
            dis.setGlow("mfx%j%", col, s * 0.08);
            dis.setObjLayer("mfx%j%", 6);
            j = j + 1;
        }
        var int call f2 = 0;
        loop [f2 <= 26]{
            j = 1;
            loop [j <= 3]{
                var float call t2 = min(1, max(0, (f2 - (j - 1) * 4) / 18.0));
                dis.setObjPos("mfx%j%", [ax + (tx - ax) * t2, ay + (ty - ay) * t2 + (j - 2) * s * 0.05]);
                j = j + 1;
            }
            wait(16);
            f2 = f2 + 1;
        }
        j = 1;
        loop [j <= 3]{
            dis.removeObj("mfx%j%");
            j = j + 1;
        }
    }
    if [k == 3]{   // 광선: 구슬 8 개가 줄지어 흘러감
        var int call b = 1;
        loop [b <= 8]{
            pxCirc(ax, ay, "mfx%b%", s * 0.05, col);
            dis.setGlow("mfx%b%", col, s * 0.1);
            dis.setObjLayer("mfx%b%", 6);
            b = b + 1;
        }
        var int call f3 = 0;
        loop [f3 <= 30]{
            b = 1;
            loop [b <= 8]{
                var float call ph = f3 / 12.0 + b / 8.0;
                var float call t3 = ph - floor(ph);
                if [f3 < 12]{   // 처음에는 공격하는 쪽에서 뻗어 나감
                    t3 = min(t3, f3 / 12.0);
                }
                dis.setObjPos("mfx%b%", [ax + (tx - ax) * t3, ay + (ty - ay) * t3 + sin(f3 * 40 + b * 45) * s * 0.02]);
                b = b + 1;
            }
            wait(16);
            f3 = f3 + 1;
        }
        b = 1;
        loop [b <= 8]{
            dis.removeObj("mfx%b%");
            b = b + 1;
        }
    }
    if [k == 4]{   // 충격: 맞는 곳에서 빛이 커지며 사라짐
        pxCirc(tx, ty, "mfx1", s * 0.05, "#ffffff");
        dis.setGlow("mfx1", col, s * 0.2);
        dis.setObjLayer("mfx1", 6);
        var int call f4 = 1;
        loop [f4 <= 14]{
            var float call t4 = f4 / 14.0;
            dis.setObjScale("mfx1", [s * (0.1 + 0.4 * t4), s * (0.1 + 0.4 * t4)]);
            dis.setObjAlpha("mfx1", floor(255 * (1 - t4 * t4)));
            wait(16);
            f4 = f4 + 1;
        }
        dis.removeObj("mfx1");
    }
    if [k == 5]{   // 전기: 맞는 곳 둘레에 작은 빛이 번쩍번쩍
        var int call e = 1;
        loop [e <= 5]{
            pxCirc(tx, ty, "mfx%e%", s * 0.035, "#ffffff");
            dis.setGlow("mfx%e%", col, s * 0.12);
            dis.setObjLayer("mfx%e%", 6);
            e = e + 1;
        }
        var int call f5 = 1;
        loop [f5 <= 8]{
            e = 1;
            loop [e <= 5]{
                dis.setObjPos("mfx%e%", [tx + jaw.random(-1, 1) * s * 0.35, ty + jaw.random(-1, 1) * s * 0.35]);
                dis.setObjAlpha("mfx%e%", floor(jaw.random(90, 255)));
                e = e + 1;
            }
            wait(45);
            f5 = f5 + 1;
        }
        e = 1;
        loop [e <= 5]{
            dis.removeObj("mfx%e%");
            e = e + 1;
        }
    }
    if [k == 6]{   // 파동: 고리 (가운데가 비치는 빛) 가 세 번 퍼짐
        var int call r = 1;
        loop [r <= 3]{
            pxCirc(tx, ty, "mfx1", s * 0.05, col);
            dis.setGlow("mfx1", col, s * 0.12);
            dis.setObjLayer("mfx1", 6);
            var int call f6 = 1;
            loop [f6 <= 10]{
                var float call t6 = f6 / 10.0;
                dis.setObjScale("mfx1", [s * (0.1 + 0.45 * t6), s * (0.1 + 0.45 * t6)]);
                dis.setObjAlpha("mfx1", floor(200 * (1 - t6)));
                wait(16);
                f6 = f6 + 1;
            }
            dis.removeObj("mfx1");
            r = r + 1;
        }
    }
}

// ── 기술마다 따로 만든 이펙트 (2026-11-22 · 픽셀 원 + 빛 번짐): 전자포 · 기합구슬 · 섀도볼 · 화염방사 · 냉동빔 · 10만볼트 · 하이드로펌프 · 에너지볼 · 용의파동 · 오버히트
//   moveFx 가 먼저 여기를 봄 (있으면 이것 · 없으면 종류별 이펙트) · 오브젝트 sfx1 ~ sfx16 (끝나면 모두 지움)
func int hasSp(int mv){
    var list call sp = [192, 411, 247, 53, 58, 85, 56, 412, 406, 315, 63, 416, 76, 451, 62, 61, 324, 430, 60, 820, 795, 796, 800, 711, 714, 888, 907, 905, 744, 705];   // 63 ~ 705 = 빔 기술 (spBeam)
    var list call sp2 = [52, 126, 83, 145, 55, 75, 345, 437, 80, 84, 209, 87, 435, 181, 196, 59, 88, 157, 317, 479, 920, 51, 124, 584];   // 타입 텍스쳐 (fx_type.png) 기술
    if [sp.find(mv) != 0]{
        return(1);
    }
    if [sp2.find(mv) != 0]{
        return(1);
    }
    return(0);
}
func spClear(int n){
    var int call i = 1;
    loop [i <= n]{
        dis.removeObj("sfx%i%");
        i = i + 1;
    }
}
// 맞는 곳에서 빛이 커지며 사라짐 (공통 마무리)
func spBurst(float x, float y, float s, float r0, float r1, string col, string glow, int fr){
    pxCirc(x, y, "sfxb", r0, col);
    dis.setGlow("sfxb", glow, s * 0.25);
    dis.setObjLayer("sfxb", 7);
    var int call f = 1;
    loop [f <= fr]{
        var float call t = f / (fr * 1.0);
        var float call r = r0 + (r1 - r0) * t;
        dis.setObjScale("sfxb", [r * 2, r * 2]);
        dis.setObjAlpha("sfxb", floor(255 * (1 - t * t)));
        wait(16);
        f = f + 1;
    }
    dis.removeObj("sfxb");
}
// 구슬 날리기 (흔들림 wob · 끝나면 그 자리에 남음 — 지우는 건 부른 쪽)
func spFly(string id, float ax, float ay, float tx, float ty, float s, int fr, float wob){
    var int call f = 1;
    loop [f <= fr]{
        var float call t = f / (fr * 1.0);
        dis.setObjPos(id, [ax + (tx - ax) * t, ay + (ty - ay) * t + sin(t * 180) * s * 0.1 + sin(f * 50) * wob]);
        wait(16);
        f = f + 1;
    }
}

// ── 빔 기술 공통 (2026-11-22): 공격하는 쪽 → 맞는 쪽으로 이어지는 굵은 빛줄기
//   몸통 = 픽셀 원 14 개 (sfx1 ~ sfx14 · 가운데 inCol · 둘레 outCol 빛 번짐) · sfx15 = 쏘는 곳 빛 · sfx16 = 줄기 끝 빛
//   w = 굵기 (반지름 = s * w) · hold = 유지 프레임 · 뻗기 10 프레임 → 유지 (굵기가 떨림) → 12 프레임 동안 가늘어지며 사라짐 → spBurst
//   mode: 0 보통 · 1 무지개 (색이 흘러감) · 2 은빛 (반짝임) · 3 물결 (줄기가 굽이침) · 4 · 7 줄기 전체를 위 · 아래로 조금 비킴 (두 번 쏘는 기술) · 5 전기 (줄기가 지직거림) · 6 빨강 · 초록 번갈아
func spBeam(float ax0, float ay0, float tx, float ty, float s, string inCol, string outCol, float w, int hold, int mode){
    var list call rb = ["#ff5a5a", "#ffb04a", "#fff06a", "#7cff8a", "#6ad8ff", "#7a8cff", "#d07aff"];
    var float call bl0 = max(1, sqrt((tx - ax0) * (tx - ax0) + (ty - ay0) * (ty - ay0)));
    var float call ax = ax0 + (tx - ax0) / bl0 * s * 0.2;   // 쏘는 곳: 공격하는 포켓몬의 조금 앞 (상대 쪽)
    var float call ay = ay0 + (ty - ay0) / bl0 * s * 0.2;
    var float call bdx = tx - ax;
    var float call bdy = ty - ay;
    var float call bln = max(1, sqrt(bdx * bdx + bdy * bdy));
    var float call bnx = 0 - bdy / bln;   // 줄기에 수직인 방향 (물결 · 두 줄 · 전기)
    var float call bny = bdx / bln;
    var float call br = s * w;
    var int call bi = 1;
    loop [bi <= 14]{
        pxCirc(ax, ay, "sfx%bi%", br, inCol);
        dis.setGlow("sfx%bi%", outCol, br * 2.2);
        dis.setObjLayer("sfx%bi%", 7);
        dis.setObjAlpha("sfx%bi%", 0);
        bi = bi + 1;
    }
    pxCirc(ax, ay, "sfx15", br * 1.5, inCol);
    dis.setGlow("sfx15", outCol, br * 3);
    dis.setObjLayer("sfx15", 8);
    pxCirc(ax, ay, "sfx16", br * 1.3, inCol);
    dis.setGlow("sfx16", outCol, br * 3);
    dis.setObjLayer("sfx16", 8);
    var int call bend = 10 + hold + 12;
    var int call bf = 1;
    loop [bf <= bend]{
        var float call ext = min(1, bf / 10.0);   // 뻗어 나간 정도
        var float call thk = 1;
        var float call bal = 255;
        if [bf > 10 + hold]{   // 가늘어지며 사라짐
            var float call fo = (bf - 10 - hold) / 12.0;
            thk = 1 - 0.8 * fo;
            bal = 255 * (1 - fo * fo);
        }
        bi = 1;
        loop [bi <= 14]{
            var float call bt = (bi - 1) / 13.0 * ext;
            var float call off = 0;
            var float call rr = br * thk * (1 + 0.15 * sin(bf * 70 + bi * 50));   // 굵기 떨림
            if [mode == 3]{
                off = sin(bt * 720 - bf * 40) * s * 0.05;
            }
            if [mode == 4]{   // 위로 비킴 (맞는 곳으로 갈수록 모임)
                off = s * 0.07 * (1 - bt * 0.7);
            }
            if [mode == 7]{   // 아래로 비킴
                off = 0 - s * 0.07 * (1 - bt * 0.7);
            }
            if [mode == 5]{
                off = jaw.random(-1, 1) * s * 0.03;
            }
            dis.setObjPos("sfx%bi%", [ax + bdx * bt + bnx * off, ay + bdy * bt + bny * off]);
            dis.setObjScale("sfx%bi%", [rr * 2, rr * 2]);
            dis.setObjAlpha("sfx%bi%", floor(bal));
            if [mode == 1]{   // 무지개: 원마다 색이 한 칸씩 흘러감
                var int call rq = bi + floor(bf / 2);
                var int call ri = rq - floor(rq / 7) * 7 + 1;
                var string call rc = rb[ri];
                dis.setGlow("sfx%bi%", rc, br * 2.2);
            }
            if [mode == 2]{   // 은빛: 군데군데 하얗게 반짝임
                if [jaw.random(0, 1) < 0.25]{
                    dis.setGlow("sfx%bi%", "#ffffff", br * 2.6);
                }
                else{
                    dis.setGlow("sfx%bi%", outCol, br * 2.2);
                }
            }
            if [mode == 6]{
                var float call gq = bi + floor(bf / 3);
                if [gq - floor(gq / 2) * 2 == 0]{
                    dis.setGlow("sfx%bi%", "#ff4a6a", br * 2.2);
                }
                else{
                    dis.setGlow("sfx%bi%", "#6aff7a", br * 2.2);
                }
            }
            bi = bi + 1;
        }
        var float call mr = br * 1.5 * thk * (1 + 0.2 * sin(bf * 90));
        dis.setObjScale("sfx15", [mr * 2, mr * 2]);
        dis.setObjAlpha("sfx15", floor(bal));
        dis.setObjPos("sfx16", [ax + bdx * ext, ay + bdy * ext]);
        dis.setObjScale("sfx16", [br * 2.6 * thk, br * 2.6 * thk]);
        dis.setObjAlpha("sfx16", floor(bal));
        wait(16);
        bf = bf + 1;
    }
    spClear(16);
    spBurst(tx, ty, s, br * 1.2, s * (0.2 + w * 2), inCol, outCol, 12);
}
// 빛 모으기 (솔라빔 · 메테오빔 · 일렉트로빔): 둘레의 작은 빛 8 개가 쏘는 곳 (spBeam 과 같은 곳 · 공격하는 쪽의 조금 앞) 으로 빨려 들고 가운데 빛이 커짐 · sfx1 ~ sfx9 (끝나면 지움)
func spGather(float ax, float ay, float tx, float ty, float s, string inCol, string outCol, int fr){
    var float call gl0 = max(1, sqrt((tx - ax) * (tx - ax) + (ty - ay) * (ty - ay)));
    var float call x = ax + (tx - ax) / gl0 * s * 0.2;
    var float call y = ay + (ty - ay) / gl0 * s * 0.2;
    var int call gi = 1;
    loop [gi <= 8]{
        pxCirc(x, y, "sfx%gi%", s * 0.02, inCol);
        dis.setGlow("sfx%gi%", outCol, s * 0.07);
        dis.setObjLayer("sfx%gi%", 7);
        gi = gi + 1;
    }
    pxCirc(x, y, "sfx9", s * 0.02, inCol);
    dis.setGlow("sfx9", outCol, s * 0.2);
    dis.setObjLayer("sfx9", 8);
    var int call gf = 0;
    loop [gf <= fr]{
        var float call gt = gf / (fr * 1.0);
        gi = 1;
        loop [gi <= 8]{
            var float call gp = gt * 2 + gi / 8.0;   // 두 바퀴: 빛이 바깥에서 다시 들어옴
            var float call gd = s * 0.5 * (1 - (gp - floor(gp)));
            var float call ga = gi * 45 + gf * 4;
            dis.setObjPos("sfx%gi%", [x + cos(ga) * gd, y + sin(ga) * gd]);
            gi = gi + 1;
        }
        var float call gr = s * (0.02 + 0.07 * gt);
        dis.setObjScale("sfx9", [gr * 2, gr * 2]);
        dis.setObjAlpha("sfx9", 170 + floor(jaw.random(0, 85)));
        wait(16);
        gf = gf + 1;
    }
    spClear(9);
}
// 거품 알갱이 줄기 (거품광선): 크기가 제각각인 거품 14 개가 흔들리며 흘러감 → 맞는 곳에서 톡톡 터짐 · sfx1 ~ sfx14
func spBubbles(float ax0, float ay0, float tx, float ty, float s, string inCol, string outCol, int fr){
    var float call ul0 = max(1, sqrt((tx - ax0) * (tx - ax0) + (ty - ay0) * (ty - ay0)));
    var float call ax = ax0 + (tx - ax0) / ul0 * s * 0.2;   // 쏘는 곳: spBeam 과 같음
    var float call ay = ay0 + (ty - ay0) / ul0 * s * 0.2;
    var int call ui = 1;
    loop [ui <= 14]{
        pxCirc(ax, ay, "sfx%ui%", s * (0.025 + 0.02 * jaw.random(0, 1)), inCol);
        dis.setGlow("sfx%ui%", outCol, s * 0.06);
        dis.setObjLayer("sfx%ui%", 7);
        dis.setObjAlpha("sfx%ui%", 0);
        ui = ui + 1;
    }
    var int call uf = 0;
    loop [uf <= fr]{
        ui = 1;
        loop [ui <= 14]{
            var float call up = uf / 14.0 - ui / 14.0;   // 하나씩 차례로 나감 · 다 가면 다시
            if [up >= 0]{
                var float call ut = up - floor(up);
                dis.setObjPos("sfx%ui%", [ax + (tx - ax) * ut + sin(ui * 83 + uf * 20) * s * 0.04, ay + (ty - ay) * ut + cos(ui * 61 + uf * 25) * s * 0.05]);
                dis.setObjAlpha("sfx%ui%", floor(200 * (1 - ut * 0.3)));
            }
            ui = ui + 1;
        }
        wait(16);
        uf = uf + 1;
    }
    var int call ug = 1;
    loop [ug <= 8]{   // 맞는 곳에 모여 터짐
        ui = 1;
        loop [ui <= 14]{
            var float call ua = ui * 26;
            var float call ud = s * (0.05 + 0.03 * ug) * (0.6 + (ui - floor(ui / 3) * 3) * 0.2);
            dis.setObjPos("sfx%ui%", [tx + cos(ua) * ud, ty + sin(ua) * ud]);
            dis.setObjAlpha("sfx%ui%", floor(220 * (1 - ug / 9.0)));
            ui = ui + 1;
        }
        wait(16);
        ug = ug + 1;
    }
    spClear(14);
    spBurst(tx, ty, s, s * 0.05, s * 0.26, inCol, outCol, 10);
}

// ── 타입별 텍스쳐 이펙트 (2026-11-22): fx_type.png (16 x 16 칸 9 개 · 그림 원래 색 그대로)
//   칸 번호 tex: 1 불똥 · 2 물거품 · 3 나뭇잎 · 4 스파크 · 5 얼음 결정 · 6 돌 · 7 독 방울 · 8 반짝임 · 9 꽃잎
//   gw = 빛 번짐 세기 (s 에 곱함 · 0 = 없음) · glow = 빛 번짐 색 · spin = 프레임마다 도는 각도 (0 = 안 돎)
func pxTex(float x, float y, string id, float r, int tex){   // 그림 안에 빈 곳이 있어 원보다 1.4 배 크게 (한 변 2.8r)
    dis.setObject([x, y], id, [r * 2.8, r * 2.8], "#ffffff");
    mag.setObjTexture(id, "fxtype", [(tex - 1) * 16, 0], [tex * 16, 16]);
}
// 알갱이 날리기: 쏘는 곳 (공격하는 쪽의 조금 앞) → 맞는 곳으로 n 개가 gap 프레임 간격으로 (하나가 fr 프레임) · 맞는 곳에서 흩어지며 사라짐
//   r = 크기 (s 에 곱함) · arc = 포물선 높이 · wob = 흔들림 · 오브젝트 sfx1 ~ sfxn (n ≤ 16)
func spShower(int tex, float ax0, float ay0, float tx, float ty, float s, int n, float r, int fr, int gap, float arc, float wob, float spin, float gw, string glow){
    var float call hl0 = max(1, sqrt((tx - ax0) * (tx - ax0) + (ty - ay0) * (ty - ay0)));
    var float call ax = ax0 + (tx - ax0) / hl0 * s * 0.2;
    var float call ay = ay0 + (ty - ay0) / hl0 * s * 0.2;
    var float call hnx = 0 - (ty - ay0) / hl0;   // 줄기에 수직 (알갱이가 겹치지 않게 조금씩 비킴)
    var float call hny = (tx - ax0) / hl0;
    var int call hi = 1;
    loop [hi <= n]{
        pxTex(ax, ay, "sfx%hi%", s * r * jaw.random(0.8, 1.2), tex);
        if [gw > 0]{
            dis.setGlow("sfx%hi%", glow, s * gw);
        }
        dis.setObjLayer("sfx%hi%", 7);
        dis.setObjAlpha("sfx%hi%", 0);
        if [spin != 0]{
            dis.rotateObj("sfx%hi%", jaw.random(0, 360), 0);
        }
        hi = hi + 1;
    }
    var int call hend = (n - 1) * gap + fr + 8;
    var int call hf = 0;
    loop [hf <= hend]{
        hi = 1;
        loop [hi <= n]{
            var float call ht = (hf - (hi - 1) * gap) / (fr * 1.0);
            if [ht > 0]{
                if [ht <= 1]{
                    var float call ho = sin(hi * 97) * s * 0.04 + sin(hf * 40 + hi * 67) * s * wob;
                    var float call hy = sin(ht * 180) * s * arc * (0.7 + 0.3 * sin(hi * 77));
                    dis.setObjPos("sfx%hi%", [ax + (tx - ax) * ht + hnx * ho, ay + (ty - ay) * ht + hny * ho + hy]);
                    dis.setObjAlpha("sfx%hi%", 255);
                }
                else{
                    var float call hq = (ht - 1) * fr / 8.0;   // 맞은 뒤 8 프레임: 흩어지며 사라짐
                    if [hq <= 1]{
                        dis.setObjPos("sfx%hi%", [tx + cos(hi * 137) * s * 0.15 * hq, ty + sin(hi * 137) * s * 0.15 * hq]);
                        dis.setObjAlpha("sfx%hi%", floor(255 * (1 - hq)));
                    }
                    else{
                        dis.setObjAlpha("sfx%hi%", 0);
                    }
                }
                if [spin != 0]{
                    dis.rotateObj("sfx%hi%", spin, 0);
                }
            }
            hi = hi + 1;
        }
        wait(16);
        hf = hf + 1;
    }
    spClear(n);
}
// 위에서 쏟아짐: 맞는 곳 위 (s * 0.9) 에서 n 개가 차례로 떨어짐 (점점 빨라짐) → 부딪힌 곳에서 사라짐 · sfx1 ~ sfxn
func spRain(int tex, float tx, float ty, float s, int n, float r, int fr, int gap, float spin, float gw, string glow){
    var int call ri = 1;
    loop [ri <= n]{
        pxTex(tx, ty, "sfx%ri%", s * r * jaw.random(0.8, 1.25), tex);
        if [gw > 0]{
            dis.setGlow("sfx%ri%", glow, s * gw);
        }
        dis.setObjLayer("sfx%ri%", 7);
        dis.setObjAlpha("sfx%ri%", 0);
        if [spin != 0]{
            dis.rotateObj("sfx%ri%", jaw.random(0, 360), 0);
        }
        ri = ri + 1;
    }
    var int call rend = (n - 1) * gap + fr + 6;
    var int call rf = 0;
    loop [rf <= rend]{
        ri = 1;
        loop [ri <= n]{
            var float call rt = (rf - (ri - 1) * gap) / (fr * 1.0);
            var float call rx = tx + sin(ri * 131) * s * 0.3;
            var float call ry = ty + sin(ri * 71) * s * 0.08;
            if [rt > 0]{
                if [rt <= 1]{
                    dis.setObjPos("sfx%ri%", [rx - s * 0.1 * (1 - rt), ry + s * 0.9 * (1 - rt * rt)]);
                    dis.setObjAlpha("sfx%ri%", 255);
                }
                else{
                    var float call rq = (rt - 1) * fr / 6.0;
                    dis.setObjAlpha("sfx%ri%", floor(255 * max(0, 1 - rq)));
                }
                if [spin != 0]{
                    dis.rotateObj("sfx%ri%", spin, 0);
                }
            }
            ri = ri + 1;
        }
        wait(16);
        rf = rf + 1;
    }
    spClear(n);
}
// ── 바위 기술 (2026-11-22): 바위 하나를 던지거나 떨어뜨림 → 부딪힌 곳에서 돌 조각이 튀고 흙먼지가 퍼짐
// 부딪힘: (x, y) 에서 돌 조각 n 개 (sfx1 ~ sfxn) 가 위쪽 부채꼴로 튀었다 떨어지며 사라짐 · 흙먼지 = sfxb · r = 조각 크기 · rad = 튀는 거리
func spRockHit(float x, float y, float s, int n, float r, float rad, int fr){
    var int call ki = 1;
    loop [ki <= n]{
        pxTex(x, y, "sfx%ki%", s * r * jaw.random(0.7, 1.2), 6);
        dis.setObjLayer("sfx%ki%", 7);
        dis.rotateObj("sfx%ki%", jaw.random(0, 360), 0);
        ki = ki + 1;
    }
    pxCirc(x, y - s * 0.03, "sfxb", s * rad * 0.3, "#d8c4a0");
    dis.setGlow("sfxb", "#8a6a40", s * 0.12);
    dis.setObjLayer("sfxb", 6);
    var int call kf = 1;
    loop [kf <= fr]{
        var float call kt = kf / (fr * 1.0);
        ki = 1;
        loop [ki <= n]{
            var float call ka = 15 + (ki - 1) * 150 / max(1, n - 1) + sin(ki * 89) * 12;
            var float call kv = s * rad * (0.8 + 0.3 * sin(ki * 53));
            dis.setObjPos("sfx%ki%", [x + cos(ka) * kv * kt, y + sin(ka) * kv * kt * 1.4 - s * rad * 1.2 * kt * kt]);
            dis.setObjAlpha("sfx%ki%", floor(255 * min(1, (1 - kt) * 2)));
            dis.rotateObj("sfx%ki%", 18, 0);
            ki = ki + 1;
        }
        var float call kr = s * rad * (0.3 + 0.9 * kt);
        dis.setObjScale("sfxb", [kr * 2.6, kr * 1.4]);   // 납작하게 퍼지는 흙먼지
        dis.setObjAlpha("sfxb", floor(200 * (1 - kt)));
        wait(16);
        kf = kf + 1;
    }
    spClear(n);
    dis.removeObj("sfxb");
}
// 던지기: 쏘는 곳 (공격하는 쪽의 조금 앞) → 맞는 곳으로 바위 하나 (sfx1) 가 포물선을 그리며 돌면서 날아감 → spRockHit
//   r = 바위 크기 (s 에 곱함) · fr = 나는 프레임 · arc = 포물선 높이 · spin = 프레임마다 도는 각도
func spRockThrow(float ax0, float ay0, float tx, float ty, float s, float r, int fr, float arc, float spin){
    var float call tl0 = max(1, sqrt((tx - ax0) * (tx - ax0) + (ty - ay0) * (ty - ay0)));
    var float call ax = ax0 + (tx - ax0) / tl0 * s * 0.2;
    var float call ay = ay0 + (ty - ay0) / tl0 * s * 0.2;
    pxTex(ax, ay, "sfx1", s * r, 6);
    dis.setObjLayer("sfx1", 7);
    dis.rotateObj("sfx1", jaw.random(0, 360), 0);
    var int call tf = 1;
    loop [tf <= fr]{
        var float call tt = tf / (fr * 1.0);
        dis.setObjPos("sfx1", [ax + (tx - ax) * tt, ay + (ty - ay) * tt + sin(tt * 180) * s * arc]);
        dis.rotateObj("sfx1", spin, 0);
        wait(16);
        tf = tf + 1;
    }
    spClear(1);
    spRockHit(tx, ty, s, 4 + floor(r * 60), r * 0.45, 0.1 + r * 1.2, 14);
}
// 떨어뜨리기: 맞는 곳 위 h 에 바위 하나 (sfx1) 가 hover 프레임 동안 나타나 흔들리다가 → fr 프레임 동안 빨라지며 떨어짐 → spRockHit
//   r = 바위 크기 · h = 높이 (s 에 곱함) · grow = 1 이면 나타날 때 커지며 생김
func spRockDrop(float tx, float ty, float s, float r, float h, int hover, int fr, int grow){
    pxTex(tx, ty + s * h, "sfx1", s * r, 6);
    dis.setObjLayer("sfx1", 7);
    dis.setObjAlpha("sfx1", 0);
    dis.rotateObj("sfx1", jaw.random(-20, 20), 0);
    var int call df = 1;
    loop [df <= hover]{
        var float call dt = df / (hover * 1.0);
        var float call dk = 1;
        if [grow == 1]{
            dk = min(1, 0.3 + dt * 1.4);
        }
        dis.setObjScale("sfx1", [s * r * 2.8 * dk, s * r * 2.8 * dk]);
        dis.setObjAlpha("sfx1", floor(255 * min(1, dt * 2.5)));
        dis.setObjPos("sfx1", [tx + sin(df * 97) * s * 0.006 * dt, ty + s * h + sin(df * 61) * s * 0.004 * dt]);   // 떨어지기 전에 부르르
        wait(16);
        df = df + 1;
    }
    dis.setObjScale("sfx1", [s * r * 2.8, s * r * 2.8]);
    dis.setObjAlpha("sfx1", 255);
    df = 1;
    loop [df <= fr]{
        var float call dq = df / (fr * 1.0);
        dis.setObjPos("sfx1", [tx, ty + s * h * (1 - dq * dq)]);
        wait(16);
        df = df + 1;
    }
    spClear(1);
    spRockHit(tx, ty, s, 4 + floor(r * 60), r * 0.45, 0.1 + r * 1.2, 16);
}
// 맴돌기: (cx, cy) 둘레를 n 개가 납작한 원을 그리며 돌면서 위로 올라감 (fr 프레임) · sfx1 ~ sfxn
func spSwirl(int tex, float cx, float cy, float s, int n, float r, int fr, float spin, float gw, string glow){
    var int call wi = 1;
    loop [wi <= n]{
        pxTex(cx, cy, "sfx%wi%", s * r * jaw.random(0.8, 1.2), tex);
        if [gw > 0]{
            dis.setGlow("sfx%wi%", glow, s * gw);
        }
        dis.setObjLayer("sfx%wi%", 7);
        dis.setObjAlpha("sfx%wi%", 0);
        wi = wi + 1;
    }
    var int call wf = 0;
    loop [wf <= fr]{
        var float call wt = wf / (fr * 1.0);
        var float call wal = 255 * min(1, min(wf / 6.0, (fr - wf) / 8.0));   // 처음 6 프레임 나타남 · 끝 8 프레임 사라짐
        wi = 1;
        loop [wi <= n]{
            var float call wa = wi * 360 / n + wf * 14;
            var float call wr = s * (0.22 + 0.08 * sin(wf * 9 + wi * 50));
            var float call wh = s * (-0.3 + 0.6 * wt) + s * 0.25 * ((wi - floor(wi / 3) * 3) - 1);   // 세 층으로 나뉘어 올라감
            dis.setObjPos("sfx%wi%", [cx + cos(wa) * wr, cy + wh + sin(wa) * wr * 0.3]);
            dis.setObjAlpha("sfx%wi%", floor(wal));
            if [spin != 0]{
                dis.rotateObj("sfx%wi%", spin, 0);
            }
            wi = wi + 1;
        }
        wait(16);
        wf = wf + 1;
    }
    spClear(n);
}
// 지직거림: (cx, cy) 둘레 (반지름 s * rad) 에 스파크 n 개가 3 프레임마다 자리 · 각도 · 크기를 바꾸며 번쩍임 (fr 프레임) · sfx1 ~ sfxn
func spSparks(float cx, float cy, float s, int n, float r, float rad, int fr){
    var int call ki = 1;
    loop [ki <= n]{
        pxTex(cx, cy, "sfx%ki%", s * r, 4);
        dis.setGlow("sfx%ki%", "#ffd23a", s * 0.08);
        dis.setObjLayer("sfx%ki%", 7);
        ki = ki + 1;
    }
    var int call kf = 0;
    loop [kf <= fr]{
        if [kf - floor(kf / 3) * 3 == 0]{
            ki = 1;
            loop [ki <= n]{
                var float call ka = jaw.random(0, 360);
                var float call kd = s * rad * jaw.random(0.2, 1);
                var float call kr = s * r * jaw.random(0.7, 1.3);
                dis.setObjPos("sfx%ki%", [cx + cos(ka) * kd, cy + sin(ka) * kd]);
                dis.setObjScale("sfx%ki%", [kr * 2.8, kr * 2.8]);
                dis.rotateObj("sfx%ki%", jaw.random(-60, 60), 0);
                dis.setObjAlpha("sfx%ki%", floor(jaw.random(120, 255)));
                ki = ki + 1;
            }
        }
        wait(16);
        kf = kf + 1;
    }
    spClear(n);
}

func spFx(int mv, float ax, float ay, float tx, float ty, float s){
    if [mv == 192]{   // 전자포: 공격하는 쪽에서 번쩍이며 커지는 전기 구슬 → 날아감 → 맞는 곳에서 터지며 불꽃이 튐
        pxCirc(ax, ay, "sfx1", s * 0.02, "#fff6b0");
        dis.setGlow("sfx1", "#ffd23a", s * 0.25);
        dis.setObjLayer("sfx1", 7);
        var int call f1 = 1;
        loop [f1 <= 22]{
            var float call r1 = s * (0.02 + 0.07 * f1 / 22.0);
            dis.setObjScale("sfx1", [r1 * 2, r1 * 2]);
            dis.setObjAlpha("sfx1", 150 + floor(jaw.random(0, 105)));
            wait(16);
            f1 = f1 + 1;
        }
        dis.setObjAlpha("sfx1", 255);
        spFly("sfx1", ax, ay, tx, ty, s, 16, s * 0.015);
        dis.removeObj("sfx1");
        var int call k1 = 2;
        loop [k1 <= 7]{
            pxCirc(tx, ty, "sfx%k1%", s * 0.025, "#ffffff");
            dis.setGlow("sfx%k1%", "#ffd23a", s * 0.1);
            dis.setObjLayer("sfx%k1%", 7);
            k1 = k1 + 1;
        }
        var int call g1 = 1;
        loop [g1 <= 10]{
            k1 = 2;
            loop [k1 <= 7]{
                var float call a1 = k1 * 60 + g1 * 9;
                dis.setObjPos("sfx%k1%", [tx + cos(a1) * s * 0.04 * g1, ty + sin(a1) * s * 0.04 * g1]);
                dis.setObjAlpha("sfx%k1%", floor(255 * (1 - g1 / 11.0)));
                k1 = k1 + 1;
            }
            wait(16);
            g1 = g1 + 1;
        }
        spClear(7);
        spBurst(tx, ty, s, s * 0.08, s * 0.32, "#fff6b0", "#ffd23a", 12);
    }
    if [mv == 411]{   // 기합구슬: 둘레에서 기운이 모여 구슬이 됨 → 날아감 → 크게 터짐
        var int call k2 = 1;
        loop [k2 <= 8]{
            pxCirc(ax, ay, "sfx%k2%", s * 0.025, "#ffd0a0");
            dis.setGlow("sfx%k2%", "#ff8a3a", s * 0.08);
            dis.setObjLayer("sfx%k2%", 7);
            k2 = k2 + 1;
        }
        var int call f2 = 0;
        loop [f2 <= 18]{
            k2 = 1;
            loop [k2 <= 8]{
                var float call d2 = s * 0.45 * (1 - f2 / 18.0);
                var float call a2 = k2 * 45 + f2 * 6;
                dis.setObjPos("sfx%k2%", [ax + cos(a2) * d2, ay + sin(a2) * d2]);
                k2 = k2 + 1;
            }
            wait(16);
            f2 = f2 + 1;
        }
        spClear(8);
        pxCirc(ax, ay, "sfx1", s * 0.08, "#fff0e0");
        dis.setGlow("sfx1", "#ff8a3a", s * 0.22);
        dis.setObjLayer("sfx1", 7);
        spFly("sfx1", ax, ay, tx, ty, s, 16, 0);
        dis.removeObj("sfx1");
        spBurst(tx, ty, s, s * 0.08, s * 0.4, "#fff0e0", "#ff8a3a", 14);
    }
    if [mv == 247]{   // 섀도볼: 흔들리며 날아가는 어두운 구슬 + 뒤따르는 그림자 → 어두운 빛이 퍼짐
        pxCirc(ax, ay, "sfx1", s * 0.08, "#3c2050");
        dis.setGlow("sfx1", "#9b5cff", s * 0.2);
        dis.setObjLayer("sfx1", 7);
        var int call k3 = 2;
        loop [k3 <= 4]{
            pxCirc(ax, ay, "sfx%k3%", s * (0.07 - k3 * 0.01), "#5a3478");
            dis.setObjAlpha("sfx%k3%", 200 - k3 * 40);
            dis.setObjLayer("sfx%k3%", 6);
            k3 = k3 + 1;
        }
        var int call f3 = 1;
        loop [f3 <= 24]{
            k3 = 1;
            loop [k3 <= 4]{
                var float call t3 = max(0, (f3 - (k3 - 1) * 2) / 24.0);
                dis.setObjPos("sfx%k3%", [ax + (tx - ax) * t3, ay + (ty - ay) * t3 + sin(t3 * 180) * s * 0.12 + sin(f3 * 40) * s * 0.02]);
                k3 = k3 + 1;
            }
            wait(16);
            f3 = f3 + 1;
        }
        spClear(4);
        spBurst(tx, ty, s, s * 0.08, s * 0.34, "#3c2050", "#9b5cff", 14);
    }
    if [mv == 53]{   // 화염방사: 불꽃 알갱이가 줄지어 뿜어져 나가며 커짐 (노랑 → 주황 → 빨강)
        var int call k4 = 1;
        loop [k4 <= 12]{
            pxCirc(ax, ay, "sfx%k4%", s * 0.02, "#ffe066");
            dis.setGlow("sfx%k4%", "#ff7a20", s * 0.08);
            dis.setObjLayer("sfx%k4%", 7);
            k4 = k4 + 1;
        }
        var int call f4 = 0;
        loop [f4 <= 34]{
            k4 = 1;
            loop [k4 <= 12]{
                var float call p4 = f4 / 14.0 + k4 / 12.0;
                var float call t4 = p4 - floor(p4);
                if [f4 < 14]{
                    t4 = min(t4, f4 / 14.0);
                }
                var float call r4 = s * (0.02 + 0.06 * t4);
                dis.setObjPos("sfx%k4%", [ax + (tx - ax) * t4 + sin(k4 * 77 + f4 * 30) * s * 0.03 * t4, ay + (ty - ay) * t4 + cos(k4 * 53 + f4 * 30) * s * 0.03 * t4]);
                dis.setObjScale("sfx%k4%", [r4 * 2, r4 * 2]);
                var string call c4 = "#ffe066";
                if [t4 > 0.35]{
                    c4 = "#ff9a2e";
                }
                if [t4 > 0.7]{
                    c4 = "#ff4a2a";
                }
                dis.setObjColor("sfx%k4%", c4);
                k4 = k4 + 1;
            }
            wait(16);
            f4 = f4 + 1;
        }
        spClear(12);
        spBurst(tx, ty, s, s * 0.06, s * 0.3, "#ff9a2e", "#ff4a2a", 10);
    }
    if [mv == 58]{   // 냉동빔: 얇은 빛 줄기 → 맞는 곳에 얼음 조각이 하나씩 돋아남
        var int call k5 = 1;
        loop [k5 <= 10]{
            pxCirc(ax, ay, "sfx%k5%", s * 0.025, "#e8fbff");
            dis.setGlow("sfx%k5%", "#7fd8ff", s * 0.08);
            dis.setObjLayer("sfx%k5%", 7);
            k5 = k5 + 1;
        }
        var int call f5 = 0;
        loop [f5 <= 26]{
            k5 = 1;
            loop [k5 <= 10]{
                var float call p5 = f5 / 10.0 + k5 / 10.0;
                var float call t5 = p5 - floor(p5);
                if [f5 < 10]{
                    t5 = min(t5, f5 / 10.0);
                }
                dis.setObjPos("sfx%k5%", [ax + (tx - ax) * t5, ay + (ty - ay) * t5]);
                k5 = k5 + 1;
            }
            wait(16);
            f5 = f5 + 1;
        }
        spClear(10);
        var int call c5 = 1;
        loop [c5 <= 6]{
            pxCirc(tx + cos(c5 * 60) * s * 0.18, ty + sin(c5 * 60) * s * 0.18, "sfx%c5%", s * 0.035, "#ffffff");
            dis.setGlow("sfx%c5%", "#7fd8ff", s * 0.1);
            dis.setObjLayer("sfx%c5%", 7);
            wait(40);
            c5 = c5 + 1;
        }
        wait(120);
        spClear(6);
        spBurst(tx, ty, s, s * 0.06, s * 0.28, "#e8fbff", "#7fd8ff", 10);
    }
    if [mv == 85]{   // 10만볼트: 위에서 맞는 곳으로 지그재그 번개가 세 번 번쩍임 → 번쩍
        var int call k6 = 1;
        loop [k6 <= 9]{
            pxCirc(tx, ty, "sfx%k6%", s * 0.03, "#ffffff");
            dis.setGlow("sfx%k6%", "#ffd23a", s * 0.1);
            dis.setObjLayer("sfx%k6%", 7);
            k6 = k6 + 1;
        }
        var int call z6 = 1;
        loop [z6 <= 3]{
            k6 = 1;
            loop [k6 <= 9]{   // 번개 모양: 위 (맞는 곳 + 0.9 s) 에서 맞는 곳까지 좌우로 엇갈림
                var float call zx = tx + (k6 - floor(k6 / 2) * 2 - 0.5) * s * 0.12 * jaw.random(0.5, 1.5);
                dis.setObjPos("sfx%k6%", [zx, ty + s * 0.9 * (1 - k6 / 9.0)]);
                dis.setObjAlpha("sfx%k6%", 255);
                k6 = k6 + 1;
            }
            wait(70);
            k6 = 1;
            loop [k6 <= 9]{
                dis.setObjAlpha("sfx%k6%", 0);
                k6 = k6 + 1;
            }
            wait(40);
            z6 = z6 + 1;
        }
        spClear(9);
        spBurst(tx, ty, s, s * 0.08, s * 0.36, "#ffffff", "#ffd23a", 10);
    }
    if [mv == 56]{   // 하이드로펌프: 굵은 물줄기 두 줄 → 물방울이 사방으로 튐
        var int call k7 = 1;
        loop [k7 <= 12]{
            pxCirc(ax, ay, "sfx%k7%", s * 0.05, "#5ab4ff");
            dis.setGlow("sfx%k7%", "#2a7aff", s * 0.08);
            dis.setObjLayer("sfx%k7%", 7);
            k7 = k7 + 1;
        }
        var int call f7 = 0;
        loop [f7 <= 30]{
            k7 = 1;
            loop [k7 <= 12]{
                var float call p7 = f7 / 12.0 + k7 / 12.0;
                var float call t7 = p7 - floor(p7);
                if [f7 < 12]{
                    t7 = min(t7, f7 / 12.0);
                }
                var float call o7 = (k7 - floor(k7 / 2) * 2 - 0.5) * s * 0.07;
                dis.setObjPos("sfx%k7%", [ax + (tx - ax) * t7, ay + (ty - ay) * t7 + o7]);
                k7 = k7 + 1;
            }
            wait(16);
            f7 = f7 + 1;
        }
        var int call g7 = 1;
        loop [g7 <= 12]{   // 물방울
            k7 = 1;
            loop [k7 <= 12]{
                var float call a7 = k7 * 30;
                dis.setObjPos("sfx%k7%", [tx + cos(a7) * s * 0.035 * g7, ty + sin(a7) * s * 0.035 * g7 - g7 * g7 * s * 0.002]);
                dis.setObjScale("sfx%k7%", [s * 0.06, s * 0.06]);
                dis.setObjAlpha("sfx%k7%", floor(255 * (1 - g7 / 13.0)));
                k7 = k7 + 1;
            }
            wait(16);
            g7 = g7 + 1;
        }
        spClear(12);
    }
    if [mv == 412]{   // 에너지볼: 둘레를 작은 빛이 도는 초록 구슬 → 터짐
        pxCirc(ax, ay, "sfx1", s * 0.075, "#c8ffb0");
        dis.setGlow("sfx1", "#5ad23a", s * 0.2);
        dis.setObjLayer("sfx1", 7);
        var int call k8 = 2;
        loop [k8 <= 4]{
            pxCirc(ax, ay, "sfx%k8%", s * 0.02, "#ffffff");
            dis.setGlow("sfx%k8%", "#9cff6a", s * 0.06);
            dis.setObjLayer("sfx%k8%", 8);
            k8 = k8 + 1;
        }
        var int call f8 = 1;
        loop [f8 <= 24]{
            var float call t8 = f8 / 24.0;
            var float call bx = ax + (tx - ax) * t8;
            var float call by = ay + (ty - ay) * t8 + sin(t8 * 180) * s * 0.1;
            dis.setObjPos("sfx1", [bx, by]);
            k8 = 2;
            loop [k8 <= 4]{
                var float call a8 = f8 * 30 + k8 * 120;
                dis.setObjPos("sfx%k8%", [bx + cos(a8) * s * 0.13, by + sin(a8) * s * 0.13]);
                k8 = k8 + 1;
            }
            wait(16);
            f8 = f8 + 1;
        }
        spClear(4);
        spBurst(tx, ty, s, s * 0.08, s * 0.34, "#c8ffb0", "#5ad23a", 12);
    }
    if [mv == 406]{   // 용의파동: 커지며 날아가는 고리 다섯 개
        var int call k9 = 1;
        loop [k9 <= 5]{
            pxCirc(ax, ay, "sfx%k9%", s * 0.04, "#6a5cff");
            dis.setGlow("sfx%k9%", "#b06cff", s * 0.12);
            dis.setObjLayer("sfx%k9%", 7);
            dis.setObjAlpha("sfx%k9%", 0);
            k9 = k9 + 1;
        }
        var int call f9 = 0;
        loop [f9 <= 32]{
            k9 = 1;
            loop [k9 <= 5]{
                var float call t9 = (f9 - (k9 - 1) * 4) / 16.0;
                if [t9 >= 0] and [t9 <= 1]{
                    var float call r9 = s * (0.04 + 0.12 * t9);
                    dis.setObjPos("sfx%k9%", [ax + (tx - ax) * t9, ay + (ty - ay) * t9]);
                    dis.setObjScale("sfx%k9%", [r9 * 2, r9 * 2]);
                    dis.setObjAlpha("sfx%k9%", floor(220 * (1 - t9 * 0.5)));
                }
                else{
                    dis.setObjAlpha("sfx%k9%", 0);
                }
                k9 = k9 + 1;
            }
            wait(16);
            f9 = f9 + 1;
        }
        spClear(5);
        spBurst(tx, ty, s, s * 0.08, s * 0.36, "#6a5cff", "#b06cff", 12);
    }
    if [mv == 315]{   // 오버히트: 맞는 곳이 큰 불길에 휩싸임 (불꽃이 아래에서 솟구침) → 크게 터짐
        pxCirc(tx, ty, "sfx16", s * 0.2, "#ff6a2a");
        dis.setGlow("sfx16", "#ff3a1a", s * 0.3);
        dis.setObjLayer("sfx16", 6);
        dis.setObjAlpha("sfx16", 120);
        var int call k10 = 1;
        loop [k10 <= 12]{
            pxCirc(tx, ty, "sfx%k10%", s * 0.04, "#ffe066");
            dis.setGlow("sfx%k10%", "#ff7a20", s * 0.08);
            dis.setObjLayer("sfx%k10%", 7);
            k10 = k10 + 1;
        }
        var int call f10 = 0;
        loop [f10 <= 36]{
            k10 = 1;
            loop [k10 <= 12]{
                var float call p10 = f10 / 18.0 + k10 / 12.0;
                var float call t10 = p10 - floor(p10);
                var float call x10 = tx + sin(k10 * 97) * s * 0.3;
                dis.setObjPos("sfx%k10%", [x10 + sin(f10 * 25 + k10 * 40) * s * 0.03, ty - s * 0.3 + t10 * s * 0.7]);
                dis.setObjAlpha("sfx%k10%", floor(255 * (1 - t10)));
                k10 = k10 + 1;
            }
            dis.setObjAlpha("sfx16", 90 + floor(jaw.random(0, 80)));
            wait(16);
            f10 = f10 + 1;
        }
        spClear(12);
        dis.removeObj("sfx16");
        spBurst(tx, ty, s, s * 0.1, s * 0.45, "#ffe066", "#ff3a1a", 14);
    }
    if [mv == 63]{   // 파괴광선: 가장 굵고 긴 주황빛 줄기
        spBeam(ax, ay, tx, ty, s, "#fff6e0", "#ffa83a", 0.09, 34, 0);
    }
    if [mv == 416]{   // 기가임팩트: 파괴광선만큼 굵고 긴 보랏빛 줄기 (쏘기 전 짧게 번쩍)
        spGather(ax, ay, tx, ty, s, "#ffffff", "#c07aff", 8);
        spBeam(ax, ay, tx, ty, s, "#fff0ff", "#b05aff", 0.095, 34, 0);
    }
    if [mv == 76]{   // 솔라빔: 공격하는 쪽에 햇빛이 모임 → 금빛 줄기
        spGather(ax, ay, tx, ty, s, "#ffffe0", "#ffe04a", 30);
        spBeam(ax, ay, tx, ty, s, "#ffffe8", "#ffd84a", 0.07, 26, 0);
    }
    if [mv == 451]{   // 차지빔: 지직거리는 노란 전기 줄기
        spBeam(ax, ay, tx, ty, s, "#fffbd0", "#ffd23a", 0.06, 22, 5);
    }
    if [mv == 62]{   // 오로라빔: 색이 무지개처럼 흘러가는 줄기
        spBeam(ax, ay, tx, ty, s, "#f4fbff", "#7ad8ff", 0.055, 26, 1);
    }
    if [mv == 61]{   // 거품광선: 줄기 대신 거품 알갱이
        spBubbles(ax, ay, tx, ty, s, "#d8f2ff", "#5ab4ff", 34);
    }
    if [mv == 324]{   // 시그널빔: 빨강 · 초록이 번갈아 깜빡이는 물결 줄기
        spBeam(ax, ay, tx, ty, s, "#f8ffe8", "#a0e040", 0.06, 22, 6);
    }
    if [mv == 430]{   // 러스터캐논: 반짝이는 은빛 줄기
        spBeam(ax, ay, tx, ty, s, "#ffffff", "#b8c8d8", 0.07, 24, 2);
    }
    if [mv == 60]{   // 환상빔: 굽이치는 분홍 줄기
        spBeam(ax, ay, tx, ty, s, "#ffe8ff", "#ff6ad0", 0.06, 22, 3);
    }
    if [mv == 820]{   // 드래곤에너지: 굵은 남빛 용의 기운
        spBeam(ax, ay, tx, ty, s, "#e8f0ff", "#5a6cff", 0.085, 30, 0);
    }
    if [mv == 795]{   // 무한다이빔: 가장 굵은 붉은 줄기
        spBeam(ax, ay, tx, ty, s, "#ffe0e8", "#ff2a5a", 0.1, 36, 0);
    }
    if [mv == 796]{   // 철제광선: 굵은 은빛 줄기
        spBeam(ax, ay, tx, ty, s, "#ffffff", "#a8b8c8", 0.085, 30, 2);
    }
    if [mv == 800]{   // 메테오빔: 우주의 빛이 모임 → 모랫빛 줄기
        spGather(ax, ay, tx, ty, s, "#fff4d8", "#d8a860", 26);
        spBeam(ax, ay, tx, ty, s, "#fff8e8", "#d8a860", 0.075, 26, 0);
    }
    if [mv == 711]{   // 프리즘레이저: 굵은 무지개 줄기
        spBeam(ax, ay, tx, ty, s, "#ffffff", "#ff9ad8", 0.09, 30, 1);
    }
    if [mv == 714]{   // 섀도레이: 보랏빛 달빛 줄기
        spBeam(ax, ay, tx, ty, s, "#ece0ff", "#7a3aff", 0.075, 28, 0);
    }
    if [mv == 888]{   // 트윈빔: 분홍 줄기가 위 · 아래에서 한 번씩 (두 번)
        spBeam(ax, ay, tx, ty, s, "#ffe8ff", "#ff6ad0", 0.06, 10, 4);
        spBeam(ax, ay, tx, ty, s, "#ffe8ff", "#ff6ad0", 0.06, 10, 7);
    }
    if [mv == 907]{   // 변덕레이저: 남빛 줄기가 위 · 아래에서 한 번씩 (두 번)
        spBeam(ax, ay, tx, ty, s, "#e8f0ff", "#6a5cff", 0.065, 12, 4);
        spBeam(ax, ay, tx, ty, s, "#e8f0ff", "#6a5cff", 0.065, 12, 7);
    }
    if [mv == 905]{   // 일렉트로빔: 전기가 모임 → 지직거리는 굵은 줄기
        spGather(ax, ay, tx, ty, s, "#fffbd0", "#ffd23a", 22);
        spBeam(ax, ay, tx, ty, s, "#fffbd0", "#ffd23a", 0.07, 26, 5);
    }
    if [mv == 744]{   // 다이맥스포: 굵은 붉은 줄기
        spBeam(ax, ay, tx, ty, s, "#ffe8e8", "#ff3a6a", 0.085, 30, 0);
    }
    if [mv == 705]{   // 플뢰르캐논: 굵은 분홍 줄기
        spBeam(ax, ay, tx, ty, s, "#fff0f8", "#ff8ac8", 0.08, 28, 0);
    }
    // ── 타입 텍스쳐 기술 (fx_type.png)
    if [mv == 52]{   // 불꽃세례: 작은 불똥 여섯 개가 통통 튀며 날아감
        spShower(1, ax, ay, tx, ty, s, 6, 0.05, 16, 3, 0.12, 0.01, 0, 0.08, "#ff7a20");
        spBurst(tx, ty, s, s * 0.05, s * 0.24, "#ffe066", "#ff7a20", 8);
    }
    if [mv == 126]{   // 불대문자: 큰 불똥이 줄지어 날아감 → 맞는 곳에서 불길이 맴돎
        spShower(1, ax, ay, tx, ty, s, 10, 0.08, 14, 2, 0.06, 0.01, 0, 0.12, "#ff4a2a");
        spSwirl(1, tx, ty, s, 10, 0.06, 26, 0, 0.1, "#ff4a2a");
        spBurst(tx, ty, s, s * 0.08, s * 0.4, "#ffe066", "#ff3a1a", 12);
    }
    if [mv == 83]{   // 회오리불꽃: 맞는 곳 둘레를 불똥이 맴돌며 솟구침
        spSwirl(1, tx, ty, s, 12, 0.055, 40, 0, 0.08, "#ff7a20");
    }
    if [mv == 145]{   // 거품: 거품 여덟 개가 흔들흔들 느리게 날아감
        spShower(2, ax, ay, tx, ty, s, 8, 0.04, 24, 3, 0.05, 0.03, 0, 0, "");
    }
    if [mv == 55]{   // 물대포: 작은 거품이 촘촘한 줄기로
        spShower(2, ax, ay, tx, ty, s, 14, 0.03, 12, 1, 0.08, 0.005, 0, 0.04, "#5ab4ff");
    }
    if [mv == 75]{   // 잎날가르기: 빙글빙글 도는 나뭇잎 여섯 장
        spShower(3, ax, ay, tx, ty, s, 6, 0.05, 16, 3, 0.14, 0, 40, 0, "");
    }
    if [mv == 345]{   // 매지컬리프: 빛나는 나뭇잎이 굽이치며 날아감 → 반짝
        spShower(3, ax, ay, tx, ty, s, 8, 0.05, 18, 2, 0.1, 0.04, 30, 0.08, "#ffe866");
        spRain(8, tx, ty, s, 4, 0.04, 8, 2, 0, 0.06, "#ffe866");
    }
    if [mv == 437]{   // 리프스톰: 나뭇잎 폭풍이 맞는 곳을 휘감음
        spShower(3, ax, ay, tx, ty, s, 12, 0.05, 12, 1, 0.05, 0.03, 35, 0, "");
        spSwirl(3, tx, ty, s, 14, 0.06, 34, 30, 0, "");
    }
    if [mv == 80]{   // 꽃잎댄스: 꽃잎이 맞는 곳 둘레를 춤추듯 돎
        spSwirl(9, tx, ty, s, 14, 0.045, 46, 15, 0.04, "#ff9ad0");
    }
    if [mv == 84]{   // 전기쇼크: 맞는 곳에 스파크가 지직지직
        spSparks(tx, ty, s, 5, 0.06, 0.3, 24);
    }
    if [mv == 209]{   // 스파크: 공격하는 쪽에서 번쩍 → 맞는 곳에 스파크
        spSparks(ax, ay, s, 4, 0.05, 0.25, 12);
        spSparks(tx, ty, s, 7, 0.06, 0.3, 21);
    }
    if [mv == 87]{   // 번개: 커다란 번개가 위에서 연달아 떨어짐 → 지직거림
        spRain(4, tx, ty, s, 5, 0.12, 6, 3, 0, 0.14, "#ffd23a");
        spSparks(tx, ty, s, 8, 0.07, 0.35, 18);
        spBurst(tx, ty, s, s * 0.08, s * 0.4, "#ffffff", "#ffd23a", 10);
    }
    if [mv == 435]{   // 방전: 공격하는 쪽 둘레가 지직거림 → 맞는 곳까지 스파크
        spSparks(ax, ay, s, 8, 0.06, 0.45, 18);
        spSparks(tx, ty, s, 8, 0.06, 0.35, 15);
    }
    if [mv == 181]{   // 눈싸라기: 눈 결정이 빙글빙글 흩날려 감
        spShower(5, ax, ay, tx, ty, s, 10, 0.035, 18, 2, 0.06, 0.03, 20, 0.05, "#bfefff");
    }
    if [mv == 196]{   // 얼어붙은바람: 눈 결정이 바람에 크게 흔들리며
        spShower(5, ax, ay, tx, ty, s, 12, 0.04, 20, 2, 0, 0.07, 25, 0.05, "#bfefff");
    }
    if [mv == 59]{   // 눈보라: 큰 눈 결정이 몰아치고 → 맞는 곳에 쏟아짐
        spShower(5, ax, ay, tx, ty, s, 14, 0.05, 14, 1, 0.04, 0.06, 30, 0.06, "#bfefff");
        spRain(5, tx, ty, s, 10, 0.05, 10, 1, 20, 0.06, "#bfefff");
    }
    if [mv == 88]{   // 돌떨구기: 작은 바위 하나를 휙 던짐
        spRockThrow(ax, ay, tx, ty, s, 0.05, 18, 0.22, 16);
    }
    if [mv == 479]{   // 떨어뜨리기: 하늘에서 중간 바위 하나가 떨어짐
        spRockDrop(tx, ty, s, 0.08, 1.0, 4, 16, 0);
    }
    if [mv == 317]{   // 암석봉인: 중간 바위 하나를 던짐 (돌떨구기보다 크고 묵직하게)
        spRockThrow(ax, ay, tx, ty, s, 0.08, 22, 0.16, 7);
    }
    if [mv == 157]{   // 스톤샤워: 중간 · 작은 바위가 하늘에서 1 초쯤 쏟아짐
        spRain(6, tx, ty, s, 16, 0.05, 14, 3, 12, 0, "");
    }
    if [mv == 920]{   // 록다운: 큰 바위가 상대 바로 위에 잠깐 생겼다가 빠르게 내리꽂힘
        spRockDrop(tx, ty, s, 0.14, 0.5, 24, 6, 1);
    }
    if [mv == 51]{   // 용해액: 독 방울이 포물선을 그리며
        spShower(7, ax, ay, tx, ty, s, 6, 0.045, 18, 3, 0.18, 0, 0, 0.05, "#c070ff");
    }
    if [mv == 124]{   // 오물공격: 독 방울이 한꺼번에 뿌려짐 → 독빛이 퍼짐
        spShower(7, ax, ay, tx, ty, s, 10, 0.05, 16, 1, 0.14, 0.02, 0, 0.05, "#c070ff");
        spBurst(tx, ty, s, s * 0.06, s * 0.3, "#d8a0ff", "#9b3cff", 10);
    }
    if [mv == 584]{   // 요정의바람: 반짝임이 바람에 흔들리며 날아감
        spShower(8, ax, ay, tx, ty, s, 10, 0.04, 20, 2, 0.04, 0.06, 0, 0.08, "#ff9ad8");
    }
}
