, 184, -3, 24, 185, 5, 26, 186, 0, 27, 187, 0, 29, 81, 0, 20, 82, 0, 18, 83, 0, 26, 84, -4, 19, 85, -4, 21, 86, 1, 33, 72, -2, 24, 73, 0, 29, 151, -1, 22];
