        spBoost(ax, ay, s, cA, cP, cA, 30, 1);
    }
    if [mv == 74] or [mv == 526] or [mv == 563] or [mv == 674]{   // 성장 · 분발 · 일구기 · 어시스트기어: 공격 · 특공
        spBoost(ax, ay, s, cA, cS, cA, 34, 1);
    }
    if [mv == 96] or [mv == 159] or [mv == 336] or [mv == 187]{   // 요가포즈 · 각지기 · 멀리짖기 · 배북: 공격
        spBoost(ax, ay, s, cA, cA, cA, 32, 1);
    }
    if [mv == 339] or [mv == 811]{   // 벌크업 · 코칭: 공격 · 방어
        spBoost(ax, ay, s, cA, cD, cA, 32, 1);
    }
    if [mv == 489]{   // 똬리틀기: 공격 · 방어 · 명중
        spBoost(ax, ay, s, cA, cD, cC, 32, 1);
    }
    if [mv == 347]{   // 명상: 특공 · 특방
        spBoost(ax, ay, s, cS, cF, cS, 34, 1);
    }
    if [mv == 417] or [mv == 294]{   // 나쁜음모 · 반딧불: 특공
        spBoost(ax, ay, s, cS, cS, cS, 34, 1);
    }
    if [mv == 133] or [mv == 268] or [mv == 597]{   // 망각술 · 충전 · 아로마미스트: 특방
        spBoost(ax, ay, s, cF, cF, cF, 30, 1);
    }
    if [mv == 483]{   // 나비춤: 특공 · 특방 · 스피드
        spBoost(ax, ay, s, cS, cF, cP, 34, 1);
    }
    if [mv == 601] or [mv == 868] or [mv == 504]{   // 지오컨트롤 · 제살깎기 · 껍질깨기: 크게
        spBoost(ax, ay, s * 1.2, cS, cF, cP, 40, 1);
    }
    if [mv == 748] or [mv == 775]{   // 배수의진 · 소울비트: 모든 능력
        spBoost(ax, ay, s, cA, cS, cP, 38, 1);
    }
    if [mv == 104] or [mv == 107]{   // 그림자분신 · 작아지기: 회피
        spBoost(ax, ay, s, cE, cE, cE, 30, 1);
    }
    // ── 간단한 공용 이펙트로 묶은 기술 (2026-11-24) ──
    if [mv == 44] or [mv == 162]{   // 물기 · 분노의앞니: 흰 이빨이 콱
        spFangs(tx, ty, sT, "#ffffff", "#c8b0e8", 0.08);
    }
    if [mv == 242]{   // 깨물어부수기: 더 큰 이빨
        spFangs(tx, ty, sT, "#dccdf1", "#9a70d8", 0.1);
    }
    if [mv == 423]{   // 얼음엄니
        spFangs(tx, ty, sT, "#bcebff", "#6ad0ff", 0.08);
        spIceHit(tx, ty, sT, 4);
    }
    if [mv == 424]{   // 불꽃엄니
        spFangs(tx, ty, sT, "#ffc19d", "#ff6a20", 0.08);
        spBurst(tx, ty, sT, sT * 0.04, sT * 0.2, "#ffe080", "#ff5a10", 10);
    }
    if [mv == 422]{   // 번개엄니
        spFangs(tx, ty, sT, "#ffeda6", "#ffd23a", 0.08);
        spSparks(tx, ty, sT, 6, 0.05, 0.3, 14);
    }
    // 소리 (음파 고리) — spSound(…, 색, 고리 수, 크기)
    if [mv == 45]{   // 울음소리
        spSound(ax, ay, tx, ty, s, "#ffffff", 4, 0.5);
    }
    if [mv == 46]{   // 울부짖기: 크고 많이
        spSound(ax, ay, tx, ty, s, "#fff0c0", 7, 0.8);
    }
    if [mv == 47]{   // 노래하기: 분홍 · 느긋하게
        spSound(ax, ay, tx, ty, s, "#ffb0e0", 5, 0.5);
    }
    if [mv == 48]{   // 초음파: 하늘빛 · 많이 · 작게
        spSound(ax, ay, tx, ty, s, "#c8f0ff", 8, 0.35);
    }
    if [mv == 103]{   // 싫은소리
        spSound(ax, ay, tx, ty, s, "#f0f0f0", 8, 0.45);
    }
    if [mv == 319]{   // 금속음
        spSound(ax, ay, tx, ty, s, "#d0dce8", 7, 0.45);
    }
    if [mv == 195]{   // 멸망의노래
        spSound(ax, ay, tx, ty, s, "#d0a0ff", 6, 0.6);
    }
    if [mv == 173] or [mv == 253]{   // 코골기 · 소란피기
        spSound(ax, ay, tx, ty, s, "#ffe0b0", 6, 0.55);
    }
    if [mv == 555]{   // 바크아웃
        spSound(ax, ay, tx, ty, s, "#a080c0", 6, 0.55);
    }
    if [mv == 574]{   // 차밍보이스
        spSound(ax, ay, tx, ty, s, "#ffa0d0", 6, 0.55);
    }
    if [mv == 405]{   // 벌레의야단법석
        spSound(ax, ay, tx, ty, s, "#c8e860", 7, 0.6);
    }
    // 흡수 (빛 알갱이가 쓰는 쪽으로)
    if [mv == 71]{   // 흡수
        spDrain(ax, ay, tx, ty, s, "#90ff70", 6);
    }
    if [mv == 202]{   // 기가드레인
        spDrain(ax, ay, tx, ty, s, "#60f040", 10);
    }
    if [mv == 141]{   // 흡혈
        spDrain(ax, ay, tx, ty, s, "#ff6a6a", 6);
    }
    if [mv == 138]{   // 꿈먹기
        spDrain(ax, ay, tx, ty, s, "#ff90d0", 10);
    }
    if [mv == 577]{   // 드레인키스
        spDrain(ax, ay, tx, ty, s, "#ffa8d8", 8);
    }
    // 회복
    if [mv == 105]{   // HP회복
        spHeal(ax, ay, s, "#a0ffb8");
    }
    if [mv == 234] or [mv == 273]{   // 아침햇살 · 희망사항
        spHeal(ax, ay, s, "#fff0a0");
    }
    if [mv == 236]{   // 달빛
        spHeal(ax, ay, s, "#e0d0ff");
    }
    if [mv == 235]{   // 광합성
        spHeal(ax, ay, s, "#b8ff80");
    }
    if [mv == 355]{   // 날개쉬기
        spHeal(ax, ay, s, "#e0f0ff");
    }
    if [mv == 156]{   // 잠자기
        spHeal(ax, ay, s, "#c8c8ff");
    }
    // 방어
    if [mv == 182] or [mv == 197]{   // 방어 · 판별
        spProtect(ax, ay, s, "#80ffb0");
    }
    if [mv == 203]{   // 버티기
        spProtect(ax, ay, s, "#ffb080");
    }
    if [mv == 501] or [mv == 469]{   // 패스트가드 · 와이드가드
        spProtect(ax, ay, s, "#ffe8a0");
    }
    // 염동력 계열
    if [mv == 93]{   // 염동력
        spPsy(tx, ty, sT, "#ff90e0", 0);
    }
    if [mv == 94]{   // 사이코키네시스
        spPsy(tx, ty, sT, "#ff70d0", 1);
    }
    // 자폭 · 대폭발: 쓰는 쪽에서 크게 터짐
    if [mv == 120]{
        spBoom(ax, ay, sA, "#fff4d0", "#ff8a2a", 0.9, 12, 0, 18);
    }
    if [mv == 153]{
        spBoom(ax, ay, sA, "#ffc8a2", "#ff6a20", 1.3, 16, 0, 22);
    }
    // 접촉 물리 기본 (돌격 → 타입 색 충격) — 전용 이펙트가 없는 접촉 기술
    var list call dashMv = [211, 231, 360, 442, 484, 684, 66, 69, 233, 249, 276, 280, 480, 122, 310, 425, 11, 12, 20, 21, 29, 32, 33, 34, 35, 37, 70, 98, 175, 206, 229, 245, 252, 283, 343, 387, 458, 398, 407, 525, 784, 91, 529, 667, 127, 401, 453, 205, 457, 224, 369, 450, 565, 679, 172, 488, 17, 64, 65, 365, 814, 228, 282, 371, 372, 389, 492, 675, 428, 609, 583, 22, 438, 452, 785, 803, 885];
    if [dashMv.find(mv) != 0]{
        spDashBasic(ax, ay, tx, ty, s, sT, fxSrcCol);
    }
    if [mv == 408]{   // 파워젬: 여러 색 보석 바위가 차츰 나타나 쓰는 쪽 둘레를 돌다가 → 맞는 곳으로 빠르게 날아가 부서짐
        spGems(ax, ay, tx, ty, s);
    }
    if [mv == 920]{   // 록다운: 큰 바위가 상대 바로 위에 잠깐 생겼다가 빠르게 내리꽂힘
        spRockDrop(tx, ty, sT, 0.14, 0.5, 24, 6, 1);
    }
    if [mv == 10]{   // 할퀴기: 흰 발톱 자국 한 번
        spClaws(tx, ty, sT, "#ffffff", "#c8d4e8", 0.3, 1, 0, 6, 0);
    }
    if [mv == 154]{   // 마구할퀴기: 작은 발톱 자국이 엇갈리며 세 번 빠르게
        spClaws(tx, ty, sT, "#ffffff", "#c8d4e8", 0.26, 3, 7, 3, 0);
    }
    if [mv == 163]{   // 베어가르기: 크고 얇은 베기 자국 하나 (spSlash · 노말 색)
        spSlash(tx, ty, sT, mu.typeCol(1), 0.6, 8, jaw.random(-20, 15));
    }
    if [mv == 232]{   // 메탈클로: 은빛 자국 + 쇳빛 번쩍
        spClaws(tx, ty, sT, "#f8fbff", "#9fb4cc", 0.34, 1, 0, 8, 0);
        spBurst(tx, ty, sT, sT * 0.03, sT * 0.16, "#ffffff", "#b8c8d8", 8);
    }
    if [mv == 306]{   // 브레이크클로: 주황빛 자국 두 개가 X 자로
        spClaws(tx, ty, sT, "#ffd3ac", "#ff9a4a", 0.36, 2, 6, 6, 0);
    }
    if [mv == 337]{   // 드래곤클로: 크고 푸른 보랏빛 자국 X 자 + 용 기운
        spClaws(tx, ty, sT, "#babcff", "#5a5cff", 0.42, 2, 6, 8, 0);
        spBurst(tx, ty, sT, sT * 0.04, sT * 0.24, "#c8ccff", "#5a5cff", 10);
    }
    if [mv == 421]{   // 섀도클로: 그림자 빛 보라 자국 + 어둠이 퍼짐
        spClaws(tx, ty, sT, "#e0c8ff", "#5a1a9a", 0.42, 1, 0, 10, 15);
        spBurst(tx, ty, sT, sT * 0.04, sT * 0.24, "#7a3ab8", "#2a0a4a", 10);
    }
    if [mv == 468]{   // 손톱갈기: 자기 몸 앞에서 작은 금빛 자국 둘 (발톱을 감)
        spClaws(ax, ay, sA, "#ffefac", "#ffd84a", 0.22, 2, 8, 4, 0);
    }
    if [mv == 827]{   // 페이탈클로: 독빛 자국 X 자 + 독 방울이 튐
        spClaws(tx, ty, sT, "#dca8ff", "#b040ff", 0.38, 2, 6, 6, 0);
        spBurst(tx, ty, sT, sT * 0.04, sT * 0.22, "#d8a0ff", "#9b3cff", 10);
    }
    if [mv == 921]{   // 플레임클로: 불빛 자국 X 자 + 불똥이 맴돌며 피어오름
        spClaws(tx, ty, sT, "#fff2c0", "#ff6a20", 0.38, 2, 6, 6, 0);
        spSwirl(1, tx, ty, sT, 8, 0.045, 26, 0, 0.08, "#ff7a20");
    }
    if [mv == 121]{   // 알폭탄: 크림빛 공 → 하얀 폭발
        spBomb(ax, ay, tx, ty, s, "#fff1c3", "#ffd870", 0.09, 22, 12, 0.3, 10, 0, 1, 1);
    }
    if [mv == 188]{   // 오물폭탄: 보랏빛 공 → 독 방울이 사방으로
        spBomb(ax, ay, tx, ty, s, "#d2a1ff", "#9b3cff", 0.09, 22, 12, 0.3, 10, 7, 5, 1);
    }
    if [mv == 402]{   // 씨폭탄: 초록빛 공 → 나뭇잎이 사방으로
        spBomb(ax, ay, tx, ty, s, "#bceca1", "#5ac83a", 0.0825, 20, 12, 0.28, 10, 3, 2, 1);
    }
    if [mv == 426]{   // 진흙폭탄: 흙빛 공 → 흙덩이가 사방으로
        spBomb(ax, ay, tx, ty, s, "#f0dcc0", "#8a5a2a", 0.09, 22, 12, 0.3, 10, 6, 3, 1);
    }
    if [mv == 443]{   // 마그넷봄: 은빛 공 → 쇳빛 폭발 (빠르게)
        spBomb(ax, ay, tx, ty, s, "#ffffff", "#a8bcd0", 0.075, 18, 9, 0.26, 10, 0, 4, 1);
    }
    if [mv == 491]{   // 애시드봄: 연보라 공 → 독 방울
        spBomb(ax, ay, tx, ty, s, "#e2b6ff", "#c060ff", 0.075, 20, 12, 0.26, 8, 7, 0, 1);
    }
    if [mv == 903]{   // 시럽봄: 호박빛 공 → 끈끈한 방울
        spBomb(ax, ay, tx, ty, s, "#fff0d0", "#ff8a2a", 0.09, 22, 13, 0.28, 10, 0, 6, 1);
    }
    if [mv == 585]{   // 문포스: 큰 분홍 달빛 공을 오래 모음 → 반짝임이 크게 퍼짐
        spBomb(ax, ay, tx, ty, s, "#ffc9f1", "#ff7ad8", 0.12, 34, 12, 0.4, 14, 8, 0, 1);
    }
    if [mv == 23]{   // 짓밟기: 한 번 쿵 → 짧게 떨림 · 작은 흙먼지 고리
        spQuake(ax, ay, tx, ty, s, 8, 22, 0.012, 0.18, 3, "#f0e0c0", "#a08050", 0);
    }
    if [mv == 89]{   // 지진: 세 번 쿵쿵 → 크게 오래 떨림 · 큰 고리 셋 + 돌 조각이 많이 튐
        spQuake(ax, ay, tx, ty, s, 24, 48, 0.03, 0.42, 10, "#f4e4c4", "#9a6a30", 0);
    }
    if [mv == 90]{   // 땅가르기: 지진보다 더 세게 · 어두운 흙빛
        spQuake(ax, ay, tx, ty, s, 24, 54, 0.036, 0.45, 10, "#d8c0a0", "#5a3a18", 0);
    }
    if [mv == 222]{   // 매그니튜드: 두 번 쿵쿵 → 중간 떨림
        spQuake(ax, ay, tx, ty, s, 16, 40, 0.022, 0.34, 7, "#f4e4c4", "#9a6a30", 0);
    }
    if [mv == 523]{   // 땅고르기: 두 번 쿵쿵 → 땅이 고르게 흔들림 · 넓고 낮은 고리
        spQuake(ax, ay, tx, ty, s, 16, 36, 0.018, 0.4, 5, "#f0e4cc", "#b08a50", 0);
    }
    if [mv == 707]{   // 분함의발구르기: 씩씩대며 세 번 쿵쿵 → 붉은 흙먼지 고리
        spQuake(ax, ay, tx, ty, s, 24, 40, 0.026, 0.36, 7, "#ffe0c8", "#e0502a", 0);
    }
    if [mv == 200]{   // 역린: 붉은 용 기운을 두르고 쿵쿵 → 크게 떨림 · 붉은 보랏빛 충격파
        spQuake(ax, ay, tx, ty, s, 32, 44, 0.03, 0.4, 8, "#efa0c1", "#d02a6a", 1);
        spBurst(tx, ty, sT, sT * 0.06, sT * 0.3, "#ffc0d8", "#c02060", 10);
    }
    if [mv == 51]{   // 용해액: 독 방울이 포물선을 그리며
        spShower(7, ax, ay, tx, ty, s, 6, 0.045, 18, 3, 0.18, 0, 0, 0.05, "#c070ff");
    }
    if [mv == 124]{   // 오물공격: 독 방울이 한꺼번에 뿌려짐 → 독빛이 퍼짐
        spShower(7, ax, ay, tx, ty, s, 10, 0.05, 16, 1, 0.14, 0.02, 0, 0.05, "#c070ff");
        spBurst(tx, ty, sT, sT * 0.06, sT * 0.3, "#d8a0ff", "#9b3cff", 10);
    }
    if [mv == 584]{   // 요정의바람: 반짝임이 바람에 흔들리며 날아감
        spShower(8, ax, ay, tx, ty, s, 10, 0.04, 20, 2, 0.04, 0.06, 0, 0.08, "#ff9ad8");
    }
}
